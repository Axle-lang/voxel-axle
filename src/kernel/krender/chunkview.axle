// chunkview — the world-face raster: one worker's share of the streamed
// chunks, projected, lit, clipped and queued, then filled in parallel bands.
//
// The sibling of `mobview`, for terrain. Each `ChunkRenderer` is one
// independent worker: it walks a stride of the chunk ring, projects every
// baked face of the slots it owns, computes the per-CORNER light (smooth
// light, ambient occlusion, the soft cast shadow and the coloured bounce,
// through `cornerlight`), near-clips in camera space and appends triangles to
// its own queue. Nothing is shared between workers, so nothing needs a lock.
//
// The queue is then filled by screen-column bands: every band owns its pixels,
// so no two threads touch the same z-buffer word, and each band walks every
// worker's queue. The split is deliberate — the build is one job and the fill
// is another, and measured, the build is the expensive two thirds.

use smalt::Mem;
use crate::kernel::krender::raster::{ rasterTriTex, columnSpan, RasterVert, RasterTri, FrameBuf, MipAtlas, Band, Camera, Lens, Projected, VertAttribs, ScreenScratch };
use crate::kernel::klight::surface::{ SurfaceLight, CornerTerms, cornerColour };
use crate::kernel::klight::gamma::{ Gamma, LinRgb };
use crate::kernel::ksky::atmosphere::{ FogTable };
use crate::kernel::klight::daymodel::{ DayState };
use crate::kernel::seams::{ CornerProbe, CornerSample };
use crate::kernel::kmath::vec3::{ Vec3, IVec3, vec3, ivec3 };
use crate::kernel::kentity::player::Player;
use crate::kernel::kworld::manager::ChunkManager;
use crate::kernel::kblock::blocks::{ fluidLevel, isWater, isSource };
use crate::configs::blocks::{ Block };
use crate::configs::face::{ FaceDir };
use crate::configs::light::{ Light };
use crate::configs::render::{ Render };
use crate::configs::time::{ Daylight };
use crate::configs::water::{ Water };
use crate::configs::world::{ World };

/** A 0..255 byte as a 0..1 fraction. */
const BYTE_TO_UNIT : f64 = 0.00392157;

/** The baked corner occlusion runs 0..3, so a level is a third of the way. */
const THIRD : f64 = 0.33333333333333333;

/**
 * Reconstruct a FaceDir from its packed discriminant (0..5). The mesher packs
 * the direction into each face's `ftile` slot (see ChunkManager.addFace) to
 * avoid a parallel direction array; this turns it back into the enum so the
 * renderer matches on it by name.
 * @param d  the direction discriminant, 0..5
 * @return the matching FaceDir
 */
fn faceDirFrom(d : i32) : FaceDir {
    return match d {
        0 => FaceDir::PosX,
        1 => FaceDir::NegX,
        2 => FaceDir::Top,
        3 => FaceDir::Bottom,
        4 => FaceDir::PosZ,
        _ => FaceDir::NegZ,
    };
}

/** Inward normal of one frustum plane, in world axes, through the eye. */
struct ViewPlane {
    nx : f64,
    ny : f64,
    nz : f64,
}

/**
 * The wedge of world a frame can see: where the eye is, and the five planes the
 * lens and the near clip cut the world with.
 *
 * The sides are the half that was missing. A chunk used to be kept whenever its
 * centre was anywhere but well behind the eye — half the world, where the
 * window shows about a hundred and six degrees of it — so half again as many
 * chunks as could ever be seen had every one of their faces projected, lit and
 * clipped before the raster threw them away offscreen.
 *
 * The planes are the REAL ones, in three dimensions, and that is not a
 * refinement — it is what makes the test correct. The first version of this
 * worked on the ground plane and carried the pitch as a fudge: a slack term
 * widened the sides by what a chunk's height could add to the depth, and a
 * chunk was allowed one chunk's length behind the eye. Both are wrong the
 * moment the camera looks steeply down from above the terrain, which is what
 * flying is. Looking down, the visible ground reaches BEHIND the eye — a point
 * below the eye has positive view depth however far back it sits — so chunks
 * that fill a third of the frame were being dropped for being behind.
 *
 * A plane through the eye with an inward normal has none of that: the test is
 * the same arithmetic at any pitch, any height, any lens.
 */
struct ViewCone {
    eyeX : f64,
    eyeY : f64,
    eyeZ : f64,
    near : ViewPlane,   // the four sides and the near clip, inward normals
    left : ViewPlane,
    right : ViewPlane,
    top : ViewPlane,
    bottom : ViewPlane,
    far : f64,          // the draw distance, plus a chunk's own extent
}

/**
 * The view cone for this eye and this lens.
 *
 * The half-angles are the lens's own: the projection puts the frame's edge at
 * `hw` (or `hh`) pixels from the centre and the film at `focal` pixels away, so
 * a point is inside a side plane exactly when its offset along that axis, times
 * the focal length, does not exceed its depth times the half-size. Written as a
 * dot product against a normal, that is the plane — and it needs no
 * normalising, because only the SIGN of the result is ever read.
 * @param p     player providing the eye position and orientation
 * @param lens  the frame's projection centre and focal length
 * @return the cone chunks are tested against
 */
fn viewConeFor(p : Player, lens : Lens) : ViewCone {
    // The camera basis. Forward carries the pitch; right lies in the ground
    // plane, there being no roll; up is the third of the frame.
    let fx : f64 = (0.0 - p.siny) * p.cosp;
    let fy : f64 = p.sinp;
    let fz : f64 = p.cosy * p.cosp;
    let rx : f64 = p.cosy;
    let rz : f64 = p.siny;
    let ux : f64 = p.siny * p.sinp;
    let uy : f64 = p.cosp;
    let uz : f64 = (0.0 - p.cosy) * p.sinp;
    return ViewCone {
        eyeX: p.eye.x,
        eyeY: p.eye.y,
        eyeZ: p.eye.z,
        near: ViewPlane { nx: fx, ny: fy, nz: fz },
        left: ViewPlane { nx: fx * lens.hw + rx * lens.focal,
                          ny: fy * lens.hw,
                          nz: fz * lens.hw + rz * lens.focal },
        right: ViewPlane { nx: fx * lens.hw - rx * lens.focal,
                           ny: fy * lens.hw,
                           nz: fz * lens.hw - rz * lens.focal },
        top: ViewPlane { nx: fx * lens.hh - ux * lens.focal,
                         ny: fy * lens.hh - uy * lens.focal,
                         nz: fz * lens.hh - uz * lens.focal },
        bottom: ViewPlane { nx: fx * lens.hh + ux * lens.focal,
                            ny: fy * lens.hh + uy * lens.focal,
                            nz: fz * lens.hh + uz * lens.focal },
        far: Render::DRAW_DIST + (World::CHUNK_SIZE as f64),
    };
}

/**
 * Whether a box lies entirely on the outside of one plane through the eye.
 *
 * Only the box corner FURTHEST along the normal is tested. If even that one is
 * behind the plane, all eight are; if it is in front, the box straddles the
 * plane or clears it, and either way the box is kept.
 * @param pl   the plane's inward normal
 * @param lox  box low corner, relative to the eye
 * @param hix  box high corner, relative to the eye
 * @return true when nothing in the box is on the inward side
 */
fn boxOutside(pl : ViewPlane, lox : f64, loy : f64, loz : f64,
              hix : f64, hiy : f64, hiz : f64) : bool {
    let x : f64 = lox;
    if (pl.nx > 0.0) {
        x = hix;
    }
    let y : f64 = loy;
    if (pl.ny > 0.0) {
        y = hiy;
    }
    let z : f64 = loz;
    if (pl.nz > 0.0) {
        z = hiz;
    }
    return pl.nx * x + pl.ny * y + pl.nz * z < 0.0;
}

/**
 * A chunk is worth drawing only if some part of it can fall inside the cone.
 *
 * The chunk is its whole column — sixteen by the world's height by sixteen —
 * and the test is that box against the five planes. Nothing that could draw a
 * pixel is refused, because a box is only dropped when one plane has all eight
 * of its corners on the far side. A free function so the world-face pass
 * (ChunkRenderer) and the torch pass (Renderer) share the one visibility rule.
 * @param cone  the frame's view cone
 * @param cx    chunk x index
 * @param cz    chunk z index
 * @return true if the chunk should be drawn
 */
fn chunkVisible(cone : ViewCone, cx : i32, cz : i32) : bool {
    let s : f64 = World::CHUNK_SIZE as f64;
    let lox : f64 = (cx as f64) * s - cone.eyeX;
    let loz : f64 = (cz as f64) * s - cone.eyeZ;
    let hix : f64 = lox + s;
    let hiz : f64 = loz + s;
    let mx : f64 = lox + s * 0.5;
    let mz : f64 = loz + s * 0.5;
    if (mx * mx + mz * mz > cone.far * cone.far) {
        return false;
    }
    let loy : f64 = 0.0 - cone.eyeY;
    let hiy : f64 = (World::HEIGHT as f64) - cone.eyeY;
    if (boxOutside(cone.near, lox, loy, loz, hix, hiy, hiz)) {
        return false;
    }
    if (boxOutside(cone.left, lox, loy, loz, hix, hiy, hiz)) {
        return false;
    }
    if (boxOutside(cone.right, lox, loy, loz, hix, hiy, hiz)) {
        return false;
    }
    if (boxOutside(cone.top, lox, loy, loz, hix, hiy, hiz)) {
        return false;
    }
    return !boxOutside(cone.bottom, lox, loy, loz, hix, hiy, hiz);
}

/**
 * Everything about a face that does not change when its merged run is cut into
 * spans: which face it is in the baked arrays, which way it points, what it is
 * made of, and the Lambert term its corners all share.
 *
 * A struct rather than a dozen arguments threaded down: the split emits one to
 * eight quads from the same face, and every one of them wants all of this.
 */
struct FaceShade {
    idx : i32,          // index into the baked face arrays (light / AO)
    tile : i32,         // atlas tile
    dir : FaceDir,
    naxis : i32,        // normal axis: 0 = X, 1 = Y, 2 = Z
    normal : Vec3,
    light : SurfaceLight, // the body's and the sky's shares, before the shadow
    boxH : f64,         // the block's box height (1.0 = full cube)
    isWater : bool,
    isPartial : bool,
    wrap : bool,        // the texture repeats over this face (merged or water)
    flowU : f64,        // flowing-water texture scroll
    flowV : f64,
}

/**
 * One span of a merged face: where it starts, how many cells it covers, and
 * where its texture picks up so a cut leaves no seam in the tiling.
 */
struct FaceSpan {
    cell : IVec3,   // the span's block origin
    probe : IVec3,  // the air cell its light and shadow are read from
    run : i32,      // cells it covers along the run axis
    uOff : f64,     // texture u where the span starts within the whole run
}

/**
 * ONE world-face raster worker. It owns the projection / near-clip scratch, the
 * per-direction face corner + UV tables and its own triangle queue: the frame
 * builds six of these over disjoint strides of the chunk ring, then fills every
 * queue in disjoint parallel column bands.
 *
 * The per-corner light is read through the `LightSample` seam — one
 * `cornerSample` per corner, carrying sun, sky access and bounce — while the
 * baked mesh FIELDS (fx/fy/fz/ftile/flight/fao) and the water geometry
 * (worldGet / blockBoxHeight) still come off the concrete ChunkManager.
 */
class ChunkRenderer {
    coff : i32[],
    uvu : i32[],
    uvv : i32[],
    cs : ScreenScratch,   // screen-space scratch (pixel x/y + inverse depth)
    ca : VertAttribs,     // camera-space input verts (pos + uv + Gouraud colour) …
    cb : VertAttribs,     // … and the near-clipped output verts
    triBuf : RasterTri[], // world-face triangle queue: the world pass projects/
                          // lights/clips into here once, then worker threads
                          // rasterise it in parallel column bands (tiled render)
    triN : i32,           // number of queued triangles this frame
    atlas : MipAtlas,     // ── per-frame render context (set in drawWorld) ──
    gam : Gamma,          // sRGB ↔ linear tables (owned by GammaTables)
    fogT : FogTable,      // the sky behind each pixel, and how much of it stands between
    day : DayState,       // sun / daylight snapshot (per-corner light + glint)
    lcurve : i64,         // brightness curve (owned by DayLighting)
    /**
     * Triangles queued in the last frame, and the microseconds the banded
     * FILL took of the world pass.
     *
     * Two numbers because the world pass is two very different jobs, and
     * which of them costs is not guessable: the queue build projects,
     * near-clips and lights every face on ONE thread, then the fill
     * spreads over twelve. Measured, the build is roughly two thirds —
     * which is the opposite of where a "the software rasteriser is slow"
     * intuition sends you.
     */
    pub(crate) queuedTris : i32 = 0,

    /** Microseconds spent in the banded fill, accumulated over the run. */
    pub(crate) fillUs : i64 = 0,

    /**
     * Allocate the triangle queue, the projection / clipping scratch buffers and
     * the face corner tables, and seed the (overwritten-per-frame) context.
     */
    constructor() {
        self.triBuf = malloc<RasterTri>(Render::TRI_QUEUE_CAP);
        self.triN = 0;
        self.coff = malloc<i32>(72);
        self.uvu = malloc<i32>(24);
        self.uvv = malloc<i32>(24);
        // Screen-space scratch sized for a near-clipped polygon (≤ 5 verts).
        self.cs = ScreenScratch { sx: Mem::take(8 * 8), sy: Mem::take(8 * 8), iz: Mem::take(8 * 8) };
        // Camera-space input (ca) and clipped output (cb) vertex buffers: x, y,
        // z (depth), the u, v texture coordinates and the r, g, b Gouraud colour
        // per vertex — the same 16 disjoint allocBytes buffers, grouped.
        self.ca = VertAttribs {
            x: Mem::take(8 * 8), y: Mem::take(8 * 8), z: Mem::take(8 * 8),
            u: Mem::take(8 * 8), v: Mem::take(8 * 8),
            r: Mem::take(8 * 8), g: Mem::take(8 * 8), b: Mem::take(8 * 8),
        };
        self.cb = VertAttribs {
            x: Mem::take(8 * 8), y: Mem::take(8 * 8), z: Mem::take(8 * 8),
            u: Mem::take(8 * 8), v: Mem::take(8 * 8),
            r: Mem::take(8 * 8), g: Mem::take(8 * 8), b: Mem::take(8 * 8),
        };
        self.atlas = MipAtlas { mips: 0, mipOff: 0, mipSz: 0 };
        self.gam = Gamma { toLin: 0, toByte: 0, scale: 0.0 };
        self.fogT = FogTable { cols: 1, rows: 1, r: 0, g: 0, b: 0, curve: 0, xscale: 0.0, yscale: 0.0, dscale: 0.0 };
        self.day = DayState {
            sunX: 0.0, sunY: 1.0, sunZ: 0.0,
            dirX: 0.0, dirY: 1.0, dirZ: 0.0,
            dirStrength: 1.0,
            dirTintR: Light::SUN_TINT_R, dirTintG: Light::SUN_TINT_G, dirTintB: Light::SUN_TINT_B,
            skyAmbient: 1.0,
            skyColR: Daylight::DAY_SKY_R, skyColG: Daylight::DAY_SKY_G, skyColB: Daylight::DAY_SKY_B,
        };
        self.lcurve = 0;
        self.fillTable();
    }

    /**
     * Store one face corner's block-space offset and tile UV into the
     * corner / UV tables.
     * @param dir  face direction index (0..5)
     * @param k    corner index within the face (0..3)
     * @param ox   x offset of the corner in block space
     * @param oy   y offset of the corner in block space
     * @param oz   z offset of the corner in block space
     * @param u    tile u coordinate for the corner
     * @param v    tile v coordinate for the corner
     */
    fn setCorner(mut self, dir : i32, k : i32, ox : i32, oy : i32, oz : i32, u : i32, v : i32) : void {
        let b : i32 = (dir * 4 + k) * 3;
        self.coff[b] = ox;
        self.coff[b + 1] = oy;
        self.coff[b + 2] = oz;
        let q : i32 = dir * 4 + k;
        self.uvu[q] = u;
        self.uvv[q] = v;
    }

    /**
     * Fill the per-direction face corner / UV tables for all 6 cube faces.
     */
    fn fillTable(mut self) : void {
        self.setCorner(0, 0, 1, 0, 0, 0, 1);
        self.setCorner(0, 1, 1, 0, 1, 1, 1);
        self.setCorner(0, 2, 1, 1, 1, 1, 0);
        self.setCorner(0, 3, 1, 1, 0, 0, 0);
        self.setCorner(1, 0, 0, 0, 0, 0, 1);
        self.setCorner(1, 1, 0, 1, 0, 0, 0);
        self.setCorner(1, 2, 0, 1, 1, 1, 0);
        self.setCorner(1, 3, 0, 0, 1, 1, 1);
        self.setCorner(2, 0, 0, 1, 0, 0, 0);
        self.setCorner(2, 1, 1, 1, 0, 1, 0);
        self.setCorner(2, 2, 1, 1, 1, 1, 1);
        self.setCorner(2, 3, 0, 1, 1, 0, 1);
        self.setCorner(3, 0, 0, 0, 0, 0, 0);
        self.setCorner(3, 1, 0, 0, 1, 0, 1);
        self.setCorner(3, 2, 1, 0, 1, 1, 1);
        self.setCorner(3, 3, 1, 0, 0, 1, 0);
        self.setCorner(4, 0, 0, 0, 1, 0, 1);
        self.setCorner(4, 1, 1, 0, 1, 1, 1);
        self.setCorner(4, 2, 1, 1, 1, 1, 0);
        self.setCorner(4, 3, 0, 1, 1, 0, 0);
        self.setCorner(5, 0, 0, 0, 0, 0, 1);
        self.setCorner(5, 1, 0, 1, 0, 0, 0);
        self.setCorner(5, 2, 1, 1, 0, 1, 0);
        self.setCorner(5, 3, 1, 0, 0, 1, 1);
    }

    // ── Projection & near-plane clipping ──

    /**
     * Transform a world point into camera space (post yaw + pitch) through the
     * shared Camera and store it into the `ca*` input buffers at slot k. No
     * perspective divide yet — that happens after near-plane clipping.
     * @param cam  the camera (eye + orientation + projection width)
     * @param w    the world-space point
     * @param k    scratch slot index to store the result in
     */
    fn toCam(self, cam : Camera, w : Vec3, k : i32) : void {
        let c : Vec3 = cam.toCamera(w);
        Mem::putRealOf(self.ca.x, k, c.x);
        Mem::putRealOf(self.ca.y, k, c.y);
        Mem::putRealOf(self.ca.z, k, c.z);
    }

    /**
     * Write the linear blend of input vertices j and i at parameter t
     * (the near-plane crossing) into output slot o.
     * @param j  first input vertex slot
     * @param i  second input vertex slot
     * @param t  blend parameter (0 at j, 1 at i)
     * @param o  output vertex slot
     */
    fn emitLerp(self, j : i32, i : i32, t : f64, o : i32) : void {
        Mem::putRealOf(self.cb.x, o, Mem::realOf(self.ca.x, j) + (Mem::realOf(self.ca.x, i) - Mem::realOf(self.ca.x, j)) * t);
        Mem::putRealOf(self.cb.y, o, Mem::realOf(self.ca.y, j) + (Mem::realOf(self.ca.y, i) - Mem::realOf(self.ca.y, j)) * t);
        Mem::putRealOf(self.cb.z, o, Mem::realOf(self.ca.z, j) + (Mem::realOf(self.ca.z, i) - Mem::realOf(self.ca.z, j)) * t);
        Mem::putRealOf(self.cb.u, o, Mem::realOf(self.ca.u, j) + (Mem::realOf(self.ca.u, i) - Mem::realOf(self.ca.u, j)) * t);
        Mem::putRealOf(self.cb.v, o, Mem::realOf(self.ca.v, j) + (Mem::realOf(self.ca.v, i) - Mem::realOf(self.ca.v, j)) * t);
        Mem::putRealOf(self.cb.r, o, Mem::realOf(self.ca.r, j) + (Mem::realOf(self.ca.r, i) - Mem::realOf(self.ca.r, j)) * t);
        Mem::putRealOf(self.cb.g, o, Mem::realOf(self.ca.g, j) + (Mem::realOf(self.ca.g, i) - Mem::realOf(self.ca.g, j)) * t);
        Mem::putRealOf(self.cb.b, o, Mem::realOf(self.ca.b, j) + (Mem::realOf(self.ca.b, i) - Mem::realOf(self.ca.b, j)) * t);
    }

    /**
     * Copy input vertex i to output slot o.
     * @param i  input vertex slot
     * @param o  output vertex slot
     */
    fn copyVert(self, i : i32, o : i32) : void {
        Mem::putRealOf(self.cb.x, o, Mem::realOf(self.ca.x, i));
        Mem::putRealOf(self.cb.y, o, Mem::realOf(self.ca.y, i));
        Mem::putRealOf(self.cb.z, o, Mem::realOf(self.ca.z, i));
        Mem::putRealOf(self.cb.u, o, Mem::realOf(self.ca.u, i));
        Mem::putRealOf(self.cb.v, o, Mem::realOf(self.ca.v, i));
        Mem::putRealOf(self.cb.r, o, Mem::realOf(self.ca.r, i));
        Mem::putRealOf(self.cb.g, o, Mem::realOf(self.ca.g, i));
        Mem::putRealOf(self.cb.b, o, Mem::realOf(self.ca.b, i));
    }

    /**
     * Which corner the fan triangulates from.
     *
     * A quad is drawn as two triangles, so one of its two diagonals becomes a
     * seam: the light is exact along it and interpolated across everything
     * else. Fanning always from corner 0 puts that seam in the same place
     * regardless of where the light actually varies, and on a quad with one
     * dark corner — the inside of every step, ledge and tree trunk — the wrong
     * choice smears the darkness diagonally across the face instead of letting
     * it wrap the corner.
     *
     * The seam belongs on the diagonal joining the DARKER pair, which is the
     * quad-flip rule from the smooth-lighting literature written as a fan
     * origin. Only a quad that survived the near clip whole can be flipped;
     * anything else is already a fan of its own shape.
     * @param n  vertices in the clipped polygon
     * @return the corner index to fan from (0 or 1)
     */
    fn fanOrigin(self, n : i32) : i32 {
        if (n != 4) {
            return 0;
        }
        let d02 : f64 = self.cornerLum(0) + self.cornerLum(2);
        let d13 : f64 = self.cornerLum(1) + self.cornerLum(3);
        if (d02 > d13) {
            return 1;
        }
        return 0;
    }

    /**
     * The baked Gouraud brightness at one clipped corner, as a plain sum of its
     * channels — only the ORDER of two of these ever matters.
     * @param i  index into the clipped-polygon scratch
     * @return the corner's brightness
     */
    fn cornerLum(self, i : i32) : f64 {
        return Mem::realOf(self.cb.r, i) + Mem::realOf(self.cb.g, i) + Mem::realOf(self.cb.b, i);
    }

    /**
     * Vertex `i` of the clipped polygon, gathered into one `RasterVert`.
     *
     * The clip and projection stages write eight parallel scratch arrays
     * (screen x/y, inverse depth, UV, and the baked Gouraud colour); the
     * rasteriser wants them as one value. Fan-triangulating a polygon
     * reads the same corner three times over, so the gather lives here
     * instead of being spelled out per triangle corner.
     *
     * @param i  index into the clipped-polygon scratch
     * @return the corner as the rasteriser's vertex
     */
    fn clippedVert(self, i : i32) : RasterVert {
        return RasterVert {
            sx: Mem::realOf(self.cs.sx, i) as f32,
            sy: Mem::realOf(self.cs.sy, i) as f32,
            iz: Mem::realOf(self.cs.iz, i) as f32,
            u: Mem::realOf(self.cb.u, i) as f32,
            v: Mem::realOf(self.cb.v, i) as f32,
            tr: Mem::realOf(self.cb.r, i) as f32,
            tg: Mem::realOf(self.cb.g, i) as f32,
            tb: Mem::realOf(self.cb.b, i) as f32,
        };
    }

    /**
     * Clip the `nIn`-vertex camera-space polygon in `ca*` against the
     * near plane (depth ≥ `Screen::NEAR_PLANE`) into `cb*` (Sutherland–Hodgman),
     * interpolating position + UV at each crossing. Replacing the old
     * "drop the whole face if any corner is too close" rule is what
     * removes the holes / texture smear when the camera hugs a block.
     * @param nIn  number of input vertices in the `ca*` buffers
     * @return number of output vertices written to the `cb*` buffers
     */
    fn clipNear(self, nIn : i32) : i32 {
        let outN : i32 = 0;
        let j : i32 = nIn - 1;
        let i : i32 = 0;
        while (i < nIn) {
            let zi : f64 = Mem::realOf(self.ca.z, i);
            let zj : f64 = Mem::realOf(self.ca.z, j);
            let inI : bool = zi >= Screen::NEAR_PLANE;
            let inJ : bool = zj >= Screen::NEAR_PLANE;
            if (inI != inJ) {
                let t : f64 = (Screen::NEAR_PLANE - zj) / (zi - zj);
                self.emitLerp(j, i, t, outN);
                outN = outN + 1;
            }
            if (inI) {
                self.copyVert(i, outN);
                outN = outN + 1;
            }
            j = i;
            i = i + 1;
        }
        return outN;
    }

    /**
     * Classify one column at a corner for the surface averager:
     *   2.0  → a source, or water with water directly above (a column) — stays
     *          full so lakes are flat and waterfalls solid;
     *   0..1 → a free flowing surface, height = level/8;
     *   -1.0 → air — counts as height 0, so a flowing edge / drop ramps down;
     *   -2.0 → solid — ignored.
     * @param man  the chunk manager
     * @param wx   world x
     * @param y    world y (the face's layer)
     * @param wz   world z
     * @return the classification value described above
     */
    fn cornerSample(self, man : ChunkManager, wx : i32, y : i32, wz : i32) : f64 {
        let id : Block = man.worldGet(ivec3(wx, y, wz));
        if (id == Block::Air) {
            return 0.0 - 1.0;
        }
        if (!isWater(id)) {
            return 0.0 - 2.0;
        }
        if (isSource(id) || isWater(man.worldGet(ivec3(wx, y + 1, wz)))) {
            return 2.0;
        }
        let lvl : i32 = fluidLevel(id);
        return (lvl as f64) / 8.0;
    }

    /**
     * Sloped-surface height at a top corner shared by up to four water columns,
     * Minecraft-style. A source or falling column keeps the corner full (lakes
     * stay flat, waterfalls stay solid). Otherwise it averages the flowing
     * surfaces AND counts adjacent air as 0, so a free water edge — and the lip
     * of a drop — ramps down in a rounded slope instead of a hard step, keeping
     * the surface connected to the fall with no void.
     * @param man  the chunk manager
     * @param cx   corner world x (a block boundary)
     * @param y    world y (the face's layer)
     * @param cz   corner world z (a block boundary)
     * @return the corner height fraction (0..1)
     */
    fn waterCornerY(self, man : ChunkManager, cx : i32, y : i32, cz : i32) : f64 {
        let s0 : f64 = self.cornerSample(man, cx - 1, y, cz - 1);
        let s1 : f64 = self.cornerSample(man, cx, y, cz - 1);
        let s2 : f64 = self.cornerSample(man, cx - 1, y, cz);
        let s3 : f64 = self.cornerSample(man, cx, y, cz);
        if (s0 > 1.5 || s1 > 1.5 || s2 > 1.5 || s3 > 1.5) {
            return 1.0;   // a source / column corner stays full height
        }
        // Air contributes Water::EDGE_HEIGHT (not a hard 0), so a flowing
        // edge keeps a bit of body and only eases down — a gentle lip rather
        // than a steep "skateboard ramp" right at the border.
        let sum : f64 = 0.0;
        let cnt : i32 = 0;
        if (s0 >= 0.0) {
            sum = sum + s0;
            cnt = cnt + 1;
        } else if (s0 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (s1 >= 0.0) {
            sum = sum + s1;
            cnt = cnt + 1;
        } else if (s1 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (s2 >= 0.0) {
            sum = sum + s2;
            cnt = cnt + 1;
        } else if (s2 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (s3 >= 0.0) {
            sum = sum + s3;
            cnt = cnt + 1;
        } else if (s3 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (cnt == 0) {
            return 1.0;
        }
        return sum / (cnt as f64);
    }

    // ── Per-face baked-light reads through the split light seams ──

    /**
     * Where one corner of a face samples the light volumes: its own air cell,
     * and the two in-plane steps to the other three cells meeting there.
     *
     * The corner's cell is the face's probe cell advanced to the far end of the
     * merged run when the corner sits at that end — a greedy quad is up to
     * `MESH_MAX_RUN` cells long, and its far corner has to read the light where
     * it actually is. The tangents are the corner's own ±1 block offsets, taken
     * on the two axes that are not the face normal.
     * @param cell     the face's air probe cell (its origin corner)
     * @param off      the corner's block offset within the face (0 or 1 per axis)
     * @param naxis    the face normal axis (0 = X, 1 = Y, 2 = Z)
     * @param advX     cells to the far end of the run along X (0 if the run is not)
     * @param advZ     cells to the far end of the run along Z (0 if the run is not)
     * @return the corner's probe
     */
    fn cornerProbe(self, cell : IVec3, off : IVec3, naxis : i32, advX : i32, advZ : i32) : CornerProbe {
        let sgx : i32 = off.x * 2 - 1;
        let sgy : i32 = off.y * 2 - 1;
        let sgz : i32 = off.z * 2 - 1;
        let base : IVec3 = ivec3(cell.x + off.x * advX, cell.y, cell.z + off.z * advZ);
        match naxis {
            0 => {
                return CornerProbe { base: base, t1: ivec3(0, sgy, 0), t2: ivec3(0, 0, sgz) };
            }
            1 => {
                return CornerProbe { base: base, t1: ivec3(sgx, 0, 0), t2: ivec3(0, 0, sgz) };
            }
            _ => {
                return CornerProbe { base: base, t1: ivec3(sgx, 0, 0), t2: ivec3(0, sgy, 0) };
            }
        }
    }

    /**
     * The ambient-sky occlusion factor of a corner sample: the baked
     * hemispherical sky access (ray-traced AO) mapped into [`Light::AO_SKY_MIN`, 1], so
     * valleys / recesses / canopy darken the ambient sky light.
     * @param s  the corner's light sample
     * @return the sky-AO factor in [`Light::AO_SKY_MIN`, 1]
     */
    fn skyAOFactor(self, s : CornerSample) : f64 {
        let skyAcc : f64 = (s.sky as f64) * 0.00392157;
        return Light::AO_SKY_MIN + (1.0 - Light::AO_SKY_MIN) * skyAcc;
    }

    /**
     * The one-bounce coloured indirect tint of a corner sample, unpacked to a
     * 0..2 RGB multiplier triple.
     * @param s  the corner's light sample
     * @return the bounce tint as (r, g, b) multipliers
     */
    fn bounceTint(self, s : CornerSample) : Vec3 {
        return vec3(
            (((s.bounce >> 16) & 0xFF) as f64) * 0.0078125,
            (((s.bounce >> 8) & 0xFF) as f64) * 0.0078125,
            ((s.bounce & 0xFF) as f64) * 0.0078125);
    }

    // ── World faces (water surface heights, face baking) ──

    /**
     * Project, cull, shade and rasterize one baked world face into the triangle
     * queue.
     * @param man     chunk manager holding the baked face arrays
     * @param idx     index of the face to draw
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     * @param ox      the slot's world x origin — the faces store chunk-local x
     * @param oz      …and z
     */
    fn renderFace(mut self, man : ChunkManager, idx : i32, cam : Camera, phase : f64,
        ox : i32, oz : i32) : void {
        let x : i32 = ox + (man.faces.fx[idx] as i32);
        let y : i32 = man.faces.fy[idx] as i32;
        let z : i32 = oz + (man.faces.fz[idx] as i32);
        // Unpack the direction and atlas tile from the packed ftile slot.
        let packed : i32 = man.faces.ftile[idx] as i32;
        let dir : FaceDir = faceDirFrom(packed / 256);
        let isWaterFace : bool = (packed % 256) == Tile::WATER;
        // Cells this face spans, from the mesher's greedy merge, stretched along
        // one axis. Which axis needs no table: for every direction the corner's
        // `u` is exactly its offset along a HORIZONTAL axis — X for the top, the
        // bottom and the Z-facing walls, Z for the X-facing ones — so the run
        // multiplies the offset and the `u` together and the two cannot disagree.
        //
        // The extent is wanted whole HERE, for the culling centre and the
        // distance cut, which measure the surface that is actually there; the
        // span loop below is what decides how many quads it is drawn as.
        let run : i32 = man.faces.frun[idx] as i32;
        let runF : f64 = run as f64;
        let runX : f64 = 1.0;
        let runZ : f64 = 1.0;
        if (dir == FaceDir::PosX || dir == FaceDir::NegX) {
            runZ = runF;
        } else {
            runX = runF;
        }
        let nx : f64 = 0.0;
        let ny : f64 = 0.0;
        let nz : f64 = 0.0;
        match dir {
            FaceDir::PosX => {
                nx = 1.0;
            }
            FaceDir::NegX => {
                nx = 0.0 - 1.0;
            }
            FaceDir::Top => {
                ny = 1.0;
            }
            FaceDir::Bottom => {
                ny = 0.0 - 1.0;
            }
            FaceDir::PosZ => {
                nz = 1.0;
            }
            _ => {
                nz = 0.0 - 1.0;
            }
        }

        // The centre of the MERGED quad, so back-face culling and the distance
        // cut both measure the thing that is actually drawn.
        let fcx : f64 = (x as f64) + 0.5 * runX + nx * 0.5;
        let fcy : f64 = (y as f64) + 0.5 + ny * 0.5;
        let fcz : f64 = (z as f64) + 0.5 * runZ + nz * 0.5;
        let vx : f64 = cam.eye.x - fcx;
        let vy : f64 = cam.eye.y - fcy;
        let vz : f64 = cam.eye.z - fcz;
        if (vx * vx + vz * vz > Render::DRAW_DIST * Render::DRAW_DIST) {
            return;
        }
        // Water surfaces AND the top of a partial block (thin snow, a slab) draw
        // double-sided so the surface stays visible from below; every other face
        // back-face culls. Without this the raised partial top back-face culls
        // the instant the eye drops below its plane (y + boxH) and the top
        // "disappears as you descend" — worse the deeper the block (higher plane).
        //
        // The test is in two halves because the exception is the expensive one:
        // knowing whether a block is partial is two walks down into the world,
        // and only a TOP face can be the exception at all. So the ordinary case
        // goes first and the walk is paid by the few faces that reach it, not by
        // every face in the ring.
        let facing : f64 = vx * nx + vy * ny + vz * nz;
        if (!isWaterFace && facing <= 0.0 && ny <= 0.0) {
            return;
        }
        // Partial, floor-resting blocks (thin snow, slabs later) render at their
        // real box height (top + side tops lowered to y + boxH), like a short
        // water surface. blockBoxHeight is the single authority (1.0 = full cube).
        let boxH : f64 = man.blockBoxHeight(ivec3(x, y, z));
        let isPartialFace : bool = boxH < 1.0;
        if (!isWaterFace && facing <= 0.0 && !isPartialFace) {
            return;
        }

        // Flow animation: flowing water scrolls its texture along the flow
        // direction (toward lower level). Still lakes have no gradient, so they
        // don't scroll.
        let flowU : f64 = 0.0;
        let flowV : f64 = 0.0;
        if (isWaterFace) {
            let lpx : i32 = fluidLevel(man.worldGet(ivec3(x + 1, y, z)));
            let lnx : i32 = fluidLevel(man.worldGet(ivec3(x - 1, y, z)));
            let lpz : i32 = fluidLevel(man.worldGet(ivec3(x, y, z + 1)));
            let lnz : i32 = fluidLevel(man.worldGet(ivec3(x, y, z - 1)));
            let tscroll : f64 = phase * Water::FLOW_SPEED;
            flowU = ((lpx - lnx) as f64) * tscroll;
            flowV = ((lpz - lnz) as f64) * tscroll;
        }

        // Face-direction (Lambert) shading + the directional sun shadow, shared
        // by all 4 corners (computed once before the per-corner light below).
        let bright : SurfaceLight = self.day.shade(vec3(nx, ny, nz));
        if (isWaterFace && facing <= 0.0) {
            // underside / far face of water, dimmer on both counts
            bright = SurfaceLight { direct: bright.direct * 0.62, ambient: bright.ambient * 0.62 };
        }
        // Directional sun shadow: if the air cell this face looks into is in the
        // sun's cast shadow, drop toward ambient (keeping Light::SHADOW_KEEP of
        // the direct term). A cell the bake never visits reads as full sun, so
        // caves / roofed faces are untouched without a separate sky-light gate.
        // The shadow-probe cell is just the neighbour in the face-normal
        // direction; dir already carries that, so match on it instead of
        // re-deriving the offset from the float normal three times.
        let sbx : i32 = x;
        let sby : i32 = y;
        let sbz : i32 = z;
        match dir {
            FaceDir::PosX => { sbx = x + 1; }
            FaceDir::NegX => { sbx = x - 1; }
            FaceDir::Top => { sby = y + 1; }
            FaceDir::Bottom => { sby = y - 1; }
            FaceDir::PosZ => { sbz = z + 1; }
            _ => { sbz = z - 1; }
        }
        let shadowCell : IVec3 = ivec3(sbx, sby, sbz);
        // `bright` is now the pure Lambert (sun-direction) term; the cast shadow
        // is applied PER CORNER below (smooth, face-independent), not flattened
        // over the whole face here — that's what removes the block staircase.
        let shade : FaceShade = FaceShade {
            idx: idx,
            tile: packed % 256,
            dir: dir,
            naxis: (dir as i32) / 2,   // normal axis: 0=X, 1=Y, 2=Z
            normal: vec3(nx, ny, nz),
            light: bright,
            boxH: boxH,
            isWater: isWaterFace,
            isPartial: isPartialFace,
            wrap: isWaterFace || run > 1,
            flowU: flowU,
            flowV: flowV,
        };

        // A merged quad carries the cast shadow at its four CORNERS and lets the
        // rasteriser interpolate between them. Over eight cells of flat ground
        // that turns a shadow edge into a ramp as wide as the run, and as the sun
        // creeps the ramp jumps from one run to the next — a shadow that moves in
        // eight-block steps instead of gliding, which is the staircase you see.
        //
        // So the run is cut where the shadow is NOT flat along it, and only
        // there: most of the world is evenly lit or evenly shaded, and those runs
        // still go out whole, which is what the merge was for.
        let step : i32 = self.shadowStep(man, shade, shadowCell, run);
        let start : i32 = 0;
        while (start < run) {
            let len : i32 = step;
            if (start + len > run) {
                len = run - start;
            }
            let advX : i32 = 0;
            let advZ : i32 = 0;
            if (shade.naxis == 0) {
                advZ = start;
            } else {
                advX = start;
            }
            self.emitSpan(man, cam, shade, FaceSpan {
                cell: ivec3(x + advX, y, z + advZ),
                probe: ivec3(shadowCell.x + advX, shadowCell.y, shadowCell.z + advZ),
                run: len,
                uOff: start as f64,
            });
            start = start + len;
        }
    }

    /**
     * How many cells of a merged run one quad may cover before the cast shadow
     * has to be resampled: the whole run where the sun visibility along it is
     * flat, one cell where it is not.
     *
     * Two gates come first because they are nearly free and they take most of
     * the faces with them: a face the sky never reaches has no cast shadow to
     * resolve, and a face turned away from the sun has no direct term at all
     * for a shadow to take away. What is left to walk is the
     * sunward, sky-facing surface — and of that, only the runs a shadow edge
     * actually crosses come back split.
     * @param man   chunk manager holding the baked face arrays
     * @param fs    the face's per-quad constants
     * @param cell  the face's air probe cell (the run's near end)
     * @param run   cells the merged face spans
     * @return the cells one emitted quad may cover
     */
    fn shadowStep(self, man : ChunkManager, fs : FaceShade, cell : IVec3, run : i32) : i32 {
        if (run < 2 || fs.light.direct <= 0.0) {
            return run;
        }
        if ((Mem::byteAt(man.faces.flight, (fs.idx * 4 * 2) as i64) >> 4) == 0) {
            return run;
        }
        let dx : i32 = 1;
        let dz : i32 = 0;
        if (fs.naxis == 0) {
            dx = 0;
            dz = 1;
        }
        let lo : i32 = 255;
        let hi : i32 = 0;
        let i : i32 = 0;
        while (i < run) {
            let v : i32 = man.sunlitGet(ivec3(cell.x + dx * i, cell.y, cell.z + dz * i));
            if (v < lo) {
                lo = v;
            }
            if (v > hi) {
                hi = v;
            }
            i = i + 1;
        }
        if (hi - lo > Light::SHADOW_SPLIT) {
            return 1;
        }
        return run;
    }

    /**
     * Project, light, clip and queue ONE span of a face — the whole merged run
     * when its shadow is flat, a single cell when the run was cut.
     *
     * Everything a span does not change is in `fs`; what it does change is where
     * it starts along the run, how far it reaches, and the texture offset that
     * keeps the tiling continuous across a cut.
     * @param man  chunk manager holding the baked face arrays
     * @param cam  the camera (eye + orientation + projection width)
     * @param fs   the face's per-quad constants
     * @param sp   this span's origin, length and texture offset
     */
    fn emitSpan(mut self, man : ChunkManager, cam : Camera, fs : FaceShade, sp : FaceSpan) : void {
        let x : i32 = sp.cell.x;
        let y : i32 = sp.cell.y;
        let z : i32 = sp.cell.z;
        let nx : f64 = fs.normal.x;
        let ny : f64 = fs.normal.y;
        let nz : f64 = fs.normal.z;
        // Cells the span spans, per axis: the run on the one it runs along, one
        // on the other. As integers, because the corner's world column is one of
        // them and the far end of the run is the other minus one.
        let runXi : i32 = 1;
        let runZi : i32 = 1;
        if (fs.naxis == 0) {
            runZi = sp.run;
        } else {
            runXi = sp.run;
        }
        let runF : f64 = sp.run as f64;

        // Load the 4 corners into camera space + their tile UVs, and bake each
        // corner's light colour (smooth light + AO + per-corner soft shadow) into
        // the car/cag/cab inputs so clipNear interpolates colour like it does UV.
        // A water face's top corners are dropped to a Minecraft-style sloped
        // surface: each corner takes the average height of the water columns
        // meeting at it, so adjacent levels join in a continuous ramp with no
        // vertical "façade" gaps between layers.
        let di : i32 = fs.dir as i32;
        let q : i32 = di * 4;
        let k : i32 = 0;
        while (k < 4) {
            let b : i32 = (di * 4 + k) * 3;
            let oxv : i32 = self.coff[b];
            let oyv : i32 = self.coff[b + 1];
            let ozv : i32 = self.coff[b + 2];
            // The corner's own world column — its block offset stretched along
            // the run. The water height and the eye vector both want the column
            // the corner actually sits over, not the span's origin.
            let cwx : i32 = x + oxv * runXi;
            let cwz : i32 = z + ozv * runZi;
            let cornerY : f64 = (y as f64) + (oyv as f64);
            if (fs.isWater && oyv > 0) {
                cornerY = (y as f64) + self.waterCornerY(man, cwx, y, cwz);
            } else if (fs.isPartial && oyv > 0) {
                cornerY = (y as f64) + fs.boxH;
            }
            self.toCam(cam, vec3(cwx as f64, cornerY, cwz as f64), k);
            Mem::putRealOf(self.ca.u, k, (self.uvu[q + k] as f64) * runF + sp.uOff + fs.flowU);
            Mem::putRealOf(self.ca.v, k, (self.uvv[q + k] as f64) + fs.flowV);
            // Every smooth term is read AT THIS CORNER, through one probe: the
            // corner's own air cell and the two in-plane steps to the other
            // three cells meeting there. On a merged quad that cell is the far
            // end of the run, not the face's origin — a term sampled at the
            // origin would be spread over eight blocks of surface.
            let smp : CornerSample = man.cornerSample(
                self.cornerProbe(sp.probe, ivec3(oxv, oyv, ozv), fs.naxis, runXi - 1, runZi - 1));

            // Everything this corner can see, gathered once and handed to the
            // one model. The renderer's job stops here: it says what is at this
            // corner, `klight::surface` says what colour that is.
            let lo : i64 = ((fs.idx * 4 + k) * 2) as i64;
            let lb0 : i32 = Mem::byteAt(man.faces.flight, lo);
            let lb1 : i32 = Mem::byteAt(man.faces.flight, lo + 1);
            let aok : i32 = (Mem::byteAt(man.faces.fao, fs.idx as i64) >> (2 * k)) & 3;
            let terms : CornerTerms = CornerTerms {
                vis: (smp.sun as f64) * BYTE_TO_UNIT,
                skyLevel: Mem::realOf(self.lcurve, (lb0 >> 4) & 0xF),
                skyAccess: (smp.sky as f64) * BYTE_TO_UNIT,
                ao: 1.0 - Light::AO_STRENGTH * ((3 - aok) as f64) * THIRD,
                block: LinRgb {
                    r: Mem::realOf(self.lcurve, lb0 & 0xF),
                    g: Mem::realOf(self.lcurve, (lb1 >> 4) & 0xF),
                    b: Mem::realOf(self.lcurve, lb1 & 0xF),
                },
                bounce: self.bounceTint(smp),
            };
            let cc : LinRgb = cornerColour(fs.light, terms,
                LinRgb { r: self.day.dirTintR, g: self.day.dirTintG, b: self.day.dirTintB });
            let visK : f64 = terms.vis;
            if (fs.isWater) {
                // View vector from this corner to the eye, for the glint.
                let vx : f64 = cam.eye.x - (cwx as f64);
                let vy : f64 = cam.eye.y - cornerY;
                let vz : f64 = cam.eye.z - (cwz as f64);
                let vl : f64 = (vx * vx + vy * vy + vz * vz).sqrt();
                if (vl < 0.0001) {
                    vl = 0.0001;
                }
                vx = vx / vl;
                vy = vy / vl;
                vz = vz / vl;
                // Sun glint: half-vector specular, cos^32, gated by sun visibility
                // and daylight. A strong warm multiplier that bloom turns to gold.
                let hx : f64 = vx + self.day.sunX;
                let hy : f64 = vy + self.day.sunY;
                let hz : f64 = vz + self.day.sunZ;
                let hl : f64 = (hx * hx + hy * hy + hz * hz).sqrt();
                if (hl < 0.0001) {
                    hl = 0.0001;
                }
                let ndh : f64 = (nx * hx + ny * hy + nz * hz) / hl;
                if (ndh < 0.0) {
                    ndh = 0.0;
                }
                let s2 : f64 = ndh * ndh;
                let s4 : f64 = s2 * s2;
                let s8 : f64 = s4 * s4;
                let s16 : f64 = s8 * s8;
                let spec : f64 = s16 * s16 * visK * self.day.dirStrength * Water::SPEC_STRENGTH;
                // Fresnel: brighter at grazing view angles (sky-reflection sheen).
                let ndv : f64 = nx * vx + ny * vy + nz * vz;
                if (ndv < 0.0) {
                    ndv = 0.0;
                }
                let om : f64 = 1.0 - ndv;
                let om2 : f64 = om * om;
                let fres : f64 = Water::F0 + (1.0 - Water::F0) * om2 * om2 * om;
                let fboost : f64 = 1.0 + fres * Water::FRESNEL_STRENGTH;
                cc.r = cc.r * fboost * (1.0 + spec * 1.10);
                cc.g = cc.g * fboost * (1.0 + spec * 1.00);
                cc.b = cc.b * fboost * (1.0 + spec * 0.72);
            }
            Mem::putRealOf(self.ca.r, k, cc.r);
            Mem::putRealOf(self.ca.g, k, cc.g);
            Mem::putRealOf(self.ca.b, k, cc.b);
            k = k + 1;
        }

        // Clip against the near plane, then project the surviving polygon.
        let n : i32 = self.clipNear(4);
        if (n < 3) {
            return;
        }
        // Mip selection + filtering is now per pixel in the rasteriser
        // (anisotropic), so no per-face mip is computed here.
        // Per-corner light colour was baked into car/cag/cab and carried through
        // clipNear into cbr/cbg/cbb — the rasteriser interpolates it per pixel.
        let v : i32 = 0;
        while (v < n) {
            let sp : Projected = cam.screenOf(vec3(Mem::realOf(self.cb.x, v), Mem::realOf(self.cb.y, v), Mem::realOf(self.cb.z, v)));
            Mem::putRealOf(self.cs.sx, v, sp.sx);
            Mem::putRealOf(self.cs.sy, v, sp.sy);
            Mem::putRealOf(self.cs.iz, v, sp.iz);
            v = v + 1;
        }

        // Fan-triangulate the clipped polygon from vertex 0 and QUEUE each
        // triangle (with its Gouraud per-vertex colours) — the parallel band
        // rasteriser fills them later. The heavy per-face lighting above is thus
        // done once, not once per worker.
        // A merged quad tiles its texture, which is the same wrap the scrolled
        // water surface asks for — and a span cut out of one carries a texture
        // offset, so it wraps for the same reason even when it is one cell wide.
        let wf : i32 = 0;
        if (fs.wrap) {
            wf = 1;
        }
        let o : i32 = self.fanOrigin(n);
        let t : i32 = 1;
        while (t < n - 1) {
            if (self.triN < Render::TRI_QUEUE_CAP) {
                let i1 : i32 = (o + t) % n;
                let i2 : i32 = (o + t + 1) % n;
                // The column span, taken here where the projection just ran,
                // so the fill's band test costs a comparison instead of a
                // whole triangle setup it then throws away.
                let (colLo, colHi) = columnSpan(
                    Mem::realOf(self.cs.sx, o),
                    Mem::realOf(self.cs.sx, i1),
                    Mem::realOf(self.cs.sx, i2)
                );
                self.triBuf[self.triN] = RasterTri {
                    a: self.clippedVert(o),
                    b: self.clippedVert(i1),
                    c: self.clippedVert(i2),
                    tile: fs.tile as i16,
                    wrap: wf as i8,
                    minx: colLo,
                    maxx: colHi
                };
                self.triN = self.triN + 1;
            }
            t = t + 1;
        }
    }

    /**
     * Snapshot the per-frame render context onto this component.
     *
     * Copied onto every worker rather than threaded through each call:
     * the band rasteriser and the projection both read it a hundred
     * thousand times a frame, and it does not change within one.
     * @param atlas   the texture atlas mip chain view
     * @param gam     the colour space the texels are lit in
     * @param fogT    the fog tables (the sky behind each pixel, and its depth curve)
     * @param day     the day/night state (sun / daylight for corner shading)
     * @param lcurve  the brightness-curve lookup
     */
    pub(crate) fn setFrame(mut self, atlas : MipAtlas, gam : Gamma, fogT : FogTable, day : DayState, lcurve : i64) : void {
        self.atlas = atlas;
        self.gam = gam;
        self.fogT = fogT;
        self.day = day;
        self.lcurve = lcurve;
        self.triN = 0;
    }

    /**
     * Project / light / clip the faces of every `stride`-th loaded chunk
     * from `first` into THIS component's triangle queue.
     *
     * The share is taken by striding the slot ring rather than by cutting
     * it into contiguous runs: chunks differ enormously in how many faces
     * they carry — a hillside against open sky — and adjacent slots are
     * the ones most likely to be alike, so contiguous shares are the ones
     * that come out lopsided.
     *
     * Each worker owns its own queue and its own clipping scratch, so
     * nothing here is shared and nothing needs a lock.
     * @param man     chunk manager holding the loaded chunks and baked faces
     * @param p       player providing the eye position (for chunk culling)
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     * @param first   the first slot this worker takes
     * @param stride  how many workers there are
     */
    pub(crate) fn buildSlots(mut self, man : ChunkManager, p : Player, cam : Camera, phase : f64,
        first : i32, stride : i32) : void {
        let slots : i32 = World::SPAN * World::SPAN;
        let cone : ViewCone = viewConeFor(p, cam.lens);
        let slot : i32 = first;
        while (slot < slots) {
            if (man.cols.loaded[slot] == 1 && chunkVisible(cone, man.cols.cxs[slot], man.cols.czs[slot])) {
                let base : i32 = slot * World::MAX_FACES_PER_CHUNK;
                let n : i32 = man.faces.fcount[slot];
                let ox : i32 = man.cols.cxs[slot] * World::CHUNK_SIZE;
                let oz : i32 = man.cols.czs[slot] * World::CHUNK_SIZE;
                let fi : i32 = 0;
                while (fi < n) {
                    self.renderFace(man, base + fi, cam, phase, ox, oz);
                    fi = fi + 1;
                }
            }
            slot = slot + stride;
        }
        self.queuedTris = self.triN;
    }

    /**
     * Rasterise the queued world triangles whose pixels fall in the column band
     * [bx0, bx1). Each band is disjoint, so threads never touch the same z-buffer
     * pixel. Called by the main thread and by `fillBandJob`. Reads this
     * frame's atlas + fog off the component (set in drawWorld).
     * @param fb   the render target (framebuffer + z-buffer + size)
     * @param bx0  inclusive left screen column of this band
     * @param bx1  exclusive right screen column of this band
     */
    pub(crate) fn rasterizeBand(self, fb : FrameBuf, bx0 : i32, bx1 : i32) : void {
        let i : i32 = 0;
        let band : Band = Band { x0: bx0, x1: bx1 };
        while (i < self.triN) {
            let tri : RasterTri = self.triBuf[i];
            // The band owns columns [bx0, bx1); a triangle that touches none
            // of them is done with here, before the setup it would not use.
            if ((tri.maxx as i32) >= bx0 && (tri.minx as i32) < bx1) {
                rasterTriTex(fb, tri, self.atlas, self.gam, self.fogT, band);
            }
            i = i + 1;
        }
    }
}

/** Worker job: project / clip / light one worker's share of the chunks. */
fn buildSlotsJob(r : ChunkRenderer, man : ChunkManager, p : Player, cam : Camera, phase : f64,
    first : i32, stride : i32) : i32 {
    r.buildSlots(man, p, cam, phase, first, stride);
    return 0;
}
