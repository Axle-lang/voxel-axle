// render — the frame conductor.
//
// One class, and what it does is decide the ORDER of a frame: clear, sky
// gradient and celestial bodies, the world faces, the mobs, the selection
// wireframe, then the post chain (god-rays, bloom, the underwater overlay).
// Every heavy job lives in a component it composes and none of them knows
// about the others:
//
//   `SkyEngine`    (ksky::skyengine)     owns everything above the ground
//   `TextureAtlas` (krender::atlas)      owns the mip chain
//   `GammaTables`  (klight::gamma)       owns the sRGB <-> linear tables
//   `DayLighting`  (klight::daymodel)    owns the sun / sky / brightness cache
//   `ChunkRenderer`(krender::chunkview)  the world-face raster crew
//   `MobView`      (krender::mobview)    the mob box models
//   `Selection`    (krender::selection)  the targeted-block wireframe
//   `Bloom`        (krender::bloom)      the soft glow
//   `GodRayFX` / `UnderwaterFX` (krender::postfx)  the other two post passes
//
// The two worker counts live here, next to the `Task` arrays that mirror
// them: a fixed-array size must be an integer literal, so the pair is kept in
// step by hand and cannot be a config field.

use smalt::Mem;
use smalt::{ Job, WorkerPool };
use std::time::monotonicNanos;
use smalt::Color;
use crate::kernel::krender::bloom::Bloom;
use crate::kernel::ksky::viewray::{ ViewRay };
use crate::kernel::ksky::clouddome::{ CloudSample };
use crate::kernel::ksky::skyengine::{ SkyEngine };
use crate::kernel::krender::postfx::{ GodRayFX, UnderwaterFX, SunScreen };
use crate::kernel::krender::atlas::{ TextureAtlas };
use crate::kernel::klight::daymodel::{ DayLighting };
use crate::kernel::krender::chunkview::{ ChunkRenderer, buildSlotsJob, chunkVisible, viewConeFor, ViewCone };
use crate::kernel::klight::daymodel::{ DayState };
use crate::kernel::krender::mobview::{ MobView, MobScene, Material };
use crate::kernel::krender::selection::Selection;
use crate::kernel::krender::raster::{ clearFrame, clearDepth, lensFor, FrameBuf, MipAtlas, Camera, Lens, Projected };
use crate::kernel::klight::gamma::{ Gamma, GammaTables, LinRgb };
use crate::kernel::kmath::vec3::{ vec3 };
use crate::kernel::kentity::player::Player;
use crate::kernel::kworld::manager::ChunkManager;
use crate::kernel::kentity::mobs::MobManager;
use crate::configs::atlas::{ Tile };
use crate::configs::light::{ Light };
use crate::configs::render::{ Render };
use crate::configs::screen::{ Screen };
use crate::configs::water::{ Water };
use crate::configs::world::{ World };

/**
 * Independent world-raster workers, each with its own triangle queue and
 * clipping scratch.
 *
 * A literal, and mirrored by the `Task` array in `drawWorld`, because a
 * fixed-array size must be an integer literal — not a `const`, and not a
 * `static` field, so the two are kept in step by hand.
 */
const BUILD_WORKERS : i32 = 6;

/** Screen column bands the fill splits into. */
const RASTER_BANDS : i32 = 12;

/**
 * The banded fill, as a pass the worker pool can run.
 *
 * It reaches its two inputs through ARRAYS, and that is the whole reason it can
 * exist: a pass is attached to the pool once and run every frame after, but
 * Axle will not let a long-lived object remember a borrowed reference, so a
 * per-frame input cannot simply be handed to it. A one-slot array can be held
 * by both the Renderer and the pass, and what the Renderer writes into it
 * before a pass the pass reads during one.
 */
class BandFill : Job {
    crew : ChunkRenderer[],  // the queues to fill from, aliased from the Renderer
    frame : FrameBuf[],      // one slot: the target this frame, written before the pass

    /**
     * @param crew   the raster crew, aliased
     * @param frame  the one-slot render target the Renderer publishes into
     */
    constructor(crew : ChunkRenderer[], frame : FrameBuf[]) {
        self.crew = crew;
        self.frame = frame;
    }

    /**
     * Fill this share's column band from every worker's queue.
     *
     * The bands are disjoint columns, so no two shares touch the same z-buffer
     * word and none of them needs a lock.
     * @param share   which band
     * @param shares  how many bands the frame was cut into
     */
    fn run(mut self, share : i32, shares : i32) : void {
        let fb : FrameBuf = self.frame[0];
        let bw : i32 = (fb.w + shares - 1) / shares;
        let x0 : i32 = (bw * share).min(fb.w);
        let x1 : i32 = (bw * (share + 1)).min(fb.w);
        for (i of 0..BUILD_WORKERS) {
            self.crew[i as i64].rasterizeBand(fb, x0, x1);
        }
    }
}

/**
 * The frame conductor: composes the focused render components (texture atlas,
 * day/night lighting, world-face raster, bloom, mob box models, selection
 * wireframe) and drives one frame's passes. It holds no raster / lighting state
 * of its own beyond the projection half-width — every heavy job lives in a
 * component it delegates to.
 */
class Renderer {
    lens : Lens,          // projection centre + focal length; rebuilt on resize so
                          // the world keeps its scale and the FOV tracks the window
    atlas : TextureAtlas, // owns the atlas mip chain (setAtlas / atlasBase)
    gamma : GammaTables,  // owns the sRGB ↔ linear tables every pass lights through
    day : DayLighting,    // owns the day/night colour + brightness cache
    /**
     * The world-face raster crew: `BUILD_WORKERS` independent components,
     * each with its own triangle queue and clipping scratch.
     *
     * One was not enough for the reason the frame timings gave: the
     * projection / clip / light pass over eighty-eight thousand faces ran
     * on ONE thread and was two thirds of the world pass, while the fill
     * it feeds already spread over twelve. Crew member 0 is the primary —
     * the main thread's share — and is where the frame counters live.
     */
    crew : ChunkRenderer[],
    sky : SkyEngine,  // everything above the ground: the atmosphere, the cloud
                      // deck, the fog those two agree on, and the backdrop
    bloom : Bloom,   // soft-glow post-process (owns its half-res buffers + jobs)
    mobs : MobView,  // mob box-model renderer (owns its own projection scratch)
    sel : Selection, // targeted-block selection wireframe (owns its own scratch)
    /**
     * The crew the parallel passes run on, started once instead of once a
     * frame. A fan-out of twelve costs ten microseconds here against four
     * hundred and ninety for twelve fresh threads, and the difference is paid
     * by THIS thread, in the middle of the frame.
     */
    pool : WorkerPool[],
    fillPass : i32,     // the banded fill's handle into the pool
    frame : FrameBuf[], // one slot: this frame's target, published to the passes

    /**
     * Build a Renderer: set the projection width from config and construct the
     * render components (each owns its own scratch / buffers).
     */
    constructor() {
        self.lens = lensFor(Screen::RENDER_W, Screen::RENDER_H);
        self.atlas = new TextureAtlas();
        self.gamma = new GammaTables();
        self.day = new DayLighting();
        self.crew = malloc<ChunkRenderer>(BUILD_WORKERS as i64);
        for (i of 0..BUILD_WORKERS) {
            self.crew[i as i64] = new ChunkRenderer();
        }
        self.bloom = new Bloom();
        self.mobs = new MobView();
        self.sel = new Selection();
        // One fewer than the widest fan-out: the calling thread takes share 0.
        self.pool = malloc<WorkerPool>(1);
        self.pool[0] = new WorkerPool(RASTER_BANDS - 1);
        self.frame = malloc<FrameBuf>(1);
        self.frame[0] = FrameBuf { pixels: 0, zbuf: 0, w: 0, h: 0 };
        self.fillPass = self.pool[0].attach(new BandFill(self.crew, self.frame));
        // Built last: it attaches its own pass to the pool above.
        self.sky = new SkyEngine(self.pool);
    }

    /**
     * Stop the render crew and wait for it.
     *
     * Called before the framebuffer it fills is released, for the reason every
     * join in this program exists: a worker still writing into memory that has
     * been given back is the one bug none of the checks can catch.
     */
    pub(crate) fn close(mut self) : void {
        self.pool[0].close();
    }

    /**
     * Set the atlas base pointer and (re)build its mip chain (delegated to the
     * texture atlas).
     * @param base  base address of the loaded atlas texels
     */
    pub(crate) fn setAtlas(mut self, base : i64) : void {
        self.atlas.setBase(base, self.gamma.view());
    }

    /**
     * Base pointer to the full-resolution atlas texels (mip level 0), for callers
     * that need raw tile texels (e.g. the HUD hotbar icons).
     * @return base address of the level-0 atlas texels
     */
    pub(crate) fn atlasBase(self) : i64 {
        return self.atlas.base();
    }

    /**
     * Match the projection to a framebuffer of this size.
     *
     * Both axes, because both move: the framebuffer follows the window's shape
     * now, not just its ratio. The vertical field of view is what stays fixed
     * (`Screen::FOV_V_DEG`), so more pixels mean a sharper image of the same
     * world rather than a bigger one, and a wider window widens the horizontal
     * angle instead of magnifying what was already there.
     * @param renderW  framebuffer width in pixels
     * @param renderH  framebuffer height in pixels
     */
    pub(crate) fn setViewport(mut self, renderW : i32, renderH : i32) : void {
        self.lens = lensFor(renderW, renderH);
    }

    // ── World pass (clear → sky → world raster) ──

    /**
     * One frame's opaque terrain: build the triangle queues in parallel,
     * then fill them in disjoint parallel column bands.
     *
     * Two different parallel shapes, because the two halves are different
     * problems. The BUILD splits by chunk — every worker owns its queue,
     * so nothing is shared. The FILL splits by screen column — every band
     * owns its pixels, so no two threads touch the same z-buffer word,
     * and each band walks every worker's queue.
     * @param man     chunk manager holding the loaded chunks and baked faces
     * @param p       player providing the eye position and orientation
     * @param fb      the render target (framebuffer + z-buffer + size)
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     * @param atlas   the texture atlas mip chain view
     * @param gam     the colour space the texels are lit in
     * @param fogT    the fog: the sky's colour behind each pixel, and its depth curve
     * @param day     the day/night state
     * @param lcurve  the brightness-curve lookup
     */
    pub(file) fn drawWorld(mut self, man : ChunkManager, p : Player, fb : FrameBuf, cam : Camera,
        phase : f64, atlas : MipAtlas, gam : Gamma, fogT : FogTable, day : DayState, lcurve : i64) : void {
        for (i of 0..BUILD_WORKERS) {
            self.crew[i as i64].setFrame(atlas, gam, fogT, day, lcurve);
        }
        let builders : Task<i32>[5];
        for (i of 0..5) {
            builders[i] = spawn buildSlotsJob(self.crew[(i + 1) as i64], man, p, cam, phase,
                i + 1, BUILD_WORKERS);
        }
        self.crew[0].buildSlots(man, p, cam, phase, 0, BUILD_WORKERS);
        for (i of 0..5) {
            let d : i32 = builders[i].join();
        }

        let tFill : i64 = monotonicNanos();
        self.frame[0] = fb;
        self.pool[0].run(self.fillPass, RASTER_BANDS);
        self.crew[0].fillUs = self.crew[0].fillUs + (monotonicNanos() - tFill) / 1000;
    }

    /** Triangles the world pass queued in the last frame. */
    pub(crate) fn triCount(self) : i32 {
        let n : i32 = 0;
        for (i of 0..BUILD_WORKERS) {
            n = n + self.crew[i as i64].queuedTris;
        }
        return n;
    }

    /** Microseconds the banded fill has taken, accumulated over the run. */
    pub(crate) fn fillMicros(self) : i64 {
        return self.crew[0].fillUs;
    }

    /**
     * Draw one full world frame: refresh the day/night state, clear to the
     * sky/fog (or deep water when submerged), move the sky on a frame, then hand
     * the world-face raster the visible chunks to project + light + clip + fill.
     * Mobs, torches, the sky paint and post-fx are layered on by the caller
     * after this returns.
     * @param man        chunk manager holding the loaded chunks and baked faces
     * @param p          player providing the eye position and orientation
     * @param fb         the render target (framebuffer + z-buffer + size)
     * @param underwater true when the eye is submerged (clears to deep water,
     *                   skips the sky/celestial pass)
     * @param phase      animation time phase (scrolls flowing-water textures)
     * @param dayTime    time of day in [0, 1) driving sun angle and sky colour
     */
    pub(crate) fn render(mut self, man : ChunkManager, p : Player, fb : FrameBuf, underwater : bool, phase : f64, dayTime : f64, worldTime : f64) : void {
        // Refresh the sun direction, daylight factor and sky/fog colour, and keep
        // the value snapshot to hand to the sky draws (and the gradient thread).
        let ds : DayState = self.day.update(dayTime);
        // Under water the cleared "void" is deep water, and nothing paints over
        // it — `drawSky` returns early down there, so the colour has to be laid
        // down here. Above water it must not be: the sky paint covers every
        // pixel the world left empty, so a colour clear is a whole frame
        // written and then thrown away.
        if (underwater) {
            clearFrame(fb, Color::packBytes(Water::DEEP_R, Water::DEEP_G, Water::DEEP_B));
        } else {
            clearDepth(fb);
        }
        // The sky moves on by a frame whether or not it is drawn: the fog reads
        // its colour field, and the world is fogged even from under water. It
        // is PAINTED later, by `drawSky`, into whatever the world leaves empty.
        self.sky.update(ds, p, self.lens, worldTime, fb);
        // One Camera carries the eye + look trig + projection width for every
        // face this frame; the world raster owns the rest of the pass.
        let cam : Camera = Camera { eye: p.eye, cosy: p.cosy, siny: p.siny, cosp: p.cosp, sinp: p.sinp, lens: self.lens };
        self.drawWorld(man, p, fb, cam, phase, self.atlas.mip(), self.gamma.view(),
            self.sky.fog(), ds, self.day.curve());
    }

    /**
     * Paint the sky into every pixel the opaque passes left empty. Call after
     * the world, mobs and torches: it reads the z-buffer they wrote, and only
     * computes the pixels that are actually sky.
     * @param p           player (camera orientation)
     * @param fb          the render target (framebuffer + z-buffer + size)
     * @param underwater  true when the eye is submerged — no sky is visible
     */
    pub(crate) fn drawSky(mut self, p : Player, fb : FrameBuf, underwater : bool) : void {
        if (underwater) {
            return;
        }
        self.sky.draw(self.day.state(), p, fb, self.lens);
    }

    /** Microseconds the cloud march and fog build have taken, accumulated over the run. */
    pub(crate) fn skyMarchMicros(self) : i64 {
        return self.sky.marchMicros();
    }

    /** Microseconds the sky paint has taken, accumulated over the run. */
    pub(crate) fn skyDrawMicros(self) : i64 {
        return self.sky.drawMicros();
    }

    // ── Post-processing (god-rays, bloom, underwater) ──

    /**
     * Volumetric god-rays (crepuscular shafts): a screen-space radial scatter
     * from the sun's projected position. Each pixel marches toward the sun and
     * sums the visible-sky mask (z-buffer cleared = sky) with per-step decay, so
     * terrain silhouettes carve warm bright shafts out of the sky glow. Additive,
     * warm-tinted, scaled by daylight. Skipped with the sun below the horizon or
     * behind the camera. Call after the opaque world + mobs + torches are drawn.
     * @param p   player (camera orientation)
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn godRays(self, p : Player, fb : FrameBuf) : void {
        let ds : DayState = self.day.state();
        if (!Render::GOD_RAYS_ON || ds.sunY < 0.02) {
            return;
        }
        // Project the sun direction to screen through the shared camera.
        let cam : Camera = Camera { eye: p.eye, cosy: p.cosy, siny: p.siny, cosp: p.cosp, sinp: p.sinp, lens: self.lens };
        let pr : Projected = cam.projectDir(vec3(ds.sunX, ds.sunY, ds.sunZ));
        if (pr.cz < 0.05) {
            return;   // sun behind the camera
        }
        // Overall exposure: fade in as the sun climbs, scale by daylight.
        let climb : f64 = ds.sunY * 4.0;
        if (climb > 1.0) {
            climb = 1.0;
        }
        // Shafts are made of the light that got past the deck, so a sun behind a
        // cloud casts none. Sampled once, at the sun — not per march step per
        // pixel, which is twenty-four cloud reads a pixel and was, measured, the
        // single most expensive thing in a sunset frame.
        let sunCloud : CloudSample = self.sky.clouds().sample(ViewRay { dx: ds.sunX, dy: ds.sunY, dz: ds.sunZ, inv: 1.0 });
        let expo : f64 = Render::GOD_RAY_WEIGHT * ds.dirStrength * climb * (1.0 - sunCloud.a);
        if (expo < 0.002) {
            return;
        }
        if (expo <= 0.0) {
            return;
        }
        // The scatter is a PostEffect over the finished frame.
        let fx : GodRayFX = new GodRayFX(SunScreen { sunSx: pr.sx, sunSy: pr.sy, expo: expo });
        fx.apply(fb);
    }

    /**
     * Bloom: bright pixels (luminance above `Render::BLOOM_THRESHOLD`) bleed a soft glow.
     * Extracted and averaged into a half-resolution buffer, blurred separably a
     * few times, then added back over the full frame — so the sun, halo,
     * god-rays, water glints and snow get a warm honeyed glow. Midtones below the
     * threshold are untouched. Call after the sky/world/god-rays, before the HUD.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn bloomPass(self, fb : FrameBuf) : void {
        self.bloom.apply(fb);
    }

    /**
     * Procedural underwater post-pass: fog every pixel toward the water colour
     * by its real depth (read from the z-buffer) and add a moving caustic light
     * pattern, so being submerged feels like a living volume rather than a flat
     * tint. Call after the world + mobs are drawn, while the eye is underwater.
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param phase  time phase that animates the caustics
     */
    pub(crate) fn underwaterOverlay(self, fb : FrameBuf, phase : f64) : void {
        let fx : UnderwaterFX = new UnderwaterFX(phase);
        fx.apply(fb);
    }

    // ── Torches (thin upright posts, drawn via the mob quad path) ──

    /**
     * Draw every loaded/visible chunk's torches as thin upright posts (4 side
     * quads + a top), reusing the oriented-quad path. Torch voxels emit no cube
     * faces in the mesh; they are collected per slot and drawn here.
     * @param man  chunk manager holding the per-slot torch lists
     * @param p    player providing the eye position and orientation
     * @param fb   the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn renderTorches(self, man : ChunkManager, p : Player, fb : FrameBuf) : void {
        let hw : f64 = 0.09;
        let ht : f64 = 0.55;
        let mat : Material = Material { color: Color::packBytes(240, 180, 70), tile: Tile::TORCH, hurt: false };
        let scene : MobScene = self.mobScene();
        // A torch is drawn in its own light, above white, so it reads as the
        // source of the pool around it and the bloom catches the flame.
        self.mobs.setLight(LinRgb { r: Light::TORCH_GLOW, g: Light::TORCH_GLOW * 0.86, b: Light::TORCH_GLOW * 0.62 });
        let slots : i32 = World::SPAN * World::SPAN;
        let cone : ViewCone = viewConeFor(p, self.lens);
        let slot : i32 = 0;
        while (slot < slots) {
            if (man.cols.loaded[slot] == 1 && chunkVisible(cone, man.cols.cxs[slot], man.cols.czs[slot])) {
                let base : i32 = slot * World::MAX_TORCHES_PER_CHUNK;
                let n : i32 = man.torches.tcount[slot];
                let ox : i32 = man.cols.cxs[slot] * World::CHUNK_SIZE;
                let oz : i32 = man.cols.czs[slot] * World::CHUNK_SIZE;
                let ti : i32 = 0;
                while (ti < n) {
                    let cx : f64 = ((ox + (man.torches.tx[base + ti] as i32)) as f64) + 0.5;
                    let cz : f64 = ((oz + (man.torches.tz[base + ti] as i32)) as f64) + 0.5;
                    let x0 : f64 = cx - hw;
                    let x1 : f64 = cx + hw;
                    let z0 : f64 = cz - hw;
                    let z1 : f64 = cz + hw;
                    let y0 : f64 = man.torches.ty[base + ti] as f64;
                    let y1 : f64 = y0 + ht;
                    self.mobs.drawQuad(p, fb, vec3(x1, y0, z1), vec3(x1, y0, z0), vec3(x1, y1, z0), vec3(x1, y1, z1), vec3(1.0, 0.0, 0.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x0, y0, z0), vec3(x0, y0, z1), vec3(x0, y1, z1), vec3(x0, y1, z0), vec3(0.0 - 1.0, 0.0, 0.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x0, y0, z1), vec3(x1, y0, z1), vec3(x1, y1, z1), vec3(x0, y1, z1), vec3(0.0, 0.0, 1.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x1, y0, z0), vec3(x0, y0, z0), vec3(x0, y1, z0), vec3(x1, y1, z0), vec3(0.0, 0.0, 0.0 - 1.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x0, y1, z0), vec3(x1, y1, z0), vec3(x1, y1, z1), vec3(x0, y1, z1), vec3(0.0, 1.0, 0.0), mat, scene);
                    ti = ti + 1;
                }
            }
            slot = slot + 1;
        }
    }

    /**
     * Build this frame's mob/torch scene: the atlas mip chain, the colour space,
     * the distance-fog colour and the day/night state (from the render
     * components) plus the projection half-width. Handed to the MobView draws
     * each frame.
     * @return the per-frame mob scene context
     */
    fn mobScene(mut self) : MobScene {
        let ds : DayState = self.day.state();
        return MobScene {
            atlas: self.atlas.mip(),
            gam: self.gamma.view(),
            fogT: self.sky.fog(),
            ds: ds,
            lens: self.lens,
        };
    }

    // ── Mobs (oriented-box models, drawn by gfx/mobview.axle) ──

    /**
     * Draw every mob of every species through the MobView, sharing the world's
     * z-buffer (so terrain correctly occludes animals behind it).
     * @param man  chunk manager (light maps, for per-mob ambient light)
     * @param mm   mob manager holding the per-species arrays
     * @param p    player providing the eye position and orientation
     * @param fb   the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn renderMobs(self, man : ChunkManager, mm : MobManager, p : Player, fb : FrameBuf) : void {
        self.mobs.drawAll(man, mm, p, fb, self.mobScene(), self.day.curve());
    }

    /**
     * Draw the centre-screen crosshair.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn crosshair(self, fb : FrameBuf) : void {
        let pixels : i64 = fb.pixels;
        let w : i32 = fb.w;
        let h : i32 = fb.h;
        let cx : i32 = w / 2;
        let cy : i32 = h / 2;
        let white : i32 = Color::packBytes(255, 255, 255);
        let i : i32 = 0 - 6;
        while (i <= 6) {
            Mem::putWordOf(pixels, cy * w + cx + i, white);
            Mem::putWordOf(pixels, (cy + i) * w + cx, white);
            i = i + 1;
        }
    }

    // ── Selection wireframe (drawn by gfx/selection.axle) ──

    /**
     * Draw the soft, depth-tested selection outline on the targeted block via
     * the owned Selection helper.
     * @param p     player providing the eye position and orientation
     * @param fb    the render target (framebuffer + z-buffer + size)
     * @param bx    targeted block x
     * @param by    targeted block y
     * @param bz    targeted block z
     * @param topH  the block's real box height (1.0 full, snowDepth for a thin
     *              snow layer) so the outline hugs the true box, not a cube
     */
    pub(crate) fn drawSelection(self, p : Player, fb : FrameBuf, bx : i32, by : i32, bz : i32, topH : f64) : void {
        self.sel.draw(p, fb, self.lens, bx, by, bz, topH);
    }
}

