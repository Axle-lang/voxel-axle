// render — draw the streamed chunk world and its mobs from the player's
// eye, textured and shaded.
//
// World faces: each loaded slot's baked faces are projected, backface /
// distance-culled, and filled with their atlas tile (perspective-correct
// UV), shaded by `normal · light`. Mobs: each animal is drawn as a small
// stack of shaded cuboids (flat-coloured by default, atlas-textured when
// `Atlas::USE_MOB_TEXTURES` is on). The mob pass shares the world's z-buffer, so
// terrain correctly occludes animals behind it.
//
// The heavy lifting is split into focused components the Renderer composes:
// a `TextureAtlas` (owns the mip chain), a `DayLighting` (owns the day/night
// colour + brightness cache), and a `ChunkRenderer` (the world-face raster:
// project / light / clip into the triangle queue, then tiled parallel fill).
// The Renderer keeps only the frame orchestration + the post-fx entry points.

use smalt::Mem;
use smalt::Color;
use crate::kernel::krender::bloom::Bloom;
use crate::kernel::krender::sky::{ DayState, computeDayState, drawSkyGradient, drawCelestial };
use crate::kernel::krender::mobview::{ MobView, MobScene, Material };
use crate::kernel::krender::selection::Selection;
use crate::kernel::krender::raster::{
    rasterTriTex, clearFrame, buildMipChain, mipChainTexels, mipLevelOffset, mipLevelSize,
    RasterVert, RasterTri, FrameBuf, MipAtlas, MipSource, Rgb, Band, Camera, Projected,
    PostEffect, VertAttribs, ScreenScratch,
};
use crate::kernel::seams::{ SkyLightField, SunLightField, BounceLightField };
use crate::kernel::kmath::vec3::{ Vec3, IVec3, vec3, ivec3 };
use crate::kernel::kentity::player::Player;
use crate::kernel::kworld::manager::ChunkManager;
use crate::kernel::kworld::meshbuf::{ FaceMesh, TorchField, ColumnRing };
use crate::kernel::kentity::mobs::MobManager;
use crate::kernel::kblock::blocks::{ fluidLevel, isWater, isSource };
use crate::kernel::kmath::mathx::{ clampI32 };
use crate::configs::atlas::{ Atlas, Tile };
use crate::configs::blocks::{ Block };
use crate::configs::face::{ FaceDir };
use crate::configs::light::{ Light };
use crate::configs::render::{ Render };
use crate::configs::screen::{ Screen };
use crate::configs::time::{ Daylight };
use crate::configs::water::{ Water };
use crate::configs::world::{ World };

/**
 * Reconstruct a FaceDir from its packed discriminant (0..5). The mesher packs
 * the direction into each face's `ftile` slot (see ChunkManager.addFace) to
 * avoid a parallel direction array; this turns it back into the enum so the
 * renderer matches on it by name.
 * @param d  the direction discriminant, 0..5
 * @return the matching FaceDir
 */
fn faceDirFrom(d : i32) : FaceDir {
    return match d {
        0 => FaceDir::PosX,
        1 => FaceDir::NegX,
        2 => FaceDir::Top,
        3 => FaceDir::Bottom,
        4 => FaceDir::PosZ,
        _ => FaceDir::NegZ,
    };
}

/**
 * A chunk is worth drawing only if any part of it is in front of the camera and
 * within render distance. We test the chunk centre against the view forward with
 * a margin of the chunk's half-diagonal, so a whole chunk behind the player is
 * skipped without touching its thousands of faces — the biggest per-frame win.
 * A free function so both the world-face pass (ChunkRenderer) and the torch pass
 * (Renderer) share the one visibility rule.
 * @param p   player providing the eye position and orientation
 * @param cx  chunk x index
 * @param cz  chunk z index
 * @return true if the chunk should be drawn
 */
fn chunkVisible(p : Player, cx : i32, cz : i32) : bool {
    let s : f64 = World::CHUNK_SIZE as f64;
    let wx : f64 = (cx as f64) * s + s * 0.5;
    let wz : f64 = (cz as f64) * s + s * 0.5;
    let dx : f64 = wx - p.eye.x;
    let dz : f64 = wz - p.eye.z;
    let dist2 : f64 = dx * dx + dz * dz;
    let far : f64 = Render::DRAW_DIST + s;
    if (dist2 > far * far) {
        return false;
    }
    // forward = (-siny, cosy); keep chunks whose centre is ahead or within a
    // half-diagonal (~0.71·chunk) behind the eye.
    let ahead : f64 = dx * (0.0 - p.siny) + dz * p.cosy;
    return ahead > 0.0 - s;
}

/**
 * The sun projected to screen space plus the god-ray exposure: bundles the
 * three loose `sunSx, sunSy, expo` scalars that the god-ray driver, its row
 * band and its worker job all passed around together.
 */
struct SunScreen {
    sunSx : f64,
    sunSy : f64,
    expo : f64,
}

/**
 * The volumetric god-ray scatter as a PostEffect: a screen-space radial march
 * from the sun's projected position, summing the visible-sky mask (z-buffer
 * cleared → sky) with per-step decay so terrain silhouettes carve warm shafts.
 * Built each frame by Renderer.godRays (which does the sun projection + exposure
 * gate), then applied over the finished frame. Splits the rows across two threads
 * (disjoint output rows → race-free).
 */
class GodRayFX : PostEffect {
    sun : SunScreen,

    /**
     * Build the effect around the sun's screen projection + exposure.
     * @param sun  the projected sun position and god-ray exposure
     */
    constructor(own sun : SunScreen) {
        self.sun = sun;
    }

    /**
     * Apply the scatter over the frame: a worker does the top half while the
     * main thread does the bottom half.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    fn apply(mut self, fb : FrameBuf) : void {
        // Eight row bands, not two. The rows are disjoint outputs, so unlike
        // the world raster — where every band re-walks the whole triangle
        // queue — this splits with no redundant work at all and scales with
        // the cores it is given. It was costing a fifth of the frame on two
        // of them.
        // Eight, as a literal: a fixed-array size must be one — not a
        // `const` and not a `static` field — so the count and the `Task`
        // array below are kept in step by hand.
        let bh : i32 = (fb.h + 7) / 8;
        let jobs : Task<i32>[7];
        for (i of 0..7) {
            let y0 : i32 = bh * (i + 1);
            let y1 : i32 = bh * (i + 2);
            if (y1 > fb.h) {
                y1 = fb.h;
            }
            if (y0 > fb.h) {
                y0 = fb.h;
            }
            jobs[i] = spawn godRaysJob(self, fb, y0, y1);
        }
        let firstEnd : i32 = bh;
        if (firstEnd > fb.h) {
            firstEnd = fb.h;
        }
        self.rows(fb, 0, firstEnd);
        for (i of 0..7) {
            let d : i32 = jobs[i].join();
        }
    }

    /**
     * God-rays for the screen rows [y0, y1) — the parallel work unit.
     * @param fb  the render target (framebuffer + z-buffer + size)
     * @param y0  first screen row (inclusive)
     * @param y1  last screen row (exclusive)
     */
    pub(file) fn rows(self, fb : FrameBuf, y0 : i32, y1 : i32) : void {
        let pixels : i64 = fb.pixels;
        let zbuf : i64 = fb.zbuf;
        let w : i32 = fb.w;
        let h : i32 = fb.h;
        let invN : f64 = 1.0 / (Render::GOD_RAY_SAMPLES as f64);
        let cr : f64 = Render::SKY_HALO_R as f64;
        let cg : f64 = Render::SKY_HALO_G as f64;
        let cb : f64 = Render::SKY_HALO_B as f64;
        let y : i32 = y0;
        while (y < y1) {
            let row : i32 = y * w;
            let x : i32 = 0;
            while (x < w) {
                let illum : f64 = godRayIllum(zbuf, w, h, x, y, self.sun);
                if (illum > 0.0) {
                    let f : f64 = illum * invN * self.sun.expo;
                    let c : i32 = Mem::dwordAt(pixels, (row + x) as i64 * 4);
                    let r : i32 = clampI32(((c >> 16) & 0xFF) + ((cr * f).floorToInt() as i32), 0, 255);
                    let g : i32 = clampI32(((c >> 8) & 0xFF) + ((cg * f).floorToInt() as i32), 0, 255);
                    let b : i32 = clampI32((c & 0xFF) + ((cb * f).floorToInt() as i32), 0, 255);
                    Mem::putWordOf(pixels, row + x, r * 65536 + g * 256 + b);
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }
}

/**
 * The living-water post-pass as a PostEffect: fog every pixel toward the water
 * colour by its real z-buffer depth, add a moving caustic light pattern, and
 * drift rising bubbles up the frame, so being submerged feels like a living
 * volume. Built each frame by Renderer.underwaterOverlay with the animation
 * phase; single-threaded (it reads and writes overlapping rows).
 */
class UnderwaterFX : PostEffect {
    phase : f64,

    /**
     * Build the effect around the animation phase.
     * @param phase  time phase that animates the caustics + bubbles
     */
    constructor(phase : f64) {
        self.phase = phase;
    }

    /**
     * Fog + caustics + bubbles over the finished frame.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    fn apply(mut self, fb : FrameBuf) : void {
        let phase : f64 = self.phase;
        let pixels : i64 = fb.pixels;
        let zbuf : i64 = fb.zbuf;
        let w : i32 = fb.w;
        let h : i32 = fb.h;
        let fogR : f64 = Water::FOG_R as f64;
        let fogG : f64 = Water::FOG_G as f64;
        let fogB : f64 = Water::FOG_B as f64;
        let y : i32 = 0;
        while (y < h) {
            let row : i32 = y * w;
            // Vertical half of the caustic pattern — constant across the row.
            let cy : f64 = ((y as f64) * Water::CAUSTIC_FREQ - phase * 1.3).sin();
            let x : i32 = 0;
            while (x < w) {
                let idx : i32 = row + x;
                // Depth fog from the z-buffer: izp = 1/depth (0 = cleared bg).
                let izp : f64 = Mem::realOf(zbuf, idx);
                let depth : f64 = Water::FOG_FAR;
                if (izp > 0.0) {
                    depth = 1.0 / izp;
                }
                let fog : f64 = depth / Water::FOG_FAR;
                if (fog > 1.0) {
                    fog = 1.0;
                }
                fog = fog * Water::FOG_MAX;
                let caustic : f64 = (((x as f64) * Water::CAUSTIC_FREQ + phase).sin() + cy) * Water::CAUSTIC_AMP;
                let keep : f64 = 1.0 - fog;
                let c : i32 = Mem::dwordAt(pixels, (idx as i64) * 4);
                let r : i32 = clampI32(((((c >> 16) & 0xFF) as f64) * keep + fogR * fog + caustic).floorToInt() as i32, 0, 255);
                let g : i32 = clampI32(((((c >> 8) & 0xFF) as f64) * keep + fogG * fog + caustic).floorToInt() as i32, 0, 255);
                let b : i32 = clampI32((((c & 0xFF) as f64) * keep + fogB * fog + caustic).floorToInt() as i32, 0, 255);
                Mem::putWordOf(pixels, idx, r * 65536 + g * 256 + b);
                x = x + 1;
            }
            y = y + 1;
        }

        // Rising bubbles: bright motes drifting upward. Each gets its own
        // column, rise speed, phase and size from a per-index hash, so they
        // don't climb in lockstep (no visible grid) and the columns wobble with
        // height instead of forming straight streaks.
        let nb : i32 = Water::BUBBLE_COUNT;
        let bcol : i32 = 200 * 65536 + 228 * 256 + 244;
        let bi : i32 = 0;
        while (bi < nb) {
            let hx : i32 = (bi * 1664525 + 1013904223) & 0x7FFFFFFF;
            let hp : i32 = ((bi + 1) * 22695477 + 13) & 0x7FFFFFFF;
            let hs : i32 = ((bi + 7) * 40503 + 101) & 0x7FFFFFFF;
            // Per-bubble rise speed (0.5..1.5x) breaks the synchronised motion.
            let sp : f64 = 0.5 + ((hs % 1000) as f64) * 0.001;
            let trav : i32 = (phase * Water::BUBBLE_SPEED * sp).floorToInt() as i32;
            let yy : i32 = h - 1 - (((hp + trav) & 0x7FFFFFFF) % h);
            // Column wobbles with height + its own phase → wavy, not a streak.
            let wob : f64 = (phase * 0.4 + (bi as f64) * 1.7 + (yy as f64) * 0.07).sin() * 3.0;
            let bx : i32 = (hx % w) + wob.floorToInt() as i32;
            self.plotBubble(fb, bx, yy, bcol);
            // Vary size: about half are a 2-px mote, the rest a single pixel.
            if ((hs & 1) == 0) {
                self.plotBubble(fb, bx + 1, yy, bcol);
                self.plotBubble(fb, bx, yy - 1, bcol);
            }
            bi = bi + 1;
        }
    }

    /**
     * Lighten one in-bounds pixel toward `col` (one cell of a bubble mote).
     * @param fb   the render target (framebuffer + z-buffer + size)
     * @param x    pixel x
     * @param y    pixel y
     * @param col  bubble colour
     */
    fn plotBubble(self, fb : FrameBuf, x : i32, y : i32, col : i32) : void {
        let pixels : i64 = fb.pixels;
        let w : i32 = fb.w;
        let h : i32 = fb.h;
        if (x < 0 || x >= w || y < 0 || y >= h) {
            return;
        }
        let idx : i32 = y * w + x;
        let c : i32 = Mem::dwordAt(pixels, (idx as i64) * 4);
        let r : i32 = (((c >> 16) & 0xFF) + ((col >> 16) & 0xFF)) / 2;
        let g : i32 = (((c >> 8) & 0xFF) + ((col >> 8) & 0xFF)) / 2;
        let b : i32 = ((c & 0xFF) + (col & 0xFF)) / 2;
        Mem::putWordOf(pixels, idx, (r & 0xFF) * 65536 + (g & 0xFF) * 256 + (b & 0xFF));
    }
}

/**
 * The texture-atlas kernel: owns the anisotropic mip chain built from the loaded
 * atlas and hands out a `MipAtlas` view through the `MipSource` seam. The
 * Renderer holds one; `setAtlas` / `atlasBase` delegate here, and both the world
 * raster and the mob pass sample through `mip()` instead of reaching at the raw
 * mip pointers.
 */
class TextureAtlas : MipSource {
    mips : i64,   // mip chain of the atlas (0 until the first setBase)
    mipOff : i64, // i32[mipLevels]: each mip level's texel offset (for aniso)
    mipSz : i64,  // i32[mipLevels]: each mip level's tile side length

    /** Allocate + fill the per-mip-level offset / size tables for the sampler. */
    constructor() {
        self.mips = 0;
        self.mipOff = Mem::take((Atlas::MIP_LEVELS as i64) * 4);
        self.mipSz = Mem::take((Atlas::MIP_LEVELS as i64) * 4);
        let ml : i32 = 0;
        while (ml < Atlas::MIP_LEVELS) {
            Mem::putWordOf(self.mipOff, ml, mipLevelOffset(ml));
            Mem::putWordOf(self.mipSz, ml, mipLevelSize(ml));
            ml = ml + 1;
        }
    }

    /**
     * Set the atlas base pointer and (re)build its mip chain. The level-0 mip is
     * a byte-for-byte copy of the loaded atlas, so `base()` doubles as the raw
     * tile-texel source.
     * @param base  base address of the loaded atlas texels
     */
    pub(file) fn setBase(mut self, base : i64) : void {
        if (self.mips == 0) {
            self.mips = Mem::take((mipChainTexels() as i64) * 4);
        }
        buildMipChain(base, self.mips);
    }

    /**
     * Base pointer to the full-resolution atlas texels (mip level 0). Callers
     * that need raw tile texels (e.g. the HUD hotbar icons) read it here instead
     * of keeping the original atlas buffer alive.
     * @return base address of the level-0 atlas texels
     */
    pub(file) fn base(self) : i64 {
        return self.mips;
    }

    /**
     * The mip-chain view the rasteriser samples (buffer + per-level tables).
     * @return the atlas mip snapshot
     */
    fn mip(self) : MipAtlas {
        return MipAtlas { mips: self.mips, mipOff: self.mipOff, mipSz: self.mipSz };
    }
}

/**
 * The day/night colour kernel: owns the sun direction, daylight factor and
 * sky/fog colour (refreshed each frame from the clock) plus the fixed brightness
 * curve the light sampler reads. `update` recomputes the cached `DayState` (the
 * value snapshot handed to the sky draws, the world raster and the mob pass);
 * `state` / `curve` expose it. The sun-direction shading itself lives on the
 * `DayState` value (its `SkyLighting.shade`).
 */
class DayLighting {
    cur : DayState, // this frame's sun / daylight / sky colour snapshot
    lcurve : i64,   // 16 f64s: lightFalloff^(15-level), the brightness curve

    /** Seed a noon day-state and build the brightness curve lookup. */
    constructor() {
        self.cur = DayState {
            sunX: 0.0, sunY: 1.0, sunZ: 0.0,
            daylight: 1.0,
            skyColR: Daylight::DAY_SKY_R, skyColG: Daylight::DAY_SKY_G, skyColB: Daylight::DAY_SKY_B,
        };
        // Brightness curve lookup: lcurve[level] = `Light::FALLOFF`^(15-level).
        self.lcurve = Mem::take(16 * 8);
        let li : i32 = 0;
        while (li < 16) {
            let pc : f64 = 1.0;
            let kc : i32 = 0;
            while (kc < 15 - li) {
                pc = pc * Light::FALLOFF;
                kc = kc + 1;
            }
            Mem::putRealOf(self.lcurve, li, pc);
            li = li + 1;
        }
    }

    /**
     * Refresh the cached day/night state from dayTime (0..1) for this frame: the
     * sun direction (face shading), the daylight factor (scales sky light) and
     * the sky/fog colour. The math lives in `sky::computeDayState`; the fresh
     * value is cached AND returned so the caller can hand the same snapshot to
     * the sky draws (and across the gradient job's thread).
     * @param dayTime  time of day in [0, 1)
     * @return the day/night state for this frame
     */
    pub(file) fn update(mut self, dayTime : f64) : DayState {
        self.cur = computeDayState(dayTime);
        return self.cur;
    }

    /**
     * This frame's cached day/night state (sun / daylight / sky colour).
     * @return the current day/night state
     */
    pub(file) fn state(self) : DayState {
        return self.cur;
    }

    /**
     * The brightness-curve lookup (`Light::FALLOFF`^(15-level)) the light sampler and
     * the mob ambient read.
     * @return base address of the 16-entry f64 curve
     */
    pub(file) fn curve(self) : i64 {
        return self.lcurve;
    }
}

/**
 * The world-face raster component: the core of the renderer. It owns the
 * projection / near-clip scratch, the per-direction face corner + UV tables and
 * the world-face triangle queue. Each frame `drawWorld` projects, lights and
 * clips every visible chunk face into the queue (once, single-threaded), then
 * fills the queue in disjoint parallel column bands (tiled render).
 *
 * The per-corner light reads are taken through the split light seams
 * (`dyn SkyLightField` / `dyn SunLightField` / `dyn BounceLightField`); the
 * baked mesh FIELDS (fx/fy/fz/ftile/flight/fao) and the water geometry
 * (worldGet / blockBoxHeight) still come off the concrete ChunkManager.
 */
class ChunkRenderer {
    coff : i32[],
    uvu : i32[],
    uvv : i32[],
    cs : ScreenScratch,   // screen-space scratch (pixel x/y + inverse depth)
    ca : VertAttribs,     // camera-space input verts (pos + uv + Gouraud colour) …
    cb : VertAttribs,     // … and the near-clipped output verts
    triBuf : RasterTri[], // world-face triangle queue: the world pass projects/
                          // lights/clips into here once, then worker threads
                          // rasterise it in parallel column bands (tiled render)
    triN : i32,           // number of queued triangles this frame
    atlas : MipAtlas,     // ── per-frame render context (set in drawWorld) ──
    fog : Rgb,            // distance-fog colour (this frame's sky colour)
    day : DayState,       // sun / daylight snapshot (per-corner light + glint)
    lcurve : i64,         // brightness curve (owned by DayLighting)

    /**
     * Allocate the triangle queue, the projection / clipping scratch buffers and
     * the face corner tables, and seed the (overwritten-per-frame) context.
     */
    constructor() {
        self.triBuf = malloc<RasterTri>(Render::TRI_QUEUE_CAP);
        self.triN = 0;
        self.coff = malloc<i32>(72);
        self.uvu = malloc<i32>(24);
        self.uvv = malloc<i32>(24);
        // Screen-space scratch sized for a near-clipped polygon (≤ 5 verts).
        self.cs = ScreenScratch { sx: Mem::take(8 * 8), sy: Mem::take(8 * 8), iz: Mem::take(8 * 8) };
        // Camera-space input (ca) and clipped output (cb) vertex buffers: x, y,
        // z (depth), the u, v texture coordinates and the r, g, b Gouraud colour
        // per vertex — the same 16 disjoint allocBytes buffers, grouped.
        self.ca = VertAttribs {
            x: Mem::take(8 * 8), y: Mem::take(8 * 8), z: Mem::take(8 * 8),
            u: Mem::take(8 * 8), v: Mem::take(8 * 8),
            r: Mem::take(8 * 8), g: Mem::take(8 * 8), b: Mem::take(8 * 8),
        };
        self.cb = VertAttribs {
            x: Mem::take(8 * 8), y: Mem::take(8 * 8), z: Mem::take(8 * 8),
            u: Mem::take(8 * 8), v: Mem::take(8 * 8),
            r: Mem::take(8 * 8), g: Mem::take(8 * 8), b: Mem::take(8 * 8),
        };
        self.atlas = MipAtlas { mips: 0, mipOff: 0, mipSz: 0 };
        self.fog = Rgb { r: Daylight::DAY_SKY_R, g: Daylight::DAY_SKY_G, b: Daylight::DAY_SKY_B };
        self.day = DayState {
            sunX: 0.0, sunY: 1.0, sunZ: 0.0,
            daylight: 1.0,
            skyColR: Daylight::DAY_SKY_R, skyColG: Daylight::DAY_SKY_G, skyColB: Daylight::DAY_SKY_B,
        };
        self.lcurve = 0;
        self.fillTable();
    }

    /**
     * Store one face corner's block-space offset and tile UV into the
     * corner / UV tables.
     * @param dir  face direction index (0..5)
     * @param k    corner index within the face (0..3)
     * @param ox   x offset of the corner in block space
     * @param oy   y offset of the corner in block space
     * @param oz   z offset of the corner in block space
     * @param u    tile u coordinate for the corner
     * @param v    tile v coordinate for the corner
     */
    fn setCorner(mut self, dir : i32, k : i32, ox : i32, oy : i32, oz : i32, u : i32, v : i32) : void {
        let b : i32 = (dir * 4 + k) * 3;
        self.coff[b] = ox;
        self.coff[b + 1] = oy;
        self.coff[b + 2] = oz;
        let q : i32 = dir * 4 + k;
        self.uvu[q] = u;
        self.uvv[q] = v;
    }

    /**
     * Fill the per-direction face corner / UV tables for all 6 cube faces.
     */
    fn fillTable(mut self) : void {
        self.setCorner(0, 0, 1, 0, 0, 0, 1);
        self.setCorner(0, 1, 1, 0, 1, 1, 1);
        self.setCorner(0, 2, 1, 1, 1, 1, 0);
        self.setCorner(0, 3, 1, 1, 0, 0, 0);
        self.setCorner(1, 0, 0, 0, 0, 0, 1);
        self.setCorner(1, 1, 0, 1, 0, 0, 0);
        self.setCorner(1, 2, 0, 1, 1, 1, 0);
        self.setCorner(1, 3, 0, 0, 1, 1, 1);
        self.setCorner(2, 0, 0, 1, 0, 0, 0);
        self.setCorner(2, 1, 1, 1, 0, 1, 0);
        self.setCorner(2, 2, 1, 1, 1, 1, 1);
        self.setCorner(2, 3, 0, 1, 1, 0, 1);
        self.setCorner(3, 0, 0, 0, 0, 0, 0);
        self.setCorner(3, 1, 0, 0, 1, 0, 1);
        self.setCorner(3, 2, 1, 0, 1, 1, 1);
        self.setCorner(3, 3, 1, 0, 0, 1, 0);
        self.setCorner(4, 0, 0, 0, 1, 0, 1);
        self.setCorner(4, 1, 1, 0, 1, 1, 1);
        self.setCorner(4, 2, 1, 1, 1, 1, 0);
        self.setCorner(4, 3, 0, 1, 1, 0, 0);
        self.setCorner(5, 0, 0, 0, 0, 0, 1);
        self.setCorner(5, 1, 0, 1, 0, 0, 0);
        self.setCorner(5, 2, 1, 1, 0, 1, 0);
        self.setCorner(5, 3, 1, 0, 0, 1, 1);
    }

    // ── Projection & near-plane clipping ──

    /**
     * Transform a world point into camera space (post yaw + pitch) through the
     * shared Camera and store it into the `ca*` input buffers at slot k. No
     * perspective divide yet — that happens after near-plane clipping.
     * @param cam  the camera (eye + orientation + projection width)
     * @param w    the world-space point
     * @param k    scratch slot index to store the result in
     */
    fn toCam(self, cam : Camera, w : Vec3, k : i32) : void {
        let c : Vec3 = cam.toCamera(w);
        Mem::putRealOf(self.ca.x, k, c.x);
        Mem::putRealOf(self.ca.y, k, c.y);
        Mem::putRealOf(self.ca.z, k, c.z);
    }

    /**
     * Write the linear blend of input vertices j and i at parameter t
     * (the near-plane crossing) into output slot o.
     * @param j  first input vertex slot
     * @param i  second input vertex slot
     * @param t  blend parameter (0 at j, 1 at i)
     * @param o  output vertex slot
     */
    fn emitLerp(self, j : i32, i : i32, t : f64, o : i32) : void {
        Mem::putRealOf(self.cb.x, o, Mem::realOf(self.ca.x, j) + (Mem::realOf(self.ca.x, i) - Mem::realOf(self.ca.x, j)) * t);
        Mem::putRealOf(self.cb.y, o, Mem::realOf(self.ca.y, j) + (Mem::realOf(self.ca.y, i) - Mem::realOf(self.ca.y, j)) * t);
        Mem::putRealOf(self.cb.z, o, Mem::realOf(self.ca.z, j) + (Mem::realOf(self.ca.z, i) - Mem::realOf(self.ca.z, j)) * t);
        Mem::putRealOf(self.cb.u, o, Mem::realOf(self.ca.u, j) + (Mem::realOf(self.ca.u, i) - Mem::realOf(self.ca.u, j)) * t);
        Mem::putRealOf(self.cb.v, o, Mem::realOf(self.ca.v, j) + (Mem::realOf(self.ca.v, i) - Mem::realOf(self.ca.v, j)) * t);
        Mem::putRealOf(self.cb.r, o, Mem::realOf(self.ca.r, j) + (Mem::realOf(self.ca.r, i) - Mem::realOf(self.ca.r, j)) * t);
        Mem::putRealOf(self.cb.g, o, Mem::realOf(self.ca.g, j) + (Mem::realOf(self.ca.g, i) - Mem::realOf(self.ca.g, j)) * t);
        Mem::putRealOf(self.cb.b, o, Mem::realOf(self.ca.b, j) + (Mem::realOf(self.ca.b, i) - Mem::realOf(self.ca.b, j)) * t);
    }

    /**
     * Copy input vertex i to output slot o.
     * @param i  input vertex slot
     * @param o  output vertex slot
     */
    fn copyVert(self, i : i32, o : i32) : void {
        Mem::putRealOf(self.cb.x, o, Mem::realOf(self.ca.x, i));
        Mem::putRealOf(self.cb.y, o, Mem::realOf(self.ca.y, i));
        Mem::putRealOf(self.cb.z, o, Mem::realOf(self.ca.z, i));
        Mem::putRealOf(self.cb.u, o, Mem::realOf(self.ca.u, i));
        Mem::putRealOf(self.cb.v, o, Mem::realOf(self.ca.v, i));
        Mem::putRealOf(self.cb.r, o, Mem::realOf(self.ca.r, i));
        Mem::putRealOf(self.cb.g, o, Mem::realOf(self.ca.g, i));
        Mem::putRealOf(self.cb.b, o, Mem::realOf(self.ca.b, i));
    }

    /**
     * Vertex `i` of the clipped polygon, gathered into one `RasterVert`.
     *
     * The clip and projection stages write eight parallel scratch arrays
     * (screen x/y, inverse depth, UV, and the baked Gouraud colour); the
     * rasteriser wants them as one value. Fan-triangulating a polygon
     * reads the same corner three times over, so the gather lives here
     * instead of being spelled out per triangle corner.
     *
     * @param i  index into the clipped-polygon scratch
     * @return the corner as the rasteriser's vertex
     */
    fn clippedVert(self, i : i32) : RasterVert {
        return RasterVert {
            sx: Mem::realOf(self.cs.sx, i),
            sy: Mem::realOf(self.cs.sy, i),
            iz: Mem::realOf(self.cs.iz, i),
            u: Mem::realOf(self.cb.u, i),
            v: Mem::realOf(self.cb.v, i),
            tr: Mem::realOf(self.cb.r, i),
            tg: Mem::realOf(self.cb.g, i),
            tb: Mem::realOf(self.cb.b, i),
        };
    }

    /**
     * Clip the `nIn`-vertex camera-space polygon in `ca*` against the
     * near plane (depth ≥ `Screen::NEAR_PLANE`) into `cb*` (Sutherland–Hodgman),
     * interpolating position + UV at each crossing. Replacing the old
     * "drop the whole face if any corner is too close" rule is what
     * removes the holes / texture smear when the camera hugs a block.
     * @param nIn  number of input vertices in the `ca*` buffers
     * @return number of output vertices written to the `cb*` buffers
     */
    fn clipNear(self, nIn : i32) : i32 {
        let outN : i32 = 0;
        let j : i32 = nIn - 1;
        let i : i32 = 0;
        while (i < nIn) {
            let zi : f64 = Mem::realOf(self.ca.z, i);
            let zj : f64 = Mem::realOf(self.ca.z, j);
            let inI : bool = zi >= Screen::NEAR_PLANE;
            let inJ : bool = zj >= Screen::NEAR_PLANE;
            if (inI != inJ) {
                let t : f64 = (Screen::NEAR_PLANE - zj) / (zi - zj);
                self.emitLerp(j, i, t, outN);
                outN = outN + 1;
            }
            if (inI) {
                self.copyVert(i, outN);
                outN = outN + 1;
            }
            j = i;
            i = i + 1;
        }
        return outN;
    }

    /**
     * Classify one column at a corner for the surface averager:
     *   2.0  → a source, or water with water directly above (a column) — stays
     *          full so lakes are flat and waterfalls solid;
     *   0..1 → a free flowing surface, height = level/8;
     *   -1.0 → air — counts as height 0, so a flowing edge / drop ramps down;
     *   -2.0 → solid — ignored.
     * @param man  the chunk manager
     * @param wx   world x
     * @param y    world y (the face's layer)
     * @param wz   world z
     * @return the classification value described above
     */
    fn cornerSample(self, man : ChunkManager, wx : i32, y : i32, wz : i32) : f64 {
        let id : Block = man.worldGet(ivec3(wx, y, wz));
        if (id == Block::Air) {
            return 0.0 - 1.0;
        }
        if (!isWater(id)) {
            return 0.0 - 2.0;
        }
        if (isSource(id) || isWater(man.worldGet(ivec3(wx, y + 1, wz)))) {
            return 2.0;
        }
        let lvl : i32 = fluidLevel(id);
        return (lvl as f64) / 8.0;
    }

    /**
     * Sloped-surface height at a top corner shared by up to four water columns,
     * Minecraft-style. A source or falling column keeps the corner full (lakes
     * stay flat, waterfalls stay solid). Otherwise it averages the flowing
     * surfaces AND counts adjacent air as 0, so a free water edge — and the lip
     * of a drop — ramps down in a rounded slope instead of a hard step, keeping
     * the surface connected to the fall with no void.
     * @param man  the chunk manager
     * @param cx   corner world x (a block boundary)
     * @param y    world y (the face's layer)
     * @param cz   corner world z (a block boundary)
     * @return the corner height fraction (0..1)
     */
    fn waterCornerY(self, man : ChunkManager, cx : i32, y : i32, cz : i32) : f64 {
        let s0 : f64 = self.cornerSample(man, cx - 1, y, cz - 1);
        let s1 : f64 = self.cornerSample(man, cx, y, cz - 1);
        let s2 : f64 = self.cornerSample(man, cx - 1, y, cz);
        let s3 : f64 = self.cornerSample(man, cx, y, cz);
        if (s0 > 1.5 || s1 > 1.5 || s2 > 1.5 || s3 > 1.5) {
            return 1.0;   // a source / column corner stays full height
        }
        // Air contributes Water::EDGE_HEIGHT (not a hard 0), so a flowing
        // edge keeps a bit of body and only eases down — a gentle lip rather
        // than a steep "skateboard ramp" right at the border.
        let sum : f64 = 0.0;
        let cnt : i32 = 0;
        if (s0 >= 0.0) {
            sum = sum + s0;
            cnt = cnt + 1;
        } else if (s0 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (s1 >= 0.0) {
            sum = sum + s1;
            cnt = cnt + 1;
        } else if (s1 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (s2 >= 0.0) {
            sum = sum + s2;
            cnt = cnt + 1;
        } else if (s2 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (s3 >= 0.0) {
            sum = sum + s3;
            cnt = cnt + 1;
        } else if (s3 > 0.0 - 1.5) {
            sum = sum + Water::EDGE_HEIGHT;
            cnt = cnt + 1;
        }
        if (cnt == 0) {
            return 1.0;
        }
        return sum / (cnt as f64);
    }

    // ── Per-face baked-light reads through the split light seams ──

    /**
     * The ambient-sky occlusion factor at the face's probe cell: the baked
     * hemispherical sky access (ray-traced AO) mapped into [`Light::AO_SKY_MIN`, 1], so
     * valleys / recesses / canopy darken the ambient sky light. One SkyLightField
     * tap per face.
     * @param sky   the sky-light seam (skyaccessGet)
     * @param cell  the probe cell (air neighbour in the face-normal direction)
     * @return the sky-AO factor in [`Light::AO_SKY_MIN`, 1]
     */
    fn skyAOFactor(self, sky : dyn SkyLightField, cell : IVec3) : f64 {
        let skyAcc : f64 = (sky.skyaccessGet(cell) as f64) * 0.00392157;
        return Light::AO_SKY_MIN + (1.0 - Light::AO_SKY_MIN) * skyAcc;
    }

    /**
     * The one-bounce coloured indirect tint at the face's probe cell, unpacked to
     * a 0..2 RGB multiplier triple. One BounceLightField tap per face.
     * @param bounce  the bounce-light seam (bounceGet)
     * @param cell    the probe cell
     * @return the bounce tint as (r, g, b) multipliers
     */
    fn bounceTint(self, bounce : dyn BounceLightField, cell : IVec3) : Vec3 {
        let bnc : i32 = bounce.bounceGet(cell);
        return vec3(
            (((bnc >> 16) & 0xFF) as f64) * 0.0078125,
            (((bnc >> 8) & 0xFF) as f64) * 0.0078125,
            ((bnc & 0xFF) as f64) * 0.0078125);
    }

    /**
     * Soft sun visibility at one face corner: the averaged soft sun-visibility
     * over the four air cells meeting at the corner (symmetric → continuous
     * across faces, no block staircase), in 0..1. One SunLightField tap.
     * @param sun   the sun-light seam (sunSoftCorner)
     * @param cell  the face's air probe cell
     * @param t1    first in-plane tangent offset
     * @param t2    second in-plane tangent offset
     * @return the soft sun-visibility fraction in [0, 1]
     */
    fn cornerSunVis(self, sun : dyn SunLightField, cell : IVec3, t1 : IVec3, t2 : IVec3) : f64 {
        return (sun.sunSoftCorner(cell, t1, t2) as f64) * 0.00392157;
    }

    // ── World faces (water surface heights, face baking) ──

    /**
     * Project, cull, shade and rasterize one baked world face into the triangle
     * queue.
     * @param man     chunk manager holding the baked face arrays
     * @param idx     index of the face to draw
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     */
    fn renderFace(mut self, man : ChunkManager, idx : i32, cam : Camera, phase : f64) : void {
        let x : i32 = man.faces.fx[idx];
        let y : i32 = man.faces.fy[idx];
        let z : i32 = man.faces.fz[idx];
        // Unpack the direction and atlas tile from the packed ftile slot.
        let packed : i32 = man.faces.ftile[idx];
        let dir : FaceDir = faceDirFrom(packed / 256);
        let isWaterFace : bool = (packed % 256) == Tile::WATER;
        // Partial, floor-resting blocks (thin snow, slabs later) render at their
        // real box height (top + side tops lowered to y + boxH), like a short
        // water surface. blockBoxHeight is the single authority (1.0 = full cube).
        let boxH : f64 = man.blockBoxHeight(ivec3(x, y, z));
        let isPartialFace : bool = boxH < 1.0;
        let nx : f64 = 0.0;
        let ny : f64 = 0.0;
        let nz : f64 = 0.0;
        match dir {
            FaceDir::PosX => {
                nx = 1.0;
            }
            FaceDir::NegX => {
                nx = 0.0 - 1.0;
            }
            FaceDir::Top => {
                ny = 1.0;
            }
            FaceDir::Bottom => {
                ny = 0.0 - 1.0;
            }
            FaceDir::PosZ => {
                nz = 1.0;
            }
            _ => {
                nz = 0.0 - 1.0;
            }
        }

        let fcx : f64 = (x as f64) + 0.5 + nx * 0.5;
        let fcy : f64 = (y as f64) + 0.5 + ny * 0.5;
        let fcz : f64 = (z as f64) + 0.5 + nz * 0.5;
        let vx : f64 = cam.eye.x - fcx;
        let vy : f64 = cam.eye.y - fcy;
        let vz : f64 = cam.eye.z - fcz;
        // Water surfaces AND the top of a partial block (thin snow, a slab) draw
        // double-sided so the surface stays visible from below; every other face
        // back-face culls. Without this the raised partial top back-face culls
        // the instant the eye drops below its plane (y + boxH) and the top
        // "disappears as you descend" — worse the deeper the block (higher plane).
        let facing : f64 = vx * nx + vy * ny + vz * nz;
        let topPartial : bool = isPartialFace && ny > 0.0;
        if (!isWaterFace && !topPartial && facing <= 0.0) {
            return;
        }
        if (vx * vx + vz * vz > Render::DRAW_DIST * Render::DRAW_DIST) {
            return;
        }

        // Flow animation: flowing water scrolls its texture along the flow
        // direction (toward lower level). Still lakes have no gradient, so they
        // don't scroll.
        let flowU : f64 = 0.0;
        let flowV : f64 = 0.0;
        if (isWaterFace) {
            let lpx : i32 = fluidLevel(man.worldGet(ivec3(x + 1, y, z)));
            let lnx : i32 = fluidLevel(man.worldGet(ivec3(x - 1, y, z)));
            let lpz : i32 = fluidLevel(man.worldGet(ivec3(x, y, z + 1)));
            let lnz : i32 = fluidLevel(man.worldGet(ivec3(x, y, z - 1)));
            let tscroll : f64 = phase * Water::FLOW_SPEED;
            flowU = ((lpx - lnx) as f64) * tscroll;
            flowV = ((lpz - lnz) as f64) * tscroll;
        }

        // Face-direction (Lambert) shading + the directional sun shadow, shared
        // by all 4 corners (computed once before the per-corner light below).
        let bright : f64 = self.day.shade(vec3(nx, ny, nz));
        if (isWaterFace && facing <= 0.0) {
            bright = bright * 0.62;   // underside / far face of water, dimmer
        }
        // Directional sun shadow: if the air cell this face looks into is in the
        // sun's cast shadow, drop toward ambient (keeping Render::SHADOW_KEEP of
        // the direct term). sunlitGet defaults to 1 for non-sky cells, so caves /
        // roofed faces are untouched without a separate sky-light gate.
        // The shadow-probe cell is just the neighbour in the face-normal
        // direction; dir already carries that, so match on it instead of
        // re-deriving the offset from the float normal three times.
        let sbx : i32 = x;
        let sby : i32 = y;
        let sbz : i32 = z;
        match dir {
            FaceDir::PosX => { sbx = x + 1; }
            FaceDir::NegX => { sbx = x - 1; }
            FaceDir::Top => { sby = y + 1; }
            FaceDir::Bottom => { sby = y - 1; }
            FaceDir::PosZ => { sbz = z + 1; }
            _ => { sbz = z - 1; }
        }
        let shadowCell : IVec3 = ivec3(sbx, sby, sbz);
        // `bright` is now the pure Lambert (sun-direction) term; the cast shadow
        // is applied PER CORNER below (smooth, face-independent), not flattened
        // over the whole face here — that's what removes the block staircase.

        // Hemispherical sky access (baked ray-traced AO) + the one-bounce
        // coloured indirect tint, both read once per face through the light seams.
        let skyAOFac : f64 = self.skyAOFactor(man, shadowCell);
        let bncTint : Vec3 = self.bounceTint(man, shadowCell);
        let bncR : f64 = bncTint.x;
        let bncG : f64 = bncTint.y;
        let bncB : f64 = bncTint.z;

        // Load the 4 corners into camera space + their tile UVs, and bake each
        // corner's light colour (smooth light + AO + per-corner soft shadow) into
        // the car/cag/cab inputs so clipNear interpolates colour like it does UV.
        // A water face's top corners are dropped to a Minecraft-style sloped
        // surface: each corner takes the average height of the water columns
        // meeting at it, so adjacent levels join in a continuous ramp with no
        // vertical "façade" gaps between layers.
        let di : i32 = dir as i32;
        let naxis : i32 = di / 2;   // normal axis: 0=X, 1=Y, 2=Z
        let q : i32 = di * 4;
        let k : i32 = 0;
        while (k < 4) {
            let b : i32 = (di * 4 + k) * 3;
            let oxv : i32 = self.coff[b];
            let oyv : i32 = self.coff[b + 1];
            let ozv : i32 = self.coff[b + 2];
            let cornerY : f64 = (y as f64) + (oyv as f64);
            if (isWaterFace && oyv > 0) {
                cornerY = (y as f64) + self.waterCornerY(man, x + oxv, y, z + ozv);
            } else if (isPartialFace && oyv > 0) {
                cornerY = (y as f64) + boxH;
            }
            self.toCam(cam, vec3((x + oxv) as f64, cornerY, (z + ozv) as f64), k);
            Mem::putRealOf(self.ca.u, k, (self.uvu[q + k] as f64) + flowU);
            Mem::putRealOf(self.ca.v, k, (self.uvv[q + k] as f64) + flowV);
            // Per-corner SOFT CAST SHADOW: average the soft sun-visibility over
            // the 4 air cells meeting at this corner (symmetric → continuous
            // across faces, no block staircase), then keep that fraction of the
            // direct sun term. The two in-plane tangent offsets come from the
            // corner's block offset and the face normal axis.
            let sgx : i32 = oxv * 2 - 1;
            let sgy : i32 = oyv * 2 - 1;
            let sgz : i32 = ozv * 2 - 1;
            let t1x : i32 = 0;
            let t1y : i32 = 0;
            let t1z : i32 = 0;
            let t2x : i32 = 0;
            let t2y : i32 = 0;
            let t2z : i32 = 0;
            match naxis {
                0 => {
                    t1y = sgy;
                    t2z = sgz;
                }
                1 => {
                    t1x = sgx;
                    t2z = sgz;
                }
                _ => {
                    t1x = sgx;
                    t2y = sgy;
                }
            }

            let visK : f64 = self.cornerSunVis(man, shadowCell, ivec3(t1x, t1y, t1z), ivec3(t2x, t2y, t2z));
            let keepK : f64 = Render::SHADOW_KEEP + (1.0 - Render::SHADOW_KEEP) * visK;
            let brightK : f64 = Render::AMBIENT + keepK * (bright - Render::AMBIENT);

            // Per-corner smooth light: sky/block nibbles averaged at bake time,
            // through the exponential curve (sky dimmed by daylight), times the
            // per-corner shaded brightness and the AO factor; block light warm.
            let lb : i32 = Mem::byteAt(man.faces.flight, (idx * 4 + k) as i64);
            let skyLk : i32 = (lb >> 4) & 0xF;
            let blkLk : i32 = lb & 0xF;
            let aok : i32 = Mem::byteAt(man.faces.fao, (idx * 4 + k) as i64);
            let aoFac : f64 = 1.0 - Light::AO_STRENGTH * ((3 - aok) as f64) * 0.3333333;
            let skyFk : f64 = Mem::realOf(self.lcurve, skyLk) * self.day.daylight * skyAOFac;
            let blkFk : f64 = Mem::realOf(self.lcurve, blkLk);
            let cfk : f64 = skyFk;
            if (blkFk > cfk) {
                cfk = blkFk;
            }
            let lfac : f64 = Light::MIN + (1.0 - Light::MIN) * cfk;
            let cbase : f64 = brightK * lfac * aoFac;
            let wf : f64 = (blkLk as f64) * 0.0667 * Light::TORCH_WARM;

            // Warm sun / cool shade by how directly THIS corner is sunlit, ×
            // the one-bounce tint, applied in proportion to the sky-light share
            // (so torch-lit caves stay warm).
            let directK : f64 = 0.0;
            if (brightK > Render::AMBIENT) {
                directK = (brightK - Render::AMBIENT) / (1.0 - Render::AMBIENT);
            }
            let wsunK : f64 = directK * self.day.daylight;
            let tintRk : f64 = (Light::SHADE_TINT_R + (Light::SUN_TINT_R - Light::SHADE_TINT_R) * wsunK) * bncR;
            let tintGk : f64 = (Light::SHADE_TINT_G + (Light::SUN_TINT_G - Light::SHADE_TINT_G) * wsunK) * bncG;
            let tintBk : f64 = (Light::SHADE_TINT_B + (Light::SUN_TINT_B - Light::SHADE_TINT_B) * wsunK) * bncB;
            let skyShare : f64 = skyFk / (skyFk + blkFk + 0.0001);
            let tR : f64 = 1.0 + (tintRk - 1.0) * skyShare;
            let tG : f64 = 1.0 + (tintGk - 1.0) * skyShare;
            let tB : f64 = 1.0 + (tintBk - 1.0) * skyShare;
            let crk : f64 = cbase * (1.0 + wf) * tR;
            let cgk : f64 = cbase * tG;
            let cbk : f64 = cbase * (1.0 - wf) * tB;

            if (isWaterFace) {
                // View vector from this corner to the eye.
                let vx : f64 = cam.eye.x - ((x + oxv) as f64);
                let vy : f64 = cam.eye.y - cornerY;
                let vz : f64 = cam.eye.z - ((z + ozv) as f64);
                let vl : f64 = (vx * vx + vy * vy + vz * vz).sqrt();
                if (vl < 0.0001) {
                    vl = 0.0001;
                }
                vx = vx / vl;
                vy = vy / vl;
                vz = vz / vl;
                // Sun glint: half-vector specular, cos^32, gated by sun visibility
                // and daylight. A strong warm multiplier that bloom turns to gold.
                let hx : f64 = vx + self.day.sunX;
                let hy : f64 = vy + self.day.sunY;
                let hz : f64 = vz + self.day.sunZ;
                let hl : f64 = (hx * hx + hy * hy + hz * hz).sqrt();
                if (hl < 0.0001) {
                    hl = 0.0001;
                }
                let ndh : f64 = (nx * hx + ny * hy + nz * hz) / hl;
                if (ndh < 0.0) {
                    ndh = 0.0;
                }
                let s2 : f64 = ndh * ndh;
                let s4 : f64 = s2 * s2;
                let s8 : f64 = s4 * s4;
                let s16 : f64 = s8 * s8;
                let spec : f64 = s16 * s16 * visK * self.day.daylight * Water::SPEC_STRENGTH;
                // Fresnel: brighter at grazing view angles (sky-reflection sheen).
                let ndv : f64 = nx * vx + ny * vy + nz * vz;
                if (ndv < 0.0) {
                    ndv = 0.0;
                }
                let om : f64 = 1.0 - ndv;
                let om2 : f64 = om * om;
                let fres : f64 = Water::F0 + (1.0 - Water::F0) * om2 * om2 * om;
                let fboost : f64 = 1.0 + fres * Water::FRESNEL_STRENGTH;
                crk = crk * fboost * (1.0 + spec * 1.10);
                cgk = cgk * fboost * (1.0 + spec * 1.00);
                cbk = cbk * fboost * (1.0 + spec * 0.72);
            }
            Mem::putRealOf(self.ca.r, k, crk);
            Mem::putRealOf(self.ca.g, k, cgk);
            Mem::putRealOf(self.ca.b, k, cbk);
            k = k + 1;
        }

        // Clip against the near plane, then project the surviving polygon.
        let n : i32 = self.clipNear(4);
        if (n < 3) {
            return;
        }
        let tile : i32 = packed % 256;
        // Mip selection + filtering is now per pixel in the rasteriser
        // (anisotropic), so no per-face mip is computed here.
        // Per-corner light colour was baked into car/cag/cab and carried through
        // clipNear into cbr/cbg/cbb — the rasteriser interpolates it per pixel.
        let v : i32 = 0;
        while (v < n) {
            let sp : Projected = cam.screenOf(vec3(Mem::realOf(self.cb.x, v), Mem::realOf(self.cb.y, v), Mem::realOf(self.cb.z, v)));
            Mem::putRealOf(self.cs.sx, v, sp.sx);
            Mem::putRealOf(self.cs.sy, v, sp.sy);
            Mem::putRealOf(self.cs.iz, v, sp.iz);
            v = v + 1;
        }

        // Fan-triangulate the clipped polygon from vertex 0 and QUEUE each
        // triangle (with its Gouraud per-vertex colours) — the parallel band
        // rasteriser fills them later. The heavy per-face lighting above is thus
        // done once, not once per worker.
        let wf : i32 = 0;
        if (isWaterFace) {
            wf = 1;
        }
        let t : i32 = 1;
        while (t < n - 1) {
            if (self.triN < Render::TRI_QUEUE_CAP) {
                self.triBuf[self.triN] = RasterTri {
                    a: self.clippedVert(0),
                    b: self.clippedVert(t),
                    c: self.clippedVert(t + 1),
                    tile: tile,
                    wrap: wf
                };
                self.triN = self.triN + 1;
            }
            t = t + 1;
        }
    }

    /**
     * Draw one full world frame's opaque terrain: reset the queue, project /
     * light / clip every visible chunk face into it (single thread), then fill
     * the queue in disjoint parallel column bands (tiled render). The per-frame
     * render context (atlas mip chain, fog colour, day-state, brightness curve)
     * is snapshotted onto the component so the band rasteriser and the worker
     * jobs read it without re-threading it through every call.
     * @param man     chunk manager holding the loaded chunks and baked faces
     * @param p       player providing the eye position and orientation
     * @param fb      the render target (framebuffer + z-buffer + size)
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     * @param atlas   the texture atlas mip chain view
     * @param fog     the distance-fog colour (this frame's sky colour)
     * @param day     the day/night state (sun / daylight for corner shading)
     * @param lcurve  the brightness-curve lookup
     */
    pub(file) fn drawWorld(mut self, man : ChunkManager, p : Player, fb : FrameBuf, cam : Camera, phase : f64,
        own atlas : MipAtlas, own fog : Rgb, own day : DayState, lcurve : i64) : void {
        self.atlas = atlas;
        self.fog = fog;
        self.day = day;
        self.lcurve = lcurve;
        // World pass — single thread: project / light / clip every visible face
        // into the triangle queue (self.triBuf / triN). Then the queue is
        // rasterised in parallel column bands below.
        self.triN = 0;
        let slots : i32 = World::SPAN * World::SPAN;
        let slot : i32 = 0;
        while (slot < slots) {
            if (man.cols.loaded[slot] == 1 && chunkVisible(p, man.cols.cxs[slot], man.cols.czs[slot])) {
                let base : i32 = slot * World::MAX_FACES_PER_CHUNK;
                let n : i32 = man.faces.fcount[slot];
                let fi : i32 = 0;
                while (fi < n) {
                    self.renderFace(man, base + fi, cam, phase);
                    fi = fi + 1;
                }
            }
            slot = slot + 1;
        }
        // Tiled rasterise: worker threads each fill a disjoint column band while
        // the main thread fills band 0 — no two threads touch the same z-buffer
        // pixel. Explicit handles (the one-shot Task checker dislikes joining an
        // array in a loop), so 1 / 2 / 4 bands.
        let w : i32 = fb.w;
        let nT : i32 = Render::RASTER_TILES;
        if (nT >= 12) {
            let bw : i32 = (w + 11) / 12;
            let jobs : Task<i32>[11];
            for (i of 0..11) {
                let x0 : i32 = bw * (i + 1);
                let x1 : i32 = bw * (i + 2);
                if (i == 10) {
                    x1 = w;
                }
                jobs[i] = spawn rasterTilesJob(self, fb, x0, x1);
            }
            self.rasterizeBand(fb, 0, bw);
            for (i of 0..11) {
                let d : i32 = jobs[i].join();
            }
        } else if (nT >= 4) {
            let bw : i32 = (w + 3) / 4;
            let ta : Task<i32> = spawn rasterTilesJob(self, fb, bw, bw * 2);
            let tb : Task<i32> = spawn rasterTilesJob(self, fb, bw * 2, bw * 3);
            let tc : Task<i32> = spawn rasterTilesJob(self, fb, bw * 3, w);
            self.rasterizeBand(fb, 0, bw);
            let da : i32 = ta.join();
            let db : i32 = tb.join();
            let dc : i32 = tc.join();
        } else if (nT == 2) {
            let bw : i32 = (w + 1) / 2;
            let ta : Task<i32> = spawn rasterTilesJob(self, fb, bw, w);
            self.rasterizeBand(fb, 0, bw);
            let da : i32 = ta.join();
        } else {
            self.rasterizeBand(fb, 0, w);
        }
    }

    /**
     * Rasterise the queued world triangles whose pixels fall in the column band
     * [bx0, bx1). Each band is disjoint, so threads never touch the same z-buffer
     * pixel. Called by the main thread and the rasterTilesJob worker. Reads this
     * frame's atlas + fog off the component (set in drawWorld).
     * @param fb   the render target (framebuffer + z-buffer + size)
     * @param bx0  inclusive left screen column of this band
     * @param bx1  exclusive right screen column of this band
     */
    pub(file) fn rasterizeBand(self, fb : FrameBuf, bx0 : i32, bx1 : i32) : void {
        let i : i32 = 0;
        let band : Band = Band { x0: bx0, x1: bx1 };
        while (i < self.triN) {
            let tri : RasterTri = self.triBuf[i];
            rasterTriTex(fb, tri, self.atlas, self.fog, band);
            i = i + 1;
        }
    }
}

/**
 * The frame conductor: composes the focused render components (texture atlas,
 * day/night lighting, world-face raster, bloom, mob box models, selection
 * wireframe) and drives one frame's passes. It holds no raster / lighting state
 * of its own beyond the projection half-width — every heavy job lives in a
 * component it delegates to.
 */
class Renderer {
    hw : f64,             // half the render width (horizontal projection centre);
                          // updated on resize so the aspect / FOV track the window
    atlas : TextureAtlas, // owns the atlas mip chain (setAtlas / atlasBase)
    day : DayLighting,    // owns the day/night colour + brightness cache
    world : ChunkRenderer,// the world-face raster (queue + tiled parallel fill)
    bloom : Bloom,   // soft-glow post-process (owns its half-res buffers + jobs)
    mobs : MobView,  // mob box-model renderer (owns its own projection scratch)
    sel : Selection, // targeted-block selection wireframe (owns its own scratch)

    /**
     * Build a Renderer: set the projection width from config and construct the
     * render components (each owns its own scratch / buffers).
     */
    constructor() {
        self.hw = Screen::HALF_W;
        self.atlas = new TextureAtlas();
        self.day = new DayLighting();
        self.world = new ChunkRenderer();
        self.bloom = new Bloom();
        self.mobs = new MobView();
        self.sel = new Selection();
    }

    /**
     * Set the atlas base pointer and (re)build its mip chain (delegated to the
     * texture atlas).
     * @param base  base address of the loaded atlas texels
     */
    pub(crate) fn setAtlas(mut self, base : i64) : void {
        self.atlas.setBase(base);
    }

    /**
     * Base pointer to the full-resolution atlas texels (mip level 0), for callers
     * that need raw tile texels (e.g. the HUD hotbar icons).
     * @return base address of the level-0 atlas texels
     */
    pub(crate) fn atlasBase(self) : i64 {
        return self.atlas.base();
    }

    /**
     * Match the projection to a framebuffer `renderW` wide. Height /
     * vertical FOV stay fixed (`Screen::FOCAL`, `Screen::HALF_H` are constant), so widening
     * the window widens the horizontal field of view instead of
     * stretching — the view stays to scale.
     * @param renderW  framebuffer width in pixels
     */
    pub(crate) fn setViewWidth(mut self, renderW : i32) : void {
        self.hw = (renderW as f64) * 0.5;
    }

    // ── World pass (clear → sky → world raster) ──

    /**
     * Draw one full world frame: refresh the day/night state, clear to the
     * sky/fog (or deep water when submerged), paint the atmospheric sky and
     * sun/moon, then hand the world-face raster the visible chunks to project +
     * light + clip + fill. Mobs, torches and post-fx are layered on by the caller
     * after this returns.
     * @param man        chunk manager holding the loaded chunks and baked faces
     * @param p          player providing the eye position and orientation
     * @param fb         the render target (framebuffer + z-buffer + size)
     * @param underwater true when the eye is submerged (clears to deep water,
     *                   skips the sky/celestial pass)
     * @param phase      animation time phase (scrolls flowing-water textures)
     * @param dayTime    time of day in [0, 1) driving sun angle and sky colour
     */
    pub(crate) fn render(mut self, man : ChunkManager, p : Player, fb : FrameBuf, underwater : bool, phase : f64, dayTime : f64) : void {
        // Refresh the sun direction, daylight factor and sky/fog colour, and keep
        // the value snapshot to hand to the sky draws (and the gradient thread).
        let ds : DayState = self.day.update(dayTime);
        // Underwater the cleared "void" becomes deep water instead of sky.
        let bg : i32 = Color::packBytes(ds.skyColR, ds.skyColG, ds.skyColB);
        if (underwater) {
            bg = Color::packBytes(Water::DEEP_R, Water::DEEP_G, Water::DEEP_B);
        }
        clearFrame(fb, bg);
        // Atmospheric sky gradient + warm sun halo over the cleared frame, then
        // the sun/moon discs ride on top — all behind the world (above water).
        if (!underwater) {
            drawSkyGradient(ds, p, fb, self.hw);
            drawCelestial(ds, p, fb, self.hw);
        }
        // One Camera carries the eye + look trig + projection width for every
        // face this frame; the world raster owns the rest of the pass.
        let cam : Camera = Camera { eye: p.eye, cosy: p.cosy, siny: p.siny, cosp: p.cosp, sinp: p.sinp, hw: self.hw };
        let fog : Rgb = Rgb { r: ds.skyColR, g: ds.skyColG, b: ds.skyColB };
        self.world.drawWorld(man, p, fb, cam, phase, self.atlas.mip(), fog, ds, self.day.curve());
    }

    // ── Post-processing (god-rays, bloom, underwater) ──

    /**
     * Volumetric god-rays (crepuscular shafts): a screen-space radial scatter
     * from the sun's projected position. Each pixel marches toward the sun and
     * sums the visible-sky mask (z-buffer cleared = sky) with per-step decay, so
     * terrain silhouettes carve warm bright shafts out of the sky glow. Additive,
     * warm-tinted, scaled by daylight. Skipped with the sun below the horizon or
     * behind the camera. Call after the opaque world + mobs + torches are drawn.
     * @param p   player (camera orientation)
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn godRays(self, p : Player, fb : FrameBuf) : void {
        let ds : DayState = self.day.state();
        if (!Render::GOD_RAYS_ON || ds.sunY < 0.02) {
            return;
        }
        // Project the sun direction to screen through the shared camera.
        let cam : Camera = Camera { eye: p.eye, cosy: p.cosy, siny: p.siny, cosp: p.cosp, sinp: p.sinp, hw: self.hw };
        let pr : Projected = cam.projectDir(vec3(ds.sunX, ds.sunY, ds.sunZ));
        if (pr.cz < 0.05) {
            return;   // sun behind the camera
        }
        // Overall exposure: fade in as the sun climbs, scale by daylight.
        let climb : f64 = ds.sunY * 4.0;
        if (climb > 1.0) {
            climb = 1.0;
        }
        let expo : f64 = Render::GOD_RAY_WEIGHT * ds.daylight * climb;
        if (expo <= 0.0) {
            return;
        }
        // The scatter is a PostEffect over the finished frame.
        let fx : GodRayFX = new GodRayFX(SunScreen { sunSx: pr.sx, sunSy: pr.sy, expo: expo });
        fx.apply(fb);
    }

    /**
     * Bloom: bright pixels (luminance above `Render::BLOOM_THRESHOLD`) bleed a soft glow.
     * Extracted and averaged into a half-resolution buffer, blurred separably a
     * few times, then added back over the full frame — so the sun, halo,
     * god-rays, water glints and snow get a warm honeyed glow. Midtones below the
     * threshold are untouched. Call after the sky/world/god-rays, before the HUD.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn bloomPass(self, fb : FrameBuf) : void {
        self.bloom.apply(fb);
    }

    /**
     * Procedural underwater post-pass: fog every pixel toward the water colour
     * by its real depth (read from the z-buffer) and add a moving caustic light
     * pattern, so being submerged feels like a living volume rather than a flat
     * tint. Call after the world + mobs are drawn, while the eye is underwater.
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param phase  time phase that animates the caustics
     */
    pub(crate) fn underwaterOverlay(self, fb : FrameBuf, phase : f64) : void {
        let fx : UnderwaterFX = new UnderwaterFX(phase);
        fx.apply(fb);
    }

    // ── Torches (thin upright posts, drawn via the mob quad path) ──

    /**
     * Draw every loaded/visible chunk's torches as thin upright posts (4 side
     * quads + a top), reusing the oriented-quad path. Torch voxels emit no cube
     * faces in the mesh; they are collected per slot and drawn here.
     * @param man  chunk manager holding the per-slot torch lists
     * @param p    player providing the eye position and orientation
     * @param fb   the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn renderTorches(self, man : ChunkManager, p : Player, fb : FrameBuf) : void {
        let hw : f64 = 0.09;
        let ht : f64 = 0.55;
        let mat : Material = Material { color: Color::packBytes(240, 180, 70), tile: Tile::TORCH, hurt: false };
        let scene : MobScene = self.mobScene();
        let slots : i32 = World::SPAN * World::SPAN;
        let slot : i32 = 0;
        while (slot < slots) {
            if (man.cols.loaded[slot] == 1 && chunkVisible(p, man.cols.cxs[slot], man.cols.czs[slot])) {
                let base : i32 = slot * World::MAX_TORCHES_PER_CHUNK;
                let n : i32 = man.torches.tcount[slot];
                let ti : i32 = 0;
                while (ti < n) {
                    let cx : f64 = (man.torches.tx[base + ti] as f64) + 0.5;
                    let cz : f64 = (man.torches.tz[base + ti] as f64) + 0.5;
                    let x0 : f64 = cx - hw;
                    let x1 : f64 = cx + hw;
                    let z0 : f64 = cz - hw;
                    let z1 : f64 = cz + hw;
                    let y0 : f64 = man.torches.ty[base + ti] as f64;
                    let y1 : f64 = y0 + ht;
                    self.mobs.drawQuad(p, fb, vec3(x1, y0, z1), vec3(x1, y0, z0), vec3(x1, y1, z0), vec3(x1, y1, z1), vec3(1.0, 0.0, 0.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x0, y0, z0), vec3(x0, y0, z1), vec3(x0, y1, z1), vec3(x0, y1, z0), vec3(0.0 - 1.0, 0.0, 0.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x0, y0, z1), vec3(x1, y0, z1), vec3(x1, y1, z1), vec3(x0, y1, z1), vec3(0.0, 0.0, 1.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x1, y0, z0), vec3(x0, y0, z0), vec3(x0, y1, z0), vec3(x1, y1, z0), vec3(0.0, 0.0, 0.0 - 1.0), mat, scene);
                    self.mobs.drawQuad(p, fb, vec3(x0, y1, z0), vec3(x1, y1, z0), vec3(x1, y1, z1), vec3(x0, y1, z1), vec3(0.0, 1.0, 0.0), mat, scene);
                    ti = ti + 1;
                }
            }
            slot = slot + 1;
        }
    }

    /**
     * Build this frame's mob/torch scene: the atlas mip chain, the distance-fog
     * colour and the day/night state (from the render components) plus the
     * projection half-width. Handed to the MobView draws each frame.
     * @return the per-frame mob scene context
     */
    fn mobScene(self) : MobScene {
        let ds : DayState = self.day.state();
        return MobScene {
            atlas: self.atlas.mip(),
            fog: Rgb { r: ds.skyColR, g: ds.skyColG, b: ds.skyColB },
            ds: ds,
            hw: self.hw,
        };
    }

    // ── Mobs (oriented-box models, drawn by gfx/mobview.axle) ──

    /**
     * Draw every mob of every species through the MobView, sharing the world's
     * z-buffer (so terrain correctly occludes animals behind it).
     * @param man  chunk manager (light maps, for per-mob ambient light)
     * @param mm   mob manager holding the per-species arrays
     * @param p    player providing the eye position and orientation
     * @param fb   the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn renderMobs(self, man : ChunkManager, mm : MobManager, p : Player, fb : FrameBuf) : void {
        self.mobs.drawAll(man, mm, p, fb, self.mobScene(), self.day.curve());
    }

    /**
     * Draw the centre-screen crosshair.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn crosshair(self, fb : FrameBuf) : void {
        let pixels : i64 = fb.pixels;
        let w : i32 = fb.w;
        let h : i32 = fb.h;
        let cx : i32 = w / 2;
        let cy : i32 = h / 2;
        let white : i32 = Color::packBytes(255, 255, 255);
        let i : i32 = 0 - 6;
        while (i <= 6) {
            Mem::putWordOf(pixels, cy * w + cx + i, white);
            Mem::putWordOf(pixels, (cy + i) * w + cx, white);
            i = i + 1;
        }
    }

    // ── Selection wireframe (drawn by gfx/selection.axle) ──

    /**
     * Draw the soft, depth-tested selection outline on the targeted block via
     * the owned Selection helper.
     * @param p     player providing the eye position and orientation
     * @param fb    the render target (framebuffer + z-buffer + size)
     * @param bx    targeted block x
     * @param by    targeted block y
     * @param bz    targeted block z
     * @param topH  the block's real box height (1.0 full, snowDepth for a thin
     *              snow layer) so the outline hugs the true box, not a cube
     */
    pub(crate) fn drawSelection(self, p : Player, fb : FrameBuf, bx : i32, by : i32, bz : i32, topH : f64) : void {
        self.sel.draw(p, fb, self.hw, bx, by, bz, topH);
    }
}

/**
 * March one screen pixel toward the sun, summing the visible-sky mask (z-buffer
 * cleared → sky) with per-step decay. The god-ray kernel, pulled out of
 * GodRayFX.rows so that loop stays shallow.
 * @param zbuf  depth buffer (≤ 0 where sky)
 * @param w     framebuffer width
 * @param h     framebuffer height
 * @param x     pixel x
 * @param y     pixel y
 * @param sun   the sun's screen position + exposure
 * @return the accumulated sky illumination (pre-exposure)
 */
fn godRayIllum(zbuf : i64, w : i32, h : i32, x : i32, y : i32, sun : SunScreen) : f64 {
    let n : i32 = Render::GOD_RAY_SAMPLES;
    let invN : f64 = 1.0 / (n as f64);
    let stepx : f64 = (sun.sunSx - (x as f64)) * invN * Render::GOD_RAY_DENSITY;
    let stepy : f64 = (sun.sunSy - (y as f64)) * invN * Render::GOD_RAY_DENSITY;
    let sxp : f64 = x as f64;
    let syp : f64 = y as f64;
    let illum : f64 = 0.0;
    let dec : f64 = 1.0;
    let i : i32 = 0;
    while (i < n) {
        sxp = sxp + stepx;
        syp = syp + stepy;
        let ix : i32 = sxp.floorToInt() as i32;
        let iy : i32 = syp.floorToInt() as i32;
        if (ix >= 0 && ix < w && iy >= 0 && iy < h && Mem::realOf(zbuf, (iy * w + ix) as i64) <= 0.0) {
            illum = illum + dec;   // a sky sample contributes
        }
        dec = dec * Render::GOD_RAY_DECAY;
        i = i + 1;
    }
    return illum;
}

/**
 * Worker job: god-rays for one horizontal row band, run on its own thread by
 * GodRayFX.apply (spawn → join). A thin wrapper so `spawn` calls a free
 * function (the effect is passed by value).
 * @return 0 (Task result unused)
 */
fn godRaysJob(fx : GodRayFX, fb : FrameBuf, y0 : i32, y1 : i32) : i32 {
    fx.rows(fb, y0, y1);
    return 0;
}

/** Worker job: rasterise the world triangle queue into one column band. */
fn rasterTilesJob(r : ChunkRenderer, fb : FrameBuf, bx0 : i32, bx1 : i32) : i32 {
    r.rasterizeBand(fb, bx0, bx1);
    return 0;
}
