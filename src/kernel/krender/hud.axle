// hud — composes the on-screen overlay: the hotbar along the bottom and
// the heart row just above it (Minecraft layout, left-aligned with the
// hotbar). Drawn straight into the framebuffer after the world and mobs.
// Stateless: reads hp + the hotbar and paints pixels.

use crate::kernel::krender::hotbar::{drawHotbar, hotbarPanelW, hotbarPanelH};
use crate::configs::blocks::{ Block };
use crate::kernel::krender::color::{Widget};
use smalt::{Frame};
use crate::kernel::krender::health::{drawHealth, healthHeight};

/**
 * The inventory bar as a Widget: its panel origin, the atlas supplying tile
 * icons, the slot block ids and the active index. `draw` delegates to the
 * stateless `drawHotbar` primitive.
 */
struct HotbarBar : Widget {
    x0 : i32,
    y0 : i32,
    atlas : i64,
    hotbar : Block[],
    selected : i32,

    /** Paint the hotbar panel + slots. */
    fn draw(self, f : Frame) : void {
        drawHotbar(f, self.x0, self.y0, self.atlas, self.hotbar, self.selected);
    }
}

/**
 * The heart row as a Widget: its origin plus the current / maximum health.
 * `draw` delegates to the stateless `drawHealth` primitive.
 */
struct HeartRow : Widget {
    x0 : i32,
    y0 : i32,
    hp : i32,
    maxHp : i32,

    /** Paint the heart row. */
    fn draw(self, f : Frame) : void {
        drawHealth(f, self.x0, self.y0, self.hp, self.maxHp);
    }
}

/**
 * Draw the full HUD overlay by composing its widgets. `atlas` supplies the
 * hotbar item textures. The body lays out a set of `Widget`s and draws each.
 * @param f         the frame to draw into.
 * @param atlas     atlas supplying the hotbar item textures.
 * @param hp        current health.
 * @param maxHp     maximum health.
 * @param hotbar    hotbar slot block ids.
 * @param selected  index of the active hotbar slot.
 */
fn drawHud(f : Frame, atlas : i64, hp : i32, maxHp : i32, hotbar : Block[], selected : i32) : void {
    let pw : i32 = hotbarPanelW();
    let ph : i32 = hotbarPanelH();
    let hx : i32 = (f.w - pw) / 2;
    let hy : i32 = f.h - 8 - ph;

    let bar : HotbarBar = HotbarBar { x0: hx, y0: hy, atlas: atlas, hotbar: hotbar, selected: selected };
    let hearts : HeartRow = HeartRow { x0: hx, y0: hy - healthHeight() - 6, hp: hp, maxHp: maxHp };

    bar.draw(f);
    hearts.draw(f);
}
