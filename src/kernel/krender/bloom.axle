// bloom — the soft-glow post-process, split out of Renderer.
//
// A self-contained LEAF mini-manager: it owns its six half-resolution scratch
// buffers and reads/writes only the framebuffer pixels — no day-state, no
// projection scratch, no atlas. It depends only on `smalt` + `configs`,
// so `render.axle` composes a Bloom one-way with NO import cycle.
//
// Pipeline: bright-extract + downsample to half-res (luma above `Render::BLOOM_THRESHOLD`,
// soft-knee), separable box blur (`Render::BLOOM_ITERS` passes, ping-ponging bl* ↔ bt*),
// then composite the upsampled glow back over the full frame. The extract and
// composite passes each split into two disjoint row bands run on two threads;
// the blur is single-threaded.

use smalt::Mem;
use crate::configs::screen::{ Screen };
use crate::kernel::krender::raster::{ FrameBuf, PostEffect };
use crate::configs::render::{ Render };

class Bloom : PostEffect {
    blR : i64, // half-res bright buffers (R/G/B) + blur ping-pong target
    blG : i64,
    blB : i64,
    btR : i64, // blur scratch (R/G/B)
    btG : i64,
    btB : i64,
    cap : i64, // half-resolution pixels each buffer currently holds

    /**
     * Start with room for the configured frame; `fit` grows it if the
     * frame ever does.
     *
     * The capacity used to be the literal `640 * 200`, which is neither
     * the frame size nor derived from it — it happened to be twice what
     * a 640x400 frame needs at half resolution, and exactly what the
     * main loop's 1280-wide clamp needs at that same height. Change the
     * render HEIGHT and it is a segmentation fault, which is what
     * raising the resolution to 960x600 found.
     */
    constructor() {
        self.cap = 0;
        self.blR = 0;
        self.blG = 0;
        self.blB = 0;
        self.btR = 0;
        self.btG = 0;
        self.btB = 0;
        self.fit(halfCount(Screen::RENDER_W, Screen::RENDER_H));
    }

    /**
     * Make sure the six buffers hold `want` half-resolution pixels each.
     *
     * Grows and never shrinks: a frame that got smaller will get bigger
     * again when the window is dragged back, and a realloc per resize
     * step is a stutter for nothing.
     * @param want  half-resolution pixels the pass is about to touch
     */
    pub(file) fn fit(mut self, want : i64) : void {
        if (want <= self.cap) {
            return;
        }
        Mem::release(self.blR);
        Mem::release(self.blG);
        Mem::release(self.blB);
        Mem::release(self.btR);
        Mem::release(self.btG);
        Mem::release(self.btB);
        self.cap = want;
        self.blR = Mem::take(want * 8);
        self.blG = Mem::take(want * 8);
        self.blB = Mem::take(want * 8);
        self.btR = Mem::take(want * 8);
        self.btG = Mem::take(want * 8);
        self.btB = Mem::take(want * 8);
    }

    /**
     * PostEffect entry point: bloom the finished frame (reads/writes only its
     * colour buffer). Delegates to `run` with the framebuffer's dimensions.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    fn apply(mut self, fb : FrameBuf) : void {
        self.run(fb.pixels, fb.w, fb.h);
    }

    /**
     * Run the full bloom pass over the frame: bright pixels (luminance above
     * `Render::BLOOM_THRESHOLD`) bleed a soft warm glow. Midtones are untouched. Call
     * after the sky/world/god-rays, before the HUD.
     * @param pixels  framebuffer base
     * @param w       framebuffer width
     * @param h       framebuffer height
     */
    fn run(self, pixels : i64, w : i32, h : i32) : void {
        if (!Render::BLOOM_ON) {
            return;
        }
        let dw : i32 = (w + 1) / 2;
        let dh : i32 = (h + 1) / 2;
        self.fit(halfCount(w, h));
        // 1) Bright extraction + downsample — two threads (disjoint output rows).
        let halfD : i32 = dh / 2;
        let te : Task<i32> = spawn bloomExtractJob(self, pixels, w, h, dw, dh, 0, halfD);
        self.extractRows(pixels, w, h, dw, dh, halfD, dh);
        let de : i32 = te.join();
        // 2) Separable box blur (`Render::BLOOM_ITERS` passes: horizontal then vertical).
        let rad : i32 = Render::BLOOM_RADIUS;
        let invK : f64 = 1.0 / ((2 * rad + 1) as f64);
        let it : i32 = 0;
        while (it < Render::BLOOM_ITERS) {
            // Horizontal blR -> btR.
            let y : i32 = 0;
            while (y < dh) {
                let rb : i32 = y * dw;
                let x : i32 = 0;
                while (x < dw) {
                    let sr : f64 = 0.0;
                    let sg : f64 = 0.0;
                    let sb : f64 = 0.0;
                    let k : i32 = 0 - rad;
                    while (k <= rad) {
                        let xx : i32 = x + k;
                        if (xx < 0) {
                            xx = 0;
                        }
                        if (xx > dw - 1) {
                            xx = dw - 1;
                        }
                        sr = sr + Mem::realOf(self.blR, rb + xx);
                        sg = sg + Mem::realOf(self.blG, rb + xx);
                        sb = sb + Mem::realOf(self.blB, rb + xx);
                        k = k + 1;
                    }
                    Mem::putRealOf(self.btR, rb + x, sr * invK);
                    Mem::putRealOf(self.btG, rb + x, sg * invK);
                    Mem::putRealOf(self.btB, rb + x, sb * invK);
                    x = x + 1;
                }
                y = y + 1;
            }
            // Vertical btR -> blR.
            let x2 : i32 = 0;
            while (x2 < dw) {
                let y2 : i32 = 0;
                while (y2 < dh) {
                    let sr : f64 = 0.0;
                    let sg : f64 = 0.0;
                    let sb : f64 = 0.0;
                    let k : i32 = 0 - rad;
                    while (k <= rad) {
                        let yy : i32 = y2 + k;
                        if (yy < 0) {
                            yy = 0;
                        }
                        if (yy > dh - 1) {
                            yy = dh - 1;
                        }
                        sr = sr + Mem::realOf(self.btR, yy * dw + x2);
                        sg = sg + Mem::realOf(self.btG, yy * dw + x2);
                        sb = sb + Mem::realOf(self.btB, yy * dw + x2);
                        k = k + 1;
                    }
                    Mem::putRealOf(self.blR, y2 * dw + x2, sr * invK);
                    Mem::putRealOf(self.blG, y2 * dw + x2, sg * invK);
                    Mem::putRealOf(self.blB, y2 * dw + x2, sb * invK);
                    y2 = y2 + 1;
                }
                x2 = x2 + 1;
            }
            it = it + 1;
        }
        // 3) Composite the upsampled glow over the full frame — two threads.
        let st : f64 = Render::BLOOM_STRENGTH;
        let halfH : i32 = h / 2;
        let tc : Task<i32> = spawn bloomCompositeJob(self, pixels, w, h, dw, st, 0, halfH);
        self.compositeRows(pixels, w, h, dw, st, halfH, h);
        let dc : i32 = tc.join();
    }

    /**
     * Bright-extraction + 2×2 downsample into the half-res bright buffers, for
     * half-res rows [dy0, dy1).
     * @param pixels  framebuffer base
     * @param w       framebuffer width
     * @param h       framebuffer height
     * @param dw      half-res width
     * @param dh      half-res height
     * @param dy0     first half-res row (inclusive)
     * @param dy1     last half-res row (exclusive)
     */
    pub(file) fn extractRows(self, pixels : i64, w : i32, h : i32, dw : i32, dh : i32, dy0 : i32, dy1 : i32) : void {
        let thr : f64 = Render::BLOOM_THRESHOLD;
        let dy : i32 = dy0;
        while (dy < dy1) {
            let sy0 : i32 = dy * 2;
            let dx : i32 = 0;
            while (dx < dw) {
                let sx0 : i32 = dx * 2;
                let ar : f64 = 0.0;
                let ag : f64 = 0.0;
                let ab : f64 = 0.0;
                let jy : i32 = 0;
                while (jy < 2) {
                    let yy : i32 = sy0 + jy;
                    if (yy < h) {
                        let jx : i32 = 0;
                        while (jx < 2) {
                            let xx : i32 = sx0 + jx;
                            if (xx < w) {
                                let c : i32 = Mem::dwordAt(pixels, ((yy * w + xx) as i64) * 4);
                                let r : f64 = ((c >> 16) & 0xFF) as f64;
                                let g : f64 = ((c >> 8) & 0xFF) as f64;
                                let b : f64 = (c & 0xFF) as f64;
                                let lum : f64 = 0.299 * r + 0.587 * g + 0.114 * b;
                                if (lum > thr) {
                                    let f : f64 = (lum - thr) / lum;
                                    ar = ar + r * f;
                                    ag = ag + g * f;
                                    ab = ab + b * f;
                                }
                            }
                            jx = jx + 1;
                        }
                    }
                    jy = jy + 1;
                }
                let di : i32 = dy * dw + dx;
                Mem::putRealOf(self.blR, di, ar * 0.25);
                Mem::putRealOf(self.blG, di, ag * 0.25);
                Mem::putRealOf(self.blB, di, ab * 0.25);
                dx = dx + 1;
            }
            dy = dy + 1;
        }
    }

    /**
     * Composite (add the upsampled glow back) for full-res rows [y0, y1).
     * @param pixels  framebuffer base
     * @param w       framebuffer width
     * @param h       framebuffer height
     * @param dw      half-res width
     * @param st      bloom strength multiplier
     * @param y0      first row (inclusive)
     * @param y1      last row (exclusive)
     */
    pub(file) fn compositeRows(self, pixels : i64, w : i32, h : i32, dw : i32, st : f64, y0 : i32, y1 : i32) : void {
        let py : i32 = y0;
        while (py < y1) {
            let row : i32 = py * w;
            let drow : i32 = (py / 2) * dw;
            let px : i32 = 0;
            while (px < w) {
                let di : i32 = drow + px / 2;
                let addr : f64 = Mem::realOf(self.blR, di) * st;
                let addg : f64 = Mem::realOf(self.blG, di) * st;
                let addb : f64 = Mem::realOf(self.blB, di) * st;
                if (addr > 0.5 || addg > 0.5 || addb > 0.5) {
                    let c : i32 = Mem::dwordAt(pixels, (row + px) as i64 * 4);
                    let r : i32 = ((c >> 16) & 0xFF) + (addr.floorToInt() as i32);
                    let g : i32 = ((c >> 8) & 0xFF) + (addg.floorToInt() as i32);
                    let b : i32 = (c & 0xFF) + (addb.floorToInt() as i32);
                    if (r > 255) {
                        r = 255;
                    }
                    if (g > 255) {
                        g = 255;
                    }
                    if (b > 255) {
                        b = 255;
                    }
                    Mem::putWordOf(pixels, row + px, (r & 0xFF) * 65536 + (g & 0xFF) * 256 + (b & 0xFF));
                }
                px = px + 1;
            }
            py = py + 1;
        }
    }
}

/**
 * Worker job: bloom bright-extraction for one half-res row band.
 * @param b       the bloom mini-manager
 * @param pixels  framebuffer base
 * @param w       framebuffer width
 * @param h       framebuffer height
 * @param dw      half-res width
 * @param dh      half-res height
 * @param dy0     first half-res row (inclusive)
 * @param dy1     last half-res row (exclusive)
 * @return 0
 */
fn bloomExtractJob(b : Bloom, pixels : i64, w : i32, h : i32, dw : i32, dh : i32, dy0 : i32, dy1 : i32) : i32 {
    b.extractRows(pixels, w, h, dw, dh, dy0, dy1);
    return 0;
}

/**
 * Worker job: bloom composite for one full-res row band.
 * @param b       the bloom mini-manager
 * @param pixels  framebuffer base
 * @param w       framebuffer width
 * @param h       framebuffer height
 * @param dw      half-res width
 * @param st      bloom strength multiplier
 * @param y0      first row (inclusive)
 * @param y1      last row (exclusive)
 * @return 0
 */
fn bloomCompositeJob(b : Bloom, pixels : i64, w : i32, h : i32, dw : i32, st : f64, y0 : i32, y1 : i32) : i32 {
    b.compositeRows(pixels, w, h, dw, st, y0, y1);
    return 0;
}

/**
 * Half-resolution pixels a `w` by `h` frame needs.
 *
 * One expression, so the allocation and the pass that fills it cannot
 * round the halving differently — which is the shape of an overflow that
 * only shows at an odd width.
 * @param w  frame width
 * @param h  frame height
 * @return the half-resolution pixel count
 */
fn halfCount(w : i32, h : i32) : i64 {
    return (((w + 1) / 2) as i64) * (((h + 1) / 2) as i64);
}
