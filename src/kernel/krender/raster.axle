// raster — software triangle rasteriser into the ARGB framebuffer with a
// per-pixel inverse-depth z-buffer (32-bit floats: a depth is compared, not accumulated). Half-plane (edge-function) inside
// test; depth is the barycentric blend of vertex inverse depths, nearest
// wins. Winding-agnostic (the area's sign flows through the weights).
//
// It fills pixels. It does not decide how bright they are: the radiometry that
// used to live here — the sun/sky split, the hemisphere term, the exposure — is
// `klight::facelight`'s, and this file reads the answer rather than forming it.
// A rasteriser that also owned the ambient was a rasteriser nothing else could
// ask about light without importing the triangle filler.

use smalt::Mem;
use smalt::Color;
use crate::kernel::kmath::mathx::clampI32;
use crate::kernel::kmath::vec3::{ Vec3 };
use crate::kernel::kmath::narrow::{ floatOf, putFloatOf, FLOAT_BYTES };
use crate::kernel::klight::gamma::{ Gamma, LinRgb, linearToSrgb };
use crate::kernel::ksky::atmosphere::{ FogTable, SkyColour };
use crate::configs::atlas::{ Atlas };
use crate::configs::screen::{ Screen };

/**
 * The render target bundle: framebuffer + z-buffer base pointers and the frame
 * size. A value-type struct passed in place of the four loose `pixels, zbuf, w,
 * h` arguments that every render/raster routine used to take.
 */
struct FrameBuf {
    pub(crate) pixels : i64,
    pub(crate) zbuf : i64,
    pub(crate) w : i32,
    pub(crate) h : i32,
}

/**
 * A projected point: screen position (sx, sy), inverse depth (iz, = 1/depth)
 * and the raw camera-space depth (cz) callers near-plane test against. The one
 * result shape every projection returns, so the yaw/pitch/focal transform lives
 * in a single place (Camera) instead of being re-derived per pass.
 */
struct Projected {
    pub(crate) sx : f64,
    pub(crate) sy : f64,
    pub(crate) iz : f64,
    pub(crate) cz : f64,
}

/**
 * The camera transform capability: world → camera space, camera space → screen,
 * and the two composed forms (a finite world point, and an infinitely-far
 * direction for sky bodies). Unifies the yaw/pitch/focal projection that the
 * world faces, mobs, the selection box and the sky discs each used to open-code.
 */
trait Projector {
    fn toCamera(self, world : Vec3) : Vec3;
    fn screenOf(self, cam : Vec3) : Projected;
    fn project(self, world : Vec3) : Projected;
    fn projectDir(self, dir : Vec3) : Projected;
}

/**
 * The lens the frame is drawn through: where the projection centre sits on the
 * framebuffer, and how many pixels away the film is.
 *
 * All three follow the framebuffer, which is why they travel together and are
 * not constants. `focal` is derived once per resize from a fixed VERTICAL field
 * of view (`Screen::FOV_V_DEG`), so the world keeps its scale at any resolution
 * and the horizontal angle widens with the window instead of the image being
 * magnified — which is what a fixed focal length in pixels does.
 */
struct Lens {
    pub(crate) hw : f64,     // horizontal projection centre = renderW / 2
    pub(crate) hh : f64,     // vertical projection centre   = renderH / 2
    pub(crate) focal : f64,  // pixels per world unit at unit depth
}

/**
 * The lens for a framebuffer of this size, at the configured vertical FOV.
 * @param renderW  framebuffer width in pixels
 * @param renderH  framebuffer height in pixels
 * @return the projection centre and focal length to draw it with
 */
fn lensFor(renderW : i32, renderH : i32) : Lens {
    let hh : f64 = (renderH as f64) * 0.5;
    let half : f64 = Screen::FOV_V_DEG * 0.5 * 3.14159265358979 / 180.0;
    let t : f64 = half.tan();
    if (t < 0.0001) {
        t = 0.0001;
    }
    return Lens { hw: (renderW as f64) * 0.5, hh: hh, focal: hh / t };
}

/** The framebuffer size one frame is rasterised at. */
struct Viewport {
    pub(crate) w : i32,
    pub(crate) h : i32,
}

/**
 * The framebuffer to draw a window of this size into: the window's own shape,
 * scaled down only as far as `Screen::MAX_RENDER_PIXELS` demands.
 *
 * It never scales UP, so the blit only ever shrinks an image and a small window
 * costs what it looks like. What it does not do any more is pin the height:
 * that is what turned fullscreen into a zoom, since the same rows were simply
 * spread over a larger screen.
 * @param winW  the window's width in pixels
 * @param winH  the window's height in pixels
 * @return the framebuffer size to render at
 */
fn viewportFor(winW : i32, winH : i32) : Viewport {
    let w : i32 = winW;
    let h : i32 = winH;
    let px : i64 = (w as i64) * (h as i64);
    let cap : i64 = Screen::MAX_RENDER_PIXELS as i64;
    if (px > cap) {
        let k : f64 = ((cap as f64) / (px as f64)).sqrt();
        w = ((w as f64) * k).floorToInt() as i32;
        h = ((h as f64) * k).floorToInt() as i32;
    }
    if (w < Screen::MIN_RENDER_W) {
        w = Screen::MIN_RENDER_W;
    }
    if (h < Screen::MIN_RENDER_H) {
        h = Screen::MIN_RENDER_H;
    }
    return Viewport { w: w, h: h };
}

/**
 * The one camera: eye position, cached look trig (yaw cos/sin, pitch cos/sin)
 * and the lens. A value struct built per frame from the Player; every render
 * pass projects through it so there is a single copy of the transform.
 */
struct Camera : Projector {
    pub(crate) eye : Vec3,
    cosy : f64,
    siny : f64,
    cosp : f64,
    sinp : f64,
    lens : Lens,

    /**
     * Rotate a world point into camera space (post yaw + pitch): x = right,
     * y = up, z = forward depth. No perspective divide (near-clip happens on
     * the camera-space polygon first).
     * @param world  the world-space point
     * @return the camera-space point (x, y, depth)
     */
    pub(crate) fn toCamera(self, world : Vec3) : Vec3 {
        let dx : f64 = world.x - self.eye.x;
        let dy : f64 = world.y - self.eye.y;
        let dz : f64 = world.z - self.eye.z;
        let rx : f64 = dx * self.cosy + dz * self.siny;
        let rz : f64 = (0.0 - dx) * self.siny + dz * self.cosy;
        return Vec3 { x: rx, y: dy * self.cosp - rz * self.sinp, z: dy * self.sinp + rz * self.cosp };
    }

    /**
     * Perspective-divide a camera-space point to screen + inverse depth. Callers
     * that clipped in camera space feed the surviving vertices back through here.
     * @param cam  the camera-space point (x, y, depth)
     * @return the projected screen point
     */
    pub(crate) fn screenOf(self, cam : Vec3) : Projected {
        return Projected {
            sx: self.lens.hw + self.lens.focal * cam.x / cam.z,
            sy: self.lens.hh - self.lens.focal * cam.y / cam.z,
            iz: 1.0 / cam.z,
            cz: cam.z,
        };
    }

    /**
     * Full projection of a finite world point (rotate + divide). The result's
     * `cz` lets the caller apply its own near-plane rule.
     * @param world  the world-space point
     * @return the projected screen point
     */
    pub(crate) fn project(self, world : Vec3) : Projected {
        return self.screenOf(self.toCamera(world));
    }

    /**
     * Project a direction at infinity (a sky body / the sun): rotate only, no
     * eye translation. `cz` < a small epsilon means it is behind the camera.
     * @param dir  the sky direction (need not be unit)
     * @return the projected screen point
     */
    pub(crate) fn projectDir(self, dir : Vec3) : Projected {
        let rx : f64 = dir.x * self.cosy + dir.z * self.siny;
        let rz : f64 = (0.0 - dir.x) * self.siny + dir.z * self.cosy;
        let ry2 : f64 = dir.y * self.cosp - rz * self.sinp;
        let rz2 : f64 = dir.y * self.sinp + rz * self.cosp;
        return Projected {
            sx: self.lens.hw + self.lens.focal * rx / rz2,
            sy: self.lens.hh - self.lens.focal * ry2 / rz2,
            iz: 1.0 / rz2,
            cz: rz2,
        };
    }
}

/**
 * A full-frame post-process capability: consume the finished framebuffer (colour
 * + depth) and blend an effect over it in place. Bloom, the volumetric god-rays
 * and the underwater overlay each implement it, so the frame's post-chain is a
 * set of uniform `PostEffect` steps rather than ad-hoc methods.
 */
trait PostEffect {
    fn apply(mut self, fb : FrameBuf) : void;
}

/**
 * Lesser of two f64 values.
 * @param a  first value.
 * @param b  second value.
 * @return the smaller of `a` and `b`.
 */
fn minf(a : f64, b : f64) : f64 {
    if (a < b) {
        return a;
    }
    return b;
}

/**
 * Greater of two f64 values.
 * @param a  first value.
 * @param b  second value.
 * @return the larger of `a` and `b`.
 */
fn maxf(a : f64, b : f64) : f64 {
    if (a > b) {
        return a;
    }
    return b;
}

/**
 * Edge function: signed area of the triangle (a, b, p).
 * @param ax  first vertex x.
 * @param ay  first vertex y.
 * @param bx  second vertex x.
 * @param by  second vertex y.
 * @param px  test point x.
 * @param py  test point y.
 * @return the signed area.
 */
fn edge(ax : f64, ay : f64, bx : f64, by : f64, px : f64, py : f64) : f64 {
    return (px - ax) * (by - ay) - (py - ay) * (bx - ax);
}

/**
 * Fill the frame with `bg` and reset the z-buffer.
 * @param fb  the render target (framebuffer + z-buffer + size).
 * @param bg  background colour.
 */
fn clearFrame(fb : FrameBuf, bg : i32) : void {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let n : i32 = fb.w * fb.h;
    let i : i32 = 0;
    while (i < n) {
        Mem::putWordOf(pixels, i, bg);
        putFloatOf(zbuf, i, 0.0);
        i = i + 1;
    }
}

/**
 * Average one channel across four texels (a 2×2 box, for mip downscaling),
 * IN LINEAR LIGHT: the four bytes are decoded, averaged as light, and encoded
 * back. Averaging the bytes themselves darkens every level of the chain,
 * because the midpoint of two sRGB codes is far below the midpoint of the
 * light they stand for.
 * @param gam    the colour space to decode / encode through.
 * @param a      first texel.
 * @param b      second texel.
 * @param c      third texel.
 * @param d      fourth texel.
 * @param shift  the channel's bit shift.
 * @return the averaged channel value in 0..255.
 */
fn avg4(gam : Gamma, a : i32, b : i32, c : i32, d : i32, shift : i32) : i32 {
    let sum : f64 = gam.decode(a, shift) + gam.decode(b, shift) + gam.decode(c, shift) + gam.decode(d, shift);
    return (linearToSrgb(sum * 0.25) * 255.0 + 0.5).floorToInt() as i32;
}

/**
 * Texel offset where mip `level` starts in the mip chain (level 0 is the
 * full-resolution atlas; each level halves the tile size).
 * @param level  the mip level.
 * @return the starting texel offset.
 */
fn mipLevelOffset(level : i32) : i32 {
    let off : i32 = 0;
    let sz : i32 = Atlas::TILE_PX;
    let l : i32 = 0;
    while (l < level) {
        off = off + Atlas::TILE_COUNT * sz * sz;
        sz = sz / 2;
        l = l + 1;
    }
    return off;
}

/**
 * Tile side length (texels) at mip `level`.
 * @param level  the mip level.
 * @return the tile side length in texels.
 */
fn mipLevelSize(level : i32) : i32 {
    let sz : i32 = Atlas::TILE_PX;
    let l : i32 = 0;
    while (l < level) {
        sz = sz / 2;
        l = l + 1;
    }
    return sz;
}

/**
 * Total texel count of the whole mip chain (for allocation).
 * @return the total texel count.
 */
fn mipChainTexels() : i32 {
    return mipLevelOffset(Atlas::MIP_LEVELS);
}

/**
 * Build the mip chain into `mips` from the level-0 `atlas`: level 0 is a
 * copy, each finer level a 2×2 box-filtered downsample of the previous.
 * Pre-averaging the texels is what stops distant textures from shimmering
 * as the camera moves (Minecraft-style mipmapping). The downsample averages
 * LINEAR light, so a shrinking texture keeps its brightness instead of sinking
 * a little darker at every level.
 * @param atlas  the level-0 texture atlas.
 * @param mips   the destination mip chain buffer.
 * @param gam    the colour space the box filter averages through.
 */
fn buildMipChain(atlas : i64, mips : i64, gam : Gamma) : void {
    let n0 : i32 = Atlas::TILE_COUNT * Atlas::TILE_PX * Atlas::TILE_PX;
    let i : i32 = 0;
    while (i < n0) {
        Mem::putWordOf(mips, i, Mem::dwordAt(atlas, (i as i64) * 4));
        i = i + 1;
    }
    let level : i32 = 1;
    let sz : i32 = Atlas::TILE_PX / 2;
    let psz : i32 = Atlas::TILE_PX;
    while (level < Atlas::MIP_LEVELS) {
        let base : i32 = mipLevelOffset(level);
        let pbase : i32 = mipLevelOffset(level - 1);
        let t : i32 = 0;
        while (t < Atlas::TILE_COUNT) {
            let ty : i32 = 0;
            while (ty < sz) {
                let tx : i32 = 0;
                while (tx < sz) {
                    let i00 : i32 = pbase + (t * psz + ty * 2) * psz + tx * 2;
                    let i01 : i32 = i00 + 1;
                    let i10 : i32 = pbase + (t * psz + ty * 2 + 1) * psz + tx * 2;
                    let i11 : i32 = i10 + 1;
                    let c00 : i32 = Mem::dwordAt(mips, (i00 as i64) * 4);
                    let c01 : i32 = Mem::dwordAt(mips, (i01 as i64) * 4);
                    let c10 : i32 = Mem::dwordAt(mips, (i10 as i64) * 4);
                    let c11 : i32 = Mem::dwordAt(mips, (i11 as i64) * 4);
                    let rr : i32 = avg4(gam, c00, c01, c10, c11, 16);
                    let gg : i32 = avg4(gam, c00, c01, c10, c11, 8);
                    let bb : i32 = avg4(gam, c00, c01, c10, c11, 0);
                    Mem::putWordOf(mips, base + (t * sz + ty) * sz + tx, Color::packBytes(rr, gg, bb));
                    tx = tx + 1;
                }
                ty = ty + 1;
            }
            t = t + 1;
        }
        psz = sz;
        sz = sz / 2;
        level = level + 1;
    }
}

/**
 * One projected, lit triangle vertex for the textured rasteriser: screen
 * position (sx, sy), inverse depth (iz), tile UV (u, v) and the per-vertex
 * Gouraud light-colour multipliers (tr, tg, tb). A value-type bundle so the
 * rasteriser takes 3 of these instead of two dozen loose scalars.
 *
 * Held at 32 bits. A screen position is a pixel and a fraction of one, a UV is
 * a texel and a fraction, a light factor is a few hundred steps between dark
 * and lit: none of them has anything to say past the seventh digit, and the
 * queue holds tens of thousands of these per worker. The rasteriser widens
 * them once, at the top, and does its arithmetic in `f64` as before.
 */
struct RasterVert {
    sx : f32,
    sy : f32,
    iz : f32,
    u : f32,
    v : f32,
    tr : f32,
    tg : f32,
    tb : f32,
}

/**
 * One queued textured triangle (3 verts + atlas tile + wrap flag). The world
 * pass projects/lights/clips faces into a queue of these once; worker threads
 * then rasterise the queue, each into its own screen-column band — so the heavy
 * per-face lighting is done once and only the fill is parallelised.
 */
struct RasterTri {
    a : RasterVert,
    b : RasterVert,
    c : RasterVert,
    tile : i16,   // atlas tile, under 256
    wrap : i8,    // 0 or 1
}

/** The texture atlas mip chain: base buffer + per-level offset / size tables. */
struct MipAtlas {
    mips : i64,
    mipOff : i64,
    mipSz : i64,
}

/**
 * One vertex-attribute SoA buffer set (each field a raw `allocBytes` pointer to
 * a small per-vertex scratch array): position x/y/z, texture u/v and Gouraud
 * light colour r/g/b. The world raster keeps two — camera-space input and the
 * near-clipped output — instead of 16 loose pointer fields; the byte layout and
 * hot-loop access (`Mem::realOf(buf.x, i)`) are identical to the old flat fields.
 */
struct VertAttribs {
    pub(crate) x : i64,
    pub(crate) y : i64,
    pub(crate) z : i64,
    pub(crate) u : i64,
    pub(crate) v : i64,
    pub(crate) r : i64,
    pub(crate) g : i64,
    pub(crate) b : i64,
}

/** Screen-space scratch for a clipped polygon: pixel x/y and inverse depth. */
struct ScreenScratch {
    pub(crate) sx : i64,
    pub(crate) sy : i64,
    pub(crate) iz : i64,
}

/**
 * Texture-atlas capability: hand out the mip-chain view (buffer + per-level
 * offset / size tables) the rasteriser samples. The owner (TextureAtlas) builds
 * and holds the chain; consumers (the world raster, the mob pass) take a
 * `MipAtlas` snapshot through this seam instead of reaching at the raw pointers.
 */
trait MipSource {
    fn mip(self) : MipAtlas;
}

/** A packed 8-bit RGB colour as three channels (e.g. the distance-fog colour). */
struct Rgb {
    r : i32,
    g : i32,
    b : i32,
}

/** A worker's disjoint screen-column band [x0, x1) (no z-buffer race). */
struct Band {
    x0 : i32,
    x1 : i32,
}

/**
 * One mip level of one tile, as the sampler addresses it: the chain, where the
 * level starts in it, how wide the level's tiles are, and the texel row this
 * tile begins at. The magnified and the minified paths differ in WHICH level
 * they read and in how they arrive at their texel coordinates — not in how a
 * tap is fetched — so they share one shape and one fetch.
 */
struct TileLevel {
    mips : i64,
    base : i32,
    size : i32,
    row : i32,
}

/**
 * One bilinear tap, in linear light: the 2×2 texels around (fu, fv) weighted by
 * the fractional part. Coordinates are in the LEVEL's texel space, already
 * shifted by the half-texel the box centre needs.
 * @param lvl   the mip level of the tile to read
 * @param fu    texel-space u within the tile
 * @param fv    texel-space v within the tile
 * @param wrap  wrap within the tile (scrolled water) vs clamp
 * @param gam   the colour space to decode through
 * @return the weighted sample, as linear light
 */
fn bilinearLin(lvl : TileLevel, fu : f64, fv : f64, wrap : bool, gam : Gamma) : LinRgb {
    let tmax : i32 = lvl.size - 1;
    let tx0 : i32 = fu.floorToInt() as i32;
    let ty0 : i32 = fv.floorToInt() as i32;
    let fx : f64 = fu - (tx0 as f64);
    let fy : f64 = fv - (ty0 as f64);
    let tx1 : i32 = tx0 + 1;
    let ty1 : i32 = ty0 + 1;
    if (wrap) {
        tx0 = tx0 & tmax;
        tx1 = tx1 & tmax;
        ty0 = ty0 & tmax;
        ty1 = ty1 & tmax;
    } else {
        tx0 = clampI32(tx0, 0, tmax);
        tx1 = clampI32(tx1, 0, tmax);
        ty0 = clampI32(ty0, 0, tmax);
        ty1 = clampI32(ty1, 0, tmax);
    }
    let rw0 : i32 = lvl.base + (lvl.row + ty0) * lvl.size;
    let rw1 : i32 = lvl.base + (lvl.row + ty1) * lvl.size;
    let c00 : i32 = Mem::dwordAt(lvl.mips, ((rw0 + tx0) as i64) * 4);
    let c10 : i32 = Mem::dwordAt(lvl.mips, ((rw0 + tx1) as i64) * 4);
    let c01 : i32 = Mem::dwordAt(lvl.mips, ((rw1 + tx0) as i64) * 4);
    let c11 : i32 = Mem::dwordAt(lvl.mips, ((rw1 + tx1) as i64) * 4);
    let mfx : f64 = 1.0 - fx;
    let mfy : f64 = 1.0 - fy;
    let w00 : f64 = mfx * mfy;
    let w10 : f64 = fx * mfy;
    let w01 : f64 = mfx * fy;
    let w11 : f64 = fx * fy;
    return LinRgb {
        r: gam.decode(c00, 16) * w00 + gam.decode(c10, 16) * w10 + gam.decode(c01, 16) * w01 + gam.decode(c11, 16) * w11,
        g: gam.decode(c00, 8) * w00 + gam.decode(c10, 8) * w10 + gam.decode(c01, 8) * w01 + gam.decode(c11, 8) * w11,
        b: gam.decode(c00, 0) * w00 + gam.decode(c10, 0) * w10 + gam.decode(c01, 0) * w01 + gam.decode(c11, 0) * w11,
    };
}

/**
 * Textured triangle with proper texture filtering: crisp **sharp-bilinear** when
 * the texture is magnified (near), and true **anisotropic filtering** when
 * minified (distance / oblique ground) — the mip is chosen from the LESS
 * compressed screen axis and several taps are averaged along the MORE compressed
 * one, so distant surfaces stay sharp instead of smearing to a blurry mush. The
 * per-pixel screen-space UV derivatives come from the triangle's constant
 * gradients of (u/z, v/z, 1/z). Each channel is scaled by its own per-vertex
 * multiplier (Gouraud light colour) — in LINEAR light: the filtered texel is
 * decoded, lit, then tone-mapped back to a display byte. The distance fog runs
 * on the encoded bytes, so far terrain meets the sky — drawn in sRGB by its own
 * pass — at exactly the same colour.
 * @param fb     the render target (framebuffer + z-buffer + size)
 * @param tri    the triangle: 3 RasterVerts + atlas tile index + wrap flag
 * @param atlas  the texture atlas mip chain (buffer + offset / size tables)
 * @param gam    the colour space the texels are lit in
 * @param fogT    the fog: the sky's colour behind each pixel, and how much of it
 * @param band   the worker's disjoint screen-column band [x0, x1) to fill
 */
fn rasterTriTex(fb : FrameBuf, tri : RasterTri, atlas : MipAtlas, gam : Gamma, fogT : FogTable, band : Band) : void {
    // The three vertices, widened once: the queue keeps them at 32 bits, the
    // edge functions and the perspective divide run at 64.
    let asx : f64 = tri.a.sx as f64;
    let asy : f64 = tri.a.sy as f64;
    let aiz : f64 = tri.a.iz as f64;
    let au : f64 = tri.a.u as f64;
    let av : f64 = tri.a.v as f64;
    let atr : f64 = tri.a.tr as f64;
    let atg : f64 = tri.a.tg as f64;
    let atb : f64 = tri.a.tb as f64;
    let bsx : f64 = tri.b.sx as f64;
    let bsy : f64 = tri.b.sy as f64;
    let biz : f64 = tri.b.iz as f64;
    let bu : f64 = tri.b.u as f64;
    let bv : f64 = tri.b.v as f64;
    let btr : f64 = tri.b.tr as f64;
    let btg : f64 = tri.b.tg as f64;
    let btb : f64 = tri.b.tb as f64;
    let csx : f64 = tri.c.sx as f64;
    let csy : f64 = tri.c.sy as f64;
    let ciz : f64 = tri.c.iz as f64;
    let cu : f64 = tri.c.u as f64;
    let cv : f64 = tri.c.v as f64;
    let ctr : f64 = tri.c.tr as f64;
    let ctg : f64 = tri.c.tg as f64;
    let ctb : f64 = tri.c.tb as f64;
    let tile : i32 = tri.tile as i32;
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let w : i32 = fb.w;
    let h : i32 = fb.h;
    let wrap : bool = (tri.wrap as i32) != 0;
    // The triangle, atlas, fog and band stay bundled — the rasteriser reads
    // vertices / UV / Gouraud straight off tri.a/tri.b/tri.c (RasterVert).
    let area : f64 = edge(asx, asy, bsx, bsy, csx, csy);
    if (area > 0.0 - 0.0001 && area < 0.0001) {
        return;
    }
    let inv : f64 = 1.0 / area;

    // Perspective-premultiplied UV (u/z, v/z) per vertex — the working set the
    // gradients and per-pixel sample interpolate.
    let uw0 : f64 = au * aiz;
    let vw0 : f64 = av * aiz;
    let uw1 : f64 = bu * biz;
    let vw1 : f64 = bv * biz;
    let uw2 : f64 = cu * ciz;
    let vw2 : f64 = cv * ciz;

    // Screen bounding box of the triangle.
    let minx : i32 = (minf(asx, minf(bsx, csx))).floorToInt() as i32;
    let maxx : i32 = (maxf(asx, maxf(bsx, csx))).floorToInt() as i32;
    let miny : i32 = (minf(asy, minf(bsy, csy))).floorToInt() as i32;
    let maxy : i32 = (maxf(asy, maxf(bsy, csy))).floorToInt() as i32;
    if (minx < 0) {
        minx = 0;
    }
    if (miny < 0) {
        miny = 0;
    }
    if (maxx > w - 1) {
        maxx = w - 1;
    }
    if (maxy > h - 1) {
        maxy = h - 1;
    }
    // Tile clip: this call only fills the column band [bandX0, bandX1) so worker
    // threads own disjoint screen columns (no z-buffer race). A triangle outside
    // the band is rejected here cheaply.
    if (minx < band.x0) {
        minx = band.x0;
    }
    if (maxx > band.x1 - 1) {
        maxx = band.x1 - 1;
    }
    if (minx > maxx) {
        return;
    }

    // Incremental edge functions: the three edge values are linear in the
    // pixel centre, so we evaluate them once at the bbox corner and step
    // them by constant deltas instead of recomputing per pixel.
    let cx0 : f64 = (minx as f64) + 0.5;
    let cy0 : f64 = (miny as f64) + 0.5;
    let ax0 : f64 = csy - bsy;
    let ay0 : f64 = bsx - csx;
    let ax1 : f64 = asy - csy;
    let ay1 : f64 = csx - asx;
    let ax2 : f64 = bsy - asy;
    let ay2 : f64 = asx - bsx;
    let e0row : f64 = edge(bsx, bsy, csx, csy, cx0, cy0);
    let e1row : f64 = edge(csx, csy, asx, asy, cx0, cy0);
    let e2row : f64 = edge(asx, asy, bsx, bsy, cx0, cy0);

    // Triangle-constant screen-space gradients of the perspective attributes
    // (u/z, v/z, 1/z): linear in screen x/y, so they're constant per triangle.
    // Each pixel derives its UV footprint (du/dx … dv/dy) from these to choose
    // the mip level and the anisotropic tap count.
    let guwx : f64 = (ax0 * uw0 + ax1 * uw1 + ax2 * uw2) * inv;
    let gvwx : f64 = (ax0 * vw0 + ax1 * vw1 + ax2 * vw2) * inv;
    let gizx : f64 = (ax0 * aiz + ax1 * biz + ax2 * ciz) * inv;
    let guwy : f64 = (ay0 * uw0 + ay1 * uw1 + ay2 * uw2) * inv;
    let gvwy : f64 = (ay0 * vw0 + ay1 * vw1 + ay2 * vw2) * inv;
    let gizy : f64 = (ay0 * aiz + ay1 * biz + ay2 * ciz) * inv;
    let tp : f64 = Atlas::TILE_PX as f64;
    let maxMip : i32 = Atlas::MIP_LEVELS - 1;
    // Magnification (near) path: crisp sharp-bilinear at mip 0.
    let tf : f64 = tp;
    let tbase : i32 = tile * Atlas::TILE_PX;

    let py : i32 = miny;
    while (py <= maxy) {
        let e0 : f64 = e0row;
        let e1 : f64 = e1row;
        let e2 : f64 = e2row;
        let rowbase : i32 = py * w;
        let px : i32 = minx;
        while (px <= maxx) {
            if (e0 * inv >= 0.0 && e1 * inv >= 0.0 && e2 * inv >= 0.0) {
                let b0 : f64 = e0 * inv;
                let b1 : f64 = e1 * inv;
                let b2 : f64 = e2 * inv;
                let izp : f64 = b0 * aiz + b1 * biz + b2 * ciz;
                let idx : i64 = (rowbase + px) as i64;
                unsafe {
                    let zp : ptr<f32> = (zbuf + idx * FLOAT_BYTES) as ptr<f32>;
                    if (izp > ((*zp) as f64)) {
                        let invz : f64 = 1.0 / izp;
                        let u : f64 = (b0 * uw0 + b1 * uw1 + b2 * uw2) * invz;
                        let v : f64 = (b0 * vw0 + b1 * vw1 + b2 * vw2) * invz;
                        // Per-pixel UV footprint in full-res texels: the screen-x
                        // and screen-y derivatives of (u,v). Their lengths give
                        // texels-per-pixel along each screen axis; the smaller is
                        // the minor axis (sets the mip), the larger the major
                        // (sets the anisotropic tap count).
                        let dudx : f64 = (guwx - u * gizx) * invz;
                        let dvdx : f64 = (gvwx - v * gizx) * invz;
                        let dudy : f64 = (guwy - u * gizy) * invz;
                        let dvdy : f64 = (gvwy - v * gizy) * invz;
                        let exx : f64 = dudx * tp;
                        let eyx : f64 = dvdx * tp;
                        let exy : f64 = dudy * tp;
                        let eyy : f64 = dvdy * tp;
                        let px2 : f64 = exx * exx + eyx * eyx;
                        let py2 : f64 = exy * exy + eyy * eyy;
                        let minor2 : f64 = px2;
                        let major2 : f64 = py2;
                        if (py2 < px2) {
                            minor2 = py2;
                            major2 = px2;
                        }
                        let rf : f64 = 0.0;
                        let gf : f64 = 0.0;
                        let bf : f64 = 0.0;
                        if (minor2 <= 1.0) {
                            // ── Magnification (near): crisp sharp-bilinear, mip 0 ──
                            let sharp : f64 = 16.0;
                            if (minor2 > 0.0000001) {
                                sharp = 1.0 / minor2.sqrt();
                            }
                            if (sharp < 1.0) {
                                sharp = 1.0;
                            }
                            if (sharp > 16.0) {
                                sharp = 16.0;
                            }
                            let rrs : f64 = 0.5 - 0.5 / sharp;
                            let fu0 : f64 = u * tf;
                            let fv0 : f64 = v * tf;
                            let flx : f64 = fu0.floorToInt() as f64;
                            let cdx0 : f64 = fu0 - flx - 0.5;
                            let ccx0 : f64 = cdx0;
                            if (ccx0 > rrs) {
                                ccx0 = rrs;
                            } else if (ccx0 < 0.0 - rrs) {
                                ccx0 = 0.0 - rrs;
                            }
                            let fu : f64 = flx + (cdx0 - ccx0) * sharp;
                            let fly : f64 = fv0.floorToInt() as f64;
                            let cdy0 : f64 = fv0 - fly - 0.5;
                            let ccy0 : f64 = cdy0;
                            if (ccy0 > rrs) {
                                ccy0 = rrs;
                            } else if (ccy0 < 0.0 - rrs) {
                                ccy0 = 0.0 - rrs;
                            }
                            let fv : f64 = fly + (cdy0 - ccy0) * sharp;
                            let c : LinRgb = bilinearLin(
                                TileLevel { mips: atlas.mips, base: 0, size: Atlas::TILE_PX, row: tbase },
                                fu, fv, wrap, gam
                            );
                            rf = c.r;
                            gf = c.g;
                            bf = c.b;
                        } else {
                            // ── Minification (distance): anisotropic filtering ──
                            // Mip from the minor axis (with a sharpening bias), then
                            // average N bilinear taps along the major axis so oblique
                            // distant surfaces stay sharp without shimmering.
                            let m2 : f64 = minor2 * Atlas::MIP_BIAS;
                            let mip : i32 = 0;
                            let lim : f64 = 4.0;
                            while (mip < maxMip && m2 >= lim) {
                                lim = lim * 4.0;
                                mip = mip + 1;
                            }
                            let lvlSz : i32 = Mem::dwordAt(atlas.mipSz, (mip as i64) * 4);
                            let lvl : TileLevel = TileLevel {
                                mips: atlas.mips,
                                base: Mem::dwordAt(atlas.mipOff, (mip as i64) * 4),
                                size: lvlSz,
                                row: tile * lvlSz,
                            };
                            let lvlF : f64 = lvlSz as f64;
                            let ratio : f64 = (major2 / minor2).sqrt();
                            let nN : i32 = (ratio + 0.5).floorToInt() as i32;
                            if (nN < 1) {
                                nN = 1;
                            }
                            if (nN > Atlas::MAX_ANISO) {
                                nN = Atlas::MAX_ANISO;
                            }
                            let mju : f64 = dudx;
                            let mjv : f64 = dvdx;
                            if (py2 > px2) {
                                mju = dudy;
                                mjv = dvdy;
                            }
                            let sr : f64 = 0.0;
                            let sg : f64 = 0.0;
                            let sb : f64 = 0.0;
                            let i : i32 = 0;
                            while (i < nN) {
                                let tt : f64 = (((i as f64) + 0.5) / (nN as f64)) - 0.5;
                                let c : LinRgb = bilinearLin(lvl,
                                    (u + mju * tt) * lvlF - 0.5, (v + mjv * tt) * lvlF - 0.5, wrap, gam);
                                sr = sr + c.r;
                                sg = sg + c.g;
                                sb = sb + c.b;
                                i = i + 1;
                            }
                            let invN : f64 = 1.0 / (nN as f64);
                            rf = sr * invN;
                            gf = sg * invN;
                            bf = sb * invN;
                        }
                        // Gouraud: per-vertex tint interpolated by the
                        // screen-space barycentrics (low-frequency light, so
                        // affine interpolation is fine and cheap).
                        let trp : f64 = b0 * atr + b1 * btr + b2 * ctr;
                        let tgp : f64 = b0 * atg + b1 * btg + b2 * ctg;
                        let tbp : f64 = b0 * atb + b1 * btb + b2 * ctb;
                        let r : i32 = gam.encode(rf * trp);
                        let g : i32 = gam.encode(gf * tgp);
                        let bl : i32 = gam.encode(bf * tbp);
                        // Aerial perspective: dissolve into the sky THAT IS
                        // THERE, behind this pixel — not into one average colour
                        // for the frame, which is grey against the sun's glow and
                        // too pale against the deep blue away from it.
                        let fog : f64 = fogT.amount(invz);
                        if (fog > 0.002) {
                            let sky : SkyColour = fogT.skyAt(px, py);
                            let keep : f64 = 1.0 - fog;
                            r = ((r as f64) * keep + sky.r * fog).floorToInt() as i32;
                            g = ((g as f64) * keep + sky.g * fog).floorToInt() as i32;
                            bl = ((bl as f64) * keep + sky.b * fog).floorToInt() as i32;
                        }
                        *zp = izp as f32;
                        let pp : ptr<i32> = (pixels + idx * 4) as ptr<i32>;
                        *pp = (r & 0xFF) * 65536 + (g & 0xFF) * 256 + (bl & 0xFF);
                    }
                }
            }
            e0 = e0 + ax0;
            e1 = e1 + ax1;
            e2 = e2 + ax2;
            px = px + 1;
        }
        e0row = e0row + ay0;
        e1row = e1row + ay1;
        e2row = e2row + ay2;
        py = py + 1;
    }
}

/**
 * Flat-colour triangle: half-plane inside test with z-buffered fill.
 * @param fb      the render target (framebuffer + z-buffer + size).
 * @param x0      first vertex x.
 * @param y0      first vertex y.
 * @param iz0     first vertex inverse depth.
 * @param x1      second vertex x.
 * @param y1      second vertex y.
 * @param iz1     second vertex inverse depth.
 * @param x2      third vertex x.
 * @param y2      third vertex y.
 * @param iz2     third vertex inverse depth.
 * @param color   fill colour.
 */
fn rasterTri(fb : FrameBuf,
    x0 : f64, y0 : f64, iz0 : f64,
    x1 : f64, y1 : f64, iz1 : f64,
    x2 : f64, y2 : f64, iz2 : f64,
    color : i32) : void {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let w : i32 = fb.w;
    let h : i32 = fb.h;
    let area : f64 = edge(x0, y0, x1, y1, x2, y2);
    if (area > 0.0 - 0.0001 && area < 0.0001) {
        return;
    }
    let inv : f64 = 1.0 / area;

    let minx : i32 = (minf(x0, minf(x1, x2))).floorToInt() as i32;
    let maxx : i32 = (maxf(x0, maxf(x1, x2))).floorToInt() as i32;
    let miny : i32 = (minf(y0, minf(y1, y2))).floorToInt() as i32;
    let maxy : i32 = (maxf(y0, maxf(y1, y2))).floorToInt() as i32;
    if (minx < 0) {
        minx = 0;
    }
    if (miny < 0) {
        miny = 0;
    }
    if (maxx > w - 1) {
        maxx = w - 1;
    }
    if (maxy > h - 1) {
        maxy = h - 1;
    }

    let py : i32 = miny;
    while (py <= maxy) {
        let cy : f64 = (py as f64) + 0.5;
        let px : i32 = minx;
        while (px <= maxx) {
            let cx : f64 = (px as f64) + 0.5;
            let b0 : f64 = edge(x1, y1, x2, y2, cx, cy) * inv;
            let b1 : f64 = edge(x2, y2, x0, y0, cx, cy) * inv;
            let b2 : f64 = edge(x0, y0, x1, y1, cx, cy) * inv;
            if (b0 >= 0.0 && b1 >= 0.0 && b2 >= 0.0) {
                let iz : f64 = b0 * iz0 + b1 * iz1 + b2 * iz2;
                let idx : i32 = py * w + px;
                if (iz > floatOf(zbuf, idx)) {
                    putFloatOf(zbuf, idx, iz);
                    Mem::putWordOf(pixels, idx, color);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
}
