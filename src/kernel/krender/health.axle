// health — the Minecraft-style heart row. Each heart is a 9×9 sprite with
// a dark outline, a red body and a light highlight (drawn from a small
// pixel mask), sitting on a grey "empty container" heart so missing
// health reads as hollow hearts. Each heart = 2 hp; odd hp shows a
// half-heart. Stateless: reads hp, paints pixels.

use smalt::Color;
use smalt::{Frame, Rect};
use crate::kernel::krender::uiscale::{ UiScale };

/** The heart sprite's grid: 9 by 9 mask cells, each 2 overlay pixels square. */
const HEART_CELLS : i32 = 9;
const HEART_PX : i32 = 2;

/**
 * 9×9 heart, one digit per pixel: 0 empty, 1 outline, 3 body, 4 highlight
 * (the shiny upper-left lobe).
 * @return the 81-char heart mask string.
 */
fn heartMask() : string {
    return "011000110144101331144313331133333331133333331013333310001333100000131000000010000";
}

/**
 * Pixel colour for a mask code, in the red (filled) or grey (empty)
 * palette.
 * @param code    the mask code.
 * @param filled  whether to use the filled (red) palette.
 * @return the ARGB-packed colour.
 */
fn heartColor(code : i32, filled : bool) : i32 {
    if (filled) {
        if (code == 1) {
            return Color::packBytes(54, 10, 10);
        }
        if (code == 3) {
            return Color::packBytes(228, 40, 40);
        }
        return Color::packBytes(255, 140, 140);
    }
    if (code == 1) {
        return Color::packBytes(22, 20, 26);
    }
    if (code == 3) {
        return Color::packBytes(78, 78, 90);
    }
    return Color::packBytes(108, 108, 122);
}

/**
 * Draw one heart at (x, y). `fill`: 0 empty, 1 half (left side red), 2
 * full. The grey container is always drawn first, then the red overlay for
 * the filled portion.
 *
 * Each mask cell is placed by its two EDGES rather than by an origin and a
 * size, so a fractional overlay scale still tiles: a cell starts exactly where
 * its neighbour ended, and the rounding that would otherwise open a seam or
 * double a row lands on the shared edge instead.
 * @param f     the frame to draw into.
 * @param x     heart left.
 * @param y     heart top.
 * @param fill  fill level: 0 empty, 1 half, 2 full.
 * @param ui    the overlay scale.
 */
fn drawHeart(f : Frame, x : i32, y : i32, fill : i32, ui : UiScale) : void {
    let mask : string = heartMask();
    let r : i32 = 0;
    while (r < HEART_CELLS) {
        let y0 : i32 = y + ui.px(r * HEART_PX);
        let y1 : i32 = y + ui.px((r + 1) * HEART_PX);
        let c : i32 = 0;
        while (c < HEART_CELLS) {
            let code : i32 = mask.byteAt(r * HEART_CELLS + c) - 48;
            if (code != 0) {
                let x0 : i32 = x + ui.px(c * HEART_PX);
                let x1 : i32 = x + ui.px((c + 1) * HEART_PX);
                let box : Rect = Rect::make(x0, y0, x1 - x0, y1 - y0);
                f.fillRect(box, heartColor(code, false));
                if (fill == 2 || (fill == 1 && c <= 4)) {
                    f.fillRect(box, heartColor(code, true));
                }
            }
            c = c + 1;
        }
        r = r + 1;
    }
}

/**
 * Draw the heart row (`maxHp / 2` hearts) with its top-left at (x0, y0).
 * @param f      the frame to draw into.
 * @param x0     row left.
 * @param y0     row top.
 * @param hp     current health.
 * @param maxHp  maximum health.
 * @param ui     the overlay scale.
 */
fn drawHealth(f : Frame, x0 : i32, y0 : i32, hp : i32, maxHp : i32, ui : UiScale) : void {
    let hearts : i32 = maxHp / 2;
    let step : i32 = ui.px(HEART_CELLS * HEART_PX + 1);
    let i : i32 = 0;
    while (i < hearts) {
        let fill : i32 = 0;
        if (hp >= (i + 1) * 2) {
            fill = 2;
        } else if (hp >= i * 2 + 1) {
            fill = 1;
        }
        drawHeart(f, x0 + i * step, y0, fill, ui);
        i = i + 1;
    }
}

/**
 * Framebuffer height of the heart row at this overlay scale (for HUD layout).
 * @param ui  the overlay scale
 * @return the heart row height in framebuffer pixels.
 */
fn healthHeight(ui : UiScale) : i32 {
    return ui.px(HEART_CELLS * HEART_PX);
}
