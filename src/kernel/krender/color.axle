// color — what this game adds to smalt's colour, and the widget contract
// the overlay is composed from.
//
// Almost nothing, now. The packing, the channel reads, the clamp, the
// scale and the mix all live in `smalt::Color`; the clipped surface, the
// rectangle fill and the backdrop dim live on `smalt::Frame`. What is
// left here is the one tint that is a *game* decision — the red flash a
// struck mob wears — and the `Widget` seam the HUD composes through.
//
// The `Canvas` struct that used to head this file is gone. It bundled
// `(base, w, h)` so the HUD primitives did not have to thread three
// scalars, which is exactly what `Frame` is — with a clip rectangle on
// top, so a widget that overruns its box is cut at the edge rather than
// painting over its neighbour.

use smalt::{Color, Frame};

/** How much red a hurt flash adds, out of 255. */
const TINT_RED_LIFT : i32 = 110;

/** What a hurt flash leaves of the other two channels, as a fraction. */
const TINT_KEEP_NUM : i32 = 45;

/** The denominator of that fraction. */
const TINT_KEEP_DEN : i32 = 100;

/**
 * A self-contained overlay element that paints itself into the frame.
 *
 * Each HUD piece (the hotbar, the heart row, the pause menu) carries its
 * own layout and payload and implements `draw`, so the compositor walks a
 * SET of widgets instead of a hand-ordered call list. Positions live
 * inside each widget, so `draw` needs only the surface.
 */
trait Widget {
    fn draw(self, f : Frame) : void;
}

/**
 * Push a colour towards red — the flash a mob wears when it is struck.
 *
 * The red channel is lifted and the other two damped, rather than the
 * whole colour blended towards a fixed red: a white sheep and a black
 * creeper both have to read as *the same mob, hurt*, and blending
 * towards one red makes them both that red.
 * @param color  the packed colour.
 * @return the red-tinted colour.
 */
fn redTint(color : i32) : i32 {
    return Color::packBytes(
        Color::clamp8(Color::red(color) + TINT_RED_LIFT),
        (Color::green(color) * TINT_KEEP_NUM) / TINT_KEEP_DEN,
        (Color::blue(color) * TINT_KEEP_NUM) / TINT_KEEP_DEN
    );
}

/**
 * `redTint(color)` when `on`, else `color` unchanged.
 * @param on     whether to apply the red tint.
 * @param color  the packed colour.
 * @return the tinted or original colour.
 */
fn tintIf(on : bool, color : i32) : i32 {
    if (on) {
        return redTint(color);
    }
    return color;
}
