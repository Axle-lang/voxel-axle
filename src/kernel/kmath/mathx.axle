// mathx — small numeric helpers the stdlib `Math` module doesn't provide:
// value clamps and angle wrapping, plus the circle constants. Kept in one place
// so the renderer, the player camera and the mob AI stop re-deriving them.

pub const PI : f64 = 3.14159265358979;
pub const TAU : f64 = 6.28318530717959;   // 2π

/**
 * Clamp `v` into the inclusive range [lo, hi].
 * @param v   the value
 * @param lo  the lower bound
 * @param hi  the upper bound
 * @return v clamped to [lo, hi]
 */
/**
 * Linear interpolation from `a` to `b`.
 * @param a  the value at t = 0
 * @param b  the value at t = 1
 * @param t  the fraction (not clamped — callers that want it clamped say so)
 * @return the interpolated value
 */
pub fn lerp(a : f64, b : f64, t : f64) : f64 {
    return a + (b - a) * t;
}

/**
 * The smooth 0→1 ramp between two edges: 0 at or below `e0`, 1 at or above
 * `e1`, and eased between.
 *
 * What a threshold wants to be. A hard comparison gives a cloud an edge like a
 * cut sheet of paper; this gives it the shoulder where it thins out, which is
 * what a cloud's edge actually is.
 * @param e0  the lower edge
 * @param e1  the upper edge
 * @param x   the value to ramp
 * @return the eased fraction in [0, 1]
 */
pub fn smoothstep(e0 : f64, e1 : f64, x : f64) : f64 {
    let d : f64 = e1 - e0;
    if (d > 0.0 - 0.000001 && d < 0.000001) {
        if (x < e0) {
            return 0.0;
        }
        return 1.0;
    }
    let t : f64 = (x - e0) / d;
    if (t < 0.0) {
        return 0.0;
    }
    if (t > 1.0) {
        return 1.0;
    }
    return t * t * (3.0 - 2.0 * t);
}

pub fn clampF64(v : f64, lo : f64, hi : f64) : f64 {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

/**
 * Clamp `v` into the inclusive range [lo, hi].
 * @param v   the value
 * @param lo  the lower bound
 * @param hi  the upper bound
 * @return v clamped to [lo, hi]
 */
pub fn clampI32(v : i32, lo : i32, hi : i32) : i32 {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

/**
 * Wrap an angle (radians) into (-π, π], the shortest signed form.
 * @param a  the angle in radians
 * @return the equivalent angle in (-π, π]
 */
pub fn wrapAngle(a : f64) : f64 {
    let r : f64 = a;
    while (r > PI) {
        r = r - TAU;
    }
    while (r < 0.0 - PI) {
        r = r + TAU;
    }
    return r;
}
