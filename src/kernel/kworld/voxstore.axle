// voxstore — the raw voxel storage of the chunk ring.
//
// A LEAF mini-manager (imports only `configs`) holding the padded per-slot voxel
// field and the per-slot highest-face Y watermark, plus the master per-voxel
// INDEX LAYOUT (`voxIdx`). That layout is shared: the manager's per-voxel byte
// light volumes (block / sky / sun / sky-access / bounce) index with the very
// same `voxIdx`, so it lives here as the single authority.
//
// Because this is a leaf, both `manager.axle` (which composes a VoxStore) and
// `treegen.axle` (which carves trees straight into one) depend on it one-way —
// no import cycle. Axle arrays (`Block[]`/`i32[]`) are references, so writes
// through a VoxStore handed to a free function mutate the owning ring in place.

use crate::kernel::kmath::vec3::{ IVec3 };
use crate::configs::blocks::{ Block };
use crate::configs::world::{ World };

class VoxStore {
    vox : Block[],            // padded block field: slots × (chunkSize+2)² × worldHeight
    lvl : i8[],               // per-voxel LEVEL, same layout; 0 = the id's default box
    pub(crate) maxFY : i32[], // per-slot highest-face Y watermark (bounds the mesh/light scan)

    /**
     * Allocate the padded voxel field, its level field and the per-slot
     * face-Y watermark.
     *
     * The level is one byte a voxel beside the id — a quarter more memory
     * for the field, and the thing that makes a partial block a piece of
     * WORLD DATA rather than a function of where it happens to sit. A
     * height derived from the coordinates cannot be placed, cannot be dug
     * a layer at a time, and cannot differ between two cells the noise
     * happens to agree about.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        let hSide : i32 = World::CHUNK_SIZE + 2;
        self.vox = malloc<Block>(slots * hSide * hSide * World::HEIGHT);
        self.lvl = malloc<i8>(slots * hSide * hSide * World::HEIGHT);
        self.maxFY = malloc<i32>(slots);
    }

    /**
     * Flat index of a padded local voxel. The inner dimension is Y; a one-voxel
     * skirt (+1) on x/z mirrors the neighbour chunks' edge columns.
     * @param slot  the slot index
     * @param lx    the local x coordinate (skirt range [-1, chunkSize])
     * @param ly    the local y coordinate
     * @param lz    the local z coordinate (skirt range [-1, chunkSize])
     * @return the flat offset into `vox` (and into the light byte volumes)
     */
    pub(crate) fn voxIdx(self, slot : i32, lx : i32, ly : i32, lz : i32) : i32 {
        let hSide : i32 = World::CHUNK_SIZE + 2;
        let px : i32 = lx + 1;
        let pz : i32 = lz + 1;
        return slot * (hSide * hSide * World::HEIGHT)
            + (pz * hSide + px) * World::HEIGHT + ly;
    }

    /**
     * Read a padded local voxel: bedrock (Stone) below y=0, Air at/above the
     * world top, the stored block otherwise.
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @return the block id at that cell
     */
    pub(crate) fn getVox(self, slot : i32, local : IVec3) : Block {
        if (local.y < 0) {
            return Block::Stone;
        }
        if (local.y >= World::HEIGHT) {
            return Block::Air;
        }
        return self.vox[self.voxIdx(slot, local.x, local.y, local.z)];
    }

    /**
     * Write block `id` at a padded local voxel (no bounds check).
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @param id     the block id to write
     */
    pub(crate) fn setVoxLocal(mut self, slot : i32, local : IVec3, own id : Block) : void {
        let at : i32 = self.voxIdx(slot, local.x, local.y, local.z);
        self.vox[at] = id;
        // A write that says nothing about the level clears it, so a cell
        // never inherits the level of whatever used to be there. Zero is
        // "the id's own default box".
        self.lvl[at] = 0;
    }

    /**
     * Write block `id` at a padded local voxel with an explicit level.
     *
     * The door a layered block goes through: a snow layer, a slab, a
     * fluid depth. `level` is 1..8 for a layered id and ignored by every
     * other one, so a caller that does not know which it holds can pass
     * the level it means and be right either way.
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @param id     the block id to write
     * @param level  the block's level, 1..8; 0 for the id's default
     */
    pub(crate) fn setVoxLevel(mut self, slot : i32, local : IVec3, own id : Block, level : i32) : void {
        let at : i32 = self.voxIdx(slot, local.x, local.y, local.z);
        self.vox[at] = id;
        self.lvl[at] = level as i8;
    }

    /**
     * The stored level of a padded local voxel; 0 outside the world.
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @return the cell's level, or 0 for "the id's default"
     */
    pub(crate) fn getLevel(self, slot : i32, local : IVec3) : i32 {
        if (local.y < 0 || local.y >= World::HEIGHT) {
            return 0;
        }
        return self.lvl[self.voxIdx(slot, local.x, local.y, local.z)] as i32;
    }

    /**
     * Write `id` only if `local` is inside this slot's padded volume — used when
     * stamping trees whose origin sits just outside the chunk.
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @param id     the block id to write
     */
    pub(crate) fn setVoxClip(mut self, slot : i32, local : IVec3, id : Block) : void {
        let s : i32 = World::CHUNK_SIZE;
        if (local.x < 0 - 1 || local.x > s || local.z < 0 - 1 || local.z > s) {
            return;
        }
        if (local.y < 0 || local.y >= World::HEIGHT) {
            return;
        }
        let v : Block = id;
        self.setVoxLocal(slot, local, v);
    }

    /**
     * Raise the slot's highest-face Y watermark to include `y`.
     * @param slot  the slot index
     * @param y     the candidate Y
     */
    pub(crate) fn bumpFY(mut self, slot : i32, y : i32) : void {
        if (y > self.maxFY[slot]) {
            self.maxFY[slot] = y;
        }
    }
}
