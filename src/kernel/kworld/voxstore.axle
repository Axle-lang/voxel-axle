// voxstore — the raw voxel storage of the chunk ring.
//
// A LEAF mini-manager (imports only `configs`) holding the per-slot voxel field
// and the per-slot highest-face Y watermark, plus the master per-voxel INDEX
// LAYOUT (`voxIdx`). That layout is shared: the manager's per-voxel byte light
// volumes (block / sky / sun / sky-access / bounce) index with the very same
// `voxIdx`, so it lives here as the single authority.
//
// A slot holds exactly its chunk's sixteen-by-sixteen columns. It used to hold
// a one-cell skirt around them too — a copy of the neighbours' edge columns, so
// the mesher could look across a border without leaving the slot. That skirt
// was 27% of every voxel and every light plane, kept in step by writing each
// edit into up to four slots, and it was wrong the moment a neighbour had not
// been generated yet. A border read now goes to the chunk that owns the cell.
//
// Because this is a leaf, both `manager.axle` (which composes a VoxStore) and
// `treegen.axle` (which carves trees straight into one) depend on it one-way —
// no import cycle.
//
// The field itself is `VoxData`, held as a `Shared<VoxData>`: the manager and
// the light engine each own a VoxStore, and both views co-own the one field.

use crate::kernel::kmath::vec3::{ IVec3 };
use crate::configs::blocks::{ Block };
use crate::configs::world::{ World };

/**
 * The voxel field, its level field and the per-slot face-Y watermark.
 *
 * The level is one byte a voxel beside the id — a quarter more memory
 * for the field, and the thing that makes a partial block a piece of
 * WORLD DATA rather than a function of where it happens to sit. A
 * height derived from the coordinates cannot be placed, cannot be dug
 * a layer at a time, and cannot differ between two cells the noise
 * happens to agree about.
 */
class VoxData {
    pub(crate) vox : Block[],   // block field: slots × chunkSize² × worldHeight
    pub(crate) lvl : i8[],      // per-voxel LEVEL, same layout; 0 = the id's default box
    pub(crate) maxFY : i16[],   // per-slot highest-face Y watermark (bounds the mesh/light
                                // scan) — a level of the world, so under World::HEIGHT

    /**
     * Allocate the three fields.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        const s : i32 = World::CHUNK_SIZE;
        self.vox = malloc<Block>(slots * s * s * World::HEIGHT);
        self.lvl = malloc<i8>(slots * s * s * World::HEIGHT);
        self.maxFY = malloc<i16>(slots);
    }
}

class VoxStore {
    data : Shared<VoxData>, // the field, co-owned with every other view

    /**
     * A view over a voxel field.
     * @param data  the field this view reads and writes
     */
    constructor(own data : Shared<VoxData>) {
        self.data = data;
    }

    /**
     * Flat index of a local voxel. The inner dimension is Y.
     * @param slot  the slot index
     * @param lx    the local x coordinate, 0..chunkSize-1
     * @param ly    the local y coordinate
     * @param lz    the local z coordinate, 0..chunkSize-1
     * @return the flat offset into `vox` (and into the light byte volumes)
     */
    pub(crate) fn voxIdx(self, slot : i32, lx : i32, ly : i32, lz : i32) : i32 {
        const s : i32 = World::CHUNK_SIZE;
        return slot * (s * s * World::HEIGHT) + (lz * s + lx) * World::HEIGHT + ly;
    }

    /**
     * Read a local voxel: bedrock (Stone) below y=0, Air at/above the
     * world top, the stored block otherwise.
     * @param slot   the slot index
     * @param local  the local voxel coordinate
     * @return the block id at that cell
     */
    pub(crate) fn getVox(self, slot : i32, local : IVec3) : Block {
        if (local.y < 0) {
            return Block::Stone;
        }
        if (local.y >= World::HEIGHT) {
            return Block::Air;
        }
        return self.data.vox[self.voxIdx(slot, local.x, local.y, local.z)];
    }

    /**
     * Write block `id` at a local voxel (no bounds check).
     * @param slot   the slot index
     * @param local  the local voxel coordinate
     * @param id     the block id to write
     */
    pub(crate) fn setVoxLocal(mut self, slot : i32, local : IVec3, own id : Block) : void {
        const at : i32 = self.voxIdx(slot, local.x, local.y, local.z);
        self.data.vox[at] = id;
        // A write that says nothing about the level clears it, so a cell
        // never inherits the level of whatever used to be there. Zero is
        // "the id's own default box".
        self.data.lvl[at] = 0;
    }

    /**
     * Write block `id` at a local voxel with an explicit level.
     *
     * The door a layered block goes through: a snow layer, a slab, a
     * fluid depth. `level` is 1..8 for a layered id and ignored by every
     * other one, so a caller that does not know which it holds can pass
     * the level it means and be right either way.
     * @param slot   the slot index
     * @param local  the local voxel coordinate
     * @param id     the block id to write
     * @param level  the block's level, 1..8; 0 for the id's default
     */
    pub(crate) fn setVoxLevel(
        mut self,
        slot : i32,
        local : IVec3,
        own id : Block,
        level : i32
    ) : void {
        const at : i32 = self.voxIdx(slot, local.x, local.y, local.z);
        self.data.vox[at] = id;
        self.data.lvl[at] = level as i8;
    }

    /**
     * The stored level of a local voxel; 0 outside the world.
     * @param slot   the slot index
     * @param local  the local voxel coordinate
     * @return the cell's level, or 0 for "the id's default"
     */
    pub(crate) fn getLevel(self, slot : i32, local : IVec3) : i32 {
        if (local.y < 0 || local.y >= World::HEIGHT) {
            return 0;
        }
        return self.data.lvl[self.voxIdx(slot, local.x, local.y, local.z)] as i32;
    }

    /**
     * Write `id` only if `local` is inside this slot — used when stamping
     * trees whose origin sits just outside the chunk, so the part of the canopy
     * that is in this chunk lands and the rest is the neighbour's to stamp.
     * @param slot   the slot index
     * @param local  the local voxel coordinate
     * @param id     the block id to write
     */
    pub(crate) fn setVoxClip(mut self, slot : i32, local : IVec3, id : Block) : void {
        const s : i32 = World::CHUNK_SIZE;
        if (local.x < 0 || local.x >= s || local.z < 0 || local.z >= s) {
            return;
        }
        if (local.y < 0 || local.y >= World::HEIGHT) {
            return;
        }
        let v : Block = id;
        self.setVoxLocal(slot, local, v);
    }

    /**
     * The slot's highest-face Y watermark: nothing in the slot sits above it.
     * @param slot  the slot index
     * @return the highest Y that carries a face
     */
    pub(crate) fn faceTop(self, slot : i32) : i32 {
        return self.data.maxFY[slot] as i32;
    }

    /**
     * Drop the slot's highest-face Y watermark to the floor, before a fresh fill.
     * @param slot  the slot index
     */
    pub(crate) fn resetFaceTop(mut self, slot : i32) : void {
        self.data.maxFY[slot] = 0;
    }

    /**
     * Raise the slot's highest-face Y watermark to include `y`.
     * @param slot  the slot index
     * @param y     the candidate Y
     */
    pub(crate) fn bumpFY(mut self, slot : i32, y : i32) : void {
        if (y > (self.data.maxFY[slot] as i32)) {
            self.data.maxFY[slot] = y as i16;
        }
    }
}
