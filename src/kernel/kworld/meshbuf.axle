// meshbuf — the shared render-mesh buffer layouts, in a leaf so both the world
// manager (which owns/allocates them), the mesher (which writes them) and the
// renderer (which reads them) can name the field layout regardless of module
// order. Plain data: raw `i32[]` / `i64` buffers, no behaviour.

/**
 * The baked render-mesh faces, one set shared by the whole chunk ring: a
 * per-slot face count plus SoA face attributes — world cell (fx/fy/fz), the
 * packed (dir<<8|tile) and the per-corner smooth light / AO byte volumes. The
 * mesher writes them, the renderer reads them; grouped so ChunkManager holds one
 * field, not seven.
 */
struct FaceMesh {
    pub(crate) fcount : i32[], // face count per slot
    pub(crate) fx : i32[],
    pub(crate) fy : i32[],
    pub(crate) fz : i32[],
    pub(crate) ftile : i32[],  // packs (dir << 8) | tile — see ChunkMesher.addFace
    pub(crate) flight : i64,   // per-face SMOOTH light: 4 bytes/face, one per corner,
                               // packing (sky << 4) | block (Minecraft-style smooth light)
    pub(crate) fao : i64,      // per-face ambient occlusion: 4 bytes/face, 0..3 per corner
}

/** Per-slot torch posts (drawn as thin columns, not cubes): world x/y/z + count. */
struct TorchField {
    pub(crate) tx : i32[],     // torch world x
    pub(crate) ty : i32[],     // torch world y
    pub(crate) tz : i32[],     // torch world z
    pub(crate) tcount : i32[], // torch count per slot
}

/** The chunk ring's per-slot ownership: chunk coords, loaded flag, collision top. */
struct ColumnRing {
    pub(crate) cxs : i32[],
    pub(crate) czs : i32[],
    pub(crate) loaded : i32[],
    pub(crate) ctop : i32[],    // per-column highest collidable voxel + 1 (entity physics)
}
