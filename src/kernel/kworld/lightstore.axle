// lightstore — the per-voxel LIGHT data of the chunk ring, split out of
// ChunkManager.
//
// A LEAF mini-manager (imports only `sdl_platform` + `config`) holding the
// per-voxel byte light volumes — block light, sky light, soft sun visibility,
// hemispherical sky access and the one-bounce coloured tint — all indexed by the
// shared `VoxStore.voxIdx` layout, plus the block-light flood stacks, the sky-AO
// hemisphere ray table and the per-slot light/sky-AO dirty + sweep cursors.
//
// `LightEngine` (below) composes one (`self.lights`) and runs the light flood /
// shadow / sky-AO passes over it; `ChunkManager` in turn composes a LightEngine.
// This mirrors how the manager composes a `VoxStore`: the light engine aliases
// the same voxel field + ring ownership the manager holds, so the background
// light thread reaches the live world with no copy — the data has a focused home.

use sdl_platform::{allocBytes, setF64, readU8, writeU8, getF64};
use crate::kernel::kmath::vec3::{ IVec3, Vec3, vec3, ivec3 };
use crate::kernel::kworld::voxstore::VoxStore;
use crate::kernel::kblock::blocks::{ isOpaque, lightEmission, albedoFor };
use crate::kernel::seams::{ BlockLightField, SkyLightField, SunLightField, BounceLightField };
use crate::config;
use crate::config::{ Block };

/** One entry of the block-light removal stack: a voxel + its old light level. */
struct LightRemoval {
    x : i32,
    y : i32,
    z : i32,
    lvl : i32,
}

/**
 * The seven per-voxel light volumes (each a raw byte array in voxIdx layout):
 * block + sky light (0..15), soft sun visibility + hemispherical sky access
 * (0..255), and the one-bounce coloured indirect tint (r/g/b, 128 = neutral).
 * Grouped so `LightStore` carries one field instead of seven loose pointers.
 */
struct LightVolumes {
    light : i64,     // per-voxel block light 0..15 (byte array, voxIdx layout)
    skylight : i64,  // per-voxel sky light 0..15 (open-to-sky exposure)
    sunlit : i64,    // per-voxel SOFT sun visibility 0..255 (255 = full sun,
                     // 0 = full shadow, between = penumbra)
    skyaccess : i64, // per-voxel hemispherical SKY ACCESS 0..255 (AO / GI)
    bnR : i64,       // per-voxel one-bounce COLOURED indirect tint (hue-only,
    bnG : i64,       // 128 = neutral 1.0): sky-AO rays that hit a surface sample
    bnB : i64,       // its albedo, so ambient bleeds the nearby colour.
}

/** The precomputed upper-hemisphere ray directions used by the sky-AO bake. */
struct HemiRays {
    hemiX : i64,
    hemiY : i64,
    hemiZ : i64,
}

class LightStore {
    vols : LightVolumes, // the 7 per-voxel light volumes
    rays : HemiRays,     // M precomputed upper-hemisphere ray directions (sky-AO)
    sunCursor : i32,    // round-robin slot index for the throttled shadow refresh
    skyAOcursor : i32,  // round-robin slot index for the throttled sky-AO bake
    skyAOdirty : i32[], // per-slot "sky-access needs (re)baking" flag
    ldirty : i32[],     // per-slot "light changed → re-mesh" flag
    lq : IVec3[],        // block-light flood (add) stack — one voxel per entry
    lqn : i32,           // its depth
    rq : LightRemoval[], // block-light removal stack — voxel + its old level
    rqn : i32,           // its depth

    /**
     * Allocate the per-voxel light volumes (block / sky / sun / sky-access /
     * bounce), the flood stacks, the per-slot dirty flags and the precomputed
     * sky-AO hemisphere ray table.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        let hSide : i32 = config::chunkSize + 2;
        let vol : i64 = (slots as i64) * (hSide as i64) * (hSide as i64) * (config::worldHeight as i64);
        self.vols = LightVolumes {
            light: allocBytes(vol), skylight: allocBytes(vol), sunlit: allocBytes(vol),
            skyaccess: allocBytes(vol),
            bnR: allocBytes(vol), bnG: allocBytes(vol), bnB: allocBytes(vol),
        };
        self.sunCursor = 0;
        self.skyAOcursor = 0;
        // Precompute M upper-hemisphere directions (Fibonacci spiral, cosine-ish)
        // for the sky-access bake.
        let m : i32 = config::skyAOSamples;
        self.rays = HemiRays {
            hemiX: allocBytes((m as i64) * 8),
            hemiY: allocBytes((m as i64) * 8),
            hemiZ: allocBytes((m as i64) * 8),
        };
        let hi : i32 = 0;
        while (hi < m) {
            let yy : f64 = ((hi as f64) + 0.5) / (m as f64);   // 0..1 toward up
            let rr : f64 = Math::sqrt(1.0 - yy * yy);
            let th : f64 = (hi as f64) * 2.399963;             // golden angle
            setF64(self.rays.hemiX, hi, rr * Math::cos(th));
            setF64(self.rays.hemiY, hi, yy);
            setF64(self.rays.hemiZ, hi, rr * Math::sin(th));
            hi = hi + 1;
        }
        self.skyAOdirty = malloc<i32>(slots);
        self.ldirty = malloc<i32>(slots);
        let lcap : i32 = config::lightQueueCap;
        self.lq = malloc<IVec3>(lcap);
        self.lqn = 0;
        self.rq = malloc<LightRemoval>(lcap);
        self.rqn = 0;
    }
}

/**
 * The throttled per-frame light bake capability (directional sun soft-shadows +
 * hemispherical sky-access / one-bounce GI), run by the background light thread.
 */
trait LightBaker {
    fn stepBake(mut self) : void;
}

/**
 * LightEngine — the voxel LIGHTING engine, lifted whole out of ChunkManager.
 *
 * Owns the LightStore (per-voxel light volumes + flood stacks) and reads world
 * topology through a shared VoxStore plus the chunk-ring ownership arrays
 * (loaded / cxs / czs), all aliased from the manager (Axle arrays / class
 * instances are references, so no data is copied — the light thread reaches the
 * same voxels the manager does). It runs the block-light flood, the sky-light
 * column + sideways gradient, the directional sun soft-shadow march and the
 * hemispherical sky-access / one-bounce GI bake, and satisfies the LightSample
 * read capabilities (Block/Sky/Sun/Bounce light fields) the renderer samples per
 * face corner. The manager keeps only thin delegators + the mesh flush, so the
 * whole lighting system finally has a focused, self-contained home.
 */
class LightEngine : BlockLightField, SkyLightField, SunLightField, BounceLightField, LightBaker {
    store : VoxStore,   // shared voxel field (aliased from the manager)
    lights : LightStore, // per-voxel light volumes + flood stacks (owned here)
    loaded : i32[],     // per-slot loaded flag (aliased)
    cxs : i32[],        // per-slot chunk x   (aliased)
    czs : i32[],        // per-slot chunk z   (aliased)
    curDayTime : f64,       // latest time-of-day, published by the main loop
    lightRunning : AtomicBoolean, // false tells the light thread to exit (quit)

    /**
     * Compose the light volumes over a shared voxel field + ring ownership.
     * @param store   the shared voxel storage
     * @param loaded  per-slot loaded flag (aliased)
     * @param cxs     per-slot chunk-x (aliased)
     * @param czs     per-slot chunk-z (aliased)
     * @param slots   the number of ring slots (span * span)
     */
    constructor(own store : VoxStore, loaded : i32[], cxs : i32[], czs : i32[], slots : i32) {
        self.store = store;
        self.loaded = loaded;
        self.cxs = cxs;
        self.czs = czs;
        self.lights = new LightStore(slots);
        self.curDayTime = config::dayStart;
        self.lightRunning = new AtomicBoolean(true);
    }

    // ── Grid / topology helpers ─────────────────────────────────

    /** Floor division of `a` by `b` (toward negative infinity). */
    fn floorDiv(self, a : i32, b : i32) : i32 {
        let q : i32 = a / b;
        if (a - q * b < 0) {
            q = q - 1;
        }
        return q;
    }

    /** Wrap a chunk coordinate into [0, span) for slot addressing. */
    fn wrap(self, v : i32) : i32 {
        let s : i32 = config::span;
        let m : i32 = v - (v / s) * s;
        if (m < 0) {
            m = m + s;
        }
        return m;
    }

    /** Slot index for chunk coords (cx, cz). */
    fn slotFor(self, cx : i32, cz : i32) : i32 {
        return self.wrap(cz) * config::span + self.wrap(cx);
    }

    /** True if `slot` currently holds chunk (cx, cz). */
    fn owns(self, slot : i32, cx : i32, cz : i32) : bool {
        return self.loaded[slot] == 1 && self.cxs[slot] == cx && self.czs[slot] == cz;
    }

    /** Block id at a world voxel; bedrock below 0, air above / unloaded. */
    fn worldGet(self, cell : IVec3) : Block {
        if (cell.y < 0) {
            return Block::Stone;
        }
        if (cell.y >= config::worldHeight) {
            return Block::Air;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(cell.x, s);
        let cz : i32 = self.floorDiv(cell.z, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return Block::Air;
        }
        return self.store.getVox(slot, ivec3(cell.x - cx * s, cell.y, cell.z - cz * s));
    }

    // ── Per-slot mesh-dirty bridge (read back by the manager's flush) ──

    /** Flag a slot's light as changed so the manager re-meshes it. */
    fn markDirty(mut self, slot : i32) : void {
        self.lights.ldirty[slot] = 1;
    }

    /** Flag a chunk dirty, but only if it is currently loaded at (cx, cz). */
    fn markDirtyAt(mut self, cx : i32, cz : i32) : void {
        let slot : i32 = self.slotFor(cx, cz);
        if (self.owns(slot, cx, cz)) {
            self.lights.ldirty[slot] = 1;
        }
    }

    /** Consume a slot's dirty flag: return whether it was set, clearing it. */
    fn takeDirty(mut self, slot : i32) : bool {
        if (self.lights.ldirty[slot] == 1) {
            self.lights.ldirty[slot] = 0;
            return true;
        }
        return false;
    }

    /** Flag a slot for a sky-access re-bake (after its geometry/light changed). */
    fn flagSkyAO(mut self, slot : i32) : void {
        self.lights.skyAOdirty[slot] = 1;
    }

    // ── Block + sky light (flood-fill; opaque blocks cast shadow) ──

    /**
     * Light level (0..15) of one channel volume at a world voxel; 0 if unloaded
     * / out of range. `vol` selects the block-light or sky-light byte volume.
     * @param vol   the light byte volume (lights.light or lights.skylight)
     * @param cell  the world voxel
     * @return the level 0..15
     */
    fn lvGetW(self, vol : i64, cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 0;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(cell.x, s);
        let cz : i32 = self.floorDiv(cell.z, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return 0;
        }
        return readU8(vol, self.store.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64);
    }

    /**
     * Set one channel volume's light at a world voxel (owner chunk), flagging the
     * slot for re-mesh if the value actually changed.
     * @param vol   the light byte volume (lights.light or lights.skylight)
     * @param cell  the world voxel
     * @param v     the new level 0..15
     */
    fn lvSetW(mut self, vol : i64, cell : IVec3, v : i32) : void {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(cell.x, s);
        let cz : i32 = self.floorDiv(cell.z, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return;
        }
        let off : i64 = self.store.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64;
        if (readU8(vol, off) != v) {
            writeU8(vol, off, v);
            self.lights.ldirty[slot] = 1;
        }
    }

    /** Block-light level (0..15) at a world voxel; 0 if unloaded / out of range. */
    fn blGetW(self, cell : IVec3) : i32 {
        return self.lvGetW(self.lights.vols.light, cell);
    }

    /** Set block light at a world voxel; flags the slot for re-mesh if changed. */
    fn blSetW(mut self, cell : IVec3, v : i32) : void {
        self.lvSetW(self.lights.vols.light, cell, v);
    }

    /** Sky-light level (0..15) at a world voxel; 0 if unloaded / out of range. */
    fn skGetW(self, cell : IVec3) : i32 {
        return self.lvGetW(self.lights.vols.skylight, cell);
    }

    /** Set sky light at a world voxel; flags the slot for re-mesh if changed. */
    fn skSetW(mut self, cell : IVec3, v : i32) : void {
        self.lvSetW(self.lights.vols.skylight, cell, v);
    }

    /**
     * Recompute a column's sky light: 15 from the top down to the first opaque
     * block, 0 below it.
     * @param wx  world x
     * @param wz  world z
     */
    fn skyColumn(mut self, wx : i32, wz : i32) : void {
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(wx, s);
        let cz : i32 = self.floorDiv(wz, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return;
        }
        let lx : i32 = wx - cx * s;
        let lz : i32 = wz - cz * s;
        let lit : i32 = 15;
        let y : i32 = config::worldHeight - 1;
        while (y >= 0) {
            if (lit > 0 && isOpaque(self.store.getVox(slot, ivec3(lx, y, lz)))) {
                lit = 0;
            }
            let off : i64 = self.store.voxIdx(slot, lx, y, lz) as i64;
            if (readU8(self.lights.vols.skylight, off) != lit) {
                writeU8(self.lights.vols.skylight, off, lit);
                self.lights.ldirty[slot] = 1;
            }
            y = y - 1;
        }
    }

    /**
     * Seed sky light for a freshly generated chunk: set each column's vertical
     * exposure, then flood the sideways gradient so overhung / roofed spots fade
     * in instead of leaving a hard black patch.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn seedSky(mut self, slot : i32, cx : i32, cz : i32) : void {
        let s : i32 = config::chunkSize;
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                self.skyColumn(cx * s + lx, cz * s + lz);
                lx = lx + 1;
            }
            lz = lz + 1;
        }
        self.lights.lqn = 0;
        let top : i32 = self.store.maxFY[slot] + 1;
        if (top > config::worldHeight - 1) {
            top = config::worldHeight - 1;
        }
        let bz : i32 = 0;
        while (bz < s) {
            let bx : i32 = 0;
            while (bx < s) {
                let by : i32 = 0;
                while (by <= top) {
                    if (readU8(self.lights.vols.skylight, self.store.voxIdx(slot, bx, by, bz) as i64) == 15) {
                        self.lpush(ivec3(cx * s + bx, by, cz * s + bz));
                    }
                    by = by + 1;
                }
                bx = bx + 1;
            }
            bz = bz + 1;
        }
        self.floodAddCh(self.lights.vols.skylight);
    }

    /**
     * Spread one channel's light into a neighbour, losing one level per block,
     * when it would be brighter there (and the neighbour isn't opaque).
     * @param vol        the light volume (lights.light or lights.skylight)
     * @param neighbour  the neighbour world voxel
     * @param lv         this cell's level (the neighbour gets lv-1)
     */
    fn trySpreadCh(mut self, vol : i64, neighbour : IVec3, lv : i32) : void {
        if (isOpaque(self.worldGet(neighbour))) {
            return;
        }
        if (self.lvGetW(vol, neighbour) < lv - 1) {
            self.lvSetW(vol, neighbour, lv - 1);
            self.lpush(neighbour);
        }
    }

    /**
     * Flood one channel's add-stack to completion: each popped cell spreads to
     * its 6 neighbours.
     * @param vol  the light volume (lights.light or lights.skylight)
     */
    fn floodAddCh(mut self, vol : i64) : void {
        while (self.lights.lqn > 0) {
            self.lights.lqn = self.lights.lqn - 1;
            let entry : IVec3 = self.lights.lq[self.lights.lqn];
            let lv : i32 = self.lvGetW(vol, entry);
            if (lv > 1) {
                self.trySpreadCh(vol, ivec3(entry.x + 1, entry.y, entry.z), lv);
                self.trySpreadCh(vol, ivec3(entry.x - 1, entry.y, entry.z), lv);
                self.trySpreadCh(vol, ivec3(entry.x, entry.y + 1, entry.z), lv);
                self.trySpreadCh(vol, ivec3(entry.x, entry.y - 1, entry.z), lv);
                self.trySpreadCh(vol, ivec3(entry.x, entry.y, entry.z + 1), lv);
                self.trySpreadCh(vol, ivec3(entry.x, entry.y, entry.z - 1), lv);
            }
        }
    }

    /**
     * One channel removal neighbour step: a neighbour dimmer than the removed
     * level is cleared and queued for further removal; an equal/brighter
     * neighbour is a surviving source, queued onto the add-stack to refill.
     * @param vol        the light volume (lights.light or lights.skylight)
     * @param neighbour  the neighbour world voxel
     * @param lvl        the level being removed from the parent cell
     */
    fn tryRemoveCh(mut self, vol : i64, neighbour : IVec3, lvl : i32) : void {
        let nl : i32 = self.lvGetW(vol, neighbour);
        if (nl != 0) {
            if (nl < lvl) {
                self.lvSetW(vol, neighbour, 0);
                self.rpush(neighbour, nl);
            } else {
                self.lpush(neighbour);
            }
        }
    }

    /**
     * Flood one channel's removal stack, feeding the add-stack from surviving
     * (brighter/equal) sources so they refill the cleared region.
     * @param vol  the light volume (lights.light or lights.skylight)
     */
    fn floodRemoveCh(mut self, vol : i64) : void {
        while (self.lights.rqn > 0) {
            self.lights.rqn = self.lights.rqn - 1;
            let entry : LightRemoval = self.lights.rq[self.lights.rqn];
            self.tryRemoveCh(vol, ivec3(entry.x + 1, entry.y, entry.z), entry.lvl);
            self.tryRemoveCh(vol, ivec3(entry.x - 1, entry.y, entry.z), entry.lvl);
            self.tryRemoveCh(vol, ivec3(entry.x, entry.y + 1, entry.z), entry.lvl);
            self.tryRemoveCh(vol, ivec3(entry.x, entry.y - 1, entry.z), entry.lvl);
            self.tryRemoveCh(vol, ivec3(entry.x, entry.y, entry.z + 1), entry.lvl);
            self.tryRemoveCh(vol, ivec3(entry.x, entry.y, entry.z - 1), entry.lvl);
        }
    }

    /** Push a cell onto the (shared block/sky) light add-stack; dropped if full. */
    fn lpush(mut self, cell : IVec3) : void {
        if (self.lights.lqn >= config::lightQueueCap) {
            return;
        }
        self.lights.lq[self.lights.lqn] = IVec3 { x: cell.x, y: cell.y, z: cell.z };
        self.lights.lqn = self.lights.lqn + 1;
    }

    /** Push a cell plus its old level onto the light removal-stack; dropped if full. */
    fn rpush(mut self, cell : IVec3, lvl : i32) : void {
        if (self.lights.rqn >= config::lightQueueCap) {
            return;
        }
        self.lights.rq[self.lights.rqn] = LightRemoval { x: cell.x, y: cell.y, z: cell.z, lvl: lvl };
        self.lights.rqn = self.lights.rqn + 1;
    }

    /**
     * Recompute block + sky light after ANY edit at a world voxel. Clears the
     * light that ran through the cell, re-seeds emission, then re-floods from the
     * cell's neighbours; reconciles the edited column's sky exposure and the
     * sideways sky gradient. Flags every touched slot (plus border neighbours)
     * dirty — the MANAGER runs the actual re-mesh flush afterwards.
     * @param cell  the edited world voxel
     */
    fn lightUpdate(mut self, cell : IVec3) : void {
        let wx : i32 = cell.x;
        let wy : i32 = cell.y;
        let wz : i32 = cell.z;
        self.lights.lqn = 0;
        self.lights.rqn = 0;
        // 1. Remove the light currently at the cell and everything it fed.
        let cur : i32 = self.blGetW(cell);
        self.blSetW(cell, 0);
        self.rpush(cell, cur + 1);
        self.floodRemoveCh(self.lights.vols.light);
        // 2. If the block now there emits light, re-seed it.
        let emit : i32 = lightEmission(self.worldGet(ivec3(wx, wy, wz)));
        if (emit > 0) {
            self.blSetW(cell, emit);
            self.lpush(cell);
        }
        // 3. Let light from the 6 neighbours flow into / around the cell.
        self.lpush(ivec3(wx + 1, wy, wz));
        self.lpush(ivec3(wx - 1, wy, wz));
        self.lpush(ivec3(wx, wy + 1, wz));
        self.lpush(ivec3(wx, wy - 1, wz));
        self.lpush(ivec3(wx, wy, wz + 1));
        self.lpush(ivec3(wx, wy, wz - 1));
        self.floodAddCh(self.lights.vols.light);
        // 4. Sky light: reconcile the edited column's vertical exposure — seed a
        // REMOVAL where a cell darkened and an ADD where it brightened — then
        // flood both, so sky light recedes as well as fills.
        self.lights.lqn = 0;
        self.lights.rqn = 0;
        let scx : i32 = self.floorDiv(wx, config::chunkSize);
        let scz : i32 = self.floorDiv(wz, config::chunkSize);
        let sslot : i32 = self.slotFor(scx, scz);
        if (self.owns(sslot, scx, scz)) {
            let slx : i32 = wx - scx * config::chunkSize;
            let slz : i32 = wz - scz * config::chunkSize;
            let lit : i32 = 15;
            let cy : i32 = config::worldHeight - 1;
            while (cy >= 0) {
                if (lit > 0 && isOpaque(self.store.getVox(sslot, ivec3(slx, cy, slz)))) {
                    lit = 0;
                }
                let coff : i64 = self.store.voxIdx(sslot, slx, cy, slz) as i64;
                let oldv : i32 = readU8(self.lights.vols.skylight, coff);
                if (oldv > lit) {
                    writeU8(self.lights.vols.skylight, coff, lit);
                    self.lights.ldirty[sslot] = 1;
                    self.rpush(ivec3(wx, cy, wz), oldv);
                } else if (lit > oldv) {
                    writeU8(self.lights.vols.skylight, coff, lit);
                    self.lights.ldirty[sslot] = 1;
                    self.lpush(ivec3(wx, cy, wz));
                }
                cy = cy - 1;
            }
        }
        self.floodRemoveCh(self.lights.vols.skylight);
        // Also seed the add from the edited cell + its 6 neighbours, so the
        // sideways sky gradient flows into a newly opened space even when the
        // edit doesn't change the column.
        self.lpush(cell);
        self.lpush(ivec3(wx + 1, wy, wz));
        self.lpush(ivec3(wx - 1, wy, wz));
        self.lpush(ivec3(wx, wy + 1, wz));
        self.lpush(ivec3(wx, wy - 1, wz));
        self.lpush(ivec3(wx, wy, wz + 1));
        self.lpush(ivec3(wx, wy, wz - 1));
        self.floodAddCh(self.lights.vols.skylight);
        // A border face is baked from the NEIGHBOUR chunk's light, which didn't
        // change — re-flag the edited chunk plus any border neighbour so their
        // shared faces re-bake with the final light.
        let ecs : i32 = config::chunkSize;
        let ecx : i32 = self.floorDiv(wx, ecs);
        let ecz : i32 = self.floorDiv(wz, ecs);
        let elx : i32 = wx - ecx * ecs;
        let elz : i32 = wz - ecz * ecs;
        self.markDirtyAt(ecx, ecz);
        if (elx == 0) { self.markDirtyAt(ecx - 1, ecz); }
        if (elx == ecs - 1) { self.markDirtyAt(ecx + 1, ecz); }
        if (elz == 0) { self.markDirtyAt(ecx, ecz - 1); }
        if (elz == ecs - 1) { self.markDirtyAt(ecx, ecz + 1); }
    }

    /**
     * Reset a slot's per-voxel light maps for a freshly (re)generated chunk:
     * block + sky light to 0, sun visibility + sky access to full, the
     * colour-bounce tint to neutral, and flag the slot for a sky-AO bake.
     * @param slot  the slot index
     */
    fn clearLight(mut self, slot : i32) : void {
        let hSide : i32 = config::chunkSize + 2;
        let n : i32 = hSide * hSide * config::worldHeight;
        let base : i64 = (slot as i64) * (n as i64);
        let i : i32 = 0;
        while (i < n) {
            writeU8(self.lights.vols.light, base + (i as i64), 0);
            writeU8(self.lights.vols.skylight, base + (i as i64), 0);
            writeU8(self.lights.vols.sunlit, base + (i as i64), 255);
            writeU8(self.lights.vols.skyaccess, base + (i as i64), 255);
            writeU8(self.lights.vols.bnR, base + (i as i64), 128);
            writeU8(self.lights.vols.bnG, base + (i as i64), 128);
            writeU8(self.lights.vols.bnB, base + (i as i64), 128);
            i = i + 1;
        }
        self.lights.skyAOdirty[slot] = 1;
    }

    // ── Directional sun shadows ─────────────────────────────────

    /**
     * Sun visibility at a world voxel: 0 (shadow) .. 255 (full sun). Out of
     * range / unloaded reads full sun so it never darkens a face wrongly.
     * @param cell  the world voxel
     * @return soft sun visibility 0..255
     */
    fn sunlitGet(self, cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 255;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(cell.x, s);
        let cz : i32 = self.floorDiv(cell.z, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return 255;
        }
        return readU8(self.lights.vols.sunlit, self.store.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64);
    }

    /**
     * March a ray from an air cell toward the sun: 1 if it escapes above all
     * terrain (`ceil`) or runs the full reach unobstructed, 0 if blocked.
     * @param cell  origin air cell
     * @param dir   sun direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     * @return 1 sunlit, 0 shadowed
     */
    fn sunRayClear(self, cell : IVec3, dir : Vec3, ceil : i32) : i32 {
        let ox : f64 = (cell.x as f64) + 0.5;
        let oy : f64 = (cell.y as f64) + 0.5;
        let oz : f64 = (cell.z as f64) + 0.5;
        let t : f64 = 0.5;
        while (t < config::sunShadowReach) {
            let cy : i32 = Math::floorToInt(oy + dir.y * t) as i32;
            if (cy > ceil) {
                return 1;
            }
            if (cy >= 0 && cy < config::worldHeight) {
                let cx : i32 = Math::floorToInt(ox + dir.x * t) as i32;
                let cz : i32 = Math::floorToInt(oz + dir.z * t) as i32;
                if (isOpaque(self.worldGet(ivec3(cx, cy, cz)))) {
                    return 0;
                }
            }
            t = t + 0.6;
        }
        return 1;
    }

    /**
     * Soft sun visibility (penumbra): cast config::sunShadowSamples rays over the
     * sun's angular disc and return the fraction that reach the sun (0..255).
     * @param cell  origin air cell
     * @param dir   sun direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     * @return soft visibility 0..255
     */
    fn sunRaySoft(self, cell : IVec3, dir : Vec3, ceil : i32) : i32 {
        let n : i32 = config::sunShadowSamples;
        if (n < 1) {
            n = 1;
        }
        let total : i32 = self.sunRayClear(cell, dir, ceil);
        if (n == 1) {
            return total * 255;
        }
        let ux : f64 = 0.0;
        let uy : f64 = 1.0;
        let uz : f64 = 0.0;
        if (dir.y > 0.9 || dir.y < 0.0 - 0.9) {
            ux = 1.0;
            uy = 0.0;
            uz = 0.0;
        }
        let tx : f64 = uy * dir.z - uz * dir.y;
        let ty : f64 = uz * dir.x - ux * dir.z;
        let tz : f64 = ux * dir.y - uy * dir.x;
        let tl : f64 = Math::sqrt(tx * tx + ty * ty + tz * tz);
        if (tl < 0.000001) {
            tl = 0.000001;
        }
        tx = tx / tl;
        ty = ty / tl;
        tz = tz / tl;
        let bx : f64 = dir.y * tz - dir.z * ty;
        let by : f64 = dir.z * tx - dir.x * tz;
        let bz : f64 = dir.x * ty - dir.y * tx;
        let hash : i32 = (cell.x * 1664525 + cell.y * 22695477 + cell.z * 40503) & 0x7FFFFFFF;
        let rot : f64 = ((hash % 628) as f64) * 0.01;
        let r : f64 = config::sunDiscAngle;
        let cnt : i32 = 1;
        let i : i32 = 1;
        while (i < n) {
            let ang : f64 = 6.2831853 * ((i - 1) as f64) / ((n - 1) as f64) + rot;
            let ox : f64 = Math::cos(ang) * r;
            let oy : f64 = Math::sin(ang) * r;
            let dx : f64 = dir.x + tx * ox + bx * oy;
            let dy : f64 = dir.y + ty * ox + by * oy;
            let dz : f64 = dir.z + tz * ox + bz * oy;
            let dl : f64 = Math::sqrt(dx * dx + dy * dy + dz * dz);
            if (dl < 0.000001) {
                dl = 0.000001;
            }
            total = total + self.sunRayClear(cell, vec3(dx / dl, dy / dl, dz / dl), ceil);
            cnt = cnt + 1;
            i = i + 1;
        }
        return (total * 255) / cnt;
    }

    /**
     * Recompute sun visibility for one chunk: every sky-lit air cell in the
     * active band gets a ray cast toward the sun.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     * @param sun   sun direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     */
    fn computeChunkSun(mut self, slot : i32, cx : i32, cz : i32, sun : Vec3, ceil : i32) : void {
        let s : i32 = config::chunkSize;
        let top : i32 = self.store.maxFY[slot] + 1;
        if (top > config::worldHeight - 1) {
            top = config::worldHeight - 1;
        }
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                let y : i32 = 0;
                while (y <= top) {
                    let off : i64 = self.store.voxIdx(slot, lx, y, lz) as i64;
                    if (self.store.getVox(slot, ivec3(lx, y, lz)) == Block::Air && readU8(self.lights.vols.skylight, off) > 0) {
                        writeU8(self.lights.vols.sunlit, off, self.sunRaySoft(ivec3(cx * s + lx, y, cz * s + lz), sun, ceil));
                    }
                    y = y + 1;
                }
                lx = lx + 1;
            }
            lz = lz + 1;
        }
    }

    /**
     * Throttled directional-shadow refresh: recompute up to `budget` loaded
     * chunks per call (round-robin). Skipped at night.
     * @param dayTime  time of day (0..1)
     * @param budget   max chunks to refresh this call
     */
    fn stepSunShadows(mut self, dayTime : f64, budget : i32) : void {
        let ang : f64 = (dayTime - 0.25) * 6.2831853;
        let sy : f64 = Math::sin(ang);
        if (sy <= 0.02) {
            return;
        }
        let sx : f64 = Math::cos(ang);
        let sz : f64 = config::sunTilt;
        let len : f64 = Math::sqrt(sx * sx + sy * sy + sz * sz);
        if (len < 0.0001) {
            len = 0.0001;
        }
        sx = sx / len;
        sy = sy / len;
        sz = sz / len;
        let slots : i32 = config::span * config::span;
        let ceil : i32 = 0;
        let j : i32 = 0;
        while (j < slots) {
            if (self.loaded[j] == 1 && self.store.maxFY[j] > ceil) {
                ceil = self.store.maxFY[j];
            }
            j = j + 1;
        }
        let done : i32 = 0;
        let guard : i32 = 0;
        while (done < budget && guard < slots) {
            let slot : i32 = self.lights.sunCursor;
            self.lights.sunCursor = self.lights.sunCursor + 1;
            if (self.lights.sunCursor >= slots) {
                self.lights.sunCursor = 0;
            }
            guard = guard + 1;
            if (self.loaded[slot] == 1) {
                self.computeChunkSun(slot, self.cxs[slot], self.czs[slot], vec3(sx, sy, sz), ceil);
                done = done + 1;
            }
        }
    }

    // ── Hemispherical sky-access (ambient occlusion / GI) ────────

    /**
     * Sky access 0..255 at a world voxel: 255 = fully open, lower = occluded.
     * Out of range / unloaded reads fully open.
     * @param cell  the world voxel
     * @return the sky access 0..255
     */
    fn skyaccessGet(self, cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 255;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(cell.x, s);
        let cz : i32 = self.floorDiv(cell.z, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return 255;
        }
        return readU8(self.lights.vols.skyaccess, self.store.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64);
    }

    /**
     * Soft sun visibility averaged over the 4 air cells meeting at a face corner,
     * so the cast shadow interpolates smoothly across faces. Returns 0..255.
     * @param base  the corner's own air cell
     * @param t1    first in-plane tangent offset
     * @param t2    second in-plane tangent offset
     * @return the averaged soft sun visibility 0..255
     */
    fn sunSoftCorner(self, base : IVec3, t1 : IVec3, t2 : IVec3) : i32 {
        let a : i32 = self.sunlitGet(base);
        let b : i32 = self.sunlitGet(ivec3(base.x + t1.x, base.y + t1.y, base.z + t1.z));
        let c : i32 = self.sunlitGet(ivec3(base.x + t2.x, base.y + t2.y, base.z + t2.z));
        let d : i32 = self.sunlitGet(ivec3(base.x + t1.x + t2.x, base.y + t1.y + t2.y, base.z + t1.z + t2.z));
        return (a + b + c + d) / 4;
    }

    /**
     * Encode a bounce tint channel: normalised colour ratio `ratio` blended
     * toward neutral by `occ`, stored as a byte where 128 = ×1.0.
     * @param ratio  the channel's colour ratio (1.0 = neutral grey)
     * @param occ    occlusion weight 0..1
     * @return the packed byte (0..255, 128 = ×1.0)
     */
    fn bounceByte(self, ratio : f64, occ : f64) : i32 {
        let f : f64 = 1.0 + (ratio - 1.0) * occ;
        let v : i32 = Math::floorToInt(f * 128.0) as i32;
        if (v < 0) {
            v = 0;
        }
        if (v > 255) {
            v = 255;
        }
        return v;
    }

    /**
     * Packed one-bounce coloured tint (r<<16|g<<8|b, each 128 = ×1.0) at a world
     * voxel; neutral grey (0x808080) out of range / unloaded.
     * @param cell  the world voxel
     * @return the packed bounce tint (0xRRGGBB)
     */
    fn bounceGet(self, cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 0x808080;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = self.floorDiv(cell.x, s);
        let cz : i32 = self.floorDiv(cell.z, s);
        let slot : i32 = self.slotFor(cx, cz);
        if (!self.owns(slot, cx, cz)) {
            return 0x808080;
        }
        let off : i64 = self.store.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64;
        return (readU8(self.lights.vols.bnR, off) << 16) | (readU8(self.lights.vols.bnG, off) << 8) | readU8(self.lights.vols.bnB, off);
    }

    /**
     * March one hemisphere ray from a cell; returns -1 if it escapes, else the
     * packed albedo of the opaque voxel it hits.
     * @param cell  origin air cell
     * @param dir   ray direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     * @return -1 if it escapes to the sky, else the packed albedo it hit
     */
    fn skyHemiHit(self, cell : IVec3, dir : Vec3, ceil : i32) : i32 {
        let ox : f64 = (cell.x as f64) + 0.5;
        let oy : f64 = (cell.y as f64) + 0.5;
        let oz : f64 = (cell.z as f64) + 0.5;
        let t : f64 = 0.6;
        while (t < config::skyAOReach) {
            let cy : i32 = Math::floorToInt(oy + dir.y * t) as i32;
            if (cy > ceil) {
                return 0 - 1;
            }
            if (cy >= 0 && cy < config::worldHeight) {
                let cx : i32 = Math::floorToInt(ox + dir.x * t) as i32;
                let cz : i32 = Math::floorToInt(oz + dir.z * t) as i32;
                let hb : Block = self.worldGet(ivec3(cx, cy, cz));
                if (isOpaque(hb)) {
                    return albedoFor(hb);
                }
            }
            t = t + 0.7;
        }
        return 0 - 1;
    }

    /**
     * Bake hemispherical sky access for one chunk: every open, sky-lit air cell
     * in the active band casts the M precomputed hemisphere rays and stores the
     * escaped fraction (0..255) plus the one-bounce coloured tint.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     * @param ceil  tallest terrain Y over loaded chunks
     */
    fn computeChunkSkyAO(mut self, slot : i32, cx : i32, cz : i32, ceil : i32) : void {
        let s : i32 = config::chunkSize;
        let m : i32 = config::skyAOSamples;
        let top : i32 = self.store.maxFY[slot] + 1;
        if (top > config::worldHeight - 1) {
            top = config::worldHeight - 1;
        }
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                let y : i32 = 0;
                while (y <= top) {
                    let off : i64 = self.store.voxIdx(slot, lx, y, lz) as i64;
                    if (self.store.getVox(slot, ivec3(lx, y, lz)) == Block::Air && readU8(self.lights.vols.skylight, off) > 0) {
                        let wx : i32 = cx * s + lx;
                        let wz : i32 = cz * s + lz;
                        let esc : i32 = 0;
                        let hits : i32 = 0;
                        let ar : i32 = 0;
                        let ag : i32 = 0;
                        let ab : i32 = 0;
                        let r : i32 = 0;
                        while (r < m) {
                            let dir : Vec3 = vec3(getF64(self.lights.rays.hemiX, r), getF64(self.lights.rays.hemiY, r), getF64(self.lights.rays.hemiZ, r));
                            let hit : i32 = self.skyHemiHit(ivec3(wx, y, wz), dir, ceil);
                            if (hit < 0) {
                                esc = esc + 1;
                            } else {
                                ar = ar + ((hit >> 16) & 0xFF);
                                ag = ag + ((hit >> 8) & 0xFF);
                                ab = ab + (hit & 0xFF);
                                hits = hits + 1;
                            }
                            r = r + 1;
                        }
                        writeU8(self.lights.vols.skyaccess, off, (esc * 255) / m);
                        if (config::bounceOn && hits > 0) {
                            let avr : f64 = (ar as f64) / (hits as f64);
                            let avg : f64 = (ag as f64) / (hits as f64);
                            let avb : f64 = (ab as f64) / (hits as f64);
                            let lum : f64 = 0.299 * avr + 0.587 * avg + 0.114 * avb;
                            if (lum < 1.0) {
                                lum = 1.0;
                            }
                            let occ : f64 = (hits as f64) / (m as f64) * config::bounceStrength;
                            writeU8(self.lights.vols.bnR, off, self.bounceByte(avr / lum, occ));
                            writeU8(self.lights.vols.bnG, off, self.bounceByte(avg / lum, occ));
                            writeU8(self.lights.vols.bnB, off, self.bounceByte(avb / lum, occ));
                        } else {
                            writeU8(self.lights.vols.bnR, off, 128);
                            writeU8(self.lights.vols.bnG, off, 128);
                            writeU8(self.lights.vols.bnB, off, 128);
                        }
                    }
                    y = y + 1;
                }
                lx = lx + 1;
            }
            lz = lz + 1;
        }
    }

    /**
     * Throttled sky-access bake: process up to `budget` dirty loaded chunks per
     * call (round-robin). Idles once every loaded chunk is baked.
     * @param budget  max chunks to bake this call
     */
    fn stepSkyAO(mut self, budget : i32) : void {
        let slots : i32 = config::span * config::span;
        let ceil : i32 = 0;
        let j : i32 = 0;
        while (j < slots) {
            if (self.loaded[j] == 1 && self.store.maxFY[j] > ceil) {
                ceil = self.store.maxFY[j];
            }
            j = j + 1;
        }
        let done : i32 = 0;
        let guard : i32 = 0;
        while (done < budget && guard < slots) {
            let slot : i32 = self.lights.skyAOcursor;
            self.lights.skyAOcursor = self.lights.skyAOcursor + 1;
            if (self.lights.skyAOcursor >= slots) {
                self.lights.skyAOcursor = 0;
            }
            guard = guard + 1;
            if (self.loaded[slot] == 1 && self.lights.skyAOdirty[slot] == 1) {
                self.computeChunkSkyAO(slot, self.cxs[slot], self.czs[slot], ceil);
                self.lights.skyAOdirty[slot] = 0;
                done = done + 1;
            }
        }
    }

    /**
     * One pass of the whole lighting system: refresh the directional sun-shadow
     * map and bake any pending hemispherical sky-access / colour-bounce. Run by
     * the dedicated light thread, reading the time of day the main loop publishes.
     */
    fn stepBake(mut self) : void {
        self.stepSunShadows(self.curDayTime, config::sunChunksPerTick);
        self.stepSkyAO(config::skyAOChunksPerTick);
    }

    /** Publish the current time of day for the background light thread. */
    fn setDayTime(mut self, d : f64) : void {
        self.curDayTime = d;
    }

    /** Tell the background light thread to stop (call before joining it). */
    fn stopLight(mut self) : void {
        self.lightRunning.set(false);
    }

    /** Whether the background light thread should keep running. */
    fn lightAlive(self) : bool {
        return self.lightRunning.get();
    }
}
