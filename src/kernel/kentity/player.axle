// player — the human entity and the camera in one. Extends Entity, so it
// falls, lands and walks up ledges through the shared physics; on top it
// adds first-person look (yaw/pitch with cached sin/cos), eye position for
// the renderer, walking/sprinting/jumping/swimming, and the survival
// loop: fall damage, drowning, and health regeneration. There is no
// floating fly-camera any more — where you look is where you walk, and
// gravity always has a say.

use crate::kernel::kentity::entity::Entity;
use crate::kernel::seams::VoxelQuery;
use crate::kernel::kblock::blocks::{ isWater };
use crate::config;
use crate::config::{ Block };
use crate::kernel::kmath::mathx::{ clampF64 };
use crate::kernel::kmath::vec3::{ Vec3, vec3, ivec3 };

/**
 * Compétence: first-person aim — apply a yaw / pitch look delta and refresh the
 * cached trig and the eye position the renderer projects from. Where you look is
 * where you walk.
 */
trait Looks {
    fn look(mut self, dyaw : f64, dpitch : f64) : void;
    fn refresh(mut self) : void;
}

/**
 * Compétence: the survival upkeep loop — fall damage on a hard landing, drowning
 * while submerged, and health regeneration once unhurt for a while. One call
 * resolves all three from this frame's state.
 */
trait Survives {
    fn survive(mut self) : void;
}

/** Compétence: a hotbar inventory — select a slot and read the held block. */
trait Inventory {
    fn selectSlot(mut self, i : i32) : void;
    fn heldBlock(self) : Block;
}

class Player : Entity, Looks, Survives, Inventory {
    yaw : f64,
    pitch : f64,
    siny : f64,
    cosy : f64,
    sinp : f64,
    cosp : f64,
    eye : Vec3,
    airTicks : i32,
    drownTick : i32,
    sinceHurt : i32,
    regenTick : i32,
    creative : i32,   // 0 = survival, 1 = creative (fly)
    headInWater : bool,   // eye voxel is water → underwater visuals / drowning
    hotbar : Block[],   // block id held in each inventory slot
    selected : i32,   // active hotbar slot (0-based)

    /** Construct a player at (x, y, z) with a stocked hotbar and full HP. */
    constructor(x : f64, y : f64, z : f64) {
        self.pos = vec3(x, y, z);
        self.velY = 0.0;
        self.radius = config::playerRadius;
        self.height = config::playerHeight;
        self.gravityScale = 1.0;
        self.hp = config::playerMaxHp;
        self.maxHp = config::playerMaxHp;
        self.onGround = 0;
        self.impact = 0.0;
        self.grav = config::gravity;
        self.apexY = y;
        self.stepUp = 0.0;
        self.inWater = false;
        self.yaw = 0.0;
        self.pitch = 0.0 - 0.18;
        self.siny = 0.0;
        self.cosy = 1.0;
        self.sinp = 0.0;
        self.cosp = 1.0;
        self.eye = vec3(x, y + config::eyeHeight, z);
        self.airTicks = 0;
        self.drownTick = config::drownEveryFrames;
        self.sinceHurt = 0;
        self.regenTick = config::regenEveryFrames;
        self.creative = 0;
        self.headInWater = false;
        self.hotbar = malloc<Block>(config::hotbarSize);
        self.hotbar[0] = Block::Grass;
        self.hotbar[1] = Block::Dirt;
        self.hotbar[2] = Block::Stone;
        self.hotbar[3] = Block::Sand;
        self.hotbar[4] = Block::Snow;
        self.hotbar[5] = Block::Gravel;
        self.hotbar[6] = Block::Wood;
        self.hotbar[7] = Block::Torch;
        self.hotbar[8] = Block::Water;
        self.selected = 0;
    }

    /**
     * Select hotbar slot `i` (ignored if out of range).
     * @param i  hotbar slot index to activate
     */
    fn selectSlot(mut self, i : i32) : void {
        if (i >= 0 && i < config::hotbarSize) {
            self.selected = i;
        }
    }

    /**
     * The block id currently held for placing.
     * @return block id in the active hotbar slot
     */
    fn heldBlock(self) : Block {
        return self.hotbar[self.selected];
    }

    /**
     * Toggle survival ↔ creative. Creative enables free flight; entering
     * it cancels any fall, leaving it restores normal gravity.
     */
    fn toggleGameMode(mut self) : void {
        if (self.creative == 0) {
            self.creative = 1;
            self.velY = 0.0;
        } else {
            self.creative = 0;
        }
    }

    /** Recompute look trig and the eye position the renderer projects from. */
    fn refresh(mut self) : void {
        self.siny = Math::sin(self.yaw);
        self.cosy = Math::cos(self.yaw);
        self.sinp = Math::sin(self.pitch);
        self.cosp = Math::cos(self.pitch);
        self.eye.x = self.pos.x;
        self.eye.y = self.pos.y + config::eyeHeight - self.stepUp;
        self.eye.z = self.pos.z;
    }

    /**
     * Apply a relative look delta, clamping pitch to the configured range.
     * @param dyaw    yaw change in radians
     * @param dpitch  pitch change in radians
     */
    fn look(mut self, dyaw : f64, dpitch : f64) : void {
        self.yaw = self.yaw + dyaw;
        self.pitch = clampF64(self.pitch + dpitch, 0.0 - config::pitchMax, config::pitchMax);
    }

    /**
     * Damage that also restarts the regeneration delay.
     * @param d  points of damage to apply
     */
    fn hurt(mut self, d : i32) : void {
        self.damage(d);
        self.sinceHurt = 0;
    }

    /**
     * Is the eye below sea level (so the player is submerged)?
     * @return true when the eye height is under the sea level
     */
    fn isUnderwater(self) : bool {
        return self.headInWater;
    }

    /**
     * Full per-frame update. `fwd`/`strafe` are in [-1,1]; `up`/`down`
     * drive vertical flight in creative. Survival applies gravity + the
     * survival effects (fall / drown / regen); creative flies freely with
     * no damage. Refreshes the camera at the end.
     * @param world   chunk manager queried for solid voxels
     * @param fwd     forward intent in [-1, 1]
     * @param strafe  strafe intent in [-1, 1]
     * @param sprint  whether the sprint modifier is held
     * @param up      whether the up / jump input is held
     * @param down    whether the down input is held
     */
    fn update(mut self, world : dyn VoxelQuery, fwd : f64, strafe : f64, sprint : bool,
        up : bool, down : bool) : void {
        if (self.creative == 1) {
            self.fly(world, fwd, strafe, sprint, up, down);
            self.refresh();
            return;
        }

        let inWater : bool = self.bodyInWater(world);
        self.inWater = inWater;
        // Submerged = the eye's own voxel is water, at any altitude (not the
        // absolute sea level) — this is what drives the underwater visuals and
        // drowning, so a pool you dug on a hill counts too.
        let ex : i32 = Math::floorToInt(self.pos.x) as i32;
        let ey : i32 = Math::floorToInt(self.pos.y + config::eyeHeight) as i32;
        let ez : i32 = Math::floorToInt(self.pos.z) as i32;
        let submerged : bool = isWater(world.worldGet(ivec3(ex, ey, ez)));
        self.headInWater = submerged;

        let speed : f64 = config::walkSpeed;
        if (inWater) {
            speed = config::swimSpeed;
        } else if (sprint) {
            speed = config::sprintSpeed;
        }

        let dx : f64 = (0.0 - self.siny) * fwd + self.cosy * strafe;
        let dz : f64 = self.cosy * fwd + self.siny * strafe;
        dx = dx * speed;
        dz = dz * speed;

        if (inWater) {
            // Additive up/down swim thrust (gentle; you sink slowly and rise
            // only while Space is held). The horizontal current that carries
            // every entity is applied in Entity.tick.
            if (up) {
                self.velY = self.velY + config::swimUpAccel;
            }
            if (down) {
                self.velY = self.velY - config::swimDownSpeed;
            }
        } else if (up && self.onGround == 1) {
            self.velY = config::jumpVel;
        }

        self.tick(world, dx, dz);
        self.survive();
        self.refresh();
    }

    /**
     * Creative free flight: no gravity, faster horizontal movement,
     * Space/Shift for up/down, blocked by walls but never sinks below
     * the ground under the feet.
     * @param world   chunk manager queried for solid voxels
     * @param fwd     forward intent in [-1, 1]
     * @param strafe  strafe intent in [-1, 1]
     * @param sprint  whether the sprint modifier is held
     * @param up      whether the up input is held
     * @param down    whether the down input is held
     */
    fn fly(mut self, world : dyn VoxelQuery, fwd : f64, strafe : f64, sprint : bool,
        up : bool, down : bool) : void {
        let speed : f64 = config::flySpeed;
        if (sprint) {
            speed = config::flySprintSpeed;
        }
        let dx : f64 = ((0.0 - self.siny) * fwd + self.cosy * strafe) * speed;
        let dz : f64 = (self.cosy * fwd + self.siny * strafe) * speed;
        self.velY = 0.0;
        self.onGround = 0;
        // Horizontal move with voxel collision (no auto-step in flight).
        if (!self.collidesAt(world, self.pos.x + dx, self.pos.y, self.pos.z)) {
            self.pos.x = self.pos.x + dx;
        }
        if (!self.collidesAt(world, self.pos.x, self.pos.y, self.pos.z + dz)) {
            self.pos.z = self.pos.z + dz;
        }
        if (up) {
            self.pos.y = self.pos.y + config::flyVertSpeed;
        }
        if (down) {
            self.pos.y = self.pos.y - config::flyVertSpeed;
        }
        // Don't sink into the ground: if the body intersects blocks, lift
        // the feet onto the highest support beneath them.
        if (self.collidesAt(world, self.pos.x, self.pos.y, self.pos.z)) {
            let top : f64 = self.supportTop(world, self.pos.x, self.pos.z,
                Math::floorToInt(self.pos.y) as i32, Math::floorToInt(self.pos.y + self.height) as i32);
            self.pos.y = top;
            self.onGround = 1;
        }
    }

    /**
     * Fall damage, drowning and regeneration based on this frame's state.
     * Reads `headInWater`, already refreshed by `look` earlier this frame.
     */
    fn survive(mut self) : void {
        let water : bool = self.headInWater;
        self.sinceHurt = self.sinceHurt + 1;

        // Water cushions a fall; on land, falling far hurts (`impact` is
        // the distance dropped from the apex).
        if (!water && self.impact > config::safeFallDist) {
            let dmg : i32 = Math::floorToInt((self.impact - config::safeFallDist) * config::fallDamagePerBlock) as i32;
            if (dmg > 0) {
                self.hurt(dmg);
            }
        }

        if (water) {
            self.airTicks = self.airTicks + 1;
            if (self.airTicks > config::drownGraceFrames) {
                self.drownTick = self.drownTick - 1;
                if (self.drownTick <= 0) {
                    self.hurt(1);
                    self.drownTick = config::drownEveryFrames;
                }
            }
        } else {
            self.airTicks = 0;
            self.drownTick = config::drownEveryFrames;
        }

        if (!water && self.hp < self.maxHp && self.sinceHurt > config::regenDelayFrames) {
            self.regenTick = self.regenTick - 1;
            if (self.regenTick <= 0) {
                self.heal(1);
                self.regenTick = config::regenEveryFrames;
            }
        }
    }
}
