// mob — base class for every creature. Extends Entity, so it is pulled
// down by gravity, stands on terrain and steps up ledges with the same
// physics as the player. On top it carries the shared mob state and the
// passive `wander` AI (ease toward a heading, alternate walking with
// grazing, bolt away when struck). Each species is a subclass under
// entities/ (chicken/sheep/cow/pig/creeper) that sets its own size/speed and,
// for the creeper, its own hostile `think`. When killed a mob enters a
// `dying` state and the renderer collapses it before the manager removes it.
//
// Dispatch is by capability trait, not by species array. A mob is an `Actor`
// (the manager's uniform view: render + Brain + Flees + life-cycle), and the
// calm animals additionally `Wander`. The one virtual `think` entry replaces
// the old wander-vs-step name split: `MobManager` keeps a single `dyn Actor[]`
// and lets dynamic dispatch pick each creature's behaviour (see mobs.axle).

use crate::kernel::kentity::entity::{ Entity, Damageable };
use crate::kernel::kentity::player::Player;
use crate::kernel::seams::{ VoxelQuery, ActorVisual };
use crate::kernel::kworld::blocksim::BlockSim;
use crate::kernel::kio::sfx::AudioManager;
use crate::config;
use crate::config::{ MobKind };
use crate::kernel::kmath::mathx::{ clampF64, wrapAngle, PI, TAU };
use crate::kernel::kmath::vec3::{ Vec3, vec3 };

/**
 * The dispatched AI entry — one virtual call per physics tick. The concrete
 * species decides what "thinking" means: the calm animals graze and roam, the
 * creeper hunts and detonates. This single seam replaces the old per-species
 * `wander` / `step` split, so the manager drives every creature through the
 * same call and dynamic dispatch selects the behaviour.
 */
trait Brain {
    fn think(mut self, world : dyn VoxelQuery, player : Player, sfx : AudioManager, sim : BlockSim, rnd : f64) : void;
}

/** Compétence: the passive graze-and-roam AI shared by the calm animals. */
trait Wanders {
    fn wander(mut self, world : dyn VoxelQuery, rnd : f64) : void;
}

/** Compétence: bolt directly away from a threat when struck. */
trait Flees {
    fn panicFrom(mut self, px : f64, pz : f64) : void;
}

/**
 * Compétence: the mortality life-cycle — enter the death collapse, report
 * whether it is playing, and whether it has finished so the manager can remove
 * the corpse. (The 0→1 collapse fraction the renderer reads is the separate
 * `Animated.deathProgress` render seam.)
 */
trait Mortal {
    fn startDying(mut self) : void;
    fn isDying(self) : bool;
    fn deathDone(self) : bool;
}

/** Compétence: flash red briefly when struck (melee hit feedback). */
trait Flashes {
    fn flashHurt(mut self) : void;
}

/** Compétence: an idle voice — count down to the next ambient call and re-arm it. */
trait Vocal {
    fn wantsVoice(mut self) : bool;
    fn rearmVoice(mut self, delay : i32) : void;
}

/**
 * Compétence (mechanism): a creature that detonates — a distance-scaled hit to
 * the player and a spherical crater of broken blocks. A kernel disposition; the
 * concrete detonating species (a creeper) lives in the app.
 */
trait Explodes {
    fn explode(mut self, world : dyn VoxelQuery, player : Player, sim : BlockSim) : void;
}

/**
 * Compétence (disposition): a creature that means the player harm. Bundles the
 * detonation mechanism; the manager narrows to `is Hostile` to tell the hostile
 * species apart from the calm animals (e.g. the silent-when-hunting idle-voice
 * rule) without depending on HOW it does harm — or on a concrete species.
 */
trait Hostile : Explodes {}

/**
 * The mob-spawning seam: build one creature at (x, y, z). The kernel's
 * MobManager holds a `dyn MobSpawner` and calls it to populate the world; the
 * concrete factory (which species exist and their spawn weights — game content)
 * lives in the app and is injected via `MobManager.attachSpawner`.
 * @param rnd  a fresh pseudo-random value in [0,1) for the species roll
 */
trait MobSpawner {
    fn create(mut self, x : f64, y : f64, z : f64, rnd : f64) : Mob;
}

/**
 * Bundle: the population manager's uniform view of a living creature, composed
 * entirely from finer compétences — its render view (ActorVisual), its
 * dispatched AI (Brain), its flee reaction (Flees), its mortality (Mortal), its
 * HP pool (Damageable), its hurt flash (Flashes) and its idle voice (Vocal).
 * MobManager holds a single `dyn Actor[]` and narrows to a species disposition
 * (e.g. `is Hostile`) only where a behaviour is species-specific.
 */
trait Actor : ActorVisual, Brain, Flees, Mortal, Damageable, Flashes, Vocal {}

/** The AI countdown timers a mob ticks down each frame (all in frames). */
struct AiTimers {
    turnTimer : i32,    // until the next heading change
    fleeTimer : i32,    // of panic-run remaining
    hurtTimer : i32,    // of the red hurt-flash remaining
    deathTimer : i32,   // of the death collapse remaining
    vocalTimer : i32,   // until the next idle voice (manager-driven)
}

class Mob : Entity, Actor, Wanders {
    kind : MobKind,
    speed : f64,
    heading : f64,
    targetHeading : f64,
    moving : i32,
    walkPhase : f64,
    state : i32,        // 0 = alive, 1 = dying
    timers : AiTimers,  // AI countdowns (turn / flee / hurt / death / vocal)

    /** Create a mob at (x, y, z) of the given kind with maxHp hit points. */
    constructor(x : f64, y : f64, z : f64, own kind : MobKind, maxHp : i32) {
        self.pos = vec3(x, y, z);
        self.velY = 0.0;
        self.radius = config::mobRadius;
        self.height = 1.0;
        self.gravityScale = 1.0;
        self.hp = maxHp;
        self.maxHp = maxHp;
        self.onGround = 0;
        self.impact = 0.0;
        self.grav = config::mobGravity;
        self.apexY = y;
        self.stepUp = 0.0;
        self.kind = kind;
        self.heading = 0.0;
        self.targetHeading = 0.0;
        self.moving = 1;
        self.walkPhase = 0.0;
        self.state = 0;
        self.timers = AiTimers { turnTimer: 0, fleeTimer: 0, hurtTimer: 0, deathTimer: 0, vocalTimer: config::mobVocalMin };
        self.speed = config::mobWanderSpeed;
    }

    // ── ActorVisual (the render-facing seam krender's billboard pass reads) ──
    /**
     * This mob's species tag (chooses the box model + textures).
     * @return the mob kind
     */
    fn kind(self) : MobKind {
        return self.kind;
    }

    /**
     * The mob's feet position in world space.
     * @return the position
     */
    fn pos(self) : Vec3 {
        return self.pos;
    }

    /**
     * Facing angle in radians (the whole box model turns to it).
     * @return the heading
     */
    fn heading(self) : f64 {
        return self.heading;
    }

    /**
     * Walk-cycle phase driving the leg swing.
     * @return the walk phase
     */
    fn walkPhase(self) : f64 {
        return self.walkPhase;
    }

    /**
     * Remaining frames of the red hurt flash (0 = not flashing).
     * @return the hurt-flash countdown
     */
    fn hurtFlash(self) : i32 {
        return self.timers.hurtTimer;
    }

    /**
     * Fuse charge level, or < 0 when not charging. The base (calm) creature is
     * never charging; the creeper overrides this to expose its live fuse.
     * @return the fuse level, or a value below zero when idle
     */
    fn fuseLevel(self) : i32 {
        return 0 - 1;
    }

    // ── Combat / life-cycle ──
    /** Flag a hit so the renderer glows the mob red for a few frames. */
    fn flashHurt(mut self) : void {
        self.timers.hurtTimer = config::hurtFlashFrames;
    }

    /**
     * React to a hit from (px, pz): panic-run directly away for a while.
     * @param px  x coordinate of the source of the hit
     * @param pz  z coordinate of the source of the hit
     */
    fn panicFrom(mut self, px : f64, pz : f64) : void {
        self.targetHeading = atan2(self.pos.z - pz, self.pos.x - px);
        self.timers.fleeTimer = config::mobFleeFrames;
        self.moving = 1;
        self.timers.turnTimer = config::mobFleeFrames;
    }

    /** Begin the death collapse; the manager removes the mob when it ends. */
    fn startDying(mut self) : void {
        self.state = 1;
        self.timers.deathTimer = config::deathFrames;
        self.moving = 0;
    }

    /**
     * Whether the mob is in its death collapse.
     * @return true while dying
     */
    fn isDying(self) : bool {
        return self.state == 1;
    }

    /**
     * Whether the death collapse has finished and the mob can be removed.
     * @return true when dying and the death timer has elapsed
     */
    fn deathDone(self) : bool {
        return self.state == 1 && self.timers.deathTimer <= 0;
    }

    /**
     * Collapse progress in [0,1): 0 at the moment of death, 1 when gone.
     * @return the normalized death-collapse progress
     */
    fn deathProgress(self) : f64 {
        if (self.state == 0) {
            return 0.0;
        }
        let df : f64 = config::deathFrames as f64;
        return (df - (self.timers.deathTimer as f64)) / df;
    }

    // ── Idle voice (manager-driven) ──
    /**
     * Count the idle-voice timer down one tick; a living mob that reaches zero
     * wants to vocalise this frame. A dying mob is silent. The manager plays
     * the sound and re-arms via `rearmVoice`.
     * @return true if the mob should speak this frame
     */
    fn wantsVoice(mut self) : bool {
        if (self.state == 1) {
            return false;
        }
        self.timers.vocalTimer = self.timers.vocalTimer - 1;
        return self.timers.vocalTimer <= 0;
    }

    /**
     * Re-arm the idle-voice timer with a fresh (manager-chosen) delay.
     * @param delay  frames until the next idle voice
     */
    fn rearmVoice(mut self, delay : i32) : void {
        self.timers.vocalTimer = delay;
    }

    /**
     * Ease `heading` toward `targetHeading` by at most `mobTurnRate`,
     * taking the shortest way around the circle.
     */
    fn turnToward(mut self) : void {
        let d : f64 = wrapAngle(self.targetHeading - self.heading);
        let rate : f64 = config::mobTurnRate;
        self.heading = self.heading + clampF64(d, 0.0 - rate, rate);
    }

    // ── AI ──
    /**
     * The dispatched per-tick brain. The calm animals simply wander; the
     * player / sfx / sim context is ignored here and used only by the hostile
     * species (creeper) that overrides `think`.
     * @param world   the world the mob moves through (read-only voxel query)
     * @param player  the player (unused by calm animals)
     * @param sfx     the audio manager (unused by calm animals)
     * @param sim     the block-update sim (unused by calm animals)
     * @param rnd     a fresh pseudo-random value in [0,1)
     */
    fn think(mut self, world : dyn VoxelQuery, player : Player, sfx : AudioManager, sim : BlockSim, rnd : f64) : void {
        self.wander(world, rnd);
    }

    /**
     * Passive wander AI, one frame. `rnd` is a fresh value in [0,1) from
     * the manager (the world has no RNG of its own). Shared by the calm
     * animals; the creeper replaces behaviour with its own `think`.
     * @param world  the world the mob moves through (read-only voxel query)
     * @param rnd    a fresh pseudo-random value in [0,1)
     */
    fn wander(mut self, world : dyn VoxelQuery, rnd : f64) : void {
        if (self.timers.hurtTimer > 0) {
            self.timers.hurtTimer = self.timers.hurtTimer - 1;
        }

        // Dying: stop steering, let gravity settle the body while the
        // collapse animation plays out.
        if (self.state == 1) {
            if (self.timers.deathTimer > 0) {
                self.timers.deathTimer = self.timers.deathTimer - 1;
            }
            self.tick(world, 0.0, 0.0);
            return;
        }

        if (self.timers.fleeTimer > 0) {
            self.timers.fleeTimer = self.timers.fleeTimer - 1;
        }
        self.timers.turnTimer = self.timers.turnTimer - 1;
        if (self.timers.turnTimer <= 0 && self.timers.fleeTimer <= 0) {
            self.targetHeading = rnd * TAU;
            self.timers.turnTimer = config::mobTurnEveryMin + Math::floorToInt(rnd * (config::mobTurnEveryRand as f64)) as i32;
            if (rnd < config::mobIdleChance) {
                self.moving = 0;
            } else {
                self.moving = 1;
            }
        }
        self.turnToward();

        let spd : f64 = 0.0;
        if (self.timers.fleeTimer > 0) {
            spd = config::mobFleeSpeed;
        } else if (self.moving == 1) {
            spd = self.speed;
        }

        if (spd > 0.0) {
            self.walkPhase = self.walkPhase + 0.35;
        }

        let dx : f64 = Math::cos(self.heading) * spd;
        let dz : f64 = Math::sin(self.heading) * spd;
        self.tick(world, dx, dz);
    }
}

/**
 * Two-argument arctangent over the full circle, in radians.
 * @param y  the y component
 * @param x  the x component
 * @return the angle of (x, y) in radians
 */
fn atan2(y : f64, x : f64) : f64 {
    if (x > 0.0) {
        return atanApprox(y / x);
    }
    if (x < 0.0) {
        if (y >= 0.0) {
            return atanApprox(y / x) + PI;
        }
        return atanApprox(y / x) - PI;
    }
    if (y > 0.0) {
        return PI * 0.5;
    }
    if (y < 0.0) {
        return 0.0 - PI * 0.5;
    }
    return 0.0;
}

/**
 * atan(z) approximation (max error ~0.0038 rad) — ample for AI facing.
 * @param z  the tangent value
 * @return the approximate arctangent of z in radians
 */
fn atanApprox(z : f64) : f64 {
    let a : f64 = z;
    if (a < 0.0) {
        a = 0.0 - a;
    }
    let inv : bool = a > 1.0;
    if (inv) {
        a = 1.0 / a;
    }
    let a3 : f64 = a * a * a;
    let r : f64 = 0.7853981634 * a - a * (a - 1.0) * (0.2447 + 0.0663 * a);
    if (inv) {
        r = 1.5707963268 - r;
    }
    if (z < 0.0) {
        return 0.0 - r;
    }
    return r;
}
