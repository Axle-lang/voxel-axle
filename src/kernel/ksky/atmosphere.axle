// atmosphere — what colour the sky is in a given direction, and how much of it
// stands between the eye and a distant surface.
//
// One question, two consumers, and until now two answers. The sky pass computed
// the gradient per pixel; the fog faded distant terrain toward a SINGLE colour
// for the whole frame. So a hillside on the horizon dissolved into an average of
// the sky rather than into the sky it was actually in front of — grey against
// the warm glow near the sun, and far too bright against the deep blue away from
// it. Aerial perspective is precisely the effect of dissolving into the sky that
// is there, and computing it twice with different answers is what stopped it
// from reading.
//
// So `SkyDome` is the answer, built once per frame, and both ask it. The sky
// pass asks per pixel. The fog asks through a small screen-space grid — the
// colour varies slowly across the frame, so a coarse table sampled bilinearly is
// indistinguishable from the real thing and costs one lookup in the raster's
// innermost loop, which is not a place to be evaluating a sky.

use smalt::Mem;
use crate::kernel::klight::daymodel::{ DayState };
use crate::kernel::ksky::viewray::{ ViewRay };
use crate::kernel::ksky::clouddome::{ CloudDome, CloudSample };
use crate::kernel::kmath::noise2::{ hashI };
use crate::kernel::kmath::mathx::{ clampI32 };
use crate::configs::render::{ Render };

/** A colour in display range (0..255 per channel), before it is packed. */
struct SkyColour {
    pub(crate) r : f64,
    pub(crate) g : f64,
    pub(crate) b : f64,
}

/**
 * The highlight shoulder, in display units.
 *
 * The halo around the sun is ADDED to the gradient, so it runs past 255 long
 * before it runs out of sky, and clamping each channel at its own ceiling put a
 * hard boundary in the picture wherever a channel arrived there. Red saturates a
 * couple of degrees off the sun, green a little further, blue further still —
 * three curves of constant angle to the sun, which is to say three rings, each
 * with a hue shift across it, and all three at their worst at dusk when the halo
 * is strongest and the sky under it is already warm.
 *
 * The same shoulder the world's tone map uses: identity below the knee, then a
 * roll-off that approaches 255 without ever arriving. Value and slope match at
 * the join, so there is no boundary to see, and because the brightest channel is
 * compressed hardest the halo desaturates toward white as it brightens — which
 * is what a halo does.
 * @param x  the channel's value, which may exceed 255
 * @return the rolled-off value, below 255
 */
fn shoulder(x : f64) : f64 {
    if (x <= Render::SKY_SHOULDER) {
        return x;
    }
    let head : f64 = 255.0 - Render::SKY_SHOULDER;
    let over : f64 = x - Render::SKY_SHOULDER;
    return Render::SKY_SHOULDER + head * over / (over + head);
}

/**
 * A triangular dither in [-1, 1), one deterministic value per pixel.
 *
 * The sky is the one surface in the frame with no texture on it, so it is the
 * one place where eight bits is not enough: its gradients cross a whole channel
 * over tens of degrees, which at this resolution is a fresh contour line every
 * twenty pixels. Those contours follow the gradient's own level sets — circles
 * about the zenith for the elevation ramp, circles about the sun for the halo.
 *
 * A dither of plus or minus one unit before the truncation trades that structure
 * for noise below the level a single pixel can show, which is the whole of why
 * it works: the banding is visible because it is ORGANISED, not because it is
 * large. Two hashes summed give the triangular distribution, which is the one
 * that leaves no residual correlation with the signal.
 * @param px  pixel x
 * @param py  pixel y
 * @return the offset to add before truncating
 */
fn ditherAt(px : i32, py : i32) : f64 {
    return hashI(px, py, 0) + hashI(px, py, 4177) - 1.0;
}

/**
 * Roll off, dither and pack a sky colour into a display word.
 * @param c   the colour, in display range but possibly over it
 * @param px  pixel x, for the dither
 * @param py  pixel y, for the dither
 * @return the packed colour
 */
fn packSky(c : SkyColour, px : i32, py : i32) : i32 {
    let d : f64 = ditherAt(px, py);
    return clampI32((shoulder(c.r) + d).floorToInt() as i32, 0, 255) * 65536
        + clampI32((shoulder(c.g) + d).floorToInt() as i32, 0, 255) * 256
        + clampI32((shoulder(c.b) + d).floorToInt() as i32, 0, 255);
}

/**
 * The sky's colour in every direction this frame: a zenith-to-horizon gradient
 * with a warm glow around the sun.
 *
 * A value struct, so it crosses `spawn` into the gradient's worker rows the same
 * way `DayState` does.
 */
struct SkyDome {
    zenR : f64, zenG : f64, zenB : f64,
    horR : f64, horG : f64, horB : f64,
    sunX : f64, sunY : f64, sunZ : f64,
    haloFade : f64,

    /**
     * The sky's colour along a direction. It need not be unit: the ray carries
     * one over its length, which the caller that has one already computed and
     * the caller that has not sets to 1.
     * @param ray  the direction, with 1 / its length alongside
     * @return the sky's colour there, in display range
     */
    pub(crate) fn colourAt(self, ray : ViewRay) : SkyColour {
        let t : f64 = ray.dy * ray.inv;
        if (t < 0.0) {
            t = 0.0;
        }
        if (t > 1.0) {
            t = 1.0;
        }
        // Sharper near the horizon: the square root pushes the gradient up, the
        // way the real one is compressed into the first few degrees.
        let ts : f64 = t.sqrt();
        let r : f64 = self.horR + (self.zenR - self.horR) * ts;
        let g : f64 = self.horG + (self.zenG - self.horG) * ts;
        let b : f64 = self.horB + (self.zenB - self.horB) * ts;
        let sd : f64 = (ray.dx * self.sunX + ray.dy * self.sunY + ray.dz * self.sunZ) * ray.inv;
        if (sd > 0.0 && self.haloFade > 0.0) {
            let s2 : f64 = sd * sd;
            let halo : f64 = s2 * s2 * s2 * Render::SKY_HALO_STRENGTH * self.haloFade;
            if (sd > Render::SKY_CORE_THRESH) {
                let cc : f64 = (sd - Render::SKY_CORE_THRESH) / (1.0 - Render::SKY_CORE_THRESH);
                halo = halo + cc * cc * self.haloFade * Render::SKY_CORE_STRENGTH;
            }
            r = r + (Render::SKY_HALO_R as f64) * halo;
            g = g + (Render::SKY_HALO_G as f64) * halo;
            b = b + (Render::SKY_HALO_B as f64) * halo;
        }
        return SkyColour { r: r, g: g, b: b };
    }
}

/**
 * The dome for this frame's day state: the two gradient endpoints derived from
 * the day/night sky colour, and the sun's glow.
 * @param ds  the day/night state
 * @return the sky's colour field for the frame
 */
fn skyDomeFor(ds : DayState) : SkyDome {
    let baseR : f64 = ds.skyColR as f64;
    let baseG : f64 = ds.skyColG as f64;
    let baseB : f64 = ds.skyColB as f64;
    let lift : f64 = Render::SKY_HORIZON_LIFT;
    let fade : f64 = (ds.sunY + 0.1) * 3.0;
    if (fade < 0.0) {
        fade = 0.0;
    }
    if (fade > 1.0) {
        fade = 1.0;
    }
    return SkyDome {
        zenR: baseR * Render::SKY_ZENITH_R,
        zenG: baseG * Render::SKY_ZENITH_G,
        zenB: baseB * Render::SKY_ZENITH_B,
        horR: baseR + (250.0 - baseR) * lift,
        horG: baseG + (245.0 - baseG) * lift,
        horB: baseB + (235.0 - baseB) * lift,
        sunX: ds.sunX, sunY: ds.sunY, sunZ: ds.sunZ,
        haloFade: fade,
    };
}

/**
 * What the fog does, as two tables the rasteriser reads instead of computing:
 * the sky's colour over a coarse grid of the SCREEN, and how much of it has
 * accumulated by a given depth.
 *
 * The colour grid is coarse on purpose — the sky changes slowly across a frame,
 * so a bilinear read of a thirty-by-twenty grid is the same picture as the exact
 * evaluation and is affordable where the exact one is not.
 *
 * The depth curve is a table rather than a formula because the formula wants to
 * be `1 - exp(-density × depth)`, and an `exp` per pixel in the fill loop is not
 * worth it when 256 entries resolve it exactly. Exponential rather than the
 * linear ramp it replaces: a linear ramp begins at a distance, and that
 * beginning is a visible ring on the ground drawn across the world. Extinction
 * has no beginning — it is already happening at one block, just not enough to
 * see.
 */
struct FogTable {
    cols : i32,
    rows : i32,
    r : i64,
    g : i64,
    b : i64,
    curve : i64,      // FOG_CURVE_STEPS f64: fog fraction by depth
    xscale : f64,     // screen px → grid column
    yscale : f64,
    dscale : f64,     // depth → curve index

    /**
     * The sky's colour behind the pixel at (px, py), bilinear over the grid.
     * @param px  screen x
     * @param py  screen y
     * @return the colour distant terrain dissolves into there
     */
    pub(crate) fn skyAt(self, px : i32, py : i32) : SkyColour {
        let fx : f64 = (px as f64) * self.xscale;
        let fy : f64 = (py as f64) * self.yscale;
        let ix : i32 = fx.floorToInt() as i32;
        let iy : i32 = fy.floorToInt() as i32;
        if (ix < 0) {
            ix = 0;
        }
        if (iy < 0) {
            iy = 0;
        }
        if (ix > self.cols - 1) {
            ix = self.cols - 1;
        }
        if (iy > self.rows - 1) {
            iy = self.rows - 1;
        }
        let tx : f64 = fx - (ix as f64);
        let ty : f64 = fy - (iy as f64);
        let w : i32 = self.cols + 1;
        let i0 : i32 = iy * w + ix;
        let i1 : i32 = i0 + w;
        let a : f64 = (1.0 - tx) * (1.0 - ty);
        let b : f64 = tx * (1.0 - ty);
        let c : f64 = (1.0 - tx) * ty;
        let d : f64 = tx * ty;
        return SkyColour {
            r: Mem::realOf(self.r, i0) * a + Mem::realOf(self.r, i0 + 1) * b
             + Mem::realOf(self.r, i1) * c + Mem::realOf(self.r, i1 + 1) * d,
            g: Mem::realOf(self.g, i0) * a + Mem::realOf(self.g, i0 + 1) * b
             + Mem::realOf(self.g, i1) * c + Mem::realOf(self.g, i1 + 1) * d,
            b: Mem::realOf(self.b, i0) * a + Mem::realOf(self.b, i0 + 1) * b
             + Mem::realOf(self.b, i1) * c + Mem::realOf(self.b, i1 + 1) * d,
        };
    }

    /**
     * How much of the view at `depth` blocks is sky rather than surface.
     * @param depth  camera-space depth in blocks
     * @return the fog fraction, 0..1
     */
    pub(crate) fn amount(self, depth : f64) : f64 {
        let i : i32 = (depth * self.dscale).floorToInt() as i32;
        if (i < 0) {
            return 0.0;
        }
        if (i >= FOG_CURVE_STEPS) {
            return 1.0;
        }
        return Mem::realOf(self.curve, i);
    }
}

/** Entries in the depth→fog curve, over 0..`Render::DRAW_DIST` blocks. */
const FOG_CURVE_STEPS : i32 = 256;

/** Columns and rows of the screen-space sky grid the fog reads. */
const FOG_GRID_COLS : i32 = 32;
const FOG_GRID_ROWS : i32 = 20;

/** The row-constant half of a view ray — the part that depends only on `py`. */
struct ViewRow {
    rz0c : f64,
    dyw : f64,
}

/**
 * How a screen pixel becomes a direction in the world: the camera's look trig
 * and the lens, together.
 *
 * Everything that has to ask "what is out THERE, through this pixel" goes
 * through it — the sky gradient, the fog's colour grid, and the clouds. It was
 * open-coded once, inside the gradient loop, which is why nothing else could ask.
 *
 * The row half is split out because it is genuinely row-constant: hoisting it is
 * what keeps a full-screen per-pixel pass affordable, and a `dirAt(px, py)` that
 * recomputed it would quietly cost a millisecond a frame.
 */
struct ViewRays {
    cosy : f64,
    siny : f64,
    cosp : f64,
    sinp : f64,
    hw : f64,
    hh : f64,
    focal : f64,

    /**
     * The part of the view ray that depends only on the screen row.
     * @param py  screen y (pixel centre)
     * @return the row-constant terms
     */
    pub(crate) fn row(self, py : f64) : ViewRow {
        let ndcy : f64 = (self.hh - py) / self.focal;
        return ViewRow {
            rz0c: self.cosp - ndcy * self.sinp,
            dyw: ndcy * self.cosp + self.sinp,
        };
    }

    /**
     * The world direction through a pixel on that row, inverting the camera's
     * yaw / pitch rotation.
     * @param r   the row's constant terms
     * @param px  screen x (pixel centre)
     * @return the direction, and 1 / its length
     */
    pub(crate) fn dir(self, r : ViewRow, px : f64) : ViewRay {
        let ndcx : f64 = (px - self.hw) / self.focal;
        let dx : f64 = ndcx * self.cosy - r.rz0c * self.siny;
        let dz : f64 = ndcx * self.siny + r.rz0c * self.cosy;
        let len : f64 = (dx * dx + r.dyw * r.dyw + dz * dz).sqrt();
        if (len < 0.0001) {
            len = 0.0001;
        }
        return ViewRay { dx: dx, dy: r.dyw, dz: dz, inv: 1.0 / len };
    }
}

/**
 * Owns the fog's two tables and refills them each frame.
 *
 * A class rather than a rebuilt value because the buffers are the same size
 * every frame and there is no reason to give them back; the `FogTable` it hands
 * out is a value view over them, which is what crosses `spawn` into the fill
 * bands.
 */
class FogTables {
    r : i64,
    g : i64,
    b : i64,
    curve : i64,

    /** Allocate the screen-space colour grid and the depth curve. */
    constructor() {
        let n : i64 = ((FOG_GRID_COLS + 1) as i64) * ((FOG_GRID_ROWS + 1) as i64) * 8;
        self.r = Mem::take(n);
        self.g = Mem::take(n);
        self.b = Mem::take(n);
        self.curve = Mem::take((FOG_CURVE_STEPS as i64) * 8);
        let i : i32 = 0;
        while (i < FOG_CURVE_STEPS) {
            // 1 - e^(-(d/scale)^2): squared, so the near field is genuinely clear
            // and the far field closes fast. A plain exponential fogs the middle
            // distance more than the eye expects on a clear day.
            let d : f64 = ((i as f64) + 0.5) / (FOG_CURVE_STEPS as f64) * Render::DRAW_DIST;
            let t : f64 = d / Render::FOG_SCALE;
            let e : f64 = (0.0 - t * t).exp();
            Mem::putRealOf(self.curve, i as i64, 1.0 - e);
            i = i + 1;
        }
    }

    /**
     * Refill the screen-space sky grid for this frame's dome and camera, and
     * hand back the view the rasteriser reads.
     *
     * The cloud is composited in, exactly as the gradient does it, because the
     * grid's whole purpose is that distant terrain dissolves into the sky
     * actually painted behind it — and under a cloudy horizon that sky is
     * cloud.
     * @param dome   the sky's colour field this frame
     * @param rays   how a screen pixel becomes a direction
     * @param cloud  the cloud deck, as the gradient reads it
     * @param w      framebuffer width
     * @param h      framebuffer height
     * @return the table view
     */
    pub(crate) fn build(mut self, dome : SkyDome, rays : ViewRays, cloud : CloudDome, w : i32, h : i32) : FogTable {
        let gw : i32 = FOG_GRID_COLS + 1;
        let stepX : f64 = (w as f64) / (FOG_GRID_COLS as f64);
        let stepY : f64 = (h as f64) / (FOG_GRID_ROWS as f64);
        let gy : i32 = 0;
        while (gy <= FOG_GRID_ROWS) {
            let vr : ViewRow = rays.row((gy as f64) * stepY + 0.5);
            let gx : i32 = 0;
            while (gx <= FOG_GRID_COLS) {
                let ray : ViewRay = rays.dir(vr, (gx as f64) * stepX + 0.5);
                let c : SkyColour = dome.colourAt(ray);
                let cl : CloudSample = cloud.sample(ray);
                if (cl.a > 0.002) {
                    let keep : f64 = 1.0 - cl.a;
                    c = SkyColour { r: c.r * keep + cl.r, g: c.g * keep + cl.g, b: c.b * keep + cl.b };
                }
                let i : i32 = gy * gw + gx;
                Mem::putRealOf(self.r, i as i64, c.r);
                Mem::putRealOf(self.g, i as i64, c.g);
                Mem::putRealOf(self.b, i as i64, c.b);
                gx = gx + 1;
            }
            gy = gy + 1;
        }
        return FogTable {
            cols: FOG_GRID_COLS,
            rows: FOG_GRID_ROWS,
            r: self.r, g: self.g, b: self.b,
            curve: self.curve,
            xscale: (FOG_GRID_COLS as f64) / (w as f64),
            yscale: (FOG_GRID_ROWS as f64) / (h as f64),
            dscale: (FOG_CURVE_STEPS as f64) / Render::DRAW_DIST,
        };
    }
}
