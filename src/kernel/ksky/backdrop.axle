// sky — the backdrop: the atmospheric gradient, the warm halo around the sun,
// and the sun / moon discs, all drawn behind the world.
//
// Only the DRAWING. What hour it is, where the sun stands and what colour its
// light arrives in belongs to `klight::daymodel`; this file is handed the answer
// as a `DayState` and paints it. Splitting them is what lets the shadow bake and
// the mob pass ask the day model what time it is without importing a module that
// paints pixels.
//
// Every function is a FREE function taking that `DayState` BY VALUE (never a
// heap object) — the value snapshot is what crosses the `spawn` boundary into
// the threaded gradient job, so no mutable day-state is shared across threads.

use smalt::Mem;
use smalt::{ Job };
use crate::kernel::kmath::narrow::{ floatOf };
use smalt::Color;
use crate::kernel::klight::daymodel::{ DayState };
use crate::kernel::ksky::viewray::{ ViewRay };
use crate::kernel::ksky::atmosphere::{ SkyColour, SkyDome, ViewRays, ViewRow, packSky };
use crate::kernel::ksky::clouddome::{ CloudDome, CloudSample };
use crate::kernel::krender::raster::{ FrameBuf, Camera, Lens, Projected };
use crate::kernel::kentity::player::Player;
use crate::kernel::kmath::vec3::{ Vec3, vec3 };

/** Which body the disc pass is drawing. */
enum SkyBody : i32 {
    Sun,
    Moon,
}

/** A screen-space disc (sun / moon): centre + radius, in pixels. */
struct Disc {
    cx : f64,
    cy : f64,
    radius : f64,
}

/**
 * Solid colour of one celestial-disc texel at offset (dx, dy) from the centre.
 * Pulled out of drawDisc so that loop stays shallow.
 * @param body    which body is being drawn
 * @param dx      texel x offset from the disc centre
 * @param dy      texel y offset from the disc centre
 * @param radius  disc radius in pixels
 * @return the packed rgb colour for the texel
 */
fn discColor(body : SkyBody, dx : f64, dy : f64, radius : f64) : i32 {
    return match body {
        SkyBody::Sun => sunTexel(dx, dy, radius),
        _ => moonTexel(dx, dy, radius),
    };
}

/**
 * A sun texel: white-hot at the centre, fading to gold at the rim.
 * @param dx      texel x offset from the disc centre
 * @param dy      texel y offset from the disc centre
 * @param radius  disc radius in pixels
 * @return the packed rgb colour for the texel
 */
fn sunTexel(dx : f64, dy : f64, radius : f64) : i32 {
    let nd : f64 = (dx * dx + dy * dy).sqrt() / radius;
    let cg : i32 = (253.0 - 42.0 * nd).floorToInt() as i32;
    let cb : i32 = (218.0 - 150.0 * nd).floorToInt() as i32;
    return Color::packBytes(255, cg, cb);
}

/**
 * A moon texel: a pale disc darkened inside two faint maria.
 * @param dx      texel x offset from the disc centre
 * @param dy      texel y offset from the disc centre
 * @param radius  disc radius in pixels
 * @return the packed rgb colour for the texel
 */
fn moonTexel(dx : f64, dy : f64, radius : f64) : i32 {
    let m1 : f64 = ((dx + radius * 0.30) * (dx + radius * 0.30) + (dy + radius * 0.32) * (dy + radius * 0.32)).sqrt();
    let m2 : f64 = ((dx - radius * 0.36) * (dx - radius * 0.36) + (dy - radius * 0.10) * (dy - radius * 0.10)).sqrt();
    if (m1 < radius * 0.26 || m2 < radius * 0.20) {
        return Color::packBytes(198, 206, 220);
    }
    return Color::packBytes(226, 231, 240);
}

/**
 * Draw a celestial disc, where the world has not already drawn. Procedural and FULLY OPAQUE: partial-coverage alpha
 * blending reads the framebuffer back, which over the bright day sky produces a
 * rasteriser striping artifact (red/green hatching) — so every drawn texel is
 * solid, never blended. Hard edge, like Minecraft's sun and moon.
 * @param fb    the render target (framebuffer + size)
 * @param d     the disc's screen centre + radius
 * @param body  which body is being drawn
 */
fn drawDisc(fb : FrameBuf, d : Disc, body : SkyBody, cloud : CloudDome, dir : Vec3) : void {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let w : i32 = fb.w;
    let h : i32 = fb.h;
    let x0 : i32 = (d.cx - d.radius).floorToInt() as i32;
    let x1 : i32 = (d.cx + d.radius).floorToInt() as i32;
    let y0 : i32 = (d.cy - d.radius).floorToInt() as i32;
    let y1 : i32 = (d.cy + d.radius).floorToInt() as i32;
    let r2 : f64 = d.radius * d.radius;
    let py : i32 = y0;
    while (py <= y1) {
        if (py >= 0 && py < h) {
            let px : i32 = x0;
            while (px <= x1) {
                if (px >= 0 && px < w) {
                    let dx : f64 = (px as f64) + 0.5 - d.cx;
                    let dy : f64 = (py as f64) + 0.5 - d.cy;
                    // Inside the disc, and not behind the world: the body is
                    // drawn after the terrain now, so the terrain's z is what
                    // hides the part of it that has set.
                    if (dx * dx + dy * dy <= r2 && floatOf(zbuf, py * w + px) <= 0.0) {
                        let c : i32 = discColor(body, dx, dy, d.radius);
                        // A cloud in front of the sun hides it, which is most of
                        // what a cloud in front of the sun is for. Blended
                        // against the sky already painted underneath rather than
                        // against the disc itself, so there is no read-back of a
                        // pattern to stripe.
                        let cl : CloudSample = cloud.sample(ViewRay { dx: dir.x, dy: dir.y, dz: dir.z, inv: 1.0 });
                        if (cl.a > 0.002) {
                            // The sky under the disc already has the cloud in it,
                            // so the body is simply hidden behind that coverage.
                            let back : i32 = Mem::wordOf(pixels, py * w + px);
                            let k : f64 = 1.0 - cl.a;
                            let rr : i32 = ((((c >> 16) & 0xFF) as f64) * k + (((back >> 16) & 0xFF) as f64) * cl.a).floorToInt() as i32;
                            let gg : i32 = ((((c >> 8) & 0xFF) as f64) * k + (((back >> 8) & 0xFF) as f64) * cl.a).floorToInt() as i32;
                            let bb : i32 = (((c & 0xFF) as f64) * k + ((back & 0xFF) as f64) * cl.a).floorToInt() as i32;
                            c = rr * 65536 + gg * 256 + bb;
                        }
                        Mem::putWordOf(pixels, py * w + px, c);
                    }
                }
                px = px + 1;
            }
        }
        py = py + 1;
    }
}

/**
 * Project a sky direction (a unit vector, infinitely far) through the camera and
 * draw a disc there. Mirrors projectPoint's yaw/pitch transform so the body
 * tracks the world. Skipped when the direction is behind the camera.
 * @param p       player (camera orientation)
 * @param fb      the render target (framebuffer + size)
 * @param dir     sky direction (unit)
 * @param radius  disc radius in pixels
 * @param body    which body is being drawn
 * @param lens    the frame's projection centre + focal length
 * @param cloud   the cloud deck, which may be in front of the body
 */
fn drawSky(p : Player, fb : FrameBuf, dir : Vec3, radius : f64, body : SkyBody, lens : Lens, cloud : CloudDome) : void {
    let cam : Camera = Camera { eye: p.eye, cosy: p.cosy, siny: p.siny, cosp: p.cosp, sinp: p.sinp, lens: lens };
    let pr : Projected = cam.projectDir(dir);
    if (pr.cz < 0.05) {
        return;
    }
    drawDisc(fb, Disc { cx: pr.sx, cy: pr.sy, radius: radius }, body, cloud, dir);
}

/**
 * Paint the sky over the rows [y0, y1): a direction through every pixel, and the
 * dome's colour along it. The parallel work unit (see drawSkyGradient).
 *
 * The gradient and the halo are `klight::atmosphere`'s, not this file's — the
 * fog reads the same dome, so distant terrain dissolves into exactly the sky
 * painted behind it rather than into an average of the whole frame's.
 * @param dome   the sky's colour field this frame
 * @param rays   how a screen pixel becomes a world direction
 * @param cloud  the marched cloud deck, composited over the gradient
 * @param fb     the render target (framebuffer + size)
 * @param y0     first screen row (inclusive)
 * @param y1     last screen row (exclusive)
 * @return how many pixels of sky this band actually found
 */
fn drawSkyGradientRows(dome : SkyDome, rays : ViewRays, cloud : CloudDome, fb : FrameBuf, y0 : i32, y1 : i32) : i32 {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let w : i32 = fb.w;
    let seen : i32 = 0;
    let py : i32 = y0;
    while (py < y1) {
        let vr : ViewRow = rays.row((py as f64) + 0.5);
        let row : i32 = py * w;
        let px : i32 = 0;
        while (px < w) {
            // Only where the world left the pixel empty. The sky is painted
            // AFTER the world for exactly this: most of a frame is ground, and
            // a bicubic cloud read under every blade of grass is a frame's
            // worth of work thrown away.
            if (floatOf(zbuf, row + px) <= 0.0) {
                let ray : ViewRay = rays.dir(vr, (px as f64) + 0.5);
                let c : SkyColour = dome.colourAt(ray);
                let cl : CloudSample = cloud.sample(ray);
                if (cl.a > 0.002) {
                    // The cloud arrives premultiplied, so it is added, not mixed.
                    let keep : f64 = 1.0 - cl.a;
                    c = SkyColour { r: c.r * keep + cl.r, g: c.g * keep + cl.g, b: c.b * keep + cl.b };
                }
                Mem::putWordOf(pixels, row + px, packSky(c, px, py));
                seen = seen + 1;
            }
            px = px + 1;
        }
        py = py + 1;
    }
    return seen;
}

/** Row bands the sky is painted in. */
pub(crate) const SKY_BANDS : i32 = 8;

/**
 * Everything one band of the sky paint needs, in one value.
 *
 * A pass on the worker pool is attached once and run every frame after, and
 * Axle will not let a long-lived object remember a borrowed reference — so what
 * changes per frame travels as a value struct, through a one-slot array that
 * both the engine and the pass hold.
 */
struct SkyPaintFrame {
    dome : SkyDome,
    rays : ViewRays,
    cloud : CloudDome,
    fb : FrameBuf,
}

/**
 * Paint the atmospheric sky into every pixel the world left empty, in row bands
 * (disjoint output rows, race-free). Runs AFTER the world, mobs and torches,
 * reading the z-buffer they wrote, so only true sky pixels are ever computed.
 */
pub(crate) class SkyPaint : Job {
    now : SkyPaintFrame[],  // one slot: what this frame paints
    // How much sky each band found, one slot per band so no two workers write
    // the same word and no atomic is needed. It is the only thing the frame
    // learns about how much of the window the sky actually reaches — and the
    // cloud march is priced off it, because a deck nobody can see is a deck not
    // worth marching at full rate.
    seen : i32[],

    /**
     * @param now   the one-slot frame the engine publishes into
     * @param seen  the per-band tally the engine reads back, one slot per band
     */
    constructor(now : SkyPaintFrame[], seen : i32[]) {
        self.now = now;
        self.seen = seen;
    }

    /**
     * Paint this share's rows.
     * @param share   which band
     * @param shares  how many bands the frame was cut into
     */
    fn run(mut self, share : i32, shares : i32) : void {
        let f : SkyPaintFrame = self.now[0];
        let band : i32 = (f.fb.h + shares - 1) / shares;
        self.seen[share] = drawSkyGradientRows(f.dome, f.rays, f.cloud, f.fb,
            (band * share).min(f.fb.h), (band * (share + 1)).min(f.fb.h));
    }
}

/**
 * Draw the sun (in the sun direction) and the moon (opposite) onto the cleared
 * sky, behind the world. A body is drawn while it is on/above the horizon
 * (terrain naturally occludes the part that dips below). Sizes are a fraction of
 * the frame height so they scale with the window.
 * @param ds  the day/night state (sun direction)
 * @param p   player (camera orientation)
 * @param fb  the render target (framebuffer + size)
 * @param lens  the frame's projection centre + focal length
 */
fn drawCelestial(ds : DayState, p : Player, fb : FrameBuf, lens : Lens, cloud : CloudDome) : void {
    let sunR : f64 = (fb.h as f64) * 0.085;
    let moonR : f64 = (fb.h as f64) * 0.072;
    if (ds.sunY > 0.0 - 0.04) {
        drawSky(p, fb, vec3(ds.sunX, ds.sunY, ds.sunZ), sunR, SkyBody::Sun, lens, cloud);
    }
    if ((0.0 - ds.sunY) > 0.0 - 0.04) {
        drawSky(p, fb, vec3(0.0 - ds.sunX, 0.0 - ds.sunY, 0.0 - ds.sunZ), moonR, SkyBody::Moon, lens, cloud);
    }
}

