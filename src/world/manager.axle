// manager — the streaming voxel world.
//
// A fixed ring of `span × span` slots follows the camera: a chunk keeps
// its slot (addressed by chunk-coord modulo `span`) as the player moves,
// so crossing a chunk border only regenerates the newly-entered ones.
// Each slot now stores a FULL voxel field: `(chunkSize+2) × worldHeight ×
// (chunkSize+2)` block ids, padded by a one-voxel skirt on x/z that
// mirrors the neighbouring chunks' edge columns so the mesher can cull
// faces seamlessly without ever touching another slot. Meshing scans the
// voxels and emits a face wherever a block borders air; trees are stamped
// straight into the voxel field, and the world is editable (dig / place)
// through `breakAt` / `placeAt`, which rewrite voxels and re-mesh.
//
// A `hmap` heightmap (terrain top, tree-free) is still kept for
// `columnHeight()` (used by spawn / mob placement); `ctop` (collision
// top, the highest collidable voxel per column) still drives entity
// physics — both interfaces are unchanged, so nothing downstream moved.

use sdl_platform::{allocBytes, readU8, writeU8, getF64};
use crate::world::noise::{terrainHeight, temperature, humidity, treeHash, hashI, snowDepth};
use crate::world::biomes::registry::{biomeAt, Biomes};
use crate::world::blocks::{tileFor, isSolid, isCollidable, isWater, isTransparent, isOpaque, lightEmission, albedoFor, isPartialShape, hasCollisionBox, isLeaves};
use crate::world::voxstore::VoxStore;
use crate::world::lightstore::{ LightStore, LightRemoval };
use crate::world::treegen::{ stampTree };
use crate::vec3::{ IVec3, Vec3, vec3, ivec3 };
use crate::config;
use crate::config::{ Block };
use crate::config::{ BiomeId };
use crate::config::{ FaceDir };

class ChunkManager {
    cxs : i32[],
    czs : i32[],
    loaded : i32[],
    fcount : i32[],
    fx : i32[],
    fy : i32[],
    fz : i32[],
    ftile : i32[],   // packs (dir << 8) | tile — see addFace
    tx : i32[],      // torch world x per slot (drawn as thin posts, not cubes)
    ty : i32[],      // torch world y
    tz : i32[],      // torch world z
    tcount : i32[],  // torch count per slot
    flight : i64,    // per-face SMOOTH light: 4 bytes/face, one per corner, each
                     // packing (sky << 4) | block — averaged over the air cells
                     // touching that corner (Minecraft-style smooth lighting)
    fao : i64,       // per-face ambient occlusion: 4 bytes/face, one 0..3 per
                     // corner (3 = open, 0 = deep inner corner). Multiplies the
                     // corner's ambient at render to darken concave seams.
    lcoff : i32[],   // face corner block offsets, (dir*4+k)*3 → (ox,oy,oz).
                     // MUST mirror Renderer.fillTable so baked corner k aligns
                     // with the renderer's corner k.
    curDayTime : f64,       // latest time-of-day, published by the main loop each
                            // frame for the background light thread to read
    lightRunning : AtomicBoolean, // false tells the light thread to exit (quit)
    lights : LightStore, // per-voxel light volumes + flood stacks + sky-AO table
                         // (block / sky / sun / sky-access / bounce). The light
                         // engine below reads and writes it, just as `store`
                         // holds the voxels — both reached by the light thread.
    hmap : i32[],
    ctop : i32[],
    store : VoxStore,   // raw voxel storage (block field + face-Y watermark + voxIdx)
    reg : Biomes,

    /**
     * Allocate the slot ring and per-slot buffers, then mark every slot
     * unloaded.
     */
    constructor() {
        this.reg = new Biomes();
        let slots : i32 = config::span * config::span;
        let faceCap : i32 = slots * config::maxFacesPerChunk;
        let hSide : i32 = config::chunkSize + 2;
        let s : i32 = config::chunkSize;
        this.cxs = malloc<i32>(slots);
        this.czs = malloc<i32>(slots);
        this.loaded = malloc<i32>(slots);
        this.fcount = malloc<i32>(slots);
        this.fx = malloc<i32>(faceCap);
        this.fy = malloc<i32>(faceCap);
        this.fz = malloc<i32>(faceCap);
        this.ftile = malloc<i32>(faceCap);
        this.tx = malloc<i32>(slots * config::maxTorchesPerChunk);
        this.ty = malloc<i32>(slots * config::maxTorchesPerChunk);
        this.tz = malloc<i32>(slots * config::maxTorchesPerChunk);
        this.tcount = malloc<i32>(slots);
        this.curDayTime = config::dayStart;
        this.lightRunning = new AtomicBoolean(true);
        // The per-voxel light volumes + flood stacks + sky-AO hemisphere table
        // now live together in their own leaf.
        this.lights = new LightStore(slots);
        this.flight = allocBytes((faceCap as i64) * 4);
        this.fao = allocBytes((faceCap as i64) * 4);
        this.lcoff = malloc<i32>(72);
        this.fillLightTable();
        this.hmap = malloc<i32>(slots * hSide * hSide);
        this.ctop = malloc<i32>(slots * s * s);
        this.store = new VoxStore(slots);
        let i : i32 = 0;
        while (i < slots) {
            this.loaded[i] = 0;
            i = i + 1;
        }
    }

    /**
     * Wrap a chunk coordinate into [0, span) for slot addressing.
     * @param v  the chunk coordinate
     * @return the wrapped index
     */
    fn wrap(v : i32) : i32 {
        let s : i32 = config::span;
        let m : i32 = v - (v / s) * s;
        if (m < 0) {
            m = m + s;
        }
        return m;
    }

    /**
     * Slot index for chunk coords (cx, cz).
     * @param cx  the chunk x coordinate
     * @param cz  the chunk z coordinate
     * @return the slot index
     */
    fn slotFor(cx : i32, cz : i32) : i32 {
        return this.wrap(cz) * config::span + this.wrap(cx);
    }

    /**
     * Floor division of `a` by `b` (toward negative infinity).
     * @param a  the dividend
     * @param b  the divisor
     * @return the floored quotient
     */
    fn floorDiv(a : i32, b : i32) : i32 {
        let q : i32 = a / b;
        if (a - q * b < 0) {
            q = q - 1;
        }
        return q;
    }

    /**
     * Heightmap value at local coords (lx, lz) within `slot`.
     * @param slot  the slot index
     * @param lx    the local x coordinate
     * @param lz    the local z coordinate
     * @return the terrain top height
     */
    fn heightAt(slot : i32, lx : i32, lz : i32) : i32 {
        let hSide : i32 = config::chunkSize + 2;
        return this.hmap[slot * hSide * hSide + (lz + 1) * hSide + (lx + 1)];
    }

    // ── Voxel access ────────────────────────────────────────────
    // Local coords accept the one-voxel skirt: lx, lz ∈ [-1 .. chunkSize].
    // Below y=0 is bedrock (occludes, so no world-floor underside is
    // drawn); above the field is air.

    /**
     * Flat voxel-array index for a padded local coordinate.
     * @param slot  the slot index
     * @param lx    the local x coordinate
     * @param ly    the local y coordinate
     * @param lz    the local z coordinate
     * @return the flat array index
     */
    fn voxIdx(slot : i32, lx : i32, ly : i32, lz : i32) : i32 {
        return this.store.voxIdx(slot, lx, ly, lz);
    }

    /**
     * Block id at a padded local voxel; bedrock below 0, air above.
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @return the block id
     */
    fn getVox(slot : i32, local : IVec3) : Block {
        return this.store.getVox(slot, local);
    }

    /**
     * Write block `id` at a padded local voxel (no bounds check).
     * @param slot   the slot index
     * @param local  the padded local voxel coordinate
     * @param id     the block id to write
     */
    fn setVoxLocal(slot : i32, local : IVec3, own id : Block) : void {
        this.store.setVoxLocal(slot, local, id);
    }

    /**
     * Raise the slot's highest-face Y watermark to include `y`.
     * @param slot  the slot index
     * @param y     the candidate Y
     */
    fn bumpFY(slot : i32, y : i32) : void {
        this.store.bumpFY(slot, y);
    }

    // ── World queries (unchanged interfaces) ────────────────────

    /**
     * Terrain surface Y at world column (wx, wz): the heightmap top,
     * excluding trees. Sea level for an unloaded column.
     * @param wx  the world x coordinate
     * @param wz  the world z coordinate
     * @return the terrain surface height
     */
    fn columnHeight(wx : i32, wz : i32) : i32 {
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(wx, s);
        let cz : i32 = this.floorDiv(wz, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return config::seaLevel;
        }
        return this.heightAt(slot, wx - cx * s, wz - cz * s);
    }

    /**
     * Solid collision surface Y at (wx, wz): the highest collidable
     * voxel + 1 (so tree trunks and placed blocks are solid, dug pits
     * drop it, leaf canopies stay passable). Used by entity physics.
     * @param wx  the world x coordinate
     * @param wz  the world z coordinate
     * @return the collision surface height
     */
    fn collisionHeight(wx : i32, wz : i32) : i32 {
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(wx, s);
        let cz : i32 = this.floorDiv(wz, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return config::seaLevel;
        }
        return this.ctop[slot * s * s + (wz - cz * s) * s + (wx - cx * s)];
    }

    /**
     * Block id at a world voxel; bedrock below 0, air above / unloaded.
     * @param cell the world voxel
     * @return the block id
     */
    fn worldGet(cell : IVec3) : Block {
        if (cell.y < 0) {
            return Block::Stone;
        }
        if (cell.y >= config::worldHeight) {
            return Block::Air;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(cell.x, s);
        let cz : i32 = this.floorDiv(cell.z, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return Block::Air;
        }
        return this.getVox(slot, ivec3(cell.x - cx * s, cell.y, cell.z - cz * s));
    }

    /**
     * Does a world voxel stop the look-ray (a targetable solid block)?
     * @param cell  the world voxel
     * @return whether the voxel is a solid target
     */
    fn solidTarget(cell : IVec3) : bool {
        return isSolid(this.worldGet(cell));
    }

    /**
     * Is the voxel a block an entity collides with (per-voxel physics)?
     * @param cell  the world voxel
     * @return whether the voxel is collidable
     */
    fn solidAt(cell : IVec3) : bool {
        return isCollidable(this.worldGet(cell));
    }

    /**
     * REAL per-type collision box for one cell against the body at foot height
     * `py`. Full blocks are solid the whole cube; a thin SnowLayer is solid only
     * up to its real partial top (cell.y + snowDepth), so the body's box meets the
     * snow at its true height instead of a phantom full cube. Used for ALL axes
     * (horizontal blocking, landing, ceiling): a low layer is a real obstacle of
     * its true height — short enough to be auto-stepped, so never a wall.
     * @param cell  the world voxel
     * @param py    the body's foot height being tested
     * @return true if the cell's real box blocks the body at `py`
     */
    fn collideFloorCell(cell : IVec3, py : f64) : bool {
        if (!hasCollisionBox(this.worldGet(cell))) {
            return false;
        }
        return py < (cell.y as f64) + this.blockBoxHeight(cell);
    }

    /**
     * Real standable top height of one cell: full blocks → cell.y+1, a thin
     * SnowLayer → cell.y + snowDepth (its partial top), nothing → a very low value.
     * @param cell  the world voxel
     * @return the standable top Y of the cell, or a very low value if none
     */
    fn supportHeight(cell : IVec3) : f64 {
        if (!hasCollisionBox(this.worldGet(cell))) {
            return 0.0 - 1000000.0;
        }
        return (cell.y as f64) + this.blockBoxHeight(cell);
    }

    /**
     * THE single authority for a block's real box HEIGHT (its vertical extent
     * within the cell): a full block is 1.0, a thin SnowLayer its noise-varied
     * `snowDepth` (e.g. 1/6). Every system — collision (collideFloorCell /
     * supportHeight), meshing, the look-ray picker and the selection wireframe —
     * reads height from here, so the box, the visual and the hitbox always agree.
     * Adding a new partial block (a slab, a carpet) = one new `match` arm here
     * (plus listing it in `isPartialShape`); nothing else hard-codes a height.
     * @param cell  the world voxel
     * @return the cell box's real height in Y (1.0 full, snowDepth for snow)
     */
    fn blockBoxHeight(cell : IVec3) : f64 {
        return match this.worldGet(cell) {
            Block::SnowLayer => snowDepth(cell.x as f64, cell.z as f64),
            _ => 1.0,
        };
    }

    /**
     * Extra vertical cells the auto-step / floor scan is padded by. A 1-cell pad
     * widens the step allowance (see Entity.moveX/moveZ) so a snow-capped or
     * near-full ledge is cleared instead of stopping the body dead against it.
     * The single knob the step logic reads.
     * @return the pad in whole cells
     */
    fn floorScanPad() : i32 {
        return 1;
    }

    // ── Streaming ───────────────────────────────────────────────

    /**
     * Regenerate any slot in view radius of the camera chunk that is
     * unloaded or holds a different chunk.
     * @param camCX  the camera chunk x coordinate
     * @param camCZ  the camera chunk z coordinate
     */
    fn ensureLoaded(camCX : i32, camCZ : i32) : i32 {
        let r : i32 = config::viewRadius;
        let budget : i32 = config::chunkLoadsPerFrame;
        if (budget < 1) {
            budget = 1;
        }
        // Generate + seed up to `budget` missing chunks per call, NEAREST FIRST
        // (concentric Chebyshev rings), so crossing into new chunks fills in over
        // a few frames instead of one stutter. Meshing a chunk bakes each border
        // face's light from the neighbour across the seam, so it's deferred to a
        // second pass (flushLightMesh) once this batch's neighbours all exist —
        // no black seams.
        let built : i32 = 0;
        let d : i32 = 0;
        while (d <= r && built < budget) {
            let dz : i32 = 0 - d;
            while (dz <= d && built < budget) {
                let dx : i32 = 0 - d;
                while (dx <= d && built < budget) {
                    // Only the cells on this ring (Chebyshev distance == d).
                    let ad : i32 = dx;
                    if (ad < 0) {
                        ad = 0 - ad;
                    }
                    let az : i32 = dz;
                    if (az < 0) {
                        az = 0 - az;
                    }
                    let cheb : i32 = ad;
                    if (az > cheb) {
                        cheb = az;
                    }
                    if (cheb == d) {
                        let cx : i32 = camCX + dx;
                        let cz : i32 = camCZ + dz;
                        let slot : i32 = this.slotFor(cx, cz);
                        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
                            this.regen(slot, cx, cz);
                            built = built + 1;
                        }
                    }
                    dx = dx + 1;
                }
                dz = dz + 1;
            }
            d = d + 1;
        }
        // Mesh the chunks flagged dirty this call (the new ones + their loaded
        // neighbours, whose border faces re-bake against the new chunk).
        if (built > 0) {
            this.flushLightMesh();
        }
        return built;
    }

    /**
     * Flag a chunk for (re)mesh, but only if it is currently loaded at (cx, cz)
     * — used to re-bake a neighbour's shared border faces after an edit / load.
     * @param cx  the chunk x coordinate
     * @param cz  the chunk z coordinate
     */
    fn markDirtyAt(cx : i32, cz : i32) : void {
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 1 && this.cxs[slot] == cx && this.czs[slot] == cz) {
            this.lights.ldirty[slot] = 1;
        }
    }

    /**
     * Fully (re)build a slot for chunk (cx, cz): heightmap, voxels, mesh.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn regen(slot : i32, cx : i32, cz : i32) : void {
        this.cxs[slot] = cx;
        this.czs[slot] = cz;
        this.loaded[slot] = 1;
        this.genHeightmap(slot, cx, cz);
        this.genVoxels(slot, cx, cz);
        this.clearLight(slot);
        this.seedSky(slot, cx, cz);
        // Don't mesh here — ensureLoaded meshes in a second pass once every
        // neighbour is generated, so border faces bake real neighbour light
        // instead of 0 (black seams). Flag this chunk and its 4 horizontal
        // neighbours so their shared faces re-bake against the new chunk.
        this.lights.ldirty[slot] = 1;
        this.markDirtyAt(cx + 1, cz);
        this.markDirtyAt(cx - 1, cz);
        this.markDirtyAt(cx, cz + 1);
        this.markDirtyAt(cx, cz - 1);
    }

    /**
     * Fill the padded heightmap for a chunk, clamped to a valid band.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn genHeightmap(slot : i32, cx : i32, cz : i32) : void {
        let s : i32 = config::chunkSize;
        let hSide : i32 = s + 2;
        let base : i32 = slot * hSide * hSide;
        let lz : i32 = 0 - 1;
        while (lz <= s) {
            let lx : i32 = 0 - 1;
            while (lx <= s) {
                let wx : f64 = (cx * s + lx) as f64;
                let wz : f64 = (cz * s + lz) as f64;
                let h : i32 = Math::floorToInt(terrainHeight(wx, wz)) as i32;
                if (h < 2) {
                    h = 2;
                }
                if (h > config::maxHeight - 1) {
                    h = config::maxHeight - 1;
                }
                this.hmap[base + (lz + 1) * hSide + (lx + 1)] = h;
                lx = lx + 1;
            }
            lz = lz + 1;
        }
    }

    /**
     * Clamped terrain height for an arbitrary world column (for tree
     * origins outside the heightmap border). Matches genHeightmap.
     * @param wx  the world x coordinate
     * @param wz  the world z coordinate
     * @return the clamped terrain height
     */
    fn colHeightWorld(wx : i32, wz : i32) : i32 {
        let h : i32 = Math::floorToInt(terrainHeight(wx as f64, wz as f64)) as i32;
        if (h < 2) {
            h = 2;
        }
        if (h > config::maxHeight - 1) {
            h = config::maxHeight - 1;
        }
        return h;
    }

    // ── Generation ──────────────────────────────────────────────

    /**
     * Fill the padded voxel field for a chunk: stone / filler / surface
     * by depth, water up to sea level, air above; then stamp trees.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn genVoxels(slot : i32, cx : i32, cz : i32) : void {
        let s : i32 = config::chunkSize;
        this.store.maxFY[slot] = 0;
        let lz : i32 = 0 - 1;
        while (lz <= s) {
            let lx : i32 = 0 - 1;
            while (lx <= s) {
                let wx : i32 = cx * s + lx;
                let wz : i32 = cz * s + lz;
                let h : i32 = this.heightAt(slot, lx, lz);
                let biome : BiomeId = biomeAt(temperature(wx as f64, wz as f64),
                    humidity(wx as f64, wz as f64), h);
                let surf : Block = this.reg.surface(biome, h);
                let filler : Block = this.reg.filler(biome);
                let topY : i32 = h - 1;
                if (h <= config::seaLevel) {
                    topY = config::seaLevel;
                }
                this.bumpFY(slot, topY);
                let ly : i32 = 0;
                while (ly < config::worldHeight) {
                    let id : Block = Block::Air;
                    if (ly < h) {
                        if (ly == h - 1) {
                            id = surf;
                        } else if (ly >= h - 3) {
                            id = filler;
                        } else {
                            id = this.oreAt(ivec3(wx, ly, wz));
                        }
                    } else if (h <= config::seaLevel && ly <= config::seaLevel) {
                        id = Block::Water;
                        // Frozen ocean: the water surface freezes to ice.
                        if (biome == BiomeId::FrozenOcean && ly == config::seaLevel) {
                            id = Block::Ice;
                        }
                    }
                    this.setVoxLocal(slot, ivec3(lx, ly, lz), id);
                    ly = ly + 1;
                }
                // Cold-biome ground: a thin, noise-varied snow layer on top of
                // the surface (bare patches where the noise is low, the odd full
                // block where it's high) — so the ground carries snow to match
                // the snow on the trees.
                if (this.coldBiome(biome) && h > config::seaLevel && h < config::worldHeight) {
                    let frac : f64 = snowDepth(wx as f64, wz as f64);
                    if (frac > 0.0) {
                        let sb : Block = Block::SnowLayer;
                        if (frac >= 0.95) {
                            sb = Block::Snow;
                        }
                        this.setVoxLocal(slot, ivec3(lx, h, lz), sb);
                        this.bumpFY(slot, h);
                    }
                }
                lx = lx + 1;
            }
            lz = lz + 1;
        }
        this.stampTrees(slot, cx, cz);
    }

    /**
     * Stamp every tree whose origin lies in this chunk's area (plus a
     * 2-column margin so canopies straddling a border appear from both
     * sides). Deterministic via `treeHash`, so the two chunks stamp the
     * shared tree identically — seamless. Voxels outside the padded
     * volume are clipped away.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn stampTrees(slot : i32, cx : i32, cz : i32) : void {
        let s : i32 = config::chunkSize;
        let olz : i32 = 0 - 2;
        while (olz <= s + 1) {
            let olx : i32 = 0 - 2;
            while (olx <= s + 1) {
                let wx : i32 = cx * s + olx;
                let wz : i32 = cz * s + olz;
                let h : i32 = this.colHeightWorld(wx, wz);
                if (h > config::seaLevel) {
                    let biome : BiomeId = biomeAt(temperature(wx as f64, wz as f64),
                        humidity(wx as f64, wz as f64), h);
                    // Thin every biome's trees toward sparser, airier woods.
                    let thr : f64 = this.reg.treeThreshold(biome);
                    thr = thr + (1.0 - thr) * config::treeThin;
                    if (treeHash(wx as f64, wz as f64) > thr) {
                        // Carving lives in treegen.axle (a leaf module): pass the
                        // slot's voxel field + face-Y watermark by reference so the
                        // stamper writes straight into this slot — no import cycle.
                        stampTree(this.store, this.reg.treeKind(biome), this.reg.treeHeight(biome), slot, olx, h, olz);
                        // Cold biomes: dust the canopy with a thin snow cap (kept
                        // here — it needs the heightmap + biome registry).
                        if (this.coldBiome(biome)) {
                            this.snowCapTree(slot, olx, olz, h, this.reg.treeHeight(biome), cx * s, cz * s);
                        }
                    }
                }
                olx = olx + 1;
            }
            olz = olz + 1;
        }
    }

    /** True for the cold, snowy biomes whose trees should carry snow. */
    fn coldBiome(b : BiomeId) : bool {
        return b == BiomeId::Snowy || b == BiomeId::Taiga || b == BiomeId::Mountain;
    }

    /**
     * Should a partial block of height `myH` emit a side wall toward the
     * neighbour cell (local nlx/nly/nlz, world column nwx/nwz)? Yes against air
     * or a strictly LOWER partial block (fills the exposed step); no against a
     * full block or an equal/higher partial (avoids an internal z-fighting grid).
     * @param slot  the chunk slot
     * @param nlx   neighbour local x
     * @param nly   neighbour local/world y
     * @param nlz   neighbour local z
     * @param nwx   neighbour world x (for its box height)
     * @param nwz   neighbour world z (for its box height)
     * @param myH   this block's box height
     * @return whether to emit the side wall toward the neighbour
     */
    fn partialSideOpen(slot : i32, nlx : i32, nly : i32, nlz : i32, nwx : i32, nwz : i32, myH : f64) : bool {
        let nb : Block = this.getVox(slot, ivec3(nlx, nly, nlz));
        if (nb == Block::Air) {
            return true;
        }
        if (!isPartialShape(nb)) {
            return false;
        }
        return this.blockBoxHeight(ivec3(nwx, nly, nwz)) < myH - 0.001;
    }

    /**
     * Deep stone, occasionally an ore — deterministic 3D scatter by depth.
     * Common ores (coal/iron) appear at most depths; rare ones (diamond/
     * emerald) only deep. Returns bStone when nothing rolls. Called only
     * for the deep stone band, so surface/filler are never replaced.
     * @param cell  the world voxel
     * @return the block id (ore or stone)
     */
    fn oreAt(cell : IVec3) : Block {
        let r : f64 = hashI(cell.x * 7 + cell.y * 131, cell.z * 13 + cell.y * 977, config::seedI + 9171);
        if (cell.y < 14) {
            if (r > 0.9930) {
                return Block::DiamondOre;
            }
            if (r > 0.9870) {
                return Block::EmeraldOre;
            }
            if (r > 0.9790) {
                return Block::RedstoneOre;
            }
            if (r > 0.9680) {
                return Block::GoldOre;
            }
        }
        if (cell.y < 36 && r > 0.9700) {
            return Block::LapisOre;
        }
        if (r > 0.9550) {
            return Block::IronOre;
        }
        if (r > 0.9150) {
            return Block::CoalOre;
        }
        return Block::Stone;
    }

    // Tree / mushroom shape carving (stampTree, leafLayer, stampTrunk, the
    // per-species canopies) lives in treegen.axle as free LEAF functions writing
    // straight into a slot's voxel field; stampTrees (above) delegates to them.
    // snowCapTree stays here because it needs the heightmap (colHeightWorld) and
    // the biome registry (coldBiome / biomeAt) — manager-only state.

    /**
     * Dust a freshly-stamped tree's canopy with a thin snow cap: over each column
     * of the tree footprint, drop a single snow block onto the topmost leaf (into
     * the air above it). One block per column → a light dusting that follows the
     * canopy silhouette, not a solid slab. Only columns whose own ground biome is
     * cold are capped, so the canopy snow matches the ground snow.
     * @param slot    the slot index
     * @param olx     the tree origin local x
     * @param olz     the tree origin local z
     * @param baseY   the trunk base Y
     * @param height  the trunk height
     * @param cx0     the chunk's world-x origin (cx * chunkSize)
     * @param cz0     the chunk's world-z origin (cz * chunkSize)
     */
    fn snowCapTree(slot : i32, olx : i32, olz : i32, baseY : i32, height : i32, cx0 : i32, cz0 : i32) : void {
        let s : i32 = config::chunkSize;
        let topSearch : i32 = baseY + height + 4;
        if (topSearch >= config::worldHeight) {
            topSearch = config::worldHeight - 1;
        }
        let dz : i32 = 0 - 2;
        while (dz <= 2) {
            let dx : i32 = 0 - 2;
            while (dx <= 2) {
                let lx : i32 = olx + dx;
                let lz : i32 = olz + dz;
                if (lx >= 0 - 1 && lx <= s && lz >= 0 - 1 && lz <= s) {
                    this.snowCapColumn(slot, lx, lz, baseY, topSearch, cx0, cz0);
                }
                dx = dx + 1;
            }
            dz = dz + 1;
        }
    }

    /**
     * Dust one column of the tree footprint: find its topmost leaf and, if the
     * cell above is open and the column's own ground biome is cold, drop a single
     * snow block there. Guard-returns keep it flat (one block per column → a light
     * dusting that follows the canopy, not a slab).
     * @param slot       the slot index
     * @param lx         local x of the column
     * @param lz         local z of the column
     * @param baseY      the trunk base Y (search floor)
     * @param topSearch  the top of the leaf search (clamped to the world top)
     * @param cx0        the chunk's world-x origin (cx * chunkSize)
     * @param cz0        the chunk's world-z origin (cz * chunkSize)
     */
    fn snowCapColumn(slot : i32, lx : i32, lz : i32, baseY : i32, topSearch : i32, cx0 : i32, cz0 : i32) : void {
        // Walk down to the topmost leaf of this column.
        let y : i32 = topSearch;
        while (y > baseY && !isLeaves(this.getVox(slot, ivec3(lx, y, lz)))) {
            y = y - 1;
        }
        if (y <= baseY) {
            return;   // no leaf in this column
        }
        // The leaf needs open air directly above to hold the snow.
        if (y + 1 >= config::worldHeight || this.getVox(slot, ivec3(lx, y + 1, lz)) != Block::Air) {
            return;
        }
        // Only cap columns whose own ground biome is cold, so the canopy snow
        // matches the ground snow (no snow on a tree over warm, bare ground).
        let wx : i32 = cx0 + lx;
        let wz : i32 = cz0 + lz;
        let ch : i32 = this.colHeightWorld(wx, wz);
        let cb : BiomeId = biomeAt(temperature(wx as f64, wz as f64), humidity(wx as f64, wz as f64), ch);
        if (!this.coldBiome(cb)) {
            return;
        }
        let frac : f64 = snowDepth(wx as f64, wz as f64);
        if (frac <= 0.0) {
            return;
        }
        let sb : Block = Block::SnowLayer;
        if (frac >= 0.95) {
            sb = Block::Snow;
        }
        this.setVoxLocal(slot, ivec3(lx, y + 1, lz), sb);
        this.bumpFY(slot, y + 1);
    }

    // ── Meshing ─────────────────────────────────────────────────

    /**
     * Append a face to the slot's face buffer (dropped if at capacity).
     * @param slot  the slot index
     * @param cell  the face's world voxel
     * @param dir   the face direction
     * @param tile  the atlas tile index
     */
    fn addFace(slot : i32, cell : IVec3, own dir : FaceDir, tile : i32) : void {
        let fc : i32 = this.fcount[slot];
        if (fc >= config::maxFacesPerChunk) {
            return;
        }
        let i : i32 = slot * config::maxFacesPerChunk + fc;
        this.fx[i] = cell.x;
        this.fy[i] = cell.y;
        this.fz[i] = cell.z;
        // Pack the face direction (0..5) and atlas tile (< 256) into one slot
        // rather than keeping a parallel FaceDir array. renderFace unpacks
        // dir = ftile / 256, tile = ftile % 256.
        let di : i32 = dir as i32;
        this.ftile[i] = di * 256 + tile;
        // Bake Minecraft-style smooth light + ambient occlusion: each of the 4
        // corners averages the light of the air cells touching it and gets an AO
        // level from its opaque neighbours, so faces shade gradient-smooth and
        // concave seams darken (see bakeFaceCorners).
        this.bakeFaceCorners(i, cell, di);
        this.fcount[slot] = fc + 1;
    }

    /**
     * Mirror of Renderer.fillTable's corner block offsets (the UVs are not
     * needed here). Stored as (dir*4+k)*3 → (ox, oy, oz). Kept identical to the
     * renderer so baked corner k lines up with the corner k it shades.
     */
    fn setLCorner(dir : i32, k : i32, ox : i32, oy : i32, oz : i32) : void {
        let b : i32 = (dir * 4 + k) * 3;
        this.lcoff[b] = ox;
        this.lcoff[b + 1] = oy;
        this.lcoff[b + 2] = oz;
    }

    /** Fill the face corner offset table (must match Renderer.fillTable). */
    fn fillLightTable() : void {
        this.setLCorner(0, 0, 1, 0, 0);
        this.setLCorner(0, 1, 1, 0, 1);
        this.setLCorner(0, 2, 1, 1, 1);
        this.setLCorner(0, 3, 1, 1, 0);
        this.setLCorner(1, 0, 0, 0, 0);
        this.setLCorner(1, 1, 0, 1, 0);
        this.setLCorner(1, 2, 0, 1, 1);
        this.setLCorner(1, 3, 0, 0, 1);
        this.setLCorner(2, 0, 0, 1, 0);
        this.setLCorner(2, 1, 1, 1, 0);
        this.setLCorner(2, 2, 1, 1, 1);
        this.setLCorner(2, 3, 0, 1, 1);
        this.setLCorner(3, 0, 0, 0, 0);
        this.setLCorner(3, 1, 0, 0, 1);
        this.setLCorner(3, 2, 1, 0, 1);
        this.setLCorner(3, 3, 1, 0, 0);
        this.setLCorner(4, 0, 0, 0, 1);
        this.setLCorner(4, 1, 1, 0, 1);
        this.setLCorner(4, 2, 1, 1, 1);
        this.setLCorner(4, 3, 0, 1, 1);
        this.setLCorner(5, 0, 0, 0, 0);
        this.setLCorner(5, 1, 0, 1, 0);
        this.setLCorner(5, 2, 1, 1, 0);
        this.setLCorner(5, 3, 1, 0, 0);
    }

    /**
     * Smooth-light + AO bake for one face's 4 corners into flight / fao.
     * For each corner: take the air cell the face looks into (nb) plus the two
     * edge-neighbour cells and the diagonal cell that meet at that corner, all
     * in the nb layer. Light = average over the NON-opaque cells among them (so a
     * lit face by a wall doesn't crater to black); AO = the classic vertex term
     * 3-(side1+side2+corner), 0 when both sides are blocked.
     * @param i   the global face index (slot*maxFacesPerChunk + fc)
     * @param w   the face block world voxel
     * @param di  the face direction (0..5)
     */
    fn bakeFaceCorners(i : i32, w : IVec3, di : i32) : void {
        // Normal offset to the air cell this face looks into (di = dir 0..5).
        let nox : i32 = 0;
        let noy : i32 = 0;
        let noz : i32 = 0;
        match di {
            0 => { nox = 1; }
            1 => { nox = 0 - 1; }
            2 => { noy = 1; }
            3 => { noy = 0 - 1; }
            4 => { noz = 1; }
            _ => { noz = 0 - 1; }
        }
        let nb : IVec3 = ivec3(w.x + nox, w.y + noy, w.z + noz);

        // Normal axis: 0 = X (dir 0/1), 1 = Y (2/3), 2 = Z (4/5).
        let naxis : i32 = di / 2;
        let k : i32 = 0;
        while (k < 4) {
            let b : i32 = (di * 4 + k) * 3;
            // Tangent signs from the corner block offset (0 → -1, 1 → +1).
            let sx : i32 = this.lcoff[b] * 2 - 1;
            let sy : i32 = this.lcoff[b + 1] * 2 - 1;
            let sz : i32 = this.lcoff[b + 2] * 2 - 1;
            // The two in-plane neighbour offsets t1, t2 (skip the normal axis).
            let t1x : i32 = 0;
            let t1y : i32 = 0;
            let t1z : i32 = 0;
            let t2x : i32 = 0;
            let t2y : i32 = 0;
            let t2z : i32 = 0;
            match naxis {
                0 => {
                    t1y = sy;
                    t2z = sz;
                }
                1 => {
                    t1x = sx;
                    t2z = sz;
                }
                _ => {
                    t1x = sx;
                    t2y = sy;
                }
            }
            // The 4 cells meeting at this corner, all in the nb layer.
            let c1 : IVec3 = ivec3(nb.x + t1x, nb.y + t1y, nb.z + t1z);
            let c2 : IVec3 = ivec3(nb.x + t2x, nb.y + t2y, nb.z + t2z);
            let c3 : IVec3 = ivec3(nb.x + t1x + t2x, nb.y + t1y + t2y, nb.z + t1z + t2z);

            // Smooth light: average sky / block over the non-opaque cells.
            let skSum : i32 = this.skGetW(nb);
            let blSum : i32 = this.blGetW(nb);
            let cnt : i32 = 1;
            let o1 : bool = isOpaque(this.worldGet(c1));
            let o2 : bool = isOpaque(this.worldGet(c2));
            let o3 : bool = isOpaque(this.worldGet(c3));
            if (!o1) {
                skSum = skSum + this.skGetW(c1);
                blSum = blSum + this.blGetW(c1);
                cnt = cnt + 1;
            }
            if (!o2) {
                skSum = skSum + this.skGetW(c2);
                blSum = blSum + this.blGetW(c2);
                cnt = cnt + 1;
            }
            if (!o3) {
                skSum = skSum + this.skGetW(c3);
                blSum = blSum + this.blGetW(c3);
                cnt = cnt + 1;
            }

            let skAvg : i32 = (skSum + cnt / 2) / cnt;
            let blAvg : i32 = (blSum + cnt / 2) / cnt;
            writeU8(this.flight, (i * 4 + k) as i64, skAvg * 16 + blAvg);

            // Ambient occlusion (0..3): both sides blocked → fully dark corner.
            let s1 : i32 = 0;
            if (o1) {
                s1 = 1;
            }
            let s2 : i32 = 0;
            if (o2) {
                s2 = 1;
            }
            let sc : i32 = 0;
            if (o3) {
                sc = 1;
            }
            let ao : i32 = 3 - (s1 + s2 + sc);
            if (s1 == 1 && s2 == 1) {
                ao = 0;
            }
            writeU8(this.fao, (i * 4 + k) as i64, ao);
            k = k + 1;
        }
    }

    /**
     * Record a torch at a world voxel in this slot's torch list (dropped if at
     * capacity). The renderer draws these as thin posts.
     * @param slot  the slot index
     * @param cell  the torch's world voxel
     */
    fn addTorch(slot : i32, cell : IVec3) : void {
        let tc : i32 = this.tcount[slot];
        if (tc >= config::maxTorchesPerChunk) {
            return;
        }
        let i : i32 = slot * config::maxTorchesPerChunk + tc;
        this.tx[i] = cell.x;
        this.ty[i] = cell.y;
        this.tz[i] = cell.z;
        this.tcount[slot] = tc + 1;
    }

    /**
     * Re-bake the chunk's faces from its voxels: every block emits a
     * face on each side that borders air (so water occludes underwater
     * walls — visual parity with the old mesher). Water draws only its
     * top surface. Each column's `ctop` is the highest collidable voxel
     * + 1. Directions match `render.renderFace` normals:
     * 0:+x 1:-x 2:+y(top) 3:-y(bottom) 4:+z 5:-z.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn buildMesh(slot : i32, cx : i32, cz : i32) : void {
        this.fcount[slot] = 0;
        this.tcount[slot] = 0;
        let s : i32 = config::chunkSize;
        let top : i32 = this.store.maxFY[slot];
        let air : Block = Block::Air;
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                let wx : i32 = cx * s + lx;
                let wz : i32 = cz * s + lz;
                let coll : i32 = 0;
                let ly : i32 = 0;
                while (ly <= top) {
                    let id : Block = this.getVox(slot, ivec3(lx, ly, lz));
                    // Non-air voxel: emit its faces; a collidable solid raises the
                    // column's collision top. The per-category work is in meshVoxel.
                    if (id != air && this.meshVoxel(slot, lx, ly, lz, wx, wz, id)) {
                        coll = ly + 1;
                    }
                    ly = ly + 1;
                }
                this.ctop[slot * s * s + lz * s + lx] = coll;
                lx = lx + 1;
            }
            lz = lz + 1;
        }
    }

    /**
     * Emit the mesh faces for one non-air voxel: a torch records a post (no cube
     * faces), water shows its surface + the side walls bordering air, a partial
     * block its raised top + the step walls toward lower neighbours, and a solid
     * block a face wherever its neighbour is transparent. Split out of buildMesh
     * to keep that triple loop shallow.
     * @param slot  the slot index
     * @param lx    local x
     * @param ly    local y
     * @param lz    local z
     * @param wx    world x
     * @param wz    world z
     * @param id    the voxel's block id (already known to be non-air)
     * @return true if the voxel is collidable (so the caller raises the column top)
     */
    fn meshVoxel(slot : i32, lx : i32, ly : i32, lz : i32, wx : i32, wz : i32, id : Block) : bool {
        let air : Block = Block::Air;
        let cell : IVec3 = ivec3(wx, ly, wz);   // this voxel, for addFace / addTorch
        if (id == Block::Torch) {
            // Torches emit no cube faces; a thin post is drawn separately
            // (renderTorches). Just record the spot.
            this.addTorch(slot, cell);
            return false;
        }
        if (isWater(id)) {
            // Water: top surface, plus side walls only where it borders air
            // (shores, dug pits) — so a body of water looks contained and you see
            // its surface and edges. Water against water/solid emits nothing.
            if (this.getVox(slot, ivec3(lx, ly + 1, lz)) == air) {
                this.addFace(slot, cell, FaceDir::Top, tileFor(id, FaceDir::Top));
            }
            if (this.getVox(slot, ivec3(lx + 1, ly, lz)) == air) {
                this.addFace(slot, cell, FaceDir::PosX, tileFor(id, FaceDir::PosX));
            }
            if (this.getVox(slot, ivec3(lx - 1, ly, lz)) == air) {
                this.addFace(slot, cell, FaceDir::NegX, tileFor(id, FaceDir::NegX));
            }
            if (this.getVox(slot, ivec3(lx, ly, lz + 1)) == air) {
                this.addFace(slot, cell, FaceDir::PosZ, tileFor(id, FaceDir::PosZ));
            }
            if (this.getVox(slot, ivec3(lx, ly, lz - 1)) == air) {
                this.addFace(slot, cell, FaceDir::NegZ, tileFor(id, FaceDir::NegZ));
            }
            return false;
        }
        if (isPartialShape(id)) {
            // A partial, floor-resting block (thin snow today, slabs later) at its
            // real height. Emit the top, and a side wall toward a neighbour that
            // is air OR a LOWER partial block (so the exposed step between two
            // heights is filled — no see-through to the ground). Equal/higher
            // partials and full blocks cull, so a flat field has no z-fighting grid.
            this.addFace(slot, cell, FaceDir::Top, tileFor(id, FaceDir::Top));
            let myH : f64 = this.blockBoxHeight(ivec3(wx, ly, wz));
            if (this.partialSideOpen(slot, lx + 1, ly, lz, wx + 1, wz, myH)) {
                this.addFace(slot, cell, FaceDir::PosX, tileFor(id, FaceDir::PosX));
            }
            if (this.partialSideOpen(slot, lx - 1, ly, lz, wx - 1, wz, myH)) {
                this.addFace(slot, cell, FaceDir::NegX, tileFor(id, FaceDir::NegX));
            }
            if (this.partialSideOpen(slot, lx, ly, lz + 1, wx, wz + 1, myH)) {
                this.addFace(slot, cell, FaceDir::PosZ, tileFor(id, FaceDir::PosZ));
            }
            if (this.partialSideOpen(slot, lx, ly, lz - 1, wx, wz - 1, myH)) {
                this.addFace(slot, cell, FaceDir::NegZ, tileFor(id, FaceDir::NegZ));
            }
            return false;
        }
        // A solid block shows a face wherever its neighbour is TRANSPARENT — air
        // or water — so submerged terrain (lakebed, walls) stays visible through
        // the water instead of vanishing.
        if (isTransparent(this.getVox(slot, ivec3(lx + 1, ly, lz)))) {
            this.addFace(slot, cell, FaceDir::PosX, tileFor(id, FaceDir::PosX));
        }
        if (isTransparent(this.getVox(slot, ivec3(lx - 1, ly, lz)))) {
            this.addFace(slot, cell, FaceDir::NegX, tileFor(id, FaceDir::NegX));
        }
        // A partial block above (snow, a slab) is transparent but seals this top
        // from view: its own raised top now renders double-sided (see
        // renderFace), so it stays watertight even when the eye drops below it —
        // no need to draw the ground skin under it (that only showed a
        // contrasting rim). A normal transparent block above keeps this top.
        let above : Block = this.getVox(slot, ivec3(lx, ly + 1, lz));
        if (isTransparent(above) && !isPartialShape(above)) {
            this.addFace(slot, cell, FaceDir::Top, tileFor(id, FaceDir::Top));
        }
        if (isTransparent(this.getVox(slot, ivec3(lx, ly - 1, lz)))) {
            this.addFace(slot, cell, FaceDir::Bottom, tileFor(id, FaceDir::Bottom));
        }
        if (isTransparent(this.getVox(slot, ivec3(lx, ly, lz + 1)))) {
            this.addFace(slot, cell, FaceDir::PosZ, tileFor(id, FaceDir::PosZ));
        }
        if (isTransparent(this.getVox(slot, ivec3(lx, ly, lz - 1)))) {
            this.addFace(slot, cell, FaceDir::NegZ, tileFor(id, FaceDir::NegZ));
        }
        return isCollidable(id);
    }

    // ── Editing (dig / place) ───────────────────────────────────

    /**
     * Write `id` at a world voxel into every loaded slot whose padded
     * volume contains it (the owner chunk, plus 1–3 neighbours when the
     * voxel sits on an edge / corner so their skirt copies stay in
     * sync), then re-mesh each.
     * @param cell  the world voxel
     * @param id  the block id to write
     */
    fn setVoxel(cell : IVec3, id : Block) : void {
        let wx : i32 = cell.x;
        let wy : i32 = cell.y;
        let wz : i32 = cell.z;
        if (wy < 0 || wy >= config::worldHeight) {
            return;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(wx, s);
        let cz : i32 = this.floorDiv(wz, s);
        let dcz : i32 = 0 - 1;
        while (dcz <= 1) {
            let dcx : i32 = 0 - 1;
            while (dcx <= 1) {
                let ccx : i32 = cx + dcx;
                let ccz : i32 = cz + dcz;
                let lx : i32 = wx - ccx * s;
                let lz : i32 = wz - ccz * s;
                if (lx >= 0 - 1 && lx <= s && lz >= 0 - 1 && lz <= s) {
                    let slot : i32 = this.slotFor(ccx, ccz);
                    if (this.loaded[slot] == 1 && this.cxs[slot] == ccx && this.czs[slot] == ccz) {
                        let v : Block = id;
                        this.setVoxLocal(slot, ivec3(lx, wy, lz), v);
                        if (id != Block::Air) {
                            this.bumpFY(slot, wy);
                        }
                        this.buildMesh(slot, ccx, ccz);
                    }
                }
                dcx = dcx + 1;
            }
            dcz = dcz + 1;
        }
    }

    // ── Block light (torches) — a flood-fill engine, walls block light ──

    /**
     * Light level (0..15) of one channel volume at a world voxel; 0 if unloaded /
     * out of range. The shared core of blGetW / skGetW — `vol` selects the
     * block-light or sky-light byte volume.
     * @param vol  the light byte volume (lights.light or lights.skylight)
     * @param cell   the world voxel
     * @return the level 0..15
     */
    fn lvGetW(vol : i64, cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 0;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(cell.x, s);
        let cz : i32 = this.floorDiv(cell.z, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return 0;
        }
        return readU8(vol, this.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64);
    }

    /**
     * Set one channel volume's light at a world voxel (owner chunk), flagging the
     * slot for re-mesh if the value actually changed. Shared core of blSetW /
     * skSetW.
     * @param vol  the light byte volume (lights.light or lights.skylight)
     * @param cell   the world voxel
     * @param v    the new level 0..15
     */
    fn lvSetW(vol : i64, cell : IVec3, v : i32) : void {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(cell.x, s);
        let cz : i32 = this.floorDiv(cell.z, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return;
        }
        let off : i64 = this.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64;
        if (readU8(vol, off) != v) {
            writeU8(vol, off, v);
            this.lights.ldirty[slot] = 1;
        }
    }

    /** Block-light level (0..15) at a world voxel; 0 if unloaded / out of range. */
    fn blGetW(cell : IVec3) : i32 {
        return this.lvGetW(this.lights.light, cell);
    }

    /** Set block light at a world voxel; flags the slot for re-mesh if changed. */
    fn blSetW(cell : IVec3, v : i32) : void {
        this.lvSetW(this.lights.light, cell, v);
    }

    /** Sky-light level (0..15) at a world voxel; 0 if unloaded / out of range. */
    fn skGetW(cell : IVec3) : i32 {
        return this.lvGetW(this.lights.skylight, cell);
    }

    /** Set sky light at a world voxel; flags the slot for re-mesh if changed. */
    fn skSetW(cell : IVec3, v : i32) : void {
        this.lvSetW(this.lights.skylight, cell, v);
    }

    /**
     * Recompute a column's sky light: 15 from the top down to the first opaque
     * block, 0 below it — so open ground is sky-lit and anything roofed over /
     * underground is dark (and needs torches).
     * @param wx  world x
     * @param wz  world z
     */
    fn skyColumn(wx : i32, wz : i32) : void {
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(wx, s);
        let cz : i32 = this.floorDiv(wz, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return;
        }
        let lx : i32 = wx - cx * s;
        let lz : i32 = wz - cz * s;
        let lit : i32 = 15;
        let y : i32 = config::worldHeight - 1;
        while (y >= 0) {
            if (lit > 0 && isOpaque(this.getVox(slot, ivec3(lx, y, lz)))) {
                lit = 0;
            }
            let off : i64 = this.voxIdx(slot, lx, y, lz) as i64;
            if (readU8(this.lights.skylight, off) != lit) {
                writeU8(this.lights.skylight, off, lit);
                this.lights.ldirty[slot] = 1;
            }
            y = y - 1;
        }
    }

    /**
     * Seed sky light for a freshly generated chunk: set each column's vertical
     * exposure, then flood the sideways gradient so overhung / roofed spots fade
     * in instead of leaving a hard black patch.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn seedSky(slot : i32, cx : i32, cz : i32) : void {
        let s : i32 = config::chunkSize;
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                this.skyColumn(cx * s + lx, cz * s + lz);
                lx = lx + 1;
            }
            lz = lz + 1;
        }
        // Sideways gradient at generation: flood sky from the fully lit cells in
        // the active band, so roofed / overhung spots (under a canopy, a cliff,
        // a cave mouth) fade in like an edit would — no hard black patch.
        this.lights.lqn = 0;
        let top : i32 = this.store.maxFY[slot] + 1;
        if (top > config::worldHeight - 1) {
            top = config::worldHeight - 1;
        }
        let bz : i32 = 0;
        while (bz < s) {
            let bx : i32 = 0;
            while (bx < s) {
                let by : i32 = 0;
                while (by <= top) {
                    if (readU8(this.lights.skylight, this.voxIdx(slot, bx, by, bz) as i64) == 15) {
                        this.lpush(ivec3(cx * s + bx, by, cz * s + bz));
                    }
                    by = by + 1;
                }
                bx = bx + 1;
            }
            bz = bz + 1;
        }
        this.floodAddCh(this.lights.skylight);
    }

    /**
     * Spread one channel's light into a neighbour, losing one level per block,
     * when it would be brighter there (and the neighbour isn't opaque). Pushes
     * the brightened neighbour so the flood continues. Shared by block + sky —
     * `vol` selects the channel.
     * @param vol        the light volume (lights.light or lights.skylight)
     * @param neighbour  the neighbour world voxel
     * @param lv         this cell's level (the neighbour gets lv-1)
     */
    fn trySpreadCh(vol : i64, neighbour : IVec3, lv : i32) : void {
        if (isOpaque(this.worldGet(neighbour))) {
            return;
        }
        if (this.lvGetW(vol, neighbour) < lv - 1) {
            this.lvSetW(vol, neighbour, lv - 1);
            this.lpush(neighbour);
        }
    }

    /**
     * Flood one channel's add-stack to completion (bounded by the stack cap):
     * each popped cell spreads to its 6 neighbours. Torch block light and sky
     * light under overhangs both use this — the add-stack is shared, so a cave
     * entrance fades from daylight to dark instead of cutting hard.
     * @param vol  the light volume (lights.light or lights.skylight)
     */
    fn floodAddCh(vol : i64) : void {
        while (this.lights.lqn > 0) {
            this.lights.lqn = this.lights.lqn - 1;
            let entry : IVec3 = this.lights.lq[this.lights.lqn];
            let lv : i32 = this.lvGetW(vol, entry);
            if (lv > 1) {
                this.trySpreadCh(vol, ivec3(entry.x + 1, entry.y, entry.z), lv);
                this.trySpreadCh(vol, ivec3(entry.x - 1, entry.y, entry.z), lv);
                this.trySpreadCh(vol, ivec3(entry.x, entry.y + 1, entry.z), lv);
                this.trySpreadCh(vol, ivec3(entry.x, entry.y - 1, entry.z), lv);
                this.trySpreadCh(vol, ivec3(entry.x, entry.y, entry.z + 1), lv);
                this.trySpreadCh(vol, ivec3(entry.x, entry.y, entry.z - 1), lv);
            }
        }
    }

    /**
     * One channel removal neighbour step: a neighbour dimmer than the removed
     * level is itself cleared and queued for further removal; an equal/brighter
     * neighbour is a surviving source, queued onto the add-stack to refill.
     * @param vol        the light volume (lights.light or lights.skylight)
     * @param neighbour  the neighbour world voxel
     * @param lvl        the level being removed from the parent cell
     */
    fn tryRemoveCh(vol : i64, neighbour : IVec3, lvl : i32) : void {
        let nl : i32 = this.lvGetW(vol, neighbour);
        if (nl != 0) {
            if (nl < lvl) {
                this.lvSetW(vol, neighbour, 0);
                this.rpush(neighbour, nl);
            } else {
                this.lpush(neighbour);
            }
        }
    }

    /**
     * Flood one channel's removal stack, feeding the add-stack from surviving
     * (brighter/equal) sources so they refill the cleared region.
     * @param vol  the light volume (lights.light or lights.skylight)
     */
    fn floodRemoveCh(vol : i64) : void {
        while (this.lights.rqn > 0) {
            this.lights.rqn = this.lights.rqn - 1;
            let entry : LightRemoval = this.lights.rq[this.lights.rqn];
            this.tryRemoveCh(vol, ivec3(entry.x + 1, entry.y, entry.z), entry.lvl);
            this.tryRemoveCh(vol, ivec3(entry.x - 1, entry.y, entry.z), entry.lvl);
            this.tryRemoveCh(vol, ivec3(entry.x, entry.y + 1, entry.z), entry.lvl);
            this.tryRemoveCh(vol, ivec3(entry.x, entry.y - 1, entry.z), entry.lvl);
            this.tryRemoveCh(vol, ivec3(entry.x, entry.y, entry.z + 1), entry.lvl);
            this.tryRemoveCh(vol, ivec3(entry.x, entry.y, entry.z - 1), entry.lvl);
        }
    }

    /**
     * Push a cell onto the (shared block/sky) light add-stack; dropped if the
     * stack is at capacity, which keeps the flood bounded.
     * @param cell the world voxel
     */
    fn lpush(cell : IVec3) : void {
        if (this.lights.lqn >= config::lightQueueCap) {
            return;
        }
        this.lights.lq[this.lights.lqn] = IVec3 { x: cell.x, y: cell.y, z: cell.z };
        this.lights.lqn = this.lights.lqn + 1;
    }

    /**
     * Push a cell plus its old level onto the light removal-stack; dropped if
     * the stack is at capacity.
     * @param cell   the world voxel
     * @param lvl  the cell's old (pre-removal) light level
     */
    fn rpush(cell : IVec3, lvl : i32) : void {
        if (this.lights.rqn >= config::lightQueueCap) {
            return;
        }
        this.lights.rq[this.lights.rqn] = LightRemoval { x: cell.x, y: cell.y, z: cell.z, lvl: lvl };
        this.lights.rqn = this.lights.rqn + 1;
    }

    /** Re-mesh every slot whose light changed, then clear the flags. */
    fn flushLightMesh() : void {
        let slots : i32 = config::span * config::span;
        let i : i32 = 0;
        while (i < slots) {
            if (this.lights.ldirty[i] == 1) {
                this.lights.ldirty[i] = 0;
                if (this.loaded[i] == 1) {
                    this.buildMesh(i, this.cxs[i], this.czs[i]);
                    this.lights.skyAOdirty[i] = 1;   // geometry/light changed → re-bake sky access
                }
            }
            i = i + 1;
        }
    }

    /**
     * Recompute block light after ANY edit at a world voxel — the general,
     * correct update. It clears the light that ran through the cell (so a newly
     * placed opaque block casts a real shadow and a walled-in torch goes dark),
     * re-seeds the cell if its block now emits light, then re-floods from the
     * cell's neighbours (so light flows into a freshly opened space). Touched
     * chunks are re-meshed.
     * @param wx  world x
     * @param cell the edited world voxel
     */
    fn lightUpdate(cell : IVec3) : void {
        let wx : i32 = cell.x;
        let wy : i32 = cell.y;
        let wz : i32 = cell.z;
        this.lights.lqn = 0;
        this.lights.rqn = 0;
        // 1. Remove the light currently at the cell and everything it fed.
        let cur : i32 = this.blGetW(cell);
        this.blSetW(cell, 0);
        this.rpush(cell, cur + 1);
        this.floodRemoveCh(this.lights.light);
        // 2. If the block now there emits light, re-seed it.
        let emit : i32 = lightEmission(this.worldGet(ivec3(wx, wy, wz)));
        if (emit > 0) {
            this.blSetW(cell, emit);
            this.lpush(cell);
        }
        // 3. Let light from the 6 neighbours flow into / around the cell.
        this.lpush(ivec3(wx + 1, wy, wz));
        this.lpush(ivec3(wx - 1, wy, wz));
        this.lpush(ivec3(wx, wy + 1, wz));
        this.lpush(ivec3(wx, wy - 1, wz));
        this.lpush(ivec3(wx, wy, wz + 1));
        this.lpush(ivec3(wx, wy, wz - 1));
        this.floodAddCh(this.lights.light);
        // 4. Sky light: reconcile the edited column's vertical exposure — seed a
        // REMOVAL where a cell darkened (a hole got sealed) and an ADD where it
        // brightened (a hole opened) — then flood both, so sky light recedes as
        // well as fills, and the sideways gradient updates either way.
        this.lights.lqn = 0;
        this.lights.rqn = 0;
        let scx : i32 = this.floorDiv(wx, config::chunkSize);
        let scz : i32 = this.floorDiv(wz, config::chunkSize);
        let sslot : i32 = this.slotFor(scx, scz);
        if (this.loaded[sslot] == 1 && this.cxs[sslot] == scx && this.czs[sslot] == scz) {
            let slx : i32 = wx - scx * config::chunkSize;
            let slz : i32 = wz - scz * config::chunkSize;
            let lit : i32 = 15;
            let cy : i32 = config::worldHeight - 1;
            while (cy >= 0) {
                if (lit > 0 && isOpaque(this.getVox(sslot, ivec3(slx, cy, slz)))) {
                    lit = 0;
                }
                let coff : i64 = this.voxIdx(sslot, slx, cy, slz) as i64;
                let oldv : i32 = readU8(this.lights.skylight, coff);
                if (oldv > lit) {
                    writeU8(this.lights.skylight, coff, lit);
                    this.lights.ldirty[sslot] = 1;
                    this.rpush(ivec3(wx, cy, wz), oldv);
                } else if (lit > oldv) {
                    writeU8(this.lights.skylight, coff, lit);
                    this.lights.ldirty[sslot] = 1;
                    this.lpush(ivec3(wx, cy, wz));
                }
                cy = cy - 1;
            }
        }
        this.floodRemoveCh(this.lights.skylight);
        // Also seed the add from the edited cell + its 6 neighbours, so the
        // sideways sky gradient flows into a newly opened space even when the
        // edit doesn't change the column (e.g. digging a horizontal tunnel off
        // a lit shaft) — the column reconcile alone would miss that.
        this.lpush(cell);
        this.lpush(ivec3(wx + 1, wy, wz));
        this.lpush(ivec3(wx - 1, wy, wz));
        this.lpush(ivec3(wx, wy + 1, wz));
        this.lpush(ivec3(wx, wy - 1, wz));
        this.lpush(ivec3(wx, wy, wz + 1));
        this.lpush(ivec3(wx, wy, wz - 1));
        this.floodAddCh(this.lights.skylight);
        // A face is baked from the light of the AIR cell it looks into. When the
        // edited cell sits on a chunk border, the face that looks into it belongs
        // to the NEIGHBOUR chunk, whose light values didn't change — so
        // flushLightMesh alone would leave it baked with the stale (pre-edit)
        // light. Re-flag the edited chunk plus any border neighbour so their
        // shared faces re-bake with the final light (fixes black/desynced faces
        // when digging on a seam).
        let ecs : i32 = config::chunkSize;
        let ecx : i32 = this.floorDiv(wx, ecs);
        let ecz : i32 = this.floorDiv(wz, ecs);
        let elx : i32 = wx - ecx * ecs;
        let elz : i32 = wz - ecz * ecs;
        this.markDirtyAt(ecx, ecz);
        if (elx == 0) { this.markDirtyAt(ecx - 1, ecz); }
        if (elx == ecs - 1) { this.markDirtyAt(ecx + 1, ecz); }
        if (elz == 0) { this.markDirtyAt(ecx, ecz - 1); }
        if (elz == ecs - 1) { this.markDirtyAt(ecx, ecz + 1); }
        this.flushLightMesh();
    }

    /**
     * Reset a slot's per-voxel light maps for a freshly (re)generated chunk:
     * block + sky light to 0 (dark), sun visibility + sky access to full, the
     * colour-bounce tint to neutral, and flag the slot for a sky-AO bake.
     * @param slot  the slot index
     */
    fn clearLight(slot : i32) : void {
        let hSide : i32 = config::chunkSize + 2;
        let n : i32 = hSide * hSide * config::worldHeight;
        let base : i64 = (slot as i64) * (n as i64);
        let i : i32 = 0;
        while (i < n) {
            writeU8(this.lights.light, base + (i as i64), 0);
            writeU8(this.lights.skylight, base + (i as i64), 0);
            writeU8(this.lights.sunlit, base + (i as i64), 255);  // fully lit until the soft-shadow pass refines it (0..255)
            writeU8(this.lights.skyaccess, base + (i as i64), 255);  // full sky access until the AO bake refines it
            writeU8(this.lights.bnR, base + (i as i64), 128);  // neutral (1.0) bounce tint until baked
            writeU8(this.lights.bnG, base + (i as i64), 128);
            writeU8(this.lights.bnB, base + (i as i64), 128);
            i = i + 1;
        }
        this.lights.skyAOdirty[slot] = 1;  // a freshly (re)generated chunk needs a sky-AO bake
    }

    // ── Directional sun shadows ─────────────────────────────────

    /**
     * Sun visibility at a world voxel: 1 if the sun reaches it, 0 if it's in
     * cast shadow. Out-of-range / unloaded cells read lit (1) so they never
     * darken a face wrongly.
     * @param cell  the world voxel
     * @return soft sun visibility 0 (shadow) .. 255 (full sun)
     */
    fn sunlitGet(cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 255;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(cell.x, s);
        let cz : i32 = this.floorDiv(cell.z, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return 255;
        }
        return readU8(this.lights.sunlit, this.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64);
    }

    /**
     * March a ray from an air cell toward the sun. Returns 1 if it escapes above
     * all terrain (`ceil`) or runs the full reach unobstructed (sunlit), 0 if an
     * opaque voxel blocks it (shadowed). Climbing past `ceil` — the tallest
     * loaded terrain — means nothing can block it, so over flat ground rays stop
     * almost immediately (the key optimisation).
     * @param cell  origin air cell
     * @param dir   sun direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     * @return 1 sunlit, 0 shadowed
     */
    fn sunRayClear(cell : IVec3, dir : Vec3, ceil : i32) : i32 {
        let ox : f64 = (cell.x as f64) + 0.5;
        let oy : f64 = (cell.y as f64) + 0.5;
        let oz : f64 = (cell.z as f64) + 0.5;
        let t : f64 = 0.5;
        while (t < config::sunShadowReach) {
            let cy : i32 = Math::floorToInt(oy + dir.y * t) as i32;
            if (cy > ceil) {
                return 1;
            }
            if (cy >= 0 && cy < config::worldHeight) {
                let cx : i32 = Math::floorToInt(ox + dir.x * t) as i32;
                let cz : i32 = Math::floorToInt(oz + dir.z * t) as i32;
                if (isOpaque(this.worldGet(ivec3(cx, cy, cz)))) {
                    return 0;
                }
            }
            t = t + 0.6;
        }
        return 1;
    }

    /**
     * Soft sun visibility (penumbra): cast config::sunShadowSamples rays from the
     * cell, the first straight at the sun and the rest spread over the sun's
     * angular disc (config::sunDiscAngle), and return the fraction that reach the
     * sun, scaled to 0..255. Because the disc rays diverge with distance, a far
     * occluder casts a wider soft edge than a near one — real penumbra. The ring
     * is rotated by a per-cell hash so the few samples don't band into facets.
     * @param cell  origin air cell
     * @param dir   sun direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     * @return soft visibility 0 (full shadow) .. 255 (full sun)
     */
    fn sunRaySoft(cell : IVec3, dir : Vec3, ceil : i32) : i32 {
        let n : i32 = config::sunShadowSamples;
        if (n < 1) {
            n = 1;
        }
        // Centre ray straight at the sun.
        let total : i32 = this.sunRayClear(cell, dir, ceil);
        if (n == 1) {
            return total * 255;
        }
        // Build a basis perpendicular to the sun direction (tangent, bitangent).
        let ux : f64 = 0.0;
        let uy : f64 = 1.0;
        let uz : f64 = 0.0;
        if (dir.y > 0.9 || dir.y < 0.0 - 0.9) {
            ux = 1.0;
            uy = 0.0;
            uz = 0.0;
        }
        let tx : f64 = uy * dir.z - uz * dir.y;
        let ty : f64 = uz * dir.x - ux * dir.z;
        let tz : f64 = ux * dir.y - uy * dir.x;
        let tl : f64 = Math::sqrt(tx * tx + ty * ty + tz * tz);
        if (tl < 0.000001) {
            tl = 0.000001;
        }
        tx = tx / tl;
        ty = ty / tl;
        tz = tz / tl;
        let bx : f64 = dir.y * tz - dir.z * ty;
        let by : f64 = dir.z * tx - dir.x * tz;
        let bz : f64 = dir.x * ty - dir.y * tx;
        // Per-cell ring rotation so few samples don't band.
        let hash : i32 = (cell.x * 1664525 + cell.y * 22695477 + cell.z * 40503) & 0x7FFFFFFF;
        let rot : f64 = ((hash % 628) as f64) * 0.01;
        let r : f64 = config::sunDiscAngle;
        let cnt : i32 = 1;
        let i : i32 = 1;
        while (i < n) {
            let ang : f64 = 6.2831853 * ((i - 1) as f64) / ((n - 1) as f64) + rot;
            let ox : f64 = Math::cos(ang) * r;
            let oy : f64 = Math::sin(ang) * r;
            let dx : f64 = dir.x + tx * ox + bx * oy;
            let dy : f64 = dir.y + ty * ox + by * oy;
            let dz : f64 = dir.z + tz * ox + bz * oy;
            let dl : f64 = Math::sqrt(dx * dx + dy * dy + dz * dz);
            if (dl < 0.000001) {
                dl = 0.000001;
            }
            total = total + this.sunRayClear(cell, vec3(dx / dl, dy / dl, dz / dl), ceil);
            cnt = cnt + 1;
            i = i + 1;
        }
        return (total * 255) / cnt;
    }

    /**
     * Recompute sun visibility for one chunk: every sky-lit air cell in the
     * active band gets a ray cast toward the sun.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     * @param sun   sun direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     */
    fn computeChunkSun(slot : i32, cx : i32, cz : i32, sun : Vec3, ceil : i32) : void {
        let s : i32 = config::chunkSize;
        let top : i32 = this.store.maxFY[slot] + 1;
        if (top > config::worldHeight - 1) {
            top = config::worldHeight - 1;
        }
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                let y : i32 = 0;
                while (y <= top) {
                    let off : i64 = this.voxIdx(slot, lx, y, lz) as i64;
                    if (this.getVox(slot, ivec3(lx, y, lz)) == Block::Air && readU8(this.lights.skylight, off) > 0) {
                        writeU8(this.lights.sunlit, off, this.sunRaySoft(ivec3(cx * s + lx, y, cz * s + lz), sun, ceil));
                    }
                    y = y + 1;
                }
                lx = lx + 1;
            }
            lz = lz + 1;
        }
    }

    /**
     * Throttled directional-shadow refresh: recompute the sun visibility of up
     * to `budget` loaded chunks per call (round-robin), so the whole view
     * refreshes over a handful of frames and the shadows track the moving sun
     * with no per-frame full recompute. Skipped at night (the sun is below the
     * horizon, so the directional term is 0 and shadows aren't visible anyway).
     * @param dayTime  time of day (0..1) — drives the sun direction
     * @param budget   max chunks to refresh this call
     */
    fn stepSunShadows(dayTime : f64, budget : i32) : void {
        let ang : f64 = (dayTime - 0.25) * 6.2831853;
        let sy : f64 = Math::sin(ang);
        if (sy <= 0.02) {
            return;
        }
        let sx : f64 = Math::cos(ang);
        let sz : f64 = config::sunTilt;
        let len : f64 = Math::sqrt(sx * sx + sy * sy + sz * sz);
        if (len < 0.0001) {
            len = 0.0001;
        }
        sx = sx / len;
        sy = sy / len;
        sz = sz / len;
        let slots : i32 = config::span * config::span;
        let ceil : i32 = 0;
        let j : i32 = 0;
        while (j < slots) {
            if (this.loaded[j] == 1 && this.store.maxFY[j] > ceil) {
                ceil = this.store.maxFY[j];
            }
            j = j + 1;
        }
        let done : i32 = 0;
        let guard : i32 = 0;
        while (done < budget && guard < slots) {
            let slot : i32 = this.lights.sunCursor;
            this.lights.sunCursor = this.lights.sunCursor + 1;
            if (this.lights.sunCursor >= slots) {
                this.lights.sunCursor = 0;
            }
            guard = guard + 1;
            if (this.loaded[slot] == 1) {
                this.computeChunkSun(slot, this.cxs[slot], this.czs[slot], vec3(sx, sy, sz), ceil);
                done = done + 1;
            }
        }
    }

    // ── Hemispherical sky-access (ambient occlusion / GI) ────────

    /**
     * Sky access 0..255 at a world voxel: 255 = fully open to the sky, lower =
     * occluded by surrounding terrain (valleys, overhangs, under canopy). Out of
     * range / unloaded reads fully open so it never wrongly darkens a face.
     * @param cell  the world voxel
     * @return the sky access 0 (occluded) .. 255 (fully open)
     */
    fn skyaccessGet(cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 255;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(cell.x, s);
        let cz : i32 = this.floorDiv(cell.z, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return 255;
        }
        return readU8(this.lights.skyaccess, this.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64);
    }

    /**
     * Soft sun visibility averaged over the 4 air cells meeting at a face corner
     * (the corner's air cell `b` plus its two edge neighbours and the diagonal,
     * given by the tangent offsets t1/t2). Symmetric in the corner, so coplanar
     * faces sharing a corner get the SAME value — the cast shadow interpolates
     * smoothly across faces instead of stepping block by block. Returns 0..255.
     * @param base  the corner's own air cell
     * @param t1    first in-plane tangent offset
     * @param t2    second in-plane tangent offset
     * @return the averaged soft sun visibility 0..255
     */
    fn sunSoftCorner(base : IVec3, t1 : IVec3, t2 : IVec3) : i32 {
        let a : i32 = this.sunlitGet(base);
        let b : i32 = this.sunlitGet(ivec3(base.x + t1.x, base.y + t1.y, base.z + t1.z));
        let c : i32 = this.sunlitGet(ivec3(base.x + t2.x, base.y + t2.y, base.z + t2.z));
        let d : i32 = this.sunlitGet(ivec3(base.x + t1.x + t2.x, base.y + t1.y + t2.y, base.z + t1.z + t2.z));
        return (a + b + c + d) / 4;
    }

    /**
     * Encode a bounce tint channel: normalised colour ratio `ratio` (1.0 = grey),
     * blended toward neutral by `occ`, stored as a byte where 128 = ×1.0.
     * @param ratio  the channel's colour ratio (1.0 = neutral grey)
     * @param occ    occlusion weight 0..1 (how strongly to apply the tint)
     * @return the packed byte (clamped 0..255, 128 = ×1.0)
     */
    fn bounceByte(ratio : f64, occ : f64) : i32 {
        let f : f64 = 1.0 + (ratio - 1.0) * occ;
        let v : i32 = Math::floorToInt(f * 128.0) as i32;
        if (v < 0) {
            v = 0;
        }
        if (v > 255) {
            v = 255;
        }
        return v;
    }

    /**
     * Packed one-bounce coloured tint (r<<16|g<<8|b, each 128 = ×1.0) at a world
     * voxel; neutral grey (0x808080) out of range / unloaded.
     * @param cell  the world voxel
     * @return the packed bounce tint (0xRRGGBB, each channel 128 = ×1.0)
     */
    fn bounceGet(cell : IVec3) : i32 {
        if (cell.y < 0 || cell.y >= config::worldHeight) {
            return 0x808080;
        }
        let s : i32 = config::chunkSize;
        let cx : i32 = this.floorDiv(cell.x, s);
        let cz : i32 = this.floorDiv(cell.z, s);
        let slot : i32 = this.slotFor(cx, cz);
        if (this.loaded[slot] == 0 || this.cxs[slot] != cx || this.czs[slot] != cz) {
            return 0x808080;
        }
        let off : i64 = this.voxIdx(slot, cell.x - cx * s, cell.y, cell.z - cz * s) as i64;
        return (readU8(this.lights.bnR, off) << 16) | (readU8(this.lights.bnG, off) << 8) | readU8(this.lights.bnB, off);
    }

    /**
     * March one hemisphere ray from a cell; returns -1 if it escapes (clears the
     * terrain ceiling or runs the full skyAOReach unobstructed), else the packed
     * albedo of the opaque voxel it hits. The caller derives sky access from the
     * escapes and the coloured bounce from the hit albedos.
     * @param cell  origin air cell
     * @param dir   ray direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks (escape shortcut)
     * @return -1 if the ray escapes to the sky, else the packed albedo it hit
     */
    fn skyHemiHit(cell : IVec3, dir : Vec3, ceil : i32) : i32 {
        let ox : f64 = (cell.x as f64) + 0.5;
        let oy : f64 = (cell.y as f64) + 0.5;
        let oz : f64 = (cell.z as f64) + 0.5;
        let t : f64 = 0.6;
        while (t < config::skyAOReach) {
            let cy : i32 = Math::floorToInt(oy + dir.y * t) as i32;
            if (cy > ceil) {
                return 0 - 1;
            }
            if (cy >= 0 && cy < config::worldHeight) {
                let cx : i32 = Math::floorToInt(ox + dir.x * t) as i32;
                let cz : i32 = Math::floorToInt(oz + dir.z * t) as i32;
                let hb : Block = this.worldGet(ivec3(cx, cy, cz));
                if (isOpaque(hb)) {
                    return albedoFor(hb);
                }
            }
            t = t + 0.7;
        }
        return 0 - 1;
    }

    /**
     * Bake hemispherical sky access for one chunk: every open, sky-lit air cell
     * in the active band casts the M precomputed hemisphere rays and stores the
     * escaped fraction (0..255). Static — recomputed only when the chunk's
     * geometry/light changes (skyAOdirty).
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     * @param ceil  tallest terrain Y over loaded chunks
     */
    fn computeChunkSkyAO(slot : i32, cx : i32, cz : i32, ceil : i32) : void {
        let s : i32 = config::chunkSize;
        let m : i32 = config::skyAOSamples;
        let top : i32 = this.store.maxFY[slot] + 1;
        if (top > config::worldHeight - 1) {
            top = config::worldHeight - 1;
        }
        let lz : i32 = 0;
        while (lz < s) {
            let lx : i32 = 0;
            while (lx < s) {
                let y : i32 = 0;
                while (y <= top) {
                    let off : i64 = this.voxIdx(slot, lx, y, lz) as i64;
                    if (this.getVox(slot, ivec3(lx, y, lz)) == Block::Air && readU8(this.lights.skylight, off) > 0) {
                        let wx : i32 = cx * s + lx;
                        let wz : i32 = cz * s + lz;
                        let esc : i32 = 0;
                        let hits : i32 = 0;
                        let ar : i32 = 0;
                        let ag : i32 = 0;
                        let ab : i32 = 0;
                        let r : i32 = 0;
                        while (r < m) {
                            let dir : Vec3 = vec3(getF64(this.lights.hemiX, r), getF64(this.lights.hemiY, r), getF64(this.lights.hemiZ, r));
                            let hit : i32 = this.skyHemiHit(ivec3(wx, y, wz), dir, ceil);
                            if (hit < 0) {
                                esc = esc + 1;
                            } else {
                                ar = ar + ((hit >> 16) & 0xFF);
                                ag = ag + ((hit >> 8) & 0xFF);
                                ab = ab + (hit & 0xFF);
                                hits = hits + 1;
                            }
                            r = r + 1;
                        }
                        writeU8(this.lights.skyaccess, off, (esc * 255) / m);
                        // One-bounce coloured tint: average hit albedo, normalised
                        // to luminance 1 (hue only — brightness is the sky-AO's
                        // job), blended toward neutral by how occluded the cell is.
                        if (config::bounceOn && hits > 0) {
                            let avr : f64 = (ar as f64) / (hits as f64);
                            let avg : f64 = (ag as f64) / (hits as f64);
                            let avb : f64 = (ab as f64) / (hits as f64);
                            let lum : f64 = 0.299 * avr + 0.587 * avg + 0.114 * avb;
                            if (lum < 1.0) {
                                lum = 1.0;
                            }
                            let occ : f64 = (hits as f64) / (m as f64) * config::bounceStrength;
                            writeU8(this.lights.bnR, off, this.bounceByte(avr / lum, occ));
                            writeU8(this.lights.bnG, off, this.bounceByte(avg / lum, occ));
                            writeU8(this.lights.bnB, off, this.bounceByte(avb / lum, occ));
                        } else {
                            writeU8(this.lights.bnR, off, 128);
                            writeU8(this.lights.bnG, off, 128);
                            writeU8(this.lights.bnB, off, 128);
                        }
                    }
                    y = y + 1;
                }
                lx = lx + 1;
            }
            lz = lz + 1;
        }
    }

    /**
     * Throttled sky-access bake: process up to `budget` dirty loaded chunks per
     * call (round-robin). Sky access is static, so once every loaded chunk is
     * baked this idles until an edit or load re-flags a chunk.
     * @param budget  max chunks to bake this call
     */
    fn stepSkyAO(budget : i32) : void {
        let slots : i32 = config::span * config::span;
        let ceil : i32 = 0;
        let j : i32 = 0;
        while (j < slots) {
            if (this.loaded[j] == 1 && this.store.maxFY[j] > ceil) {
                ceil = this.store.maxFY[j];
            }
            j = j + 1;
        }
        let done : i32 = 0;
        let guard : i32 = 0;
        while (done < budget && guard < slots) {
            let slot : i32 = this.lights.skyAOcursor;
            this.lights.skyAOcursor = this.lights.skyAOcursor + 1;
            if (this.lights.skyAOcursor >= slots) {
                this.lights.skyAOcursor = 0;
            }
            guard = guard + 1;
            if (this.loaded[slot] == 1 && this.lights.skyAOdirty[slot] == 1) {
                this.computeChunkSkyAO(slot, this.cxs[slot], this.czs[slot], ceil);
                this.lights.skyAOdirty[slot] = 0;
                done = done + 1;
            }
        }
    }

    /** Publish the current time of day for the background light thread. */
    fn setDayTime(d : f64) : void {
        this.curDayTime = d;
    }

    /** Tell the background light thread to stop (call before joining it). */
    fn stopLight() : void {
        this.lightRunning.set(false);
    }

    /** Whether the background light thread should keep running. */
    fn lightAlive() : bool {
        return this.lightRunning.get();
    }

    /**
     * One pass of the whole lighting system: refresh the directional sun-shadow
     * map and bake any pending hemispherical sky-access / colour-bounce. Run by
     * the dedicated light thread (lightLoop), reading the time of day published
     * by the main loop. Writes only the per-voxel light maps (sunlit / skyaccess
     * / bounce); the render thread reads them byte-wise, so a torn read is at
     * worst one frame stale — never a crash (the chunk ring never reallocates).
     */
    fn stepLight() : void {
        this.stepSunShadows(this.curDayTime, config::sunChunksPerTick);
        this.stepSkyAO(config::skyAOChunksPerTick);
    }

    /**
     * Dig (set to air) a world voxel.
     * @param cell the world voxel
     */
    fn breakAt(cell : IVec3) : void {
        this.setVoxel(cell, Block::Air);
    }

    /**
     * Place `block` at a world voxel.
     * @param cell     the world voxel
     * @param block  the block id to place
     */
    fn placeAt(cell : IVec3, block : Block) : void {
        this.setVoxel(cell, block);
    }
}

/**
 * The light thread body: continuously refresh the sun-shadow map and bake sky
 * access / colour bounce, decoupled from the render thread, so heavy frames
 * never delay the lighting and the main loop never blocks on it. Reads the time
 * of day the main loop publishes via setDayTime; paced by a short sleep so it
 * advances at a steady rate independent of the render frame rate. Runs on its
 * own OS thread (spawned in main); exits when stopLight() is called.
 * @param man  the chunk manager owning the light maps
 * @return 0 (Task result unused)
 */
fn lightLoop(man : ChunkManager) : i32 {
    while (man.lightAlive()) {
        man.stepLight();
        System::sleep(8);
    }
    return 0;
}
