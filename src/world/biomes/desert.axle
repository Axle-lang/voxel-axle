// Desert — sand over sandstone, the odd cactus, no trees.

use crate::world::biomes::Biome;
use crate::config;
use crate::config::{ Block, TreeKind };

class Desert : Biome {
    /** Construct the desert biome. */
    constructor() {
        super();
        self.fillerBlock = Block::Sandstone;
        self.treeThresh = 0.992;
        self.treeKindId = TreeKind::Cactus;
        self.treeHt = 3;
    }

    /**
     * Top block: sand.
     * @param height  the column's surface height
     * @return the surface block id
     */
    fn surface(self, height : i32) : Block {
        return Block::Sand;
    }
}
