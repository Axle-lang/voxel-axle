// Mushroom fields — rare mycelium islands studded with giant mushrooms.

use crate::world::biomes::Biome;
use crate::config;
use crate::config::{ Block, TreeKind };

class MushroomFields : Biome {
    /** Construct the mushroom fields biome. */
    constructor() {
        super();
        self.treeThresh = 0.955;
        self.treeKindId = TreeKind::RedMushroom;
        self.treeHt = 4;
    }

    /**
     * Top block: mycelium.
     * @param height  the column's surface height
     * @return the surface block id
     */
    fn surface(self, height : i32) : Block {
        return Block::Mycelium;
    }
}
