// Swamp — low, wet, dark-green grass with scattered oaks.

use crate::world::biomes::Biome;
use crate::config;
use crate::config::{ Block, TreeKind };

class Swamp : Biome {
    /** Construct the swamp biome. */
    constructor() {
        super();
        self.treeThresh = 0.985;
        self.treeKindId = TreeKind::Oak;
        self.treeHt = 4;
    }

    /**
     * Top block: swamp grass.
     * @param height  the column's surface height
     * @return the surface block id
     */
    fn surface(self, height : i32) : Block {
        return Block::GrassSwamp;
    }
}
