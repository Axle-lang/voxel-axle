// treegen — the tree / mushroom STAMPER, split out of ChunkManager.
//
// A cohesive LEAF mini-manager for "decoration" voxels: it carves trunks, leaf
// canopies, cactus stalks, giant mushrooms and bushy / conical / flat canopies.
// Every function is a FREE function that writes straight into a slot through a
// `VoxStore` (the raw voxel storage), never the owning ChunkManager. Both this
// module and the manager depend on `voxstore` one-way, so there is NO import
// cycle (Axle would otherwise drop the cycle edge and fail to resolve methods).
//
// Shapes are FIXED (no per-call RNG): the two chunks that share a border tree
// stamp it identically, so a canopy straddling a seam is seamless. The manager
// keeps `stampTrees` (it needs the per-biome registry) and the cold-biome
// `snowCapTree` (it needs the heightmap + biome), and delegates the carving here.

use crate::world::voxstore::VoxStore;
use crate::vec3::{ ivec3 };
use crate::config;
use crate::config::{ Block, TreeKind };

/**
 * Stamp one leaf voxel of `leafId`, but only into air (never carving terrain).
 * Clipped to the slot's padded volume so a canopy straddling the border is
 * trimmed cleanly.
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param lx      the local x coordinate
 * @param ly      the local y coordinate
 * @param lz      the local z coordinate
 * @param leafId  the leaf block id
 */
fn stampLeafId(vs : VoxStore, slot : i32, lx : i32, ly : i32, lz : i32, leafId : Block) : void {
    let s : i32 = config::chunkSize;
    if (lx < 0 - 1 || lx > s || lz < 0 - 1 || lz > s) {
        return;
    }
    if (ly < 0 || ly >= config::worldHeight) {
        return;
    }
    if (vs.getVox(slot, ivec3(lx, ly, lz)) == Block::Air) {
        let v : Block = leafId;
        vs.setVoxLocal(slot, ivec3(lx, ly, lz), v);
    }
}

/**
 * Stamp a solid square leaf layer of half-size `rad` centred on (cx, cy, cz).
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param cx      the layer centre x coordinate
 * @param cy      the layer y coordinate
 * @param cz      the layer centre z coordinate
 * @param rad     the half-size of the square
 * @param leafId  the leaf block id
 */
fn leafLayer(vs : VoxStore, slot : i32, cx : i32, cy : i32, cz : i32, rad : i32, leafId : Block) : void {
    let dz : i32 = 0 - rad;
    while (dz <= rad) {
        let dx : i32 = 0 - rad;
        while (dx <= rad) {
            stampLeafId(vs, slot, cx + dx, cy, cz + dz, leafId);
            dx = dx + 1;
        }
        dz = dz + 1;
    }
}

/**
 * Stamp a vertical trunk of `height` blocks and bump the slot's face-Y mark.
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param olx     the trunk origin x coordinate
 * @param baseY   the trunk base Y
 * @param olz     the trunk origin z coordinate
 * @param height  the trunk height
 * @param woodId  the wood block id
 */
fn stampTrunk(vs : VoxStore, slot : i32, olx : i32, baseY : i32, olz : i32, height : i32, woodId : Block) : void {
    let t : i32 = 0;
    while (t < height) {
        vs.setVoxClip(slot, ivec3(olx, baseY + t, olz), woodId);
        t = t + 1;
    }
    vs.bumpFY(slot, baseY + height + 1);
}

/**
 * Stamp a tree of `kind` (config::tree*) with origin column (olx, olz), trunk
 * base `baseY` and trunk `height` (the biome's `treeHt`). Leaves first, then the
 * trunk overwrites its column. Shapes are fixed (no RNG) so the two chunks
 * sharing a border tree stamp it identically.
 * @param vs      the slot voxel storage
 * @param kind    the tree kind id
 * @param height  the trunk height (from the biome)
 * @param slot    the slot index
 * @param olx     the tree origin x coordinate
 * @param baseY   the trunk base Y
 * @param olz     the tree origin z coordinate
 */
fn stampTree(vs : VoxStore, kind : TreeKind, height : i32, slot : i32, olx : i32, baseY : i32, olz : i32) : void {
    match kind {
        TreeKind::None => {
            return;
        }
        TreeKind::Cactus => {
            let c : i32 = 0;
            while (c < height) {
                vs.setVoxClip(slot, ivec3(olx, baseY + c, olz), Block::Cactus);
                c = c + 1;
            }
            vs.bumpFY(slot, baseY + height);
        }
        TreeKind::Spruce => {
            stampSpruce(vs, slot, olx, baseY, olz, height);
        }
        TreeKind::Acacia => {
            stampAcacia(vs, slot, olx, baseY, olz, height);
        }
        TreeKind::Bamboo => {
            // A tall, thin bamboo stalk.
            let t : i32 = 0;
            while (t < height) {
                vs.setVoxClip(slot, ivec3(olx, baseY + t, olz), Block::Bamboo);
                t = t + 1;
            }
            vs.bumpFY(slot, baseY + height);
        }
        TreeKind::RedMushroom => {
            stampMushroom(vs, slot, olx, baseY, olz, height, Block::RedMushroom);
        }
        TreeKind::BrownMushroom => {
            stampMushroom(vs, slot, olx, baseY, olz, height, Block::BrownMushroom);
        }
        // Oak / birch / jungle / cherry: a bushy round canopy; they differ
        // only in wood / leaf species (the trunk height comes from the biome).
        _ => {
            let wood : Block = match kind {
                TreeKind::Birch => Block::WoodBirch,
                TreeKind::Jungle => Block::WoodJungle,
                TreeKind::Cherry => Block::CherryLog,
                _ => Block::Wood,
            };
            let leaf : Block = match kind {
                TreeKind::Birch => Block::LeavesBirch,
                TreeKind::Jungle => Block::LeavesJungle,
                TreeKind::Cherry => Block::CherryLeaves,
                _ => Block::Leaves,
            };
            stampBushy(vs, slot, olx, baseY, olz, height, wood, leaf);
        }
    }
}

/**
 * Giant mushroom: a pale stem topped by a flat round cap of `capId`.
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param olx     the origin x coordinate
 * @param baseY   the stem base Y
 * @param olz     the origin z coordinate
 * @param height  the stem height
 * @param capId   the cap block id (red / brown mushroom block)
 */
fn stampMushroom(vs : VoxStore, slot : i32, olx : i32, baseY : i32, olz : i32, height : i32, capId : Block) : void {
    let cy : i32 = baseY + height;
    leafLayer(vs, slot, olx, cy, olz, 1, capId);
    stampLeafId(vs, slot, olx, cy + 1, olz, capId);
    stampTrunk(vs, slot, olx, baseY, olz, height, Block::MushroomStem);
}

/**
 * Round canopy (oak / birch / jungle / cherry): two wide rings, a narrow ring
 * and a small crown atop the trunk.
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param olx     the tree origin x coordinate
 * @param baseY   the trunk base Y
 * @param olz     the tree origin z coordinate
 * @param height  the trunk height
 * @param wood    the wood block id
 * @param leaf    the leaf block id
 */
fn stampBushy(vs : VoxStore, slot : i32, olx : i32, baseY : i32, olz : i32, height : i32, wood : Block, leaf : Block) : void {
    let cy : i32 = baseY + height;
    leafLayer(vs, slot, olx, cy - 2, olz, 2, leaf);
    leafLayer(vs, slot, olx, cy - 1, olz, 2, leaf);
    leafLayer(vs, slot, olx, cy, olz, 1, leaf);
    stampLeafId(vs, slot, olx, cy + 1, olz, leaf);
    stampLeafId(vs, slot, olx + 1, cy + 1, olz, leaf);
    stampLeafId(vs, slot, olx - 1, cy + 1, olz, leaf);
    stampLeafId(vs, slot, olx, cy + 1, olz + 1, leaf);
    stampLeafId(vs, slot, olx, cy + 1, olz - 1, leaf);
    stampTrunk(vs, slot, olx, baseY, olz, height, wood);
}

/**
 * Conical spruce: shrinking square rings up a tall trunk, with a tip.
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param olx     the tree origin x coordinate
 * @param baseY   the trunk base Y
 * @param olz     the tree origin z coordinate
 * @param height  the trunk height
 */
fn stampSpruce(vs : VoxStore, slot : i32, olx : i32, baseY : i32, olz : i32, height : i32) : void {
    let cy : i32 = baseY + height;
    leafLayer(vs, slot, olx, cy - 3, olz, 2, Block::LeavesSpruce);
    leafLayer(vs, slot, olx, cy - 2, olz, 1, Block::LeavesSpruce);
    leafLayer(vs, slot, olx, cy - 1, olz, 1, Block::LeavesSpruce);
    stampLeafId(vs, slot, olx, cy, olz, Block::LeavesSpruce);
    stampTrunk(vs, slot, olx, baseY, olz, height, Block::WoodSpruce);
}

/**
 * Flat-topped acacia: a tall trunk and a wide thin canopy.
 * @param vs      the slot voxel storage
 * @param slot    the slot index
 * @param olx     the tree origin x coordinate
 * @param baseY   the trunk base Y
 * @param olz     the tree origin z coordinate
 * @param height  the trunk height
 */
fn stampAcacia(vs : VoxStore, slot : i32, olx : i32, baseY : i32, olz : i32, height : i32) : void {
    let cy : i32 = baseY + height;
    leafLayer(vs, slot, olx, cy, olz, 2, Block::LeavesAcacia);
    leafLayer(vs, slot, olx, cy + 1, olz, 1, Block::LeavesAcacia);
    stampTrunk(vs, slot, olx, baseY, olz, height, Block::WoodAcacia);
}
