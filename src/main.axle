// voxel — a Minecraft-style survival world in Axle, software-rendered into
// a window smalt opened. You are a real entity: gravity pulls you down, you stand
// and walk on the solid streamed terrain, jump, swim, take fall / drowning
// damage with regenerating health, and can dig and place blocks in a full
// voxel world. The land is split into Minecraft-like biomes with trees,
// and texture-skinned passive mobs wander, flee when struck, and collapse
// when killed.
//
// Controls:  Mouse look, W/A/S/D move, LCtrl sprint, Space jump / swim up,
//            Left-click dig / attack, Right-click place block,
//            1-9 select hotbar slot, Esc pause menu, close quit.
//
// Build & run:  axle run -O 3   (atlas.raw beside the binary)
//
// The platform layer is `smalt`: the window, the event queue, the
// monotonic clock, the blit and the audio device. It is Axle calling
// Win32 or X11 + ALSA depending on the build target, so there is
// no shared library to ship and nothing to install.
//
// This entry point only chooses what to run: one of the headless checks,
// or the game itself — a `app::session::game::Game`.

use smalt::{ PlatformError };
use crate::app::session::game::{ Game };
use crate::app::cli::{ hasFlag, wantsPhysicsCheck };
use crate::checks::physcheck::runPhysicsCheck;
use crate::checks::lightcheck::runLightCheck;
use crate::checks::biomecheck::runBiomeScan;
use crate::checks::cullcheck::runCullCheck;

/**
 * Runs a headless check when one is asked for, the game otherwise.
 *
 * The checks are headless so they run unattended, and each exists because
 * its failure is invisible on screen:
 * - `--physics-check` drives the real body over the real world — a collision
 *   or auto-step regression looks exactly like standing still;
 * - `--light-check` reads back the flood under a real torch — a screenshot of
 *   a glow says nothing about its shape;
 * - `--biome-scan` tallies the biome of every column on a wide grid — the only
 *   honest way to tune a biome rate;
 * - `--cull-check` sweeps the camera and reports any chunk the frustum dropped
 *   while part of it was on screen — a hole in one frame at one angle.
 * @return the process exit code: 0 on success, the failure count for a check
 */
fn main() : i32 {
    if (wantsPhysicsCheck()) {
        return runPhysicsCheck();
    }
    if (hasFlag("--light-check")) {
        return runLightCheck();
    }
    if (hasFlag("--biome-scan")) {
        return runBiomeScan();
    }
    if (hasFlag("--cull-check")) {
        return runCullCheck();
    }

    try {
        const game = new Game();
        defer game.close();
        game.play();
        return 0;
    } catch e : PlatformError {
        Console::println("voxel: ${e.message}");
        return 1;
    }
}
