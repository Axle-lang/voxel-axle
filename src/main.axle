// voxel — a Minecraft-style survival world in Axle, software-rendered into
// a window smalt opened. You are a real entity: gravity pulls you down, you stand
// and walk on the solid streamed terrain, jump, swim, take fall / drowning
// damage with regenerating health, and can dig and place blocks in a full
// voxel world. The land is split into Minecraft-like biomes with trees,
// and texture-skinned passive mobs wander, flee when struck, and collapse
// when killed.
//
// Controls:  Mouse look, W/A/S/D move, LCtrl sprint, Space jump / swim up,
//            Left-click dig / attack, Right-click place block,
//            1-9 select hotbar slot, Esc pause menu, close quit.
//
// Build & run:  axle build && ./target/voxel   (atlas.raw beside the binary)
//
// The platform layer is `smalt`: the window, the event queue, the
// monotonic clock, the blit and the audio device. It is Axle calling
// Win32 or X11 + ALSA depending on the build target, so there is
// no shared library to ship and nothing to install.
//
// This entry point stays thin: create the window + buffers, build the
// world, place the player (see `game::start`), then run the
// input → simulate → render loop paced by the frame clock. Block picking
// lives in `game::ray`, the HUD in `krender::hud`.

use smalt::{
    BitmapFont, Bmp, Clock, Event, EventKind, Events, Face, FramePacer, Mem,
    mixerLoop, MouseButton, Platform, PlatformError, Surface, Window, WindowDesc,
};
use crate::kernel::kio::input::Keys;
use crate::kernel::kio::assets::Assets;
use crate::kernel::kworld::manager::{ ChunkManager, lightLoop };
use crate::game::world::terraingen::TerrainGen;
use crate::kernel::kworld::blocksim::BlockSim;
use crate::kernel::kentity::player::{ GameMode, Player };
use crate::kernel::kentity::mobs::MobManager;
use crate::game::entities::fauna::Fauna;
use crate::game::start::{Spawn, openYaw};
use crate::game::controls::{ readIntent, applyLook, readHotbar, readGameMode, Intent };
use crate::game::stepaudio::{ StepTimers, stepAudio };
use crate::game::cli::{ snapDeadline, startColumn, lookPin, dayTimeArg, hasFlag, windowSize, walkBlocks, wantsPhysicsCheck };
use crate::game::physcheck::runPhysicsCheck;
use crate::game::lightcheck::runLightCheck;
use crate::game::ray::{Picker, cellInPlayer};
use crate::kernel::kio::sfx::{ AudioManager };
use crate::kernel::kmath::vec3::{ IVec3, ivec3 };
use crate::kernel::kmath::narrow::{ FLOAT_BYTES };
use crate::game::tick::TickManager;
use crate::kernel::seams::{ LightMoment };
use crate::kernel::krender::render::Renderer;
use crate::kernel::krender::raster::{ FrameBuf, Viewport, viewportFor };
use crate::kernel::krender::hud::drawHud;
use crate::kernel::krender::menu::{drawPauseMenu, menuHit};
use crate::configs::atlas::{ Atlas };
use crate::configs::blocks::{ Block };
use crate::configs::gameplay::{ Gameplay };
use crate::configs::health::{ Health };
use crate::configs::hud::{ Hotbar };
use crate::configs::time::{ Daylight };
use crate::configs::water::{ Water };
use crate::configs::world::{ World };

/** How far ahead of the player `--torch` stands its torch, in blocks. */
const TORCH_AHEAD : f64 = 3.5;

/**
 * Converts a world coordinate to its containing chunk index.
 * @param p  a world-space coordinate along one axis
 * @return the chunk index that contains that coordinate
 */
fn chunkOf(p : f64) : i32 {
    return (p / (World::CHUNK_SIZE as f64)).floorToInt() as i32;
}

/**
 * Program entry point: builds the window, world and player, then runs the
 * input → simulate → render loop until the player quits.
 */
fn main() : i32 {
    // `--physics-check` drives the real body over the real world and
    // exits with the failure count. Headless, so it runs unattended —
    // and it is the net under any change to collision or the auto-step,
    // where a regression looks exactly like standing still.
    if (wantsPhysicsCheck()) {
        return runPhysicsCheck();
    }
    // `--light-check` places a real torch in the real world and reads the light
    // volumes back. Headless, for the same reason: a screenshot of a glow says
    // nothing about the shape of the flood underneath it.
    if (hasFlag("--light-check")) {
        return runLightCheck();
    }
    try {
        return run();
    } catch e : PlatformError {
        Console::println("voxel: ${e.message}");
        return 1;
    }
}

/**
 * The game proper. Every startup failure leaves through the throwing
 * contract, so nothing below tests a half-built subsystem: a `Platform`
 * that exists is initialised, and a `Window` that exists is open.
 */
fn run() : i32 ! PlatformError {
    let (winW, winH) = windowSize();
    // The framebuffer takes the window's own shape from the first frame, not a
    // configured one, so nothing has to be resized into place on frame two.
    let vp0 : Viewport = viewportFor(winW, winH);
    let w : i32 = vp0.w;
    let h : i32 = vp0.h;

    let platform : Platform = new Platform()?;
    let win : Window = platform.open(
        WindowDesc { title: "Axle Voxel — survival", w: winW, h: winH, resizable: true }
    )?;
    let events : Events = new Events();

    // The framebuffer this game's own renderer fills. `base()` is its
    // address, which every drawing path walks through `Mem` — and it is
    // taken again after each resize, because a reallocation moves it.
    let screen : Surface = new Surface(w, h);
    let pixels : i64 = screen.base();
    let zbuf : i64 = Mem::take((w as i64) * (h as i64) * FLOAT_BYTES);
    events.setRelativeMouse(true);
    // Set when the pointer is grabbed, so the frame that follows
    // discards its look delta: the grab warps the pointer to the middle
    // of the window, and turning by however far it had wandered is a
    // camera that snaps on every un-pause.
    let swallowLook : bool = true;


    // The monotonic clock and the loop's metronome, both smalt's — the
    // two halves this game used to carry its own `GameClock` for. The
    // clock is built here rather than beside the pacer because the start
    // column is drawn from its counter, and that happens before the
    // world is streamed.
    //
    // Both rates are `World::TICK_HZ`, which is what the old clock did:
    // `tick` sleeps whatever is left of the frame budget (the CPU cap,
    // independent of v-sync), and `steps` drains that same measurement
    // into whole simulation steps. Naming the tick rate as well as the
    // frame rate is not redundant — it pins it, so a later change to the
    // frame cap cannot silently retime the physics with it.
    let clock : Clock = new Clock();

    let man : ChunkManager = new ChunkManager();
    // Inject the game's concrete terrain generator (biome tables + ore / tree
    // rules — all app content) over the manager's shared voxel store. The kernel
    // drives it through the `Generator` seam and never names TerrainGen.
    man.attachGenerator(new TerrainGen(man.store, World::SPAN * World::SPAN));
    // Where this run starts. Random unless `--at x z` names a column, and
    // printed either way, so a world worth keeping can be returned to.
    let (startX, startZ) = startColumn(clock);
    Console::println("start column ${startX} ${startZ}  (replay with: --at ${startX} ${startZ})");

    // The search reads heights, so the chunks around the centre have to
    // exist before it runs — which is what the origin load used to do
    // when the centre was always the origin.
    while (man.ensureLoaded(chunkOf(startX as f64), chunkOf(startZ as f64)) > 0) {
    }

    // Choose an open hilltop to start on and a yaw facing the clearing.
    let sp : Spawn = new Spawn();
    sp.find(man, startX, startZ);
    let player : Player = new Player((sp.sx as f64) + 0.5, sp.h as f64, (sp.sz as f64) + 0.5);
    player.yaw = openYaw(man, sp.sx, sp.sz, sp.h);
    // A pinned view overrides the clearing the spawn picked, and holds against
    // the mouse for the whole run; a pinned hour starts the day clock elsewhere.
    let (lookPinned, lookYaw, lookPitch) = lookPin();
    let dayStart : f64 = dayTimeArg();
    if (lookPinned) {
        player.aimAt(lookYaw, lookPitch);
    }
    player.refresh();
    while (man.ensureLoaded(chunkOf(player.pos.x), chunkOf(player.pos.z)) > 0) {
    }
    // `--torch` stands one on the ground a few blocks ahead. A night capture of
    // coloured light needs a source in frame, and a source placed by hand is a
    // capture nobody can reproduce.
    if (hasFlag("--torch")) {
        plantTorch(man, player);
    }

    let mobs : MobManager = new MobManager();
    // Inject the game's fauna (which species exist + spawn weights — app content);
    // the kernel's MobManager builds mobs through the MobSpawner seam.
    mobs.attachSpawner(new Fauna());
    let renderer : Renderer = new Renderer();
    renderer.setViewport(w, h);
    // The overlay's face, smalt's. Built once and held — the glyph tables
    // are minted by the call, so a face per frame would be three
    // allocations and a copy of the whole font every frame.
    let hudFont : BitmapFont = BitmapFont::baked(Face::Ui);

    // Block + mob texture atlas, loaded at runtime from `atlas.raw`.
    let tpx : i64 = Atlas::TILE_PX as i64;
    let atlasBytes : i64 = tpx * tpx * 4 * (Atlas::TILE_COUNT as i64);
    let atlas : i64 = Mem::take(atlasBytes);
    if (Assets::loadAtlas(atlas, atlasBytes) != atlasBytes) {
        Console::println("warning: atlas.raw not found next to the binary — textures will be blank");
    }
    renderer.setAtlas(atlas);
    // The mip chain's level 0 is a full copy of the atlas, so the standalone
    // atlas buffer is now redundant; free it and read tile texels from the
    // renderer (mip level 0) wherever they're still needed (the HUD hotbar).
    Mem::release(atlas);

    let pacer : FramePacer = new FramePacer(World::TICK_HZ);
    pacer.setTickRate(World::TICK_HZ);
    // Isochronous scheduler: physics runs every tick, while chunk streaming
    // (on chunk-border cross) and the mob cull/spawn scan run on a coarser
    // uniform cadence to cut wasted CPU. See `game::tick`.
    let sched : TickManager = new TickManager();
    // Block-update sim: falling sand/gravel + edit-driven water flow. Stepped
    // on the sim cadence; only what the player disturbs is enqueued.
    let blocksim : BlockSim = new BlockSim();
    let picker : Picker = new Picker();
    // All game audio: footsteps / digs by material, mob voices, the player's
    // hurts and splashes, and the creeper's fuse / blast — every positional
    // sound attenuated by 3D distance. Missing clips are silent.
    let sfx : AudioManager = new AudioManager();
    // Pump the audio device on its own OS thread so a heavy render/light-bake
    // frame can't starve the queue and stutter the sound (the queue is topped up
    // every few ms regardless of frame time). Stopped + joined at quit.
    let audioTask : Task<i32> = spawn mixerLoop(sfx.mixer);
    // The whole lighting system (sun shadows + sky-access + colour bounce) runs
    // on its own OS thread, reading the time of day the main loop publishes. It
    // updates the per-voxel light maps continuously and independently of the
    // render frame rate, so heavy frames never delay the light and the main loop
    // never blocks on it. Stopped + joined at quit.
    // Publish the hour BEFORE the thread starts: its first pass is the one that
    // lights the whole ring, and until the first frame it would otherwise run
    // against the default hour — so a run started at another hour would bake the
    // wrong shadows and then spend seconds gliding onto the right ones.
    man.setMoment(LightMoment {
        dayTime: dayStart,
        seconds: 0.0,
        camX: player.pos.x.floorToInt() as i32,
        camZ: player.pos.z.floorToInt() as i32,
    });
    // Light the ring before the first frame, not alongside it. The world is
    // already generated by here; leaving the shadows and the sky-access to the
    // thread means the first tenth of a second shows a generated world that is
    // not yet lit, and that arrival is visible. This is a load, so it belongs
    // with the loading.
    man.primeLight();
    let lightTask : Task<i32> = spawn lightLoop(man);
    // A scripted walk (`--walk`): where it started, and how far it goes.
    let walkFar : f64 = walkBlocks();
    let walkX0 : f64 = player.pos.x;
    let walkZ0 : f64 = player.pos.z;
    let attackCd : i32 = 0;
    let timers : StepTimers = StepTimers { foot: 0, ambient: 0 };
    let prevHp : i32 = player.hp; // to detect the player taking damage
    let wasUnderwater : bool = false;
    let wasGmToggle : bool = false;
    let wasRight : bool = false;
    let wasEsc : bool = false;
    let wasMenuClick : bool = false;
    let sprintLatch : bool = false;
    let paused : bool = false;
    // Last menu hover drawn while paused; -2 forces a redraw (on pause entry
    // and resize). While paused the world is frozen, so the loop only renders
    // when this changes — otherwise it idles, keeping the CPU near zero.
    let lastHover : i32 = 0 - 2;
    let running : bool = true;
    // `--snap [ms]` plays for that long, writes `voxel.bmp` and quits. A
    // capture for a report, or for a script, without anyone standing over
    // the machine at the right moment — and the way this game's overlay
    // is checked without a person looking at it.
    let snapAtMs : i64 = snapDeadline();
    let tWorld : i64 = 0;
    let tRays : i64 = 0;
    let tBloom : i64 = 0;
    let tBlit : i64 = 0;
    let frames : i64 = 0;
    let startMs : i64 = clock.ticks();
    while (running) {
        // Sleeps to the frame boundary and measures what the last frame
        // actually took; `pacer.steps()` below drains that measurement, so
        // the simulation and the frame share one timeline.
        pacer.tick(clock);
        events.pump(win, clock);
        while (events.hasNext()) {
            let e : Event = events.next();
            if (e.kind == EventKind::Quit) {
                running = false;
            } else if (e.kind == EventKind::MouseWheel) {
                // Scroll the hotbar: wheel up = previous slot, down = next.
                let wy : i32 = e.wheel;
                if (wy != 0) {
                    let ns : i32 = player.selected;
                    if (wy > 0) {
                        ns = ns - 1;
                    } else {
                        ns = ns + 1;
                    }
                    if (ns < 0) {
                        ns = Hotbar::SIZE - 1;
                    }
                    if (ns >= Hotbar::SIZE) {
                        ns = 0;
                    }
                    player.selectSlot(ns);
                }
            }
        }

        // Keep the framebuffer matched to the (resizable) window — its SHAPE,
        // both axes. Pinning the height and letting only the width follow the
        // ratio is what made going fullscreen a zoom: the view kept its six
        // hundred rows, so a much larger screen showed the same cone of world,
        // simply magnified. Now the buffer grows with the window up to a pixel
        // budget, and the vertical field of view is what is held fixed.
        let winCW : i32 = win.width();
        let winCH : i32 = win.height();
        if (winCW >= 1 && winCH >= 1) {
            let want : Viewport = viewportFor(winCW, winCH);
            if (want.w != w || want.h != h) {
                Mem::release(zbuf);
                w = want.w;
                h = want.h;
                screen.resize(w, h);
                // The reallocation moved the pixels, so every address
                // taken from the old buffer is dead — which is why this
                // is read again rather than kept.
                pixels = screen.base();
                zbuf = Mem::take((w as i64) * (h as i64) * FLOAT_BYTES);
                renderer.setViewport(w, h);
                lastHover = 0 - 2;   // framebuffer changed — force a redraw
            }
        }

        // Esc toggles the pause menu (edge-triggered). Pausing frees the
        // cursor for the menu; resuming re-grabs it and discards the
        // accumulated look delta so the camera doesn't jump.
        let escDown : bool = events.isKeyDown(Keys::pause());
        if (escDown && !wasEsc) {
            paused = !paused;
            if (paused) {
                events.setRelativeMouse(false);
                lastHover = 0 - 2;   // force the menu to draw on entry
            } else {
                events.setRelativeMouse(true);
                swallowLook = true;
            }
        }
        wasEsc = escDown;

        let hover : i32 = 0 - 1;
        if (!paused) {
            // ── Running: input → fixed-timestep simulation → editing ──
            wasGmToggle = readGameMode(events, player, wasGmToggle);
            swallowLook = applyLook(events, player, swallowLook, lookPinned);
            readHotbar(events, player);
            let (want, latch) = readIntent(events, sprintLatch);
            sprintLatch = latch;
            if (walkFar > 0.0) {
                let wdx : f64 = player.pos.x - walkX0;
                let wdz : f64 = player.pos.z - walkZ0;
                if (wdx * wdx + wdz * wdz < walkFar * walkFar) {
                    want = Intent { fwd: 1.0, strafe: 0.0, sprint: true, up: false, down: false, moving: true };
                }
            }

            // Fixed-timestep simulation: as many fixed steps as the real
            // elapsed time demands (frame-rate independent). Physics, mob AI
            // and the per-step audio timers all advance HERE, on the tick —
            // so footstep and ambience cadence are isochronous (tied to ticks,
            // never to the displayed frame rate).
            let nsteps : i32 = pacer.steps();
            prevHp = player.hp;
            let stp : i32 = 0;
            while (stp < nsteps) {
                sched.advance();
                player.update(man, want.fwd, want.strafe, want.sprint, want.up, want.down);
                mobs.update(man, player, sfx, blocksim);
                if (attackCd > 0) {
                    attackCd = attackCd - 1;
                }

                timers = stepAudio(man, player, mobs, sfx, want.moving, want.sprint, timers);
                stp = stp + 1;
            }
            if (player.hp < prevHp) {
                sfx.playerHurt(mobs.rand());
            }
            player.refresh();

            // Stream the world only when the player crosses a chunk border,
            // and run the mob cull / spawn scan on the maintenance cadence —
            // both far cheaper than the former unconditional every-frame work.
            let pcx : i32 = chunkOf(player.pos.x);
            let pcz : i32 = chunkOf(player.pos.z);
            // Stream every frame: ensureLoaded builds at most a few chunks per
            // call (nearest-first), so entering new chunks fills in smoothly over
            // a handful of frames instead of one stutter. Cheap when the view is
            // already full (just a ring scan).
            man.ensureLoaded(pcx, pcz);
            if (sched.dueMaintain()) {
                mobs.maintain(man, player);
            }
            if (sched.dueSim()) {
                blocksim.step(man);
            }

            // Water: a splash on entry (the submerged ambience is ticked above).
            let nowUW : bool = player.isUnderwater();
            if (nowUW && !wasUnderwater) {
                sfx.splash(mobs.rand());
            }
            wasUnderwater = nowUW;

            // Aim once; left-click breaks / attacks, right-click places.
            picker.cast(man, player);
            if (events.isButtonDown(MouseButton::Left) && attackCd == 0) {
                let kind : i32 = mobs.attackNearest(player, sfx);
                if (kind < 0 && picker.hit == 1) {
                    let bcell : IVec3 = ivec3(picker.bx, picker.by, picker.bz);
                    let broken : Block = man.worldGet(bcell);
                    man.breakAt(bcell);
                    sfx.blockEdit(broken, bcell, mobs.rand());
                    blocksim.enqueue6(bcell);
                    man.lightUpdate(bcell);
                }
                attackCd = Gameplay::EDIT_COOLDOWN;
            }
            let rightDown : bool = events.isButtonDown(MouseButton::Right);
            if (rightDown && !wasRight && picker.hit == 1) {
                if (!cellInPlayer(player, picker.px, picker.py, picker.pz)) {
                    let pcell : IVec3 = ivec3(picker.px, picker.py, picker.pz);
                    let held : Block = player.heldBlock();
                    man.placeAt(pcell, held);
                    sfx.blockEdit(held, pcell, mobs.rand());
                    blocksim.enqueue6(pcell);
                    man.lightUpdate(pcell);
                }
            }
            wasRight = rightDown;

            // Death → respawn at full health on the nearest ground.
            if (player.hp <= 0) {
                player.hp = Health::PLAYER_MAX_HP;
                player.velY = 0.0;
                player.airTicks = 0;
                player.sinceHurt = 0;
                player.pos.y = man.columnHeight(player.pos.x.floorToInt() as i32, player.pos.z.floorToInt() as i32) as f64;
                player.refresh();
            }
        } else {
            // ── Paused: drive the menu with the free cursor. The window is
            // resizable and the framebuffer follows it, so map the window-space
            // cursor into the framebuffer the menu is laid out in — `menuHit`
            // takes the same overlay scale the draw does, so the buttons cannot
            // end up somewhere other than where they were hit-tested. ──
            let cwW : i32 = win.width();
            let cwH : i32 = win.height();
            if (cwW < 1) {
                cwW = 1;
            }
            if (cwH < 1) {
                cwH = 1;
            }
            let fbx : i32 = events.mouseX() * w / cwW;
            let fby : i32 = events.mouseY() * h / cwH;
            hover = menuHit(w, h, fbx, fby);
            let click : bool = events.isButtonDown(MouseButton::Left);
            if (click && !wasMenuClick && hover >= 0) {
                if (hover == 0) {
                    paused = false;
                    events.setRelativeMouse(true);
                    swallowLook = true;
                } else {
                    running = false;
                }
            }
            wasMenuClick = click;
        }

        // ── Render. Running: redraw every frame. Paused: the world is frozen
        // and mobs don't move, so re-render only when the menu hover changes —
        // otherwise skip the whole render + present and let the loop idle, so
        // sitting in the pause menu costs almost no CPU. ──
        let drawFrame : bool = true;
        if (paused) {
            drawFrame = hover != lastHover;
            lastHover = hover;
        }
        if (drawFrame) {
            let underwater : bool = player.isUnderwater();
            let phase : f64 = (sched.tick as f64) * Water::RIPPLE_SPEED;
            // Day clock: advances with the fixed-step tick, wrapped to [0, 1).
            // Seconds since the run began, for the things that move on their own
            // rather than with the sun — the wind, and so the clouds.
            let worldTime : f64 = (sched.tick as f64) / (World::TICK_HZ as f64);
            let dayTime : f64 = dayStart + (sched.tick as f64) / (Daylight::LENGTH_TICKS as f64);
            dayTime = dayTime - (dayTime.floorToInt() as f64);
            // Publish the time of day for the dedicated light thread (it bakes
            // the sun shadows + sky access continuously off the render path); the
            // render just reads the latest light maps.
            man.setMoment(LightMoment {
                dayTime: dayTime,
                seconds: worldTime,
                camX: player.pos.x.floorToInt() as i32,
                camZ: player.pos.z.floorToInt() as i32,
            });
            // Bundle the render target (rebuilt each frame — a resize reallocs
            // pixels/zbuf and changes w).
            let fb : FrameBuf = FrameBuf { pixels: pixels, zbuf: zbuf, w: w, h: h };
            let t0 : i64 = clock.micros();
            renderer.render(man, player, fb, underwater, phase, dayTime, worldTime);
            let t1 : i64 = clock.micros();
            tWorld = tWorld + (t1 - t0);
            renderer.renderMobs(man, mobs, player, fb);
            renderer.renderTorches(man, player, fb);
            // The sky last among the opaque passes, into what they left empty.
            renderer.drawSky(player, fb, underwater);
            // Volumetric god-rays from the sun (above water only); then the
            // living-water post-pass (depth fog + moving caustics) under the HUD.
            let t2 : i64 = clock.micros();
            if (underwater) {
                renderer.underwaterOverlay(fb, phase);
            } else {
                renderer.godRays(player, fb);
            }
            let t3 : i64 = clock.micros();
            tRays = tRays + (t3 - t2);
            // Soft warm glow on bright pixels (sun, halo, shafts, water, snow).
            renderer.bloomPass(fb);
            let t4 : i64 = clock.micros();
            tBloom = tBloom + (t4 - t3);
            // The overlay's drawing view of the same pixels the world was
            // rasterised into. Taken fresh each frame rather than kept: a
            // resize moves the buffer, and a `Frame` held across one is the
            // dangling address this game used to have to remember about.
            let cv = screen.frame();
            if (!paused) {
                if (picker.hit == 1) {
                    renderer.drawSelection(player, fb, picker.bx, picker.by, picker.bz,
                        man.blockBoxHeight(ivec3(picker.bx, picker.by, picker.bz)));
                }
                drawHud(cv, hudFont, renderer.atlasBase(), player.hp, player.maxHp,
                    player.hotbar, player.selected, player.mode == GameMode::Creative);
                renderer.crosshair(fb);
            } else {
                drawPauseMenu(cv, hudFont, hover);
            }

            // One blit, scaled to the client area — the framebuffer keeps
            // a fixed height and follows the window aspect in width.
            let t5 : i64 = clock.micros();
            screen.present(win);
            tBlit = tBlit + (clock.micros() - t5);
            frames = frames + 1;
        }

        // Outside the render branch on purpose: a screenshot should capture
        // what is ON SCREEN, which while paused is a menu drawn once and
        // then left alone. Inside the branch it could only ever catch a
        // frame the loop happened to be redrawing.
        if (snapAtMs > 0 && clock.ticks() - startMs >= snapAtMs) {
            if (Bmp::write("voxel.bmp", screen.frame())) {
                // The measured rate over the run, so a capture also says what
                // it cost to draw. `fps()` is the pacer's own window average,
                // and it reads 0 until a full second has passed.
                Console::println("wrote voxel.bmp  (${w}x${h} render, ${pacer.fps().round()} fps)");
                if (frames > 0) {
                    // The world pass split in two, because they are different
                    // jobs with different costs: the queue build is one
                    // thread, the fill is twelve.
                    let fillUs : i64 = renderer.fillMicros() / frames;
                    Console::println("  world = build ${tWorld / frames - fillUs}us"
                        + " (6 workers) + fill ${fillUs}us (12 bands)"
                        + " over ${renderer.triCount()} tris");
                    Console::println("  per frame (us): world=${tWorld / frames}"
                        + " sky=${renderer.skyMarchMicros() / frames}+${renderer.skyDrawMicros() / frames}"
                        + " rays=${tRays / frames} bloom=${tBloom / frames}"
                        + " blit=${tBlit / frames}  over ${frames} frames");
                }
            } else {
                Console::println("could not write voxel.bmp");
            }
            running = false;
        }
        // Update the listener at the player so positional sounds attenuate live;
        // smalt's `mixerLoop`, on its own thread, does the device feeding.
        sfx.setListener(player.pos.x, player.pos.y, player.pos.z);
    }

    // Stop the worker threads (audio + lighting) and wait for them before
    // anything they touch is released.
    sfx.stop();
    man.stopLight();
    let audioDone : i32 = audioTask.join();
    let lightDone : i32 = lightTask.join();
    // The pump ran on the audio thread, so the device is released only
    // once that thread has been joined — closing it under a live pump is
    // a mixer reading a handle that has been given back.
    sfx.close();

    // Closed in the reverse order of construction. The framebuffer goes
    // after the last present and before the window, because the blit
    // reads its pixels: a surface released while a present were still in
    // flight would hand the OS an address nobody owns.
    Mem::release(zbuf);
    screen.close();
    events.close();
    win.close();
    platform.close();
    clock.close();
    return 0;
}

/**
 * Stand a torch on the ground `TORCH_AHEAD` blocks in front of the player, and
 * light it through the same edit path a right-click uses.
 * @param man  the world to place into
 * @param p    the player whose facing the torch is placed along
 */
fn plantTorch(man : ChunkManager, p : Player) : void {
    let fx : f64 = 0.0 - p.yaw.sin();
    let fz : f64 = p.yaw.cos();
    let tx : i32 = (p.pos.x + fx * TORCH_AHEAD).floorToInt() as i32;
    let tz : i32 = (p.pos.z + fz * TORCH_AHEAD).floorToInt() as i32;
    let cell : IVec3 = ivec3(tx, man.columnHeight(tx, tz) + 1, tz);
    man.placeAt(cell, Block::Torch);
    man.lightUpdate(cell);
    Console::println("torch at (${cell.x}, ${cell.y}, ${cell.z})");
}
