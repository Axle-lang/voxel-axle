// raster — software triangle rasteriser into the ARGB framebuffer with a
// per-pixel inverse-depth z-buffer. Half-plane (edge-function) inside
// test; depth is the barycentric blend of vertex inverse depths, nearest
// wins. Winding-agnostic (the area's sign flows through the weights).

use sdl_platform::{putPixel, getF64, setF64, readI32, rgb};
use crate::config;
use crate::mathx::{ clampF64, clampI32 };

/**
 * The render target bundle: framebuffer + z-buffer base pointers and the frame
 * size. A value-type struct passed in place of the four loose `pixels, zbuf, w,
 * h` arguments that every render/raster routine used to take.
 */
struct FrameBuf {
    pixels : i64,
    zbuf : i64,
    w : i32,
    h : i32,
}

/**
 * Lesser of two f64 values.
 * @param a  first value.
 * @param b  second value.
 * @return the smaller of `a` and `b`.
 */
fn minf(a : f64, b : f64) : f64 {
    if (a < b) {
        return a;
    }
    return b;
}

/**
 * Greater of two f64 values.
 * @param a  first value.
 * @param b  second value.
 * @return the larger of `a` and `b`.
 */
fn maxf(a : f64, b : f64) : f64 {
    if (a > b) {
        return a;
    }
    return b;
}

/**
 * Edge function: signed area of the triangle (a, b, p).
 * @param ax  first vertex x.
 * @param ay  first vertex y.
 * @param bx  second vertex x.
 * @param by  second vertex y.
 * @param px  test point x.
 * @param py  test point y.
 * @return the signed area.
 */
fn edge(ax : f64, ay : f64, bx : f64, by : f64, px : f64, py : f64) : f64 {
    return (px - ax) * (by - ay) - (py - ay) * (bx - ax);
}

/**
 * Fill the frame with `bg` and reset the z-buffer.
 * @param pixels  framebuffer base pointer.
 * @param zbuf    z-buffer base pointer.
 * @param w       framebuffer width.
 * @param h       framebuffer height.
 * @param bg      background colour.
 */
fn clearFrame(fb : FrameBuf, bg : i32) : void {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let n : i32 = fb.w * fb.h;
    let i : i32 = 0;
    while (i < n) {
        putPixel(pixels, i, bg);
        setF64(zbuf, i, 0.0);
        i = i + 1;
    }
}

/**
 * Extract one 8-bit channel of an ARGB colour.
 * @param c      the packed colour.
 * @param shift  the channel's bit shift (16 = red, 8 = green, 0 = blue).
 * @return the channel value in 0..255.
 */
fn channel(c : i32, shift : i32) : i32 {
    return (c >> shift) & 0xFF;
}

/**
 * Average one channel across four texels (a 2×2 box, for mip downscaling).
 * @param a      first texel.
 * @param b      second texel.
 * @param c      third texel.
 * @param d      fourth texel.
 * @param shift  the channel's bit shift.
 * @return the averaged channel value in 0..255.
 */
fn avg4(a : i32, b : i32, c : i32, d : i32, shift : i32) : i32 {
    return (channel(a, shift) + channel(b, shift) + channel(c, shift) + channel(d, shift)) / 4;
}

/**
 * Texel offset where mip `level` starts in the mip chain (level 0 is the
 * full-resolution atlas; each level halves the tile size).
 * @param level  the mip level.
 * @return the starting texel offset.
 */
fn mipLevelOffset(level : i32) : i32 {
    let off : i32 = 0;
    let sz : i32 = config::tilePx;
    let l : i32 = 0;
    while (l < level) {
        off = off + config::atlasTiles * sz * sz;
        sz = sz / 2;
        l = l + 1;
    }
    return off;
}

/**
 * Tile side length (texels) at mip `level`.
 * @param level  the mip level.
 * @return the tile side length in texels.
 */
fn mipLevelSize(level : i32) : i32 {
    let sz : i32 = config::tilePx;
    let l : i32 = 0;
    while (l < level) {
        sz = sz / 2;
        l = l + 1;
    }
    return sz;
}

/**
 * Total texel count of the whole mip chain (for allocation).
 * @return the total texel count.
 */
fn mipChainTexels() : i32 {
    return mipLevelOffset(config::mipLevels);
}

/**
 * Build the mip chain into `mips` from the level-0 `atlas`: level 0 is a
 * copy, each finer level a 2×2 box-filtered downsample of the previous.
 * Pre-averaging the texels is what stops distant textures from shimmering
 * as the camera moves (Minecraft-style mipmapping).
 * @param atlas  the level-0 texture atlas.
 * @param mips   the destination mip chain buffer.
 */
fn buildMipChain(atlas : i64, mips : i64) : void {
    let n0 : i32 = config::atlasTiles * config::tilePx * config::tilePx;
    let i : i32 = 0;
    while (i < n0) {
        putPixel(mips, i, readI32(atlas, (i as i64) * 4));
        i = i + 1;
    }
    let level : i32 = 1;
    let sz : i32 = config::tilePx / 2;
    let psz : i32 = config::tilePx;
    while (level < config::mipLevels) {
        let base : i32 = mipLevelOffset(level);
        let pbase : i32 = mipLevelOffset(level - 1);
        let t : i32 = 0;
        while (t < config::atlasTiles) {
            let ty : i32 = 0;
            while (ty < sz) {
                let tx : i32 = 0;
                while (tx < sz) {
                    let i00 : i32 = pbase + (t * psz + ty * 2) * psz + tx * 2;
                    let i01 : i32 = i00 + 1;
                    let i10 : i32 = pbase + (t * psz + ty * 2 + 1) * psz + tx * 2;
                    let i11 : i32 = i10 + 1;
                    let c00 : i32 = readI32(mips, (i00 as i64) * 4);
                    let c01 : i32 = readI32(mips, (i01 as i64) * 4);
                    let c10 : i32 = readI32(mips, (i10 as i64) * 4);
                    let c11 : i32 = readI32(mips, (i11 as i64) * 4);
                    let rr : i32 = avg4(c00, c01, c10, c11, 16);
                    let gg : i32 = avg4(c00, c01, c10, c11, 8);
                    let bb : i32 = avg4(c00, c01, c10, c11, 0);
                    putPixel(mips, base + (t * sz + ty) * sz + tx, rgb(rr, gg, bb));
                    tx = tx + 1;
                }
                ty = ty + 1;
            }
            t = t + 1;
        }
        psz = sz;
        sz = sz / 2;
        level = level + 1;
    }
}

/**
 * One projected, lit triangle vertex for the textured rasteriser: screen
 * position (sx, sy), inverse depth (iz), tile UV (u, v) and the per-vertex
 * Gouraud light-colour multipliers (tr, tg, tb). A value-type bundle so the
 * rasteriser takes 3 of these instead of two dozen loose scalars.
 */
struct RasterVert {
    sx : f64,
    sy : f64,
    iz : f64,
    u : f64,
    v : f64,
    tr : f64,
    tg : f64,
    tb : f64,
}

/**
 * One queued textured triangle (3 verts + atlas tile + wrap flag). The world
 * pass projects/lights/clips faces into a queue of these once; worker threads
 * then rasterise the queue, each into its own screen-column band — so the heavy
 * per-face lighting is done once and only the fill is parallelised.
 */
struct RasterTri {
    a : RasterVert,
    b : RasterVert,
    c : RasterVert,
    tile : i32,
    wrap : i32,
}

/**
 * Bilinear sample of one atlas tile at a given mip level, returning packed rgb.
 * Used for the anisotropic minification taps.
 * @param mips     the mip chain buffer
 * @param lvlBase  texel offset of the mip level
 * @param lvlSz    tile side length of the mip level
 * @param tile     atlas tile index
 * @param u        tile u (0..1, may exceed when wrapping)
 * @param v        tile v
 * @param wrap     wrap within the tile (scrolled water) vs clamp
 * @return packed rgb of the bilinear sample
 */
fn sampleTile(mips : i64, lvlBase : i32, lvlSz : i32, tile : i32, u : f64, v : f64, wrap : bool) : i32 {
    let tmax : i32 = lvlSz - 1;
    let tbase : i32 = tile * lvlSz;
    let fu : f64 = u * (lvlSz as f64) - 0.5;
    let fv : f64 = v * (lvlSz as f64) - 0.5;
    let tx0 : i32 = Math::floorToInt(fu) as i32;
    let ty0 : i32 = Math::floorToInt(fv) as i32;
    let fx : f64 = fu - (tx0 as f64);
    let fy : f64 = fv - (ty0 as f64);
    let tx1 : i32 = tx0 + 1;
    let ty1 : i32 = ty0 + 1;
    if (wrap) {
        tx0 = tx0 & tmax;
        tx1 = tx1 & tmax;
        ty0 = ty0 & tmax;
        ty1 = ty1 & tmax;
    } else {
        if (tx0 < 0) { tx0 = 0; } else if (tx0 > tmax) { tx0 = tmax; }
        if (tx1 < 0) { tx1 = 0; } else if (tx1 > tmax) { tx1 = tmax; }
        if (ty0 < 0) { ty0 = 0; } else if (ty0 > tmax) { ty0 = tmax; }
        if (ty1 < 0) { ty1 = 0; } else if (ty1 > tmax) { ty1 = tmax; }
    }
    let rw0 : i32 = lvlBase + (tbase + ty0) * lvlSz;
    let rw1 : i32 = lvlBase + (tbase + ty1) * lvlSz;
    let c00 : i32 = readI32(mips, ((rw0 + tx0) as i64) * 4);
    let c10 : i32 = readI32(mips, ((rw0 + tx1) as i64) * 4);
    let c01 : i32 = readI32(mips, ((rw1 + tx0) as i64) * 4);
    let c11 : i32 = readI32(mips, ((rw1 + tx1) as i64) * 4);
    let mfx : f64 = 1.0 - fx;
    let mfy : f64 = 1.0 - fy;
    let w00 : f64 = mfx * mfy;
    let w10 : f64 = fx * mfy;
    let w01 : f64 = mfx * fy;
    let w11 : f64 = fx * fy;
    let rr : i32 = Math::floorToInt((((c00 >> 16) & 0xFF) as f64) * w00 + (((c10 >> 16) & 0xFF) as f64) * w10 + (((c01 >> 16) & 0xFF) as f64) * w01 + (((c11 >> 16) & 0xFF) as f64) * w11) as i32;
    let gg : i32 = Math::floorToInt((((c00 >> 8) & 0xFF) as f64) * w00 + (((c10 >> 8) & 0xFF) as f64) * w10 + (((c01 >> 8) & 0xFF) as f64) * w01 + (((c11 >> 8) & 0xFF) as f64) * w11) as i32;
    let bb : i32 = Math::floorToInt(((c00 & 0xFF) as f64) * w00 + ((c10 & 0xFF) as f64) * w10 + ((c01 & 0xFF) as f64) * w01 + ((c11 & 0xFF) as f64) * w11) as i32;
    return rr * 65536 + gg * 256 + bb;
}

/**
 * Textured triangle with proper texture filtering: crisp **sharp-bilinear** when
 * the texture is magnified (near), and true **anisotropic filtering** when
 * minified (distance / oblique ground) — the mip is chosen from the LESS
 * compressed screen axis and several taps are averaged along the MORE compressed
 * one, so distant surfaces stay sharp instead of smearing to a blurry mush. The
 * per-pixel screen-space UV derivatives come from the triangle's constant
 * gradients of (u/z, v/z, 1/z). Each channel is scaled by its own per-vertex
 * multiplier (Gouraud light colour).
 * @param mips    the mip chain buffer
 * @param tile    atlas tile index
 * @param mipOff  i32[mipLevels] of each mip level's texel offset (1 build cost)
 * @param mipSz   i32[mipLevels] of each mip level's tile side length
 */
fn rasterTriTex(fb : FrameBuf,
    a0 : RasterVert, a1 : RasterVert, a2 : RasterVert,
    mips : i64, tile : i32, mipOff : i64, mipSz : i64,
    wrap : bool, fogr : i32, fogg : i32, fogb : i32, bandX0 : i32, bandX1 : i32) : void {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let w : i32 = fb.w;
    let h : i32 = fb.h;
    // Unpack the vertex bundles into the locals the body uses.
    let x0 : f64 = a0.sx; let y0 : f64 = a0.sy; let iz0 : f64 = a0.iz; let u0 : f64 = a0.u; let v0 : f64 = a0.v;
    let x1 : f64 = a1.sx; let y1 : f64 = a1.sy; let iz1 : f64 = a1.iz; let u1 : f64 = a1.u; let v1 : f64 = a1.v;
    let x2 : f64 = a2.sx; let y2 : f64 = a2.sy; let iz2 : f64 = a2.iz; let u2 : f64 = a2.u; let v2 : f64 = a2.v;
    let tr0 : f64 = a0.tr; let tg0 : f64 = a0.tg; let tb0 : f64 = a0.tb;
    let tr1 : f64 = a1.tr; let tg1 : f64 = a1.tg; let tb1 : f64 = a1.tb;
    let tr2 : f64 = a2.tr; let tg2 : f64 = a2.tg; let tb2 : f64 = a2.tb;
    let area : f64 = edge(x0, y0, x1, y1, x2, y2);
    if (area > 0.0 - 0.0001 && area < 0.0001) {
        return;
    }
    let inv : f64 = 1.0 / area;
    let uw0 : f64 = u0 * iz0;
    let vw0 : f64 = v0 * iz0;
    let uw1 : f64 = u1 * iz1;
    let vw1 : f64 = v1 * iz1;
    let uw2 : f64 = u2 * iz2;
    let vw2 : f64 = v2 * iz2;

    let minx : i32 = Math::floorToInt(minf(x0, minf(x1, x2))) as i32;
    let maxx : i32 = Math::floorToInt(maxf(x0, maxf(x1, x2))) as i32;
    let miny : i32 = Math::floorToInt(minf(y0, minf(y1, y2))) as i32;
    let maxy : i32 = Math::floorToInt(maxf(y0, maxf(y1, y2))) as i32;
    if (minx < 0) {
        minx = 0;
    }
    if (miny < 0) {
        miny = 0;
    }
    if (maxx > w - 1) {
        maxx = w - 1;
    }
    if (maxy > h - 1) {
        maxy = h - 1;
    }
    // Tile clip: this call only fills the column band [bandX0, bandX1) so worker
    // threads own disjoint screen columns (no z-buffer race). A triangle outside
    // the band is rejected here cheaply.
    if (minx < bandX0) {
        minx = bandX0;
    }
    if (maxx > bandX1 - 1) {
        maxx = bandX1 - 1;
    }
    if (minx > maxx) {
        return;
    }

    // Incremental edge functions: the three edge values are linear in the
    // pixel centre, so we evaluate them once at the bbox corner and step
    // them by constant deltas instead of recomputing per pixel.
    let cx0 : f64 = (minx as f64) + 0.5;
    let cy0 : f64 = (miny as f64) + 0.5;
    let ax0 : f64 = y2 - y1;
    let ay0 : f64 = x1 - x2;
    let ax1 : f64 = y0 - y2;
    let ay1 : f64 = x2 - x0;
    let ax2 : f64 = y1 - y0;
    let ay2 : f64 = x0 - x1;
    let e0row : f64 = edge(x1, y1, x2, y2, cx0, cy0);
    let e1row : f64 = edge(x2, y2, x0, y0, cx0, cy0);
    let e2row : f64 = edge(x0, y0, x1, y1, cx0, cy0);

    // Triangle-constant screen-space gradients of the perspective attributes
    // (u/z, v/z, 1/z): linear in screen x/y, so they're constant per triangle.
    // Each pixel derives its UV footprint (du/dx … dv/dy) from these to choose
    // the mip level and the anisotropic tap count.
    let guwx : f64 = (ax0 * uw0 + ax1 * uw1 + ax2 * uw2) * inv;
    let gvwx : f64 = (ax0 * vw0 + ax1 * vw1 + ax2 * vw2) * inv;
    let gizx : f64 = (ax0 * iz0 + ax1 * iz1 + ax2 * iz2) * inv;
    let guwy : f64 = (ay0 * uw0 + ay1 * uw1 + ay2 * uw2) * inv;
    let gvwy : f64 = (ay0 * vw0 + ay1 * vw1 + ay2 * vw2) * inv;
    let gizy : f64 = (ay0 * iz0 + ay1 * iz1 + ay2 * iz2) * inv;
    let tp : f64 = config::tilePx as f64;
    let maxMip : i32 = config::mipLevels - 1;
    // Magnification (near) path: crisp sharp-bilinear at mip 0.
    let tf : f64 = tp;
    let tmax : i32 = config::tilePx - 1;
    let tbase : i32 = tile * config::tilePx;

    let py : i32 = miny;
    while (py <= maxy) {
        let e0 : f64 = e0row;
        let e1 : f64 = e1row;
        let e2 : f64 = e2row;
        let rowbase : i32 = py * w;
        let px : i32 = minx;
        while (px <= maxx) {
            if (e0 * inv >= 0.0 && e1 * inv >= 0.0 && e2 * inv >= 0.0) {
                let b0 : f64 = e0 * inv;
                let b1 : f64 = e1 * inv;
                let b2 : f64 = e2 * inv;
                let izp : f64 = b0 * iz0 + b1 * iz1 + b2 * iz2;
                let idx : i64 = (rowbase + px) as i64;
                unsafe {
                    let zp : ptr<f64> = (zbuf + idx * 8) as ptr<f64>;
                    if (izp > *zp) {
                        let invz : f64 = 1.0 / izp;
                        let u : f64 = (b0 * uw0 + b1 * uw1 + b2 * uw2) * invz;
                        let v : f64 = (b0 * vw0 + b1 * vw1 + b2 * vw2) * invz;
                        // Per-pixel UV footprint in full-res texels: the screen-x
                        // and screen-y derivatives of (u,v). Their lengths give
                        // texels-per-pixel along each screen axis; the smaller is
                        // the minor axis (sets the mip), the larger the major
                        // (sets the anisotropic tap count).
                        let dudx : f64 = (guwx - u * gizx) * invz;
                        let dvdx : f64 = (gvwx - v * gizx) * invz;
                        let dudy : f64 = (guwy - u * gizy) * invz;
                        let dvdy : f64 = (gvwy - v * gizy) * invz;
                        let exx : f64 = dudx * tp;
                        let eyx : f64 = dvdx * tp;
                        let exy : f64 = dudy * tp;
                        let eyy : f64 = dvdy * tp;
                        let px2 : f64 = exx * exx + eyx * eyx;
                        let py2 : f64 = exy * exy + eyy * eyy;
                        let minor2 : f64 = px2;
                        let major2 : f64 = py2;
                        if (py2 < px2) {
                            minor2 = py2;
                            major2 = px2;
                        }
                        let rf : f64 = 0.0;
                        let gf : f64 = 0.0;
                        let bf : f64 = 0.0;
                        if (minor2 <= 1.0) {
                            // ── Magnification (near): crisp sharp-bilinear, mip 0 ──
                            let sharp : f64 = 16.0;
                            if (minor2 > 0.0000001) {
                                sharp = 1.0 / Math::sqrt(minor2);
                            }
                            if (sharp < 1.0) {
                                sharp = 1.0;
                            }
                            if (sharp > 16.0) {
                                sharp = 16.0;
                            }
                            let rrs : f64 = 0.5 - 0.5 / sharp;
                            let fu0 : f64 = u * tf;
                            let fv0 : f64 = v * tf;
                            let flx : f64 = Math::floorToInt(fu0) as f64;
                            let cdx0 : f64 = fu0 - flx - 0.5;
                            let ccx0 : f64 = cdx0;
                            if (ccx0 > rrs) {
                                ccx0 = rrs;
                            } else if (ccx0 < 0.0 - rrs) {
                                ccx0 = 0.0 - rrs;
                            }
                            let fu : f64 = flx + (cdx0 - ccx0) * sharp;
                            let fly : f64 = Math::floorToInt(fv0) as f64;
                            let cdy0 : f64 = fv0 - fly - 0.5;
                            let ccy0 : f64 = cdy0;
                            if (ccy0 > rrs) {
                                ccy0 = rrs;
                            } else if (ccy0 < 0.0 - rrs) {
                                ccy0 = 0.0 - rrs;
                            }
                            let fv : f64 = fly + (cdy0 - ccy0) * sharp;
                            let tx0 : i32 = Math::floorToInt(fu) as i32;
                            let ty0 : i32 = Math::floorToInt(fv) as i32;
                            let fx : f64 = fu - (tx0 as f64);
                            let fy : f64 = fv - (ty0 as f64);
                            let tx1 : i32 = tx0 + 1;
                            let ty1 : i32 = ty0 + 1;
                            if (wrap) {
                                tx0 = tx0 & tmax;
                                tx1 = tx1 & tmax;
                                ty0 = ty0 & tmax;
                                ty1 = ty1 & tmax;
                            } else {
                                if (tx0 < 0) { tx0 = 0; } else if (tx0 > tmax) { tx0 = tmax; }
                                if (tx1 < 0) { tx1 = 0; } else if (tx1 > tmax) { tx1 = tmax; }
                                if (ty0 < 0) { ty0 = 0; } else if (ty0 > tmax) { ty0 = tmax; }
                                if (ty1 < 0) { ty1 = 0; } else if (ty1 > tmax) { ty1 = tmax; }
                            }
                            let rw0 : i32 = (tbase + ty0) * config::tilePx;
                            let rw1 : i32 = (tbase + ty1) * config::tilePx;
                            let c00 : i32 = *((mips + ((rw0 + tx0) as i64) * 4) as ptr<i32>);
                            let c10 : i32 = *((mips + ((rw0 + tx1) as i64) * 4) as ptr<i32>);
                            let c01 : i32 = *((mips + ((rw1 + tx0) as i64) * 4) as ptr<i32>);
                            let c11 : i32 = *((mips + ((rw1 + tx1) as i64) * 4) as ptr<i32>);
                            let mfx : f64 = 1.0 - fx;
                            let mfy : f64 = 1.0 - fy;
                            let w00 : f64 = mfx * mfy;
                            let w10 : f64 = fx * mfy;
                            let w01 : f64 = mfx * fy;
                            let w11 : f64 = fx * fy;
                            rf = (((c00 >> 16) & 0xFF) as f64) * w00 + (((c10 >> 16) & 0xFF) as f64) * w10 + (((c01 >> 16) & 0xFF) as f64) * w01 + (((c11 >> 16) & 0xFF) as f64) * w11;
                            gf = (((c00 >> 8) & 0xFF) as f64) * w00 + (((c10 >> 8) & 0xFF) as f64) * w10 + (((c01 >> 8) & 0xFF) as f64) * w01 + (((c11 >> 8) & 0xFF) as f64) * w11;
                            bf = ((c00 & 0xFF) as f64) * w00 + ((c10 & 0xFF) as f64) * w10 + ((c01 & 0xFF) as f64) * w01 + ((c11 & 0xFF) as f64) * w11;
                        } else {
                            // ── Minification (distance): anisotropic filtering ──
                            // Mip from the minor axis (with a sharpening bias), then
                            // average N bilinear taps along the major axis so oblique
                            // distant surfaces stay sharp without shimmering.
                            let m2 : f64 = minor2 * config::mipBias;
                            let mip : i32 = 0;
                            let lim : f64 = 4.0;
                            while (mip < maxMip && m2 >= lim) {
                                lim = lim * 4.0;
                                mip = mip + 1;
                            }
                            let lvlBase : i32 = readI32(mipOff, (mip as i64) * 4);
                            let lvlSz : i32 = readI32(mipSz, (mip as i64) * 4);
                            let ratio : f64 = Math::sqrt(major2 / minor2);
                            let nN : i32 = Math::floorToInt(ratio + 0.5) as i32;
                            if (nN < 1) {
                                nN = 1;
                            }
                            if (nN > config::maxAniso) {
                                nN = config::maxAniso;
                            }
                            let mju : f64 = dudx;
                            let mjv : f64 = dvdx;
                            if (py2 > px2) {
                                mju = dudy;
                                mjv = dvdy;
                            }
                            let sr : f64 = 0.0;
                            let sg : f64 = 0.0;
                            let sb : f64 = 0.0;
                            let i : i32 = 0;
                            while (i < nN) {
                                let tt : f64 = (((i as f64) + 0.5) / (nN as f64)) - 0.5;
                                let c : i32 = sampleTile(mips, lvlBase, lvlSz, tile, u + mju * tt, v + mjv * tt, wrap);
                                sr = sr + (((c >> 16) & 0xFF) as f64);
                                sg = sg + (((c >> 8) & 0xFF) as f64);
                                sb = sb + ((c & 0xFF) as f64);
                                i = i + 1;
                            }
                            let invN : f64 = 1.0 / (nN as f64);
                            rf = sr * invN;
                            gf = sg * invN;
                            bf = sb * invN;
                        }
                        // Gouraud: per-vertex tint interpolated by the
                        // screen-space barycentrics (low-frequency light, so
                        // affine interpolation is fine and cheap).
                        let trp : f64 = b0 * tr0 + b1 * tr1 + b2 * tr2;
                        let tgp : f64 = b0 * tg0 + b1 * tg1 + b2 * tg2;
                        let tbp : f64 = b0 * tb0 + b1 * tb1 + b2 * tb2;
                        let r : i32 = Math::floorToInt(rf * trp) as i32;
                        let g : i32 = Math::floorToInt(gf * tgp) as i32;
                        let bl : i32 = Math::floorToInt(bf * tbp) as i32;
                        if (r > 255) {
                            r = 255;
                        }
                        if (g > 255) {
                            g = 255;
                        }
                        if (bl > 255) {
                            bl = 255;
                        }
                        // Distance fog: blend toward the sky past fogStart
                        // so far terrain dissolves instead of shimmering.
                        if (invz > config::fogStart) {
                            let fog : f64 = (invz - config::fogStart) / (config::fogEnd - config::fogStart);
                            if (fog > 1.0) {
                                fog = 1.0;
                            }
                            let keep : f64 = 1.0 - fog;
                            r = Math::floorToInt((r as f64) * keep + (fogr as f64) * fog) as i32;
                            g = Math::floorToInt((g as f64) * keep + (fogg as f64) * fog) as i32;
                            bl = Math::floorToInt((bl as f64) * keep + (fogb as f64) * fog) as i32;
                        }
                        *zp = izp;
                        let pp : ptr<i32> = (pixels + idx * 4) as ptr<i32>;
                        *pp = (r & 0xFF) * 65536 + (g & 0xFF) * 256 + (bl & 0xFF);
                    }
                }
            }
            e0 = e0 + ax0;
            e1 = e1 + ax1;
            e2 = e2 + ax2;
            px = px + 1;
        }
        e0row = e0row + ay0;
        e1row = e1row + ay1;
        e2row = e2row + ay2;
        py = py + 1;
    }
}

/**
 * Flat-colour triangle: half-plane inside test with z-buffered fill.
 * @param pixels  framebuffer base pointer.
 * @param zbuf    z-buffer base pointer.
 * @param w       framebuffer width.
 * @param h       framebuffer height.
 * @param x0      first vertex x.
 * @param y0      first vertex y.
 * @param iz0     first vertex inverse depth.
 * @param x1      second vertex x.
 * @param y1      second vertex y.
 * @param iz1     second vertex inverse depth.
 * @param x2      third vertex x.
 * @param y2      third vertex y.
 * @param iz2     third vertex inverse depth.
 * @param color   fill colour.
 */
fn rasterTri(fb : FrameBuf,
    x0 : f64, y0 : f64, iz0 : f64,
    x1 : f64, y1 : f64, iz1 : f64,
    x2 : f64, y2 : f64, iz2 : f64,
    color : i32) : void {
    let pixels : i64 = fb.pixels;
    let zbuf : i64 = fb.zbuf;
    let w : i32 = fb.w;
    let h : i32 = fb.h;
    let area : f64 = edge(x0, y0, x1, y1, x2, y2);
    if (area > 0.0 - 0.0001 && area < 0.0001) {
        return;
    }
    let inv : f64 = 1.0 / area;

    let minx : i32 = Math::floorToInt(minf(x0, minf(x1, x2))) as i32;
    let maxx : i32 = Math::floorToInt(maxf(x0, maxf(x1, x2))) as i32;
    let miny : i32 = Math::floorToInt(minf(y0, minf(y1, y2))) as i32;
    let maxy : i32 = Math::floorToInt(maxf(y0, maxf(y1, y2))) as i32;
    if (minx < 0) {
        minx = 0;
    }
    if (miny < 0) {
        miny = 0;
    }
    if (maxx > w - 1) {
        maxx = w - 1;
    }
    if (maxy > h - 1) {
        maxy = h - 1;
    }

    let py : i32 = miny;
    while (py <= maxy) {
        let cy : f64 = (py as f64) + 0.5;
        let px : i32 = minx;
        while (px <= maxx) {
            let cx : f64 = (px as f64) + 0.5;
            let b0 : f64 = edge(x1, y1, x2, y2, cx, cy) * inv;
            let b1 : f64 = edge(x2, y2, x0, y0, cx, cy) * inv;
            let b2 : f64 = edge(x0, y0, x1, y1, cx, cy) * inv;
            if (b0 >= 0.0 && b1 >= 0.0 && b2 >= 0.0) {
                let iz : f64 = b0 * iz0 + b1 * iz1 + b2 * iz2;
                let idx : i32 = py * w + px;
                if (iz > getF64(zbuf, idx)) {
                    setF64(zbuf, idx, iz);
                    putPixel(pixels, idx, color);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
}
