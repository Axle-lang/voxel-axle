// terraingen — the terrain generator, a leaf split out of the world manager.
//
// Owns the padded heightmap and the biome registry, and writes voxels straight
// into the VoxStore the manager lends each `generate` call. It fills a chunk's
// stone / filler / surface bands by depth, water up to sea level, a thin
// cold-biome snow layer, then stamps deterministic trees (carving delegated to
// treegen's free functions) and dusts cold canopies with snow. Tree placement
// is deterministic (treeHash), so a canopy straddling a chunk border is stamped
// identically from both sides — seamless.

use crate::engine::world::chunks::Generator;
use crate::game::world::terrain::{
    terrainHeight, temperature, humidity, treeHash, hashI, snowDepth
};
use crate::game::world::biomes::{ biomeAt, biomeDef, biomeSurface, BiomeDef };
use crate::engine::block::blocks::{ isLeaves };
use crate::engine::block::box::{ levelOfHeight };
use crate::engine::world::voxstore::VoxStore;
use crate::game::world::treegen::{ stampTree };
use crate::engine::math::vec3::{ IVec3, ivec3 };
use crate::configs::biomes::{ BiomeId };
use crate::configs::blocks::{ Block };
use crate::configs::noise::{ Noise };
use crate::configs::trees::{ Trees };
use crate::configs::world::{ World };

/** The chunk being generated: the slot it lands in and its chunk coordinates. */
struct GenChunk {
    slot : i32,
    cx : i32,
    cz : i32,
}

class TerrainGen : Generator {
    hmap : i8[],      // per-slot terrain top (tree-free), owned here — under 128

    /**
     * Allocate the padded heightmap. The voxel store stays the manager's and is
     * lent per `generate` call. Biome parameters are a pure lookup (biomes.axle),
     * so there is no per-biome state to own here.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        const s : i32 = World::CHUNK_SIZE;
        self.hmap = malloc<i8>(slots * s * s);
    }

    /**
     * Heightmap value at local coords (lx, lz) within `slot`.
     * @param slot  the slot index
     * @param lx    the local x coordinate
     * @param lz    the local z coordinate
     * @return the terrain top height
     */
    fn heightAt(self, slot : i32, lx : i32, lz : i32) : i32 {
        const s : i32 = World::CHUNK_SIZE;
        return self.hmap[slot * s * s + lz * s + lx] as i32;
    }

    /**
     * Generate a chunk: heightmap first, then the voxel field + trees.
     * @param store  the manager's voxel storage to fill
     * @param slot   the slot index
     * @param cx     the chunk x coordinate
     * @param cz     the chunk z coordinate
     */
    fn generate(mut self, store : VoxStore, slot : i32, cx : i32, cz : i32) : void {
        self.genHeightmap(slot, cx, cz);
        self.genVoxels(store, slot, cx, cz);
    }

    /**
     * Fill the heightmap for a chunk, clamped to a valid band.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn genHeightmap(mut self, slot : i32, cx : i32, cz : i32) : void {
        const s : i32 = World::CHUNK_SIZE;
        const base : i32 = slot * s * s;
        for (lz of 0..s) {
            for (lx of 0..s) {
                const wx : f64 = (cx * s + lx) as f64;
                const wz : f64 = (cz * s + lz) as f64;
                let h : i32 = (terrainHeight(wx, wz)).floorToInt() as i32;
                if (h < 2) {
                    h = 2;
                }
                if (h > World::MAX_HEIGHT - 1) {
                    h = World::MAX_HEIGHT - 1;
                }
                self.hmap[base + lz * s + lx] = h as i8;
            }
        }
    }

    /**
     * Clamped terrain height for an arbitrary world column (for tree origins
     * outside the chunk). Matches genHeightmap.
     * @param wx  the world x coordinate
     * @param wz  the world z coordinate
     * @return the clamped terrain height
     */
    pub(crate) fn colHeightWorld(self, wx : i32, wz : i32) : i32 {
        let h : i32 = (terrainHeight(wx as f64, wz as f64)).floorToInt() as i32;
        if (h < 2) {
            h = 2;
        }
        if (h > World::MAX_HEIGHT - 1) {
            h = World::MAX_HEIGHT - 1;
        }
        return h;
    }

    /**
     * True for the cold, snowy biomes whose trees + ground should carry snow.
     * @param b  the biome id
     * @return whether the biome is snowy, taiga or mountain
     */
    pub(crate) fn coldBiome(self, b : BiomeId) : bool {
        return b == BiomeId::Snowy || b == BiomeId::Taiga || b == BiomeId::Mountain;
    }

    /**
     * Deep stone, occasionally an ore — deterministic 3D scatter by depth.
     * @param cell  the world voxel
     * @return the block id (ore or stone)
     */
    fn oreAt(self, cell : IVec3) : Block {
        const r : f64 = hashI(
            cell.x * 7 + cell.y * 131,
            cell.z * 13 + cell.y * 977,
            Noise::SEED + 9171
        );

        if (cell.y < 14) {
            if (r > 0.9930) {
                return Block::DiamondOre;
            }
            if (r > 0.9870) {
                return Block::EmeraldOre;
            }
            if (r > 0.9790) {
                return Block::RedstoneOre;
            }
            if (r > 0.9680) {
                return Block::GoldOre;
            }
        }
        if (cell.y < 36 && r > 0.9700) {
            return Block::LapisOre;
        }
        if (r > 0.9550) {
            return Block::IronOre;
        }
        if (r > 0.9150) {
            return Block::CoalOre;
        }
        return Block::Stone;
    }

    /**
     * Fill the voxel field for a chunk: stone / filler / surface by depth,
     * water up to sea level, a thin cold-biome snow layer, air above; then trees.
     * @param store  the voxel storage to fill
     * @param slot   the slot index
     * @param cx     the chunk x coordinate
     * @param cz     the chunk z coordinate
     */
    fn genVoxels(mut self, store : VoxStore, slot : i32, cx : i32, cz : i32) : void {
        const s : i32 = World::CHUNK_SIZE;
        store.resetFaceTop(slot);
        for (lz of 0..s) {
            for (lx of 0..s) {
                const wx : i32 = cx * s + lx;
                const wz : i32 = cz * s + lz;
                const h : i32 = self.heightAt(slot, lx, lz);
                const temp : f64 = temperature(wx as f64, wz as f64);
                const humid : f64 = humidity(wx as f64, wz as f64);
                const biome : BiomeId = biomeAt(temp, humid, h);
                const surf : Block = biomeSurface(biome, h);
                const filler : Block = biomeDef(biome).filler;
                const topY : i32 = h <= World::SEA_LEVEL ? World::SEA_LEVEL : h - 1;
                store.bumpFY(slot, topY);

                for (ly of 0..World::HEIGHT) {
                    let id : Block = Block::Air;
                    if (ly < h) {
                        if (ly == h - 1) {
                            id = surf;
                        } else if (ly >= h - 3) {
                            id = filler;
                        } else {
                            id = self.oreAt(ivec3(wx, ly, wz));
                        }
                    } else if (h <= World::SEA_LEVEL && ly <= World::SEA_LEVEL) {
                        id = Block::Water;
                        // Frozen ocean: the water surface freezes to ice.
                        if (biome == BiomeId::FrozenOcean && ly == World::SEA_LEVEL) {
                            id = Block::Ice;
                        }
                    }
                    store.setVoxLocal(slot, ivec3(lx, ly, lz), id);
                }

                // Cold-biome ground: a thin, noise-varied snow layer on top of the
                // surface (bare patches where the noise is low, the odd full block
                // where it's high) — so the ground carries snow like the trees.
                if (self.coldBiome(biome) && h > World::SEA_LEVEL && h < World::HEIGHT) {
                    const frac : f64 = snowDepth(wx as f64, wz as f64);
                    if (frac > 0.0) {
                        if (frac >= 0.95) {
                            store.setVoxLocal(slot, ivec3(lx, h, lz), Block::Snow);
                        } else {
                            // The noise is sampled ONCE, here, and what it says
                            // is stored as the cell's level. Nothing downstream
                            // asks the terrain field how deep this snow is —
                            // which is what lets it be dug a layer at a time,
                            // and what keeps the world seed out of the collision
                            // path.
                            store.setVoxLevel(
                                slot,
                                ivec3(lx, h, lz),
                                Block::SnowLayer,
                                levelOfHeight(frac)
                            );
                        }
                        store.bumpFY(slot, h);
                    }
                }
            }
        }
        self.stampTrees(store, slot, cx, cz);
    }

    /**
     * Stamp every tree whose origin lies in this chunk's area (plus a 2-column
     * margin so canopies straddling a border appear from both sides).
     * Deterministic via `treeHash`, so the two chunks stamp the shared tree
     * identically. Carving lives in treegen.axle; this drives it per-biome.
     * @param store  the voxel storage to carve into
     * @param slot   the slot index
     * @param cx     the chunk x coordinate
     * @param cz     the chunk z coordinate
     */
    fn stampTrees(mut self, store : VoxStore, slot : i32, cx : i32, cz : i32) : void {
        const s : i32 = World::CHUNK_SIZE;
        const chunk : GenChunk = GenChunk {
            slot,
            cx,
            cz,
        };

        for (olz of (-2)..=(s + 1)) {
            for (olx of (-2)..=(s + 1)) {
                const wx : i32 = cx * s + olx;
                const wz : i32 = cz * s + olz;
                const h : i32 = self.colHeightWorld(wx, wz);
                if (h > World::SEA_LEVEL) {
                    const temp : f64 = temperature(wx as f64, wz as f64);
                    const humid : f64 = humidity(wx as f64, wz as f64);
                    const biome : BiomeId = biomeAt(temp, humid, h);

                    // Thin every biome's trees toward sparser, airier woods.
                    const bd : BiomeDef = biomeDef(biome);
                    const baseThr : f64 = bd.treeThresh;
                    const thr : f64 = baseThr + (1.0 - baseThr) * Trees::THIN;
                    if (treeHash(wx as f64, wz as f64) > thr) {
                        const base : IVec3 = ivec3(olx, h, olz);
                        stampTree(store, bd.treeKind, bd.treeHt, slot, base);
                        // Cold biomes: dust the canopy with a thin snow cap.
                        if (self.coldBiome(biome)) {
                            self.snowCapTree(store, chunk, base, bd.treeHt);
                        }
                    }
                }
            }
        }
    }

    /**
     * Dust a freshly-stamped tree's canopy with a thin snow cap: over each column
     * of the tree footprint, drop a single snow block onto the topmost leaf.
     * @param store   the voxel storage holding the canopy
     * @param chunk   the chunk being generated
     * @param base    the trunk base, chunk-local x/z and world y
     * @param height  the trunk height
     */
    fn snowCapTree(
        mut self,
        store : VoxStore,
        chunk : GenChunk,
        base : IVec3,
        height : i32
    ) : void {
        const s : i32 = World::CHUNK_SIZE;
        let topSearch : i32 = base.y + height + 4;
        if (topSearch >= World::HEIGHT) {
            topSearch = World::HEIGHT - 1;
        }

        for (dz of (-2)..=2) {
            for (dx of (-2)..=2) {
                const lx : i32 = base.x + dx;
                const lz : i32 = base.z + dz;
                if (lx >= 0 && lx < s && lz >= 0 && lz < s) {
                    self.snowCapColumn(store, chunk, ivec3(lx, base.y, lz), topSearch);
                }
            }
        }
    }

    /**
     * Dust one column of the tree footprint: find its topmost leaf and, if the
     * cell above is open and the column's own ground biome is cold, drop a single
     * snow block there (one block per column → a light dusting, not a slab).
     * @param store      the voxel storage holding the canopy
     * @param chunk      the chunk being generated
     * @param floor      the column, chunk-local x/z, at the trunk base y (search floor)
     * @param topSearch  the top of the leaf search (clamped to the world top)
     */
    fn snowCapColumn(
        mut self,
        store : VoxStore,
        chunk : GenChunk,
        floor : IVec3,
        topSearch : i32
    ) : void {
        const slot : i32 = chunk.slot;
        const lx : i32 = floor.x;
        const lz : i32 = floor.z;
        const baseY : i32 = floor.y;

        // Walk down to the topmost leaf of this column.
        let y : i32 = topSearch;
        while (y > baseY && !isLeaves(store.getVox(slot, ivec3(lx, y, lz)))) {
            y--;
        }
        if (y <= baseY) {
            return;   // no leaf in this column
        }

        // The leaf needs open air directly above to hold the snow.
        if (y + 1 >= World::HEIGHT || store.getVox(slot, ivec3(lx, y + 1, lz)) != Block::Air) {
            return;
        }

        // Only cap columns whose own ground biome is cold, so the canopy snow
        // matches the ground snow.
        const wx : i32 = chunk.cx * World::CHUNK_SIZE + lx;
        const wz : i32 = chunk.cz * World::CHUNK_SIZE + lz;
        const ch : i32 = self.colHeightWorld(wx, wz);
        const temp : f64 = temperature(wx as f64, wz as f64);
        const humid : f64 = humidity(wx as f64, wz as f64);
        const cb : BiomeId = biomeAt(temp, humid, ch);
        if (!self.coldBiome(cb)) {
            return;
        }

        const frac : f64 = snowDepth(wx as f64, wz as f64);
        if (frac <= 0.0) {
            return;
        }
        if (frac >= 0.95) {
            store.setVoxLocal(slot, ivec3(lx, y + 1, lz), Block::Snow);
        } else {
            store.setVoxLevel(
                slot,
                ivec3(lx, y + 1, lz),
                Block::SnowLayer,
                levelOfHeight(frac)
            );
        }
        store.bumpFY(slot, y + 1);
    }
}
