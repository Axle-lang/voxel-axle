// biomes — every biome as ONE data-driven table (was a base class + 17 subclass
// files + a registry, each repeating the same four fields and a trivial getter).
//
// A biome is almost entirely DATA: a filler block, three tree parameters and a
// top ("surface") block. The only behaviour is the height-dependent surface of
// three biomes — mountain (snow cap → bare stone → grass), badlands (banded
// terracotta) and ocean/frozen-ocean (gravel deeps → sand shallows) — selected
// by `surfMode`; every other biome's top block is the constant `surf`.
//
// Add a biome: one arm in `biomeDef` (+ a branch in `biomeAt`). No new class,
// file, field or getter.

use crate::configs::biomes::{ BiomeId };
use crate::configs::blocks::{ Block };
use crate::configs::noise::{ Noise };
use crate::configs::trees::{ TreeKind };
use crate::configs::world::{ World };

/**
 * Which rule picks a column's top block. `Constant` just answers
 * `BiomeDef.surf`; the other three read the column height (see
 * `biomeSurface`), and they are the only per-biome behaviour left.
 */
enum SurfaceRule : i32 {
    Constant,
    Mountain,
    Badlands,
    Ocean,
}

/** One biome's full parameter set — plain data, resolved by id from a table. */
struct BiomeDef {
    pub(crate) filler : Block,      // block a few voxels below the surface
    pub(crate) treeThresh : f64,    // a column grows a tree when its tree-hash exceeds this (>= 1.1 = none)
    pub(crate) treeKind : TreeKind, // which tree to stamp
    pub(crate) treeHt : i32,        // trunk height for that tree
    surf : Block,                   // constant top block (used when surfMode is `Constant`)
    surfMode : SurfaceRule,         // which surface rule picks the top block
}

/**
 * The parameter set for biome `b`. One dense arm per biome replaces a whole
 * subclass file; defaults (dirt filler, no trees, grass top) are just spelled
 * out where they apply.
 * @param b  the biome id
 * @return the biome's data
 */
fn biomeDef(b : BiomeId) : BiomeDef {
    return match b {
        BiomeId::Beach          => BiomeDef { filler: Block::Sand,         treeThresh: 1.1,   treeKind: TreeKind::None,        treeHt: 0,  surf: Block::Sand,          surfMode: SurfaceRule::Constant },
        BiomeId::Plains         => BiomeDef { filler: Block::Dirt,         treeThresh: 0.992, treeKind: TreeKind::Oak,         treeHt: 4,  surf: Block::Grass,         surfMode: SurfaceRule::Constant },
        BiomeId::Forest         => BiomeDef { filler: Block::Dirt,         treeThresh: 0.928, treeKind: TreeKind::Oak,         treeHt: 4,  surf: Block::Grass,         surfMode: SurfaceRule::Constant },
        BiomeId::Desert         => BiomeDef { filler: Block::Sandstone,    treeThresh: 0.992, treeKind: TreeKind::Cactus,      treeHt: 3,  surf: Block::Sand,          surfMode: SurfaceRule::Constant },
        BiomeId::Savanna        => BiomeDef { filler: Block::Dirt,         treeThresh: 0.993, treeKind: TreeKind::Acacia,      treeHt: 5,  surf: Block::GrassSavanna,  surfMode: SurfaceRule::Constant },
        BiomeId::Snowy          => BiomeDef { filler: Block::Dirt,         treeThresh: 0.984, treeKind: TreeKind::Spruce,      treeHt: 6,  surf: Block::Snow,          surfMode: SurfaceRule::Constant },
        BiomeId::Mountain       => BiomeDef { filler: Block::Stone,        treeThresh: 1.05,  treeKind: TreeKind::Spruce,      treeHt: 6,  surf: Block::Grass,         surfMode: SurfaceRule::Mountain },
        BiomeId::Taiga          => BiomeDef { filler: Block::Dirt,         treeThresh: 0.918, treeKind: TreeKind::Spruce,      treeHt: 6,  surf: Block::GrassTaiga,    surfMode: SurfaceRule::Constant },
        BiomeId::Jungle         => BiomeDef { filler: Block::Dirt,         treeThresh: 0.865, treeKind: TreeKind::Jungle,      treeHt: 8,  surf: Block::GrassJungle,   surfMode: SurfaceRule::Constant },
        BiomeId::Swamp          => BiomeDef { filler: Block::Dirt,         treeThresh: 0.985, treeKind: TreeKind::Oak,         treeHt: 4,  surf: Block::GrassSwamp,    surfMode: SurfaceRule::Constant },
        BiomeId::Badlands       => BiomeDef { filler: Block::RedSandstone, treeThresh: 1.1,   treeKind: TreeKind::None,        treeHt: 0,  surf: Block::Terracotta,    surfMode: SurfaceRule::Badlands },
        BiomeId::BirchForest    => BiomeDef { filler: Block::Dirt,         treeThresh: 0.930, treeKind: TreeKind::Birch,       treeHt: 6,  surf: Block::Grass,         surfMode: SurfaceRule::Constant },
        BiomeId::FrozenOcean    => BiomeDef { filler: Block::Sand,         treeThresh: 1.1,   treeKind: TreeKind::None,        treeHt: 0,  surf: Block::Sand,          surfMode: SurfaceRule::Ocean },
        BiomeId::BambooJungle   => BiomeDef { filler: Block::Dirt,         treeThresh: 0.80,  treeKind: TreeKind::Bamboo,      treeHt: 12, surf: Block::GrassJungle,   surfMode: SurfaceRule::Constant },
        BiomeId::CherryGrove    => BiomeDef { filler: Block::Dirt,         treeThresh: 0.965, treeKind: TreeKind::Cherry,      treeHt: 5,  surf: Block::Grass,         surfMode: SurfaceRule::Constant },
        BiomeId::MushroomFields => BiomeDef { filler: Block::Dirt,         treeThresh: 0.955, treeKind: TreeKind::RedMushroom, treeHt: 4,  surf: Block::Mycelium,      surfMode: SurfaceRule::Constant },
        // Ocean is the default (deep water everywhere the climate map doesn't
        // pick a land biome).
        _               => BiomeDef { filler: Block::Sand,         treeThresh: 1.1,   treeKind: TreeKind::None,        treeHt: 0,  surf: Block::Sand,          surfMode: SurfaceRule::Ocean },
    };
}

/**
 * Surface (top) block for biome `b` at column height `height`. Constant for
 * most biomes; the three height-dependent ones (mountain / badlands / ocean)
 * compute it here — the only per-biome behaviour left.
 * @param b       the biome id
 * @param height  the column's surface height
 * @return the surface block id
 */
fn biomeSurface(b : BiomeId, height : i32) : Block {
    let d : BiomeDef = biomeDef(b);
    return match d.surfMode {
        // Snow on the peaks, bare stone higher up, grass at the foot.
        SurfaceRule::Mountain => mountainSurface(height),
        // Red sand near the waterline, otherwise banded terracotta.
        SurfaceRule::Badlands => badlandsSurface(height),
        // Gravel in the deeps, sand in the shallows.
        SurfaceRule::Ocean => oceanSurface(height),
        _ => d.surf,
    };
}

/**
 * Mountain top block: snow cap, bare stone below it, grass at the foot.
 * @param height  the column's surface height
 * @return the surface block id
 */
fn mountainSurface(height : i32) : Block {
    if (height > World::SEA_LEVEL + 44) {
        return Block::Snow;
    }
    if (height > World::SEA_LEVEL + 38) {
        return Block::Stone;
    }
    return Block::Grass;
}

/**
 * Badlands top block: red sand near the waterline, banded terracotta above.
 * @param height  the column's surface height
 * @return the surface block id
 */
fn badlandsSurface(height : i32) : Block {
    if (height <= World::SEA_LEVEL + 2) {
        return Block::RedSand;
    }
    return match (height / 3) % 3 {
        0 => Block::Terracotta,
        1 => Block::TerracottaOrange,
        _ => Block::TerracottaWhite,
    };
}

/**
 * Ocean floor block: gravel in the deeps, sand in the shallows.
 * @param height  the column's surface height
 * @return the surface block id
 */
fn oceanSurface(height : i32) : Block {
    if (height < World::SEA_LEVEL - 6) {
        return Block::Gravel;
    }
    return Block::Sand;
}

/**
 * Pick a biome id from climate (temp, humid in [0,1)) and column height.
 * Elevation decides first (ocean / beach / mountain), then a
 * temperature×humidity grid chooses the land biome.
 * @param temp    temperature in [0,1)
 * @param humid   humidity in [0,1)
 * @param height  the column's surface height
 * @return the chosen biome id
 */
fn biomeAt(temp : f64, humid : f64, height : i32) : BiomeId {
    if (height <= World::SEA_LEVEL) {
        if (temp < 0.26) {
            return BiomeId::FrozenOcean;
        }
        return BiomeId::Ocean;
    }
    if (height <= World::SEA_LEVEL + 1) {
        return BiomeId::Beach;
    }
    if (height >= World::SEA_LEVEL + 34) {
        return BiomeId::Mountain;
    }
    // Cool the climate with altitude: higher ground trends toward taiga / snow
    // even in a warm region, so foothills and uplands read coherently.
    let t : f64 = temp - ((height - World::SEA_LEVEL) as f64) * Noise::ALTITUDE_COOLING;
    if (t < 0.0) {
        t = 0.0;
    }
    if (t < 0.25) {
        return BiomeId::Snowy;
    }
    if (t < 0.40) {
        return BiomeId::Taiga;
    }
    if (t > 0.75 && humid < 0.30) {
        return BiomeId::Badlands;
    }
    if (t > 0.70 && humid < 0.40) {
        return BiomeId::Desert;
    }
    if (t > 0.58 && humid < 0.52) {
        return BiomeId::Savanna;
    }
    if (humid > 0.85 && t > 0.72) {
        return BiomeId::BambooJungle;
    }
    if (humid > 0.75 && t > 0.62) {
        return BiomeId::Jungle;
    }
    if (humid > 0.90 && t > 0.42 && t < 0.60) {
        return BiomeId::MushroomFields;
    }
    if (humid > 0.68 && height <= World::SEA_LEVEL + 5) {
        return BiomeId::Swamp;
    }
    if (t > 0.50 && t < 0.64 && humid > 0.52 && humid < 0.66) {
        return BiomeId::CherryGrove;
    }
    if (humid > 0.60) {
        return BiomeId::Forest;
    }
    if (humid > 0.48) {
        return BiomeId::BirchForest;
    }
    return BiomeId::Plains;
}
