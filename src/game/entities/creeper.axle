// Creeper — the hostile mob. Homes in on a survival player (3D range),
// lights a fuse, holds, then explodes; defuses if the player flees or
// switches to creative. Overrides the passive base `think` with its own
// hostile brain and is `Hostile` (which bundles the `Explodes` mechanism). The fuse countdown lives
// here (not on the calm base Mob) — only the creeper charges.

use std::numeric::math;
use smalt::Color;
use crate::engine::entity::model::{ BoxModel, BoxPart };
use crate::configs::atlas::{ Tile };
use crate::engine::entity::mob::{ Mob, MobState, Hostile };
use crate::engine::entity::player::{ GameMode, Player };
use crate::engine::world::seams::{ VoxelQuery, VoxelEdit };
use crate::engine::world::sim::blocksim::BlockSim;
use crate::engine::audio::sfx::AudioManager;
use crate::engine::math::vec3::{ IVec3, ivec3, vec3 };
use crate::configs::blocks::{ Block };
use crate::configs::mobs::{ MobKind, Mobs };

class Creeper : Mob, Hostile {
    fuse : i32,         // charge countdown; < 0 = not charging

    /**
     * Create a creeper at (x, y, z).
     * @param x  the spawn x coordinate, in world space
     * @param y  the spawn y coordinate (feet), in world space
     * @param z  the spawn z coordinate, in world space
     */
    constructor(x : f64, y : f64, z : f64) {
        super(x, y, z, MobKind::Creeper, Mobs::CREEPER_HP);
        self.speed = Mobs::CREEPER_SPEED;
        self.height = 1.5;
        self.fuse = -1;
    }

    /**
     * The creeper's body: textured green skin with its face on the head's
     * forward face. Once the fuse is lit it swaps to the "gilet jaune" charge
     * skin and face, swells to 1.25x from the feet and strobes white, faster as
     * the blast nears.
     * @param out  the model to append the boxes to
     */
    fn buildModel(self, out : BoxModel) : void {
        const sw : f64 = self.walkPhase.sin() * 0.10;
        const fuse : i32 = self.fuse;

        // Calm green vs. charging gilet jaune skin/face tiles + base tints.
        let skin : i32 = Tile::CREEPER_SKIN;
        let face : i32 = Tile::CREEPER_FACE;
        let body : i32 = Color::packBytes(58, 140, 58);
        let leg : i32 = Color::packBytes(42, 96, 42);
        // Legs always wear the plain green skin — the vest only belongs on the
        // torso, so they never carry the charge tile.
        let legTile : i32 = Tile::CREEPER_SKIN;

        // Charging menace: swell the whole model and strobe white. The strobe
        // accelerates as the fuse runs down; a flash frame paints every part
        // flat white (tile = -1) so it reads as a bright pulse over the model.
        let s : f64 = 1.0;
        let flash : bool = false;
        if (fuse >= 0) {
            skin = Tile::CHARGE_SKIN;
            face = Tile::CHARGE_FACE;
            body = Color::packBytes(228, 196, 40);
            leg = Color::packBytes(170, 140, 28);
            s = 1.25;
            const period : i32 = 2 + fuse / 40;
            if ((fuse / period) % 4 == 0) {
                flash = true;
            }
        }
        if (flash) {
            const wht : i32 = Color::packBytes(242, 248, 242);
            skin = -1;
            face = -1;
            legTile = -1;
            body = wht;
            leg = wht;
        }

        // Four legs (plain skin), the upright body (vest), then the head whose
        // forward face carries the creeper / meme mug. Every extent and offset
        // is scaled by `s` so the swell grows from the feet.
        out.add(BoxPart {
            ctr: vec3((0.0 - 0.12) * s, 0.13 * s, (0.12 + sw) * s),
            half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            color: leg,
            skinTile: legTile,
            faceTile: legTile,
        });
        out.add(BoxPart {
            ctr: vec3(0.12 * s, 0.13 * s, (0.12 - sw) * s),
            half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            color: leg,
            skinTile: legTile,
            faceTile: legTile,
        });
        out.add(BoxPart {
            ctr: vec3((0.0 - 0.12) * s, 0.13 * s, (0.0 - 0.12 - sw) * s),
            half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            color: leg,
            skinTile: legTile,
            faceTile: legTile,
        });
        out.add(BoxPart {
            ctr: vec3(0.12 * s, 0.13 * s, (0.0 - 0.12 + sw) * s),
            half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            color: leg,
            skinTile: legTile,
            faceTile: legTile,
        });
        out.add(BoxPart {
            ctr: vec3(0.0, 0.58 * s, 0.0),
            half: vec3(0.16 * s, 0.32 * s, 0.11 * s),
            color: body,
            skinTile: skin,
            faceTile: skin,
        });
        out.add(BoxPart {
            ctr: vec3(0.0, 1.06 * s, 0.0),
            half: vec3(0.18 * s, 0.18 * s, 0.18 * s),
            color: body,
            skinTile: skin,
            faceTile: face,
        });
    }

    /**
     * Creeper AI for one frame (the hostile `think` — replaces the base wander).
     * Aggression is fully 3D: the creeper only chases / charges / detonates when
     * the player is close in straight-line distance AND within
     * `Mobs::CREEPER_MAX_VERTICAL` of its own level, so a player flying or perched well
     * above is out of reach and a lit fuse defuses. The fuse / blast sounds are
     * played here, attenuated by 3D distance.
     * @param world   the world the creeper moves through (read-only voxel query)
     * @param player  the player to home in on
     * @param sfx     the audio manager for the charge / blast sounds
     * @param sim     the block-update sim woken around the blast crater
     * @param rnd     unused (the creeper is deterministic toward its target)
     */
    fn think(
        mut self,
        world : dyn VoxelQuery,
        player : Player,
        sfx : AudioManager,
        sim : BlockSim,
        rnd : f64
    ) : void {
        if (self.timers.hurtTimer > 0) {
            self.timers.hurtTimer--;
        }
        if (self.state == MobState::Dying) {
            if (self.timers.deathTimer > 0) {
                self.timers.deathTimer--;
            }
            self.tick(world, 0.0, 0.0);
            return;
        }

        const dx : f64 = player.pos.x - self.pos.x;
        const dy : f64 = player.pos.y - self.pos.y;
        const dz : f64 = player.pos.z - self.pos.z;
        // 3D distance + an explicit vertical cap: a player flying or standing
        // high overhead is NOT in range, so the creeper won't chase or blow up
        // under an out-of-reach target.
        const dist : f64 = (dx * dx + dy * dy + dz * dz).sqrt();
        const vert : f64 = dy < 0.0 ? 0.0 - dy : dy;
        self.heading = math::atan2(dz, dx);

        // Hostile only toward a survival player who is near our own level. In
        // creative / flight, or too far above/below, the creeper stands down
        // (and any lit fuse is defused below).
        const survival : bool = player.mode == GameMode::Survival;
        const hostile : bool = survival && vert <= Mobs::CREEPER_MAX_VERTICAL;

        if (self.fuse < 0) {
            if (hostile && dist <= Mobs::CREEPER_TRIGGER_DIST) {
                self.fuse = Mobs::CREEPER_FUSE_FRAMES;
                self.tick(world, 0.0, 0.0);
                sfx.creeperFuse(self.pos);
                return;
            }
            if (hostile && dist <= Mobs::CREEPER_CHASE_DIST) {
                const spd : f64 = Mobs::CREEPER_SPEED;
                self.walkPhase += 0.35;
                self.tick(world, self.heading.cos() * spd, self.heading.sin() * spd);
            } else {
                self.tick(world, 0.0, 0.0);
            }
            return;
        }

        // Fuse lit: defuse if the player escaped (3D / vertically) or switched
        // to creative.
        if (!hostile || dist > Mobs::CREEPER_TRIGGER_DIST * 2.4) {
            self.fuse = -1;
            self.tick(world, 0.0, 0.0);
            return;
        }
        self.fuse--;
        self.tick(world, 0.0, 0.0);
        if (self.fuse <= 0) {
            self.explode(world, player, sim);
            sfx.creeperBlast(self.pos);
        }
    }

    /**
     * Detonate: distance-scaled damage to the player and a spherical
     * crater of broken blocks, then mark the creeper for removal. The block
     * edits go through the `VoxelEdit` capability of the same world object the
     * query reads from (narrowed here from the read-only `VoxelQuery` view).
     * @param world   the world (queried for blocks; narrowed to VoxelEdit to crater)
     * @param player  the player to damage by the blast
     * @param sim     the block-update sim woken (fluid / falling) around each broken cell
     */
    fn explode(mut self, world : dyn VoxelQuery, player : Player, sim : BlockSim) : void {
        const dx : f64 = player.pos.x - self.pos.x;
        const dy : f64 = player.pos.y - self.pos.y;
        const dz : f64 = player.pos.z - self.pos.z;
        const d : f64 = (dx * dx + dy * dy + dz * dz).sqrt();
        const reach : f64 = Mobs::CREEPER_BLAST_RADIUS * 2.0;
        if (d < reach) {
            const f : f64 = 1.0 - d / reach;
            const dmg : i32 = (f * (Mobs::CREEPER_DAMAGE as f64)).floorToInt() as i32;
            if (dmg > 0) {
                player.hurt(dmg);
            }
        }

        // The crater writes blocks: run it only when the world exposes the
        // VoxelEdit seam (its provider — ChunkManager — implements both). Narrow
        // a throwaway alias so `world` stays a VoxelQuery for the crater probe.
        let ed : dyn VoxelQuery = world;
        if (ed is VoxelEdit) {
            self.crater(world, ed as VoxelEdit, sim);
        }
        self.state = MobState::Dying;
        self.timers.deathTimer = 0;
    }

    /**
     * Carve the spherical blast crater: break every non-air cell within the
     * blast radius, re-light it, and wake the fluid / falling sim around it.
     * @param query  the world read view (tests which cells are non-air)
     * @param edit   the world write view (breaks + re-lights each crater cell)
     * @param sim    the block-update sim woken around each broken cell
     */
    fn crater(mut self, query : dyn VoxelQuery, edit : dyn VoxelEdit, sim : BlockSim) : void {
        const r : i32 = (Mobs::CREEPER_BLAST_RADIUS).floorToInt() as i32;
        const cx : i32 = self.pos.x.floorToInt() as i32;
        const cy : i32 = self.pos.y.floorToInt() as i32;
        const cz : i32 = self.pos.z.floorToInt() as i32;

        for (ox of (-r)..=r) {
            for (oy of (-r)..=r) {
                for (oz of (-r)..=r) {
                    if (ox * ox + oy * oy + oz * oz <= r * r) {
                        const cell : IVec3 = ivec3(cx + ox, cy + oy, cz + oz);
                        if (query.worldGet(cell) != Block::Air) {
                            edit.breakAt(cell);
                            sim.enqueue6(cell);
                        }
                    }
                }
            }
        }
    }
}
