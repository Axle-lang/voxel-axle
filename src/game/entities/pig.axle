// Pig — a calm pink animal that uses the base wander AI, a touch slower than
// the others.

use smalt::Color;
use crate::engine::entity::mob::Mob;
use crate::engine::entity::model::{ BoxModel, BoxPart };
use crate::engine::math::vec3::{ vec3 };
use crate::configs::atlas::{ Tile };
use crate::configs::mobs::{ MobKind, Mobs };

class Pig : Mob {
    /**
     * Create a pig at (x, y, z).
     * @param x  the spawn x coordinate, in world space
     * @param y  the spawn y coordinate (feet), in world space
     * @param z  the spawn z coordinate, in world space
     */
    constructor(x : f64, y : f64, z : f64) {
        super(x, y, z, MobKind::Pig, Mobs::PIG_HP);
        self.speed = Mobs::PIG_SPEED;
        self.height = 0.9;
    }

    /**
     * Four legs, the body, the head and the snout; diagonal legs swing together.
     * @param out  the model to append the boxes to
     */
    fn buildModel(self, out : BoxModel) : void {
        const sw : f64 = self.walkPhase.sin() * 0.10;
        const leg : i32 = Color::packBytes(196, 128, 128);
        out.add(BoxPart {
            ctr: vec3(0.0 - 0.20, 0.16, 0.20 + sw),
            half: vec3(0.07, 0.16, 0.07),
            color: leg,
            skinTile: -1,
            faceTile: -1,
        });
        out.add(BoxPart {
            ctr: vec3(0.20, 0.16, 0.20 - sw),
            half: vec3(0.07, 0.16, 0.07),
            color: leg,
            skinTile: -1,
            faceTile: -1,
        });
        out.add(BoxPart {
            ctr: vec3(0.0 - 0.20, 0.16, 0.0 - 0.20 - sw),
            half: vec3(0.07, 0.16, 0.07),
            color: leg,
            skinTile: -1,
            faceTile: -1,
        });
        out.add(BoxPart {
            ctr: vec3(0.20, 0.16, 0.0 - 0.20 + sw),
            half: vec3(0.07, 0.16, 0.07),
            color: leg,
            skinTile: -1,
            faceTile: -1,
        });
        out.add(BoxPart {
            ctr: vec3(0.0, 0.46, 0.0),
            half: vec3(0.30, 0.26, 0.42),
            color: Color::packBytes(222, 150, 150),
            skinTile: Tile::PIG_BODY,
            faceTile: Tile::PIG_BODY,
        });
        out.add(BoxPart {
            ctr: vec3(0.0, 0.50, 0.48),
            half: vec3(0.18, 0.17, 0.16),
            color: Color::packBytes(226, 156, 156),
            skinTile: Tile::PIG_BODY,
            faceTile: Tile::PIG_HEAD,
        });
        out.add(BoxPart {
            ctr: vec3(0.0, 0.47, 0.64),
            half: vec3(0.08, 0.07, 0.05),
            color: Color::packBytes(232, 170, 170),
            skinTile: -1,
            faceTile: -1,
        });
    }
}
