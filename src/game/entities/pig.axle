// Pig — a calm pink animal that uses the base wander AI, a touch slower than
// the others.

use crate::kernel::kentity::mob::Mob;
use crate::configs::mobs::{ MobKind, Mobs };

class Pig : Mob {
    /** Create a pig at (x, y, z). */
    constructor(x : f64, y : f64, z : f64) {
        super(x, y, z, MobKind::Pig, Mobs::PIG_HP);
        self.speed = Mobs::PIG_SPEED;
        self.height = 0.9;
    }
}
