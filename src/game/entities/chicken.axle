// Chicken — small, light, flutters down slowly. Uses the base wander AI.

use crate::kernel::kentity::mob::Mob;
use crate::configs::mobs::{ MobKind, Mobs };

class Chicken : Mob {
    /**
     * Create a chicken at (x, y, z).
     * @param x  the spawn x coordinate, in world space
     * @param y  the spawn y coordinate (feet), in world space
     * @param z  the spawn z coordinate, in world space
     */
    constructor(x : f64, y : f64, z : f64) {
        super(x, y, z, MobKind::Chicken, Mobs::CHICKEN_HP);
        self.gravityScale = Mobs::CHICKEN_GRAVITY_SCALE;
        self.height = 0.6;
    }
}
