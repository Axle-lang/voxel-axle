// controls — the key and mouse state of one frame, read into what the player
// is ASKING for.
//
// The loop used to carry the answers as eight loose locals — two axes, three
// held keys, a latch, a swallow flag, an edge flag — computed inline between
// the pause check and the physics. They are not eight things: they are one
// frame's intent, and the simulation wants it as one value it can hold across
// however many fixed steps that frame turns out to be.
//
// Two of them have to survive the frame, and they are handed back rather than
// hidden here: the sprint LATCH (sprint stays on while you keep moving, so
// releasing Ctrl does not stop the run — only releasing the movement keys
// does), and the mouse-grab swallow (the frame after a grab carries the warp
// to the middle of the window, which is motion the player did not make).

use smalt::{Events, Scancode};
use crate::kernel::kio::input::Keys;
use crate::kernel::kentity::player::Player;
use crate::configs::hud::{ Hotbar };
use crate::configs::motion::{ Motion };

/**
 * One frame's movement intent, constant across the fixed steps it drives:
 * the two axes, the three held modifiers, and whether any of it amounts to
 * moving (which the footstep cadence keys off).
 */
struct Intent {
    pub(crate) fwd : f64,
    pub(crate) strafe : f64,
    pub(crate) sprint : bool,
    pub(crate) up : bool,
    pub(crate) down : bool,
    pub(crate) moving : bool,
}

/**
 * Read two keys as a -1/0/+1 movement axis.
 *
 * The keys are physical positions, so `Keys::forward()` is the key above
 * `Keys::back()` on every layout — a WASD binding on an AZERTY board lands
 * under the same three fingers.
 * @param events the pump holding the current key state
 * @param plus   the key that contributes +1 when held
 * @param minus  the key that contributes -1 when held
 * @return the combined axis value (-1.0, 0.0, or 1.0)
 */
fn axis(events : Events, plus : Scancode, minus : Scancode) : f64 {
    let v : f64 = 0.0;
    if (events.isKeyDown(plus)) {
        v = v + 1.0;
    }
    if (events.isKeyDown(minus)) {
        v = v - 1.0;
    }
    return v;
}

/**
 * Read this frame's movement intent off the key state.
 * @param events   the pump holding the current key state
 * @param latched  whether sprint was latched on entering this frame
 * @return the intent, and the sprint latch to carry into the next frame
 */
fn readIntent(events : Events, latched : bool) : (intent: Intent, latch: bool) {
    let fwd : f64 = axis(events, Keys::forward(), Keys::back());
    let strafe : f64 = axis(events, Keys::right(), Keys::left());
    let latch : bool = latched;
    if (events.isKeyDown(Keys::sprint())) {
        latch = true;
    }
    if (fwd == 0.0 && strafe == 0.0) {
        latch = false;
    }
    return (Intent {
        fwd: fwd,
        strafe: strafe,
        sprint: latch,
        up: events.isKeyDown(Keys::up()),
        down: events.isKeyDown(Keys::down()),
        moving: fwd != 0.0 || strafe != 0.0,
    }, latch);
}

/**
 * Turn the view by this frame's mouse motion, unless the view is pinned for a
 * scripted capture.
 * @param events   the pump holding the mouse delta
 * @param p        the player to aim
 * @param swallow  whether this frame's delta is the grab's own warp
 * @param pinned   whether `--look` fixed the view for the run
 * @return the swallow flag for the next frame
 */
fn applyLook(events : Events, p : Player, swallow : bool, pinned : bool) : bool {
    let mdx : i32 = events.mouseDX();
    let mdy : i32 = events.mouseDY();
    if (swallow) {
        return false;
    }
    if (!pinned) {
        p.look(0.0 - (mdx as f64) * Motion::MOUSE_SENS, 0.0 - (mdy as f64) * Motion::MOUSE_SENS);
    }
    return false;
}

/**
 * Select a hotbar slot from the number row.
 * @param events  the pump holding the current key state
 * @param p       the player whose held block changes
 */
fn readHotbar(events : Events, p : Player) : void {
    let slot : i32 = 0;
    while (slot < Hotbar::SIZE) {
        if (events.isKeyDown(Keys::hotbar(slot))) {
            p.selectSlot(slot);
        }
        slot = slot + 1;
    }
}

/**
 * F3 + F4 together toggles survival ↔ creative, on the edge — the mode is a
 * badge on the HUD, and holding both keys must not flip it sixty times a
 * second.
 * @param events   the pump holding the current key state
 * @param p        the player whose mode toggles
 * @param wasBoth  whether both keys were down last frame
 * @return whether both keys are down now
 */
fn readGameMode(events : Events, p : Player, wasBoth : bool) : bool {
    let both : bool = events.isKeyDown(Keys::gameModeA()) && events.isKeyDown(Keys::gameModeB());
    if (both && !wasBoth) {
        p.toggleGameMode();
    }
    return both;
}
