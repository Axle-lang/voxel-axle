// sfx — the game's audio orchestrator. Owns the single software Mixer and every
// sound bank, and exposes semantic play methods. Positional sounds (a mob's
// voice, a dug block, the creeper's fuse / blast) carry their WORLD POSITION and
// an audible range; the mixer attenuates them live against the listener set each
// frame via `setListener`, so a sound fades as the player walks away — even
// mid-playback. The player's own sounds (footstep, hurt, splash, ambience) are
// non-positional and play at a fixed gain.
//
// `pump()` must be called once per frame to feed the device. Footsteps and digs
// are grouped by material into one bank each (random variant per call); ice with
// no footfall clip and any other gap fall back to stone. Clips live under
// `assets/sounds/` (next to the binary or one dir up — the prefix is resolved once).
// Missing files are silent.

use sdl_platform::{Mixer, SoundBank};
use sdl_platform::fileExists;
use crate::world::blocks::materialOf;
use crate::vec3::{ Vec3, IVec3 };
use crate::config;
use crate::config::{ Block, AudioMaterial, MobKind };

/**
 * The material with bank index `i` (inverse of the enum discriminant), used to
 * walk the materials 0..matCount when loading banks.
 * @param i  the bank index
 * @return the corresponding material
 */
fn materialAt(i : i32) : AudioMaterial {
    return match i {
        0 => AudioMaterial::Grass,
        1 => AudioMaterial::Sand,
        2 => AudioMaterial::Gravel,
        3 => AudioMaterial::Snow,
        4 => AudioMaterial::Stone,
        5 => AudioMaterial::Wood,
        6 => AudioMaterial::Foliage,
        _ => AudioMaterial::Glass,
    };
}

/**
 * Folder name under `step/` and `dig/` for material `m`.
 * @param m  the material
 * @return the material's folder name
 */
fn matFolder(m : AudioMaterial) : string {
    return match m {
        AudioMaterial::Grass => "grass",
        AudioMaterial::Sand => "sand",
        AudioMaterial::Gravel => "gravel",
        AudioMaterial::Snow => "snow",
        AudioMaterial::Stone => "stone",
        AudioMaterial::Wood => "wood",
        AudioMaterial::Foliage => "foliage",
        AudioMaterial::Glass => "glass",
    };
}

class AudioManager {
    mixer : Mixer,
    lock : AtomicBoolean,    // spinlock guarding the mixer between the main
                             // thread (play / setListener) and the audio thread
                             // (pump) — see audioLoop. AtomicBoolean is the only
                             // std lock primitive with a usable constructor.
    running : AtomicBoolean, // false tells the audio thread to exit (on quit)
    base : string,
    footstepBanks : SoundBank[],
    digBanks : SoundBank[],
    chickenSayBank : SoundBank,
    chickenHurtBank : SoundBank,
    cowSayBank : SoundBank,
    cowHurtBank : SoundBank,
    sheepSayBank : SoundBank,
    pigSayBank : SoundBank,
    playerHurtBank : SoundBank,
    splashBank : SoundBank,
    ambientUWBank : SoundBank,
    creeperChargeBank : SoundBank,
    creeperBlastBank : SoundBank,

    /** Open the mixer, resolve the sounds/ prefix and load every bank. */
    constructor() {
        self.mixer = new Mixer();
        self.lock = new AtomicBoolean(false);
        self.running = new AtomicBoolean(true);
        self.base = "assets/sounds/";
        if (!fileExists("assets/sounds/step/grass/1.wav")) {
            self.base = "../assets/sounds/";
        }

        // Per-material footstep + dig banks (variants auto-discovered 1..8).
        self.footstepBanks = malloc<SoundBank>(config::matCount);
        self.digBanks = malloc<SoundBank>(config::matCount);
        let m : i32 = 0;
        while (m < config::matCount) {
            let mat : AudioMaterial = materialAt(m);
            let fb : SoundBank = new SoundBank(8);
            self.loadDir(fb, "step/" + matFolder(mat));
            self.footstepBanks[m] = fb;
            let db : SoundBank = new SoundBank(8);
            self.loadDir(db, "dig/" + matFolder(mat));
            self.digBanks[m] = db;
            m = m + 1;
        }

        self.chickenSayBank = self.bankFrom("mob/chicken/say");
        self.chickenHurtBank = self.bankFrom("mob/chicken/hurt");
        self.cowSayBank = self.bankFrom("mob/cow/say");
        self.cowHurtBank = self.bankFrom("mob/cow/hurt");
        self.sheepSayBank = self.bankFrom("mob/sheep/say");
        self.pigSayBank = self.bankFrom("mob/pig/say");
        self.playerHurtBank = self.bankFrom("player/hurt");
        self.splashBank = self.bankFrom("player/splash");
        self.ambientUWBank = self.bankFrom("ambient/underwater");

        // The creeper's charge / blast are single bespoke files (not numbered
        // variant folders), so load them directly.
        self.creeperChargeBank = new SoundBank(1);
        self.creeperChargeBank.add(self.base + "mob/creeper/charge.wav");
        self.creeperBlastBank = new SoundBank(1);
        self.creeperBlastBank.add(self.base + "mob/creeper/exploded.wav");
    }

    /**
     * Add variants `1.wav`..`8.wav` from `<base><rel>/` to `bank` (missing
     * files are skipped silently).
     * @param bank  the bank to fill
     * @param rel   the folder, relative to the sounds prefix
     */
    fn loadDir(self, bank : SoundBank, rel : string) : void {
        let i : i32 = 1;
        while (i <= 8) {
            bank.add(self.base + rel + "/" + i + ".wav");
            i = i + 1;
        }
    }

    /**
     * A fresh bank filled from the folder `rel` (variants `1.wav`..`8.wav`).
     * @param rel  the folder, relative to the sounds prefix
     * @return the loaded bank
     */
    fn bankFrom(self, rel : string) : SoundBank {
        let b : SoundBank = new SoundBank(8);
        self.loadDir(b, rel);
        return b;
    }

    /**
     * Set the listener (player) position for live distance attenuation.
     * @param x  listener x
     * @param y  listener y
     * @param z  listener z
     */
    fn setListener(self, x : f64, y : f64, z : f64) : void {
        self.acquire();
        self.mixer.setListener(x, y, z);
        self.release();
    }

    /** Spin until this thread owns the mixer lock (short critical sections). */
    fn acquire(self) : void {
        while (!self.lock.compareAndSet(false, true)) {
        }
    }

    /** Release the mixer lock. */
    fn release(self) : void {
        self.lock.set(false);
    }

    /**
     * Top up the audio device queue under the lock. Called by the dedicated
     * audio thread (audioLoop), NOT per frame — so a slow render/bake frame can
     * no longer starve the queue and make the sound stutter.
     */
    fn pumpTick(self) : void {
        self.acquire();
        self.mixer.pump();
        self.release();
    }

    /** Signal the audio thread to stop (call before joining it on quit). */
    fn stop(self) : void {
        self.running.set(false);
    }

    /** Whether the audio thread should keep running. */
    fn isRunning(self) : bool {
        return self.running.get();
    }

    /**
     * Footstep for the block underfoot (the listener's own step, fixed gain).
     * @param blockId  the block stepped on
     * @param rnd      variant selector in [0, 1)
     */
    fn footstep(self, blockId : Block, rnd : f64) : void {
        let mat : AudioMaterial = materialOf(blockId);
        let bank : SoundBank = self.footstepBanks[mat as i32];
        if (!bank.loaded()) {
            bank = self.footstepBanks[AudioMaterial::Stone as i32];
        }
        self.acquire();
        bank.playRand(self.mixer, rnd, config::volFootstep);
        self.release();
    }

    /**
     * Dig / place sound at a block, attenuated live by distance.
     * @param blockId  the block broken or placed
     * @param cell     the block cell
     * @param rnd      variant selector in [0, 1)
     */
    fn blockEdit(self, blockId : Block, cell : IVec3, rnd : f64) : void {
        let mat : AudioMaterial = materialOf(blockId);
        let bank : SoundBank = self.digBanks[mat as i32];
        if (!bank.loaded()) {
            bank = self.digBanks[AudioMaterial::Stone as i32];
        }
        self.acquire();
        bank.playRandPos(self.mixer, rnd, config::volBreak,
            (cell.x as f64) + 0.5, (cell.y as f64) + 0.5, (cell.z as f64) + 0.5, config::sndBreakDist);
        self.release();
    }

    /**
     * A mob's idle voice at its world position, attenuated live by distance.
     * @param kind  the mob kind
     * @param pos   the source position
     * @param rnd   variant selector in [0, 1)
     */
    fn mobSay(self, kind : MobKind, pos : Vec3, rnd : f64) : void {
        let x : f64 = pos.x;
        let y : f64 = pos.y;
        let z : f64 = pos.z;
        self.acquire();
        match kind {
            MobKind::Chicken => {
                self.chickenSayBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
            MobKind::Cow => {
                self.cowSayBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
            MobKind::Sheep => {
                self.sheepSayBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
            MobKind::Pig => {
                self.pigSayBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
            // The creeper has no idle voice (only its fuse / blast).
            _ => {}
        }
        self.release();
    }

    /**
     * A mob's hurt cry at its world position. Species without a dedicated clip
     * fall back to the generic impact (player hurt) sound.
     * @param kind  the mob kind
     * @param pos   the source position
     * @param rnd   variant selector in [0, 1)
     */
    fn mobHurt(self, kind : MobKind, pos : Vec3, rnd : f64) : void {
        let x : f64 = pos.x;
        let y : f64 = pos.y;
        let z : f64 = pos.z;
        self.acquire();
        match kind {
            MobKind::Chicken => {
                self.chickenHurtBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
            MobKind::Cow => {
                self.cowHurtBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
            // Species without a dedicated clip fall back to the generic impact.
            _ => {
                self.playerHurtBank.playRandPos(self.mixer, rnd, config::volMob, x, y, z, config::sndMobDist);
            }
        }
        self.release();
    }

    /**
     * The player taking damage (non-positional).
     * @param rnd  variant selector in [0, 1)
     */
    fn playerHurt(self, rnd : f64) : void {
        self.acquire();
        self.playerHurtBank.playRand(self.mixer, rnd, config::volPlayer);
        self.release();
    }

    /**
     * A splash as the player enters water (non-positional).
     * @param rnd  variant selector in [0, 1)
     */
    fn splash(self, rnd : f64) : void {
        self.acquire();
        self.splashBank.playRand(self.mixer, rnd, config::volPlayer);
        self.release();
    }

    /**
     * A soft underwater ambience while submerged (non-positional).
     * @param rnd  variant selector in [0, 1)
     */
    fn ambientUnderwater(self, rnd : f64) : void {
        self.acquire();
        self.ambientUWBank.playRand(self.mixer, rnd, config::volAmbient);
        self.release();
    }

    /**
     * The creeper lighting its fuse, attenuated live by distance.
     * @param pos  the creeper position
     */
    fn creeperFuse(self, pos : Vec3) : void {
        self.acquire();
        self.creeperChargeBank.playRandPos(self.mixer, 0.0, config::volCreeper, pos.x, pos.y, pos.z, config::sndCreeperDist);
        self.release();
    }

    /**
     * The creeper detonating, attenuated live by distance.
     * @param pos  the creeper position
     */
    fn creeperBlast(self, pos : Vec3) : void {
        self.acquire();
        self.creeperBlastBank.playRandPos(self.mixer, 0.0, config::volCreeper, pos.x, pos.y, pos.z, config::sndCreeperDist);
        self.release();
    }
}

/**
 * The audio thread body: top up the device queue continuously, decoupled from
 * the frame loop, so heavy render/light-bake frames can't starve the sound. Runs
 * on its own OS thread (spawned in main); exits when the manager is stopped.
 * @param sfx  the audio manager to pump
 * @return 0 (Task result unused)
 */
fn audioLoop(sfx : AudioManager) : i32 {
    while (sfx.isRunning()) {
        sfx.pumpTick();
        System::sleep(4);
    }
    return 0;
}
