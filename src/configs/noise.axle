// configs::noise — terrain noise (Minecraft-ish: warp + continentalness) and
// the integer seed for the lattice hash. Temperature/humidity drive the
// biome selector (see world::biomes::registry).

const seedI : i32 = 1337;       // integer seed for the lattice hash
const warpScale : f64 = 0.011;
const contScale : f64 = 0.0050;   // larger continents / oceans
const hillScale : f64 = 0.032;
// Climate varies slowly over large distances (like latitude), so biome zones
// are big and gradual: extremes (desert vs snow) are always separated by
// temperate buffers instead of sitting side by side. Lowered so biomes are
// substantially LARGER (≈2× the zone size) and transitions are broader — fewer
// abrupt borders, more coherent regions you travel through.
const tempScale : f64 = 0.0013;
const humidScale : f64 = 0.0018;
// Land vs ocean split on continentalness, and how fast terrain cools with
// altitude (so high ground turns to taiga / snow / bare peaks).
const oceanLevel : f64 = 0.34;
const altitudeCooling : f64 = 0.0065;

// ── Erosion + peaks/valleys (Minecraft 1.21-style terrain shaping) ──
// erosion: low = rugged/mountainous (tall, jagged), high = flat/eroded
// (plains, plateaus). weirdness drives a RIDGED "peaks & valleys" field that
// carves ridgelines and valleys. Both vary slowly (low frequency) so relief is
// coherent over large regions instead of uniform bumpiness.
const erosionScale : f64 = 0.0026;
const weirdScale : f64 = 0.0090;
// Snow-cover variation frequency: how quickly the snow-layer depth drifts across
// cold ground (higher = patchier).
const snowScale : f64 = 0.16;
