// configs::hud — inventory hotbar layout (keys 1–9).

/** Inventory hotbar layout (keys 1-9). */
class Hotbar {
    static SIZE : i32 = 9;  // number of slots (keys 1–9)
    static CELL : i32 = 22; // slot size in framebuffer pixels
    static PAD : i32 = 3;   // padding inside the panel / between cells
}
