// configs::light — the block-light engine (torches) tunables.
//
// Torches flood a 0..15 light level outward (blocked by opaque blocks); the
// mesher bakes the per-face level and the renderer adds a warm boost to the
// face brightness for each unit of light. Sky-light and day/night come later.

/** The block-light engine, ambient occlusion, sky access and the colour bounce. */
class Light {
    static QUEUE_CAP : i32 = 65536;   // flood-fill stack capacity (cells)

    // Face brightness vs. baked light level (0..15) follows an EXPONENTIAL falloff
    // (Minecraft-style): each level down multiplies brightness by `Light::FALLOFF`, so
    // light dies fast with distance — and since the flood loses one level per block
    // travelled, a longer/zig-zag path goes much darker.
    //
    // `Light::MIN` is the darkness floor: what a surface reflects with NO light
    // reaching it at all. It exists so a sealed cave is navigable rather than a
    // black screen, and it is linear light, so it wants to be small — 0.006 is
    // about a twentieth of the display range once encoded, which reads as
    // "almost black" rather than as "dim".
    static MIN : f64 = 0.006;
    static FALLOFF : f64 = 0.80;

    // A block light's colour is no longer a constant here: it is the per-channel
    // emission level in `blocks::emissionOf`, which floods the world as three
    // volumes. See `krender::cornerlight`.
    //
    // What is left is how bright the FLAME ITSELF is drawn — a source is not lit
    // by the room, it lights it. Above 1 so it comes through the tone map's
    // shoulder as a highlight and the bloom picks it up.
    static TORCH_GLOW : f64 = 1.9;

    // Ambient occlusion strength for smooth lighting: how much a fully-occluded
    // face corner (AO level 0) is darkened. 0 = no AO, 1 = corner goes black at the
    // deepest seams. The bake stores 0..3 per corner; the renderer maps it to
    // 1 - `Light::AO_STRENGTH`·(3-ao)/3. It scales LINEAR light, so it takes a
    // larger number than it did to darken a seam by the same amount on screen.
    static AO_STRENGTH : f64 = 0.75;

    // Warm sun / cool shade — the heart of the "sunny" feel. Direct sunlight tints
    // surfaces a warm gold; the ambient / shadow side cools to a soft blue, like
    // skylight. The renderer blends between these by how directly a corner faces the
    // sun (and by daylight, so night stays neutral-blue moonlight). Multipliers
    // around 1.0 per channel.
    static SUN_TINT_R : f64 = 1.16;   // warm gold for full sun …
    static SUN_TINT_G : f64 = 1.04;
    static SUN_TINT_B : f64 = 0.78;
    static SHADE_TINT_R : f64 = 0.74; // … cool blue for shade / ambient
    static SHADE_TINT_G : f64 = 0.86;
    static SHADE_TINT_B : f64 = 1.32;

    // Hemispherical sky-access (ray-traced ambient occlusion / soft GI). Each open
    // cell casts `Light::SKY_AO_SAMPLES` rays over the upper hemisphere (up to `Light::SKY_AO_REACH`
    // blocks); the escaped fraction darkens the ambient SKY light at render —
    // contact shadows in valleys, corners and under canopy. Baked & amortised
    // (`Light::SKY_AO_CHUNKS_PER_TICK` chunks/frame, once per chunk; static, no re-bake until an
    // edit). `Light::AO_SKY_MIN` is the darkest the sky term drops to at zero access.
    static SKY_AO_SAMPLES : i32 = 10;
    static SKY_AO_REACH : f64 = 14.0;
    static SKY_AO_CHUNKS_PER_TICK : i32 = 3;
    static AO_SKY_MIN : f64 = 0.18;

    // One-bounce coloured indirect light (GI tint): the sky-AO rays that hit a
    // surface sample its albedo, so ambient bleeds the nearby colour (green under
    // canopy, warm by sand/wood). Hue-only (brightness stays the sky-AO's job).
    static BOUNCE_ON : bool = true;
    static BOUNCE_STRENGTH : f64 = 0.5;   // how strongly surrounding colour tints ambient (0 = off)
}
