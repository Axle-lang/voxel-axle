// configs::biomes — the biome id enum (Minecraft-inspired). The climate
// selector `game::world::biomes::biomeAt` maps temperature/humidity/height to
// one of these, and one `BiomeDef` row per id carries the parameters.

/**
 * The lightweight biome tag; `game::world::biomes::BiomeDef` holds the
 * behaviour. The backing i32 discriminants follow declaration order.
 */
enum BiomeId : i32 {
    Ocean,
    Beach,
    Plains,
    Forest,
    Desert,
    Savanna,
    Snowy,
    Mountain,
    Taiga,
    Jungle,
    Swamp,
    Badlands,
    BirchForest,
    FrozenOcean,
    BambooJungle,
    CherryGrove,
    MushroomFields,
}
