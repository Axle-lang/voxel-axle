// configs::screen — window size, framebuffer size and the camera projection.
//
// The window is `Screen::WINDOW_W × Screen::WINDOW_H`; the world is rasterised into a smaller
// `Screen::RENDER_W × Screen::RENDER_H` framebuffer the blit upscales to the window. Fewer
// pixels to fill is the main per-frame speed lever — the projection constants
// (`Screen::HALF_W/Screen::HALF_H/Screen::FOCAL`) match the RENDER size.

/** Window size, framebuffer size and the camera projection. */
class Screen {
    static WINDOW_W : i32 = 960;
    static WINDOW_H : i32 = 600;
    static RENDER_W : i32 = 960;
    static RENDER_H : i32 = 600;
    static HALF_W : f64 = 480.0;
    static HALF_H : f64 = 300.0;
    static FOCAL : f64 = 495.0;   // wider FOV (~62° vert) — less "zoomed" than 373
    static NEAR_PLANE : f64 = 0.12;
}
