// configs::health — player hit points, fall / drown damage and regeneration.
//
// Fall damage is distance-based (the descent is constant-speed, so landing
// speed no longer encodes the drop height).

/** Hit points, fall and drowning damage, and regeneration. */
class Health {
    static PLAYER_MAX_HP : i32 = 20;
    static SAFE_FALL_DIST : f64 = 4.0;        // blocks fallen before it hurts
    static FALL_DAMAGE_PER_BLOCK : f64 = 1.5; // hp per block beyond the safe distance
    static DROWN_GRACE_FRAMES : i32 = 180;    // ~3 s of breath
    static DROWN_EVERY_FRAMES : i32 = 18;     // lose 1 hp per this many frames
    static REGEN_DELAY_FRAMES : i32 = 420;    // ~7 s without damage before regen
    static REGEN_EVERY_FRAMES : i32 = 90;     // +1 hp per this many frames
}
