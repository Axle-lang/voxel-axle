// configs::trees — tree kinds stamped by `game::world::treegen`. A biome picks
// one kind (and a per-biome trunk height; see `BiomeDef.treeHt`).

/** The kind of tree (if any) a biome stamps. `None` is the no-tree case. */
enum TreeKind : i32 {
    None,
    Oak,
    Birch,
    Spruce,
    Acacia,
    Jungle,
    Cactus,
    Bamboo,
    Cherry,
    RedMushroom,
    BrownMushroom,
}

/** Tree placement tuning shared by every biome. */
class Trees {
    // Global thinning applied to every biome's tree threshold (0 = as authored,
    // →1 = no trees). Raises each threshold toward 1 proportionally, so forests
    // stay forests but woods are airier and less cluttered.
    static THIN : f64 = 0.6;
}
