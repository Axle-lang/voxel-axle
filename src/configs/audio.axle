// configs::audio — step/dig material ids, audible ranges, per-channel master
// volumes and the timing of footsteps / mob voices / ambience. The audio
// engine (`kio::sfx`) reads everything here; `kblock::blocks::materialOf` maps a
// block id to one of the `AudioMaterial` variants below.

/**
 * How a block sounds underfoot and when dug — one bank of footstep / dig
 * clips per variant. The discriminants ARE the bank index in `kio::sfx`, so
 * the order here matches the order the folders are loaded in.
 */
enum AudioMaterial : i32 {
    Grass,
    Sand,
    Gravel,
    Snow,
    Stone,
    Wood,
    Foliage, // leaves — soft "cloth" footfall
    Glass,   // ice digs with a glassy crack
}

/** Audible ranges, per-channel volumes, and the cadence of footsteps, voices and ambience. */
class Audio {
    static MATERIAL_COUNT : i32 = 8;

    // ── Audible ranges (blocks): a positional sound fades to silence here ──
    static MOB_DIST : f64 = 26.0;
    static CREEPER_DIST : f64 = 32.0;
    static BREAK_DIST : f64 = 24.0;

    // ── Per-channel master volume (0..1, scales the distance attenuation) ──
    static VOL_FOOTSTEP : f64 = 0.45;
    static VOL_BREAK : f64 = 0.70;
    static VOL_MOB : f64 = 0.75;
    static VOL_CREEPER : f64 = 1.0;
    static VOL_PLAYER : f64 = 0.85;
    static VOL_AMBIENT : f64 = 0.55;

    // ── Timing ──────────────────────────────────────────────────
    static FOOT_WALK_FRAMES : i32 = 18;   // frames between footfalls when walking
    static FOOT_SPRINT_FRAMES : i32 = 12; // …when sprinting
    static MOB_VOCAL_MIN : i32 = 150;     // min frames between a mob's idle voices
    static MOB_VOCAL_RAND : i32 = 360;    // extra random spread on top of the min
    static AMBIENT_MIN : i32 = 220;       // min frames between underwater ambiences
    static AMBIENT_RAND : i32 = 300;
}
