// configs::atlas — texture atlas geometry and the per-tile indices.
//
// The atlas is a vertical strip of square tiles. The first `Atlas::BLOCK_TILES` tiles
// are block faces; any tiles above that are mob skins. Bump `Atlas::TILE_COUNT` (and
// the embedded hex in bake_atlas.py) when you add mob textures, then flip
// `Atlas::USE_MOB_TEXTURES` on. The `Tile` indices MIRROR THE ORDER IN `bake_atlas.py`
// EXACTLY — keep them in sync.

/** Texture atlas geometry: tile size, tile counts, and the mip / filter settings. */
class Atlas {
    static TILE_PX : i32 = 128;
    static BLOCK_TILES : i32 = 81;
    static TILE_COUNT : i32 = 94;
    static USE_MOB_TEXTURES : bool = true;
    // Mip chain depth (64 → 32 → … → 1 = 7 levels). Distant faces sample a
    // coarser, pre-averaged level so textures don't shimmer when moving.
    static MIP_LEVELS : i32 = 8;
    // Texture filtering: the rasteriser picks the mip from the LESS compressed
    // screen axis and averages `Atlas::MAX_ANISO` taps along the MORE compressed one
    // (anisotropic filtering) — this is what keeps oblique distant ground crisp
    // instead of a blurry mush. `Atlas::MIP_BIAS` < 1 sharpens (delays the mip step);
    // lower = sharper but more shimmer.
    static MAX_ANISO : i32 = 8;
    static MIP_BIAS : f64 = 0.5;
}

/** The atlas index of every tile, in the order `bake_atlas.py` writes them. */
class Tile {
    // ── Block tiles (0 .. Atlas::BLOCK_TILES-1) ─────────────────
    static GRASS_TOP : i32 = 0;
    static GRASS_SIDE : i32 = 1;
    static DIRT : i32 = 2;
    static COARSE_DIRT : i32 = 3;
    static PODZOL_TOP : i32 = 4;
    static PODZOL_SIDE : i32 = 5;
    static MYCELIUM_TOP : i32 = 6;
    static MYCELIUM_SIDE : i32 = 7;
    static SAND : i32 = 8;
    static RED_SAND : i32 = 9;
    static GRAVEL : i32 = 10;
    static CLAY : i32 = 11;
    static SNOW : i32 = 12;
    static ICE : i32 = 13;
    static PACKED_ICE : i32 = 14;
    static STONE : i32 = 15;
    static COBBLE : i32 = 16;
    static MOSSY_COBBLE : i32 = 17;
    static GRANITE : i32 = 18;
    static DIORITE : i32 = 19;
    static ANDESITE : i32 = 20;
    static STONE_BRICKS : i32 = 21;
    static BRICKS : i32 = 22;
    static SANDSTONE_TOP : i32 = 23;
    static SANDSTONE_SIDE : i32 = 24;
    static SANDSTONE_BOTTOM : i32 = 25;
    static RED_SANDSTONE_TOP : i32 = 26;
    static RED_SANDSTONE_SIDE : i32 = 27;
    static TERRACOTTA : i32 = 28;
    static TERRACOTTA_ORANGE : i32 = 29;
    static TERRACOTTA_WHITE : i32 = 30;
    static OAK_LOG_SIDE : i32 = 31;
    static OAK_LOG_TOP : i32 = 32;
    static OAK_LEAVES : i32 = 33;
    static PLANKS : i32 = 34;
    static BIRCH_LOG_SIDE : i32 = 35;
    static BIRCH_LOG_TOP : i32 = 36;
    static BIRCH_LEAVES : i32 = 37;
    static SPRUCE_LOG_SIDE : i32 = 38;
    static SPRUCE_LOG_TOP : i32 = 39;
    static SPRUCE_LEAVES : i32 = 40;
    static ACACIA_LOG_SIDE : i32 = 41;
    static ACACIA_LOG_TOP : i32 = 42;
    static ACACIA_LEAVES : i32 = 43;
    static JUNGLE_LOG_SIDE : i32 = 44;
    static JUNGLE_LOG_TOP : i32 = 45;
    static JUNGLE_LEAVES : i32 = 46;
    static DARK_OAK_LOG_SIDE : i32 = 47;
    static DARK_OAK_LOG_TOP : i32 = 48;
    static DARK_OAK_LEAVES : i32 = 49;
    static CACTUS_SIDE : i32 = 50;
    static CACTUS_TOP : i32 = 51;
    static PUMPKIN_SIDE : i32 = 52;
    static PUMPKIN_TOP : i32 = 53;
    static MELON_SIDE : i32 = 54;
    static MELON_TOP : i32 = 55;
    static GLOWSTONE : i32 = 56;
    static WATER : i32 = 57;
    static COAL_ORE : i32 = 58;
    static IRON_ORE : i32 = 59;
    static GOLD_ORE : i32 = 60;
    static DIAMOND_ORE : i32 = 61;
    static REDSTONE_ORE : i32 = 62;
    static EMERALD_ORE : i32 = 63;
    static LAPIS_ORE : i32 = 64;
    static GRASS_TOP_SAVANNA : i32 = 65;
    static GRASS_SIDE_SAVANNA : i32 = 66;
    static GRASS_TOP_JUNGLE : i32 = 67;
    static GRASS_SIDE_JUNGLE : i32 = 68;
    static GRASS_TOP_SWAMP : i32 = 69;
    static GRASS_SIDE_SWAMP : i32 = 70;
    static GRASS_TOP_TAIGA : i32 = 71;
    static GRASS_SIDE_TAIGA : i32 = 72;

    // ── Expansion blocks: bamboo, cherry, giant mushrooms ───────
    static BAMBOO_SIDE : i32 = 73;
    static BAMBOO_TOP : i32 = 74;
    static CHERRY_LOG_SIDE : i32 = 75;
    static CHERRY_LOG_TOP : i32 = 76;
    static CHERRY_LEAVES : i32 = 77;
    static MUSHROOM_STEM : i32 = 78;
    static RED_MUSHROOM : i32 = 79;
    static BROWN_MUSHROOM : i32 = 80;

    // ── Mob tiles (after the block tiles) ───────────────────────
    static CHICKEN_BODY : i32 = 81;
    static CHICKEN_HEAD : i32 = 82;
    static SHEEP_WOOL : i32 = 83;
    static SHEEP_HEAD : i32 = 84;
    static COW_BODY : i32 = 85;
    static COW_HEAD : i32 = 86;
    static CREEPER_SKIN : i32 = 87;
    static CREEPER_FACE : i32 = 88;
    static CHARGE_SKIN : i32 = 89;
    static CHARGE_FACE : i32 = 90;
    static PIG_BODY : i32 = 91;
    static PIG_HEAD : i32 = 92;

    // ── Decoration tiles ────────────────────────────────────────
    static TORCH : i32 = 93;
}
