// configs::time — the day/night cycle.
//
// dayTime runs 0..1 over a full day (0 = midnight, 0.25 = sunrise, 0.5 = noon,
// 0.75 = sunset). A daylight factor scales SKY light at render time (so night
// darkens without re-meshing — block/torch light is unaffected), the sun
// direction drives the directional face shading, and the sky/fog colour
// interpolates night → dusk → day.

/** The day/night cycle: its length, the sun's shadows, and the sky colours. */
class Daylight {
    static LENGTH_TICKS : i32 = 14400; // a full day in fixed ticks (~4 min @ 60 Hz)
    static START : f64 = 0.42;         // start mid-morning
    static SUN_TILT : f64 = 0.35;      // sun's north/south lean (so it's not dead overhead)

    // ── Night ───────────────────────────────────────────────────
    // What the SKY alone gives once the sun is down: starlight, and almost
    // nothing. It replaces a 0.13 floor that was applied to the whole light term,
    // which made night a daylit world turned down — uniform, shadowless, and
    // grey. Night is now dark for the right reason: its light source has set.
    static STARLIGHT : f64 = 0.018;
    // And what the moon casts, as a fraction of full sun. Small, but DIRECTIONAL:
    // it runs through the same Lambert term and the same shadow bake, so a wall
    // facing the moon is lit and the one behind it is not, and a tree still lays
    // a shadow. That is the difference between a night you can read and a night
    // that is merely dim.
    static MOON_STRENGTH : f64 = 0.055;
    // How fast a body reaches full strength as it climbs off the horizon —
    // 1/sin(elevation at full). At 3.2 that is about eighteen degrees, which is
    // roughly how long a real sunrise takes to stop being a sunrise.
    static HORIZON_FADE : f64 = 3.2;

    // ── Directional sun shadows ─────────────────────────────────
    static SUN_SHADOW_REACH : f64 = 40.0; // how far (blocks) a shadow ray probes toward the sun
                                          // (a tree's own shadow is as long as the tree is tall,
                                          // over the tangent of the sun's elevation — 30 cut it off
                                          // at the hours the shadow is worth having)
    static SUN_CHUNKS_PER_TICK : i32 = 32; // chunks whose sun-shadow map is refreshed per pass
                                          // (round-robin → the whole ring refreshes in ~span²/this
                                          // passes, and a cell only moves once per sweep, so the
                                          // sweep's LENGTH is how coarsely the shadow tracks the sun)
    static SUN_SHADOW_SAMPLES : i32 = 6;  // rays per cell over the sun disc (1 = hard, more = softer penumbra)
    // Angular radius of the sun disc the rays spread over, in radians, and the
    // one number that decides whether a shadow has a SHAPE.
    //
    // A penumbra is the disc's angle carried over the distance to whatever casts
    // the shadow: twice the distance times the tangent, so every feature narrower
    // than that is averaged away before it reaches the ground. At 0.085 — some
    // eighteen times the real sun — a shadow fifteen blocks from its caster had a
    // penumbra two and a half blocks wide, which is wider than a tree trunk. That
    // is why the ground carried soft grey blobs with no canopy in them and no
    // trunk shadows at all: the blur was not a soft edge, it was the whole shadow.
    //
    // Four times the real sun instead. Fifteen blocks out the penumbra is six
    // tenths of a block and the shape survives; forty blocks out it is a block and
    // a half, so an edge still softens with distance the way a real one does.
    static SUN_DISC_ANGLE : f64 = 0.020;

    // How far a cell's sun visibility moves toward its freshly measured value on
    // each sweep of the ring. Not 1.0, and that is the whole point: a cell is
    // visited once per sweep, so at 1.0 the shadow holds perfectly still and then
    // JUMPS the whole distance the sun travelled since it was last looked at —
    // a shadow that ticks forward once a sweep instead of moving. Moving a third
    // of the way turns each of those jumps into the start of a fade, and what you
    // see is an edge that softens and re-forms rather than one that hops.
    //
    // It only applies to the tracking sweep. A chunk that has just arrived, or
    // one the player just edited, is written outright — there is nothing to glide
    // from, and a shadow that faded in over two seconds would be its own bug.
    static SUN_GLIDE : f64 = 0.34;

    // Sky colours interpolated across the day.
    static DAY_SKY_R : i32 = 150;
    static DAY_SKY_G : i32 = 198;
    static DAY_SKY_B : i32 = 240;
    static NIGHT_SKY_R : i32 = 12;
    static NIGHT_SKY_G : i32 = 16;
    static NIGHT_SKY_B : i32 = 40;
    static DUSK_SKY_R : i32 = 235;
    static DUSK_SKY_G : i32 = 128;
    static DUSK_SKY_B : i32 = 70;
}
