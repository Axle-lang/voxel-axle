// mobs — the entity manager. Owns one typed array per species (Axle has no
// virtual dispatch, so a single heterogeneous Mob[] couldn't call the
// subclasses' methods). Drives each mob's AI per frame, spawns creatures
// onto solid land in a ring around the player (despawning the far ones),
// and resolves the player's melee against the nearest mob in view. The
// world has no RNG, so the manager threads its own counter through a hash.

use crate::entities::mob::Mob;
use crate::entities::chicken::Chicken;
use crate::entities::sheep::Sheep;
use crate::entities::cow::Cow;
use crate::entities::pig::Pig;
use crate::entities::creeper::Creeper;
use crate::entities::player::Player;
use crate::world::manager::ChunkManager;
use crate::world::blocksim::BlockSim;
use crate::world::noise::hash2;
use crate::game::sfx::AudioManager;
use crate::config;

class MobManager {
    chickens : Chicken[],
    chN : i32,
    sheep : Sheep[],
    shN : i32,
    cows : Cow[],
    coN : i32,
    pigs : Pig[],
    pgN : i32,
    creepers : Creeper[],
    crN : i32,
    rc : f64,

    /** Create an empty mob manager with per-species arrays allocated. */
    constructor() {
        self.chickens = malloc<Chicken>(config::mobCap);
        self.sheep = malloc<Sheep>(config::mobCap);
        self.cows = malloc<Cow>(config::mobCap);
        self.pigs = malloc<Pig>(config::mobCap);
        self.creepers = malloc<Creeper>(config::mobCap);
        self.chN = 0;
        self.shN = 0;
        self.coN = 0;
        self.pgN = 0;
        self.crN = 0;
        self.rc = 9.0;
    }

    // ── RNG (the world has no RNG of its own) ──
    /**
     * Next pseudo-random value in [0,1).
     * @return the next pseudo-random value in [0,1)
     */
    fn rand(mut self) : f64 {
        self.rc = self.rc + 1.0;
        return hash2(self.rc, self.rc * 1.3 + 7.0, config::seedI + 4242);
    }

    // ── Census & typed lookup ──
    /**
     * Total live mob count across all species.
     * @return the sum of the per-species counts
     */
    fn total(self) : i32 {
        return self.chN + self.shN + self.coN + self.pgN + self.crN;
    }

    /**
     * The element at (arr, idx) as a base Mob, for the shared melee path. The
     * selector matches the `MobKind` discriminants (0 chicken, 1 sheep, 2 cow,
     * 4 pig, 3 / default creeper).
     * @param arr  species array selector (MobKind discriminant)
     * @param idx  index within that species array
     * @return the selected mob as a base Mob
     */
    fn pick(self, arr : i32, idx : i32) : Mob {
        return match arr {
            0 => self.chickens[idx] as Mob,
            1 => self.sheep[idx] as Mob,
            2 => self.cows[idx] as Mob,
            4 => self.pigs[idx] as Mob,
            _ => self.creepers[idx] as Mob,
        };
    }

    // ── Render accessors (so the renderer needs only the Mob type) ──
    /**
     * The chicken at index i as a base Mob.
     * @param i  index into the chicken array
     * @return the chicken as a base Mob
     */
    fn chickenAt(self, i : i32) : Mob {
        return self.chickens[i] as Mob;
    }

    /**
     * The sheep at index i as a base Mob.
     * @param i  index into the sheep array
     * @return the sheep as a base Mob
     */
    fn sheepAt(self, i : i32) : Mob {
        return self.sheep[i] as Mob;
    }

    /**
     * The cow at index i as a base Mob.
     * @param i  index into the cow array
     * @return the cow as a base Mob
     */
    fn cowAt(self, i : i32) : Mob {
        return self.cows[i] as Mob;
    }

    /**
     * The pig at index i as a base Mob.
     * @param i  index into the pig array
     * @return the pig as a base Mob
     */
    fn pigAt(self, i : i32) : Mob {
        return self.pigs[i] as Mob;
    }

    /**
     * The creeper at index i as a base Mob.
     * @param i  index into the creeper array
     * @return the creeper as a base Mob
     */
    fn creeperAt(self, i : i32) : Mob {
        return self.creepers[i] as Mob;
    }

    // ── Spawning ──
    /**
     * Try to place one creature on land in the spawn ring around the
     * player. Returns whether it found a dry column.
     * @param world   the chunk manager that provides column heights
     * @param player  the player the spawn ring is centered on
     * @return true if a dry column was found and a creature placed
     */
    fn spawnOne(mut self, world : ChunkManager, player : Player) : bool {
        if (self.total() >= config::mobCap) {
            return false;
        }
        // Pick a random bearing on the spawn ring around the player (6.2831853 = 2π).
        let angle : f64 = self.rand() * 6.2831853;
        let cosA : f64 = Math::cos(angle);
        let sinA : f64 = Math::sin(angle);
        // Spawn out of sight: skip directions inside the camera's forward
        // cone so creatures never pop into existence in front of the player.
        let fwdx : f64 = 0.0 - player.siny;
        let fwdz : f64 = player.cosy;
        if (cosA * fwdx + sinA * fwdz > config::mobSpawnFovDot) {
            return false;
        }
        // Distance out: a random radius within the [min, radius] ring band.
        let ringSpan : f64 = (config::mobSpawnRadius - config::mobSpawnMin) as f64;
        let ringRadius : f64 = (config::mobSpawnMin as f64) + self.rand() * ringSpan;
        let worldX : f64 = player.pos.x + cosA * ringRadius;
        let worldZ : f64 = player.pos.z + sinA * ringRadius;
        let cellX : i32 = Math::floorToInt(worldX) as i32;
        let cellZ : i32 = Math::floorToInt(worldZ) as i32;
        let surfaceY : i32 = world.columnHeight(cellX, cellZ);
        if (surfaceY <= config::seaLevel) {
            return false;
        }
        // Only open, solid ground: reject columns carrying a tree trunk,
        // cactus, giant mushroom or any placed block (the collision surface
        // sits above the bare terrain there), so mobs never spawn up a tree.
        if (world.collisionHeight(cellX, cellZ) > surfaceY) {
            return false;
        }
        let spawnY : f64 = surfaceY as f64;
        // Species roll in [0,1): the cut points weight the herd toward chickens
        // /sheep and keep creepers rare (~22% creeper, 18% pig, 18% cow, 21%
        // sheep, 21% chicken). Newborns get a randomised first-voice delay so a
        // fresh herd doesn't all vocalise on the same frame.
        let roll : f64 = self.rand();
        if (roll > 0.78) {
            if (self.crN < config::mobCap) {
                self.creepers[self.crN] = new Creeper(worldX, spawnY, worldZ);
                self.crN = self.crN + 1;
            }
        } else if (roll > 0.60) {
            if (self.pgN < config::mobCap) {
                let pg : Pig = new Pig(worldX, spawnY, worldZ);
                pg.vocalTimer = self.nextVocalDelay();
                self.pigs[self.pgN] = pg;
                self.pgN = self.pgN + 1;
            }
        } else if (roll > 0.42) {
            if (self.coN < config::mobCap) {
                let cow : Cow = new Cow(worldX, spawnY, worldZ);
                cow.vocalTimer = self.nextVocalDelay();
                self.cows[self.coN] = cow;
                self.coN = self.coN + 1;
            }
        } else if (roll > 0.21) {
            if (self.shN < config::mobCap) {
                let sheep : Sheep = new Sheep(worldX, spawnY, worldZ);
                sheep.vocalTimer = self.nextVocalDelay();
                self.sheep[self.shN] = sheep;
                self.shN = self.shN + 1;
            }
        } else {
            if (self.chN < config::mobCap) {
                let chicken : Chicken = new Chicken(worldX, spawnY, worldZ);
                chicken.vocalTimer = self.nextVocalDelay();
                self.chickens[self.chN] = chicken;
                self.chN = self.chN + 1;
            }
        }
        return true;
    }

    /**
     * A fresh randomised delay (frames) until a mob's next idle voice, so a
     * herd doesn't vocalise in unison.
     * @return the delay in frames
     */
    fn nextVocalDelay(mut self) : i32 {
        return config::mobVocalMin + Math::floorToInt(self.rand() * (config::mobVocalRand as f64)) as i32;
    }

    // ── Voices ──
    /**
     * Count down a mob's voice timer and, when it fires, play its idle voice
     * attenuated by 3D distance to the player, then re-arm it.
     * @param m       the mob to voice
     * @param player  the listener
     * @param sfx     the audio manager
     */
    fn voice(mut self, m : Mob, player : Player, sfx : AudioManager) : void {
        if (m.isDying()) {
            return;
        }
        m.vocalTimer = m.vocalTimer - 1;
        if (m.vocalTimer <= 0) {
            sfx.mobSay(m.kind, m.pos, self.rand());
            m.vocalTimer = self.nextVocalDelay();
        }
    }

    // ── Population upkeep (cull + respawn) ──
    /**
     * Cull a mob: remove a finished corpse, or a live one that wandered out
     * of range (a dying one stays so its animation plays through).
     * @param m       the mob to test
     * @param player  the player whose position bounds the keep range
     * @return true if the mob should be removed
     */
    fn cull(self, m : Mob, player : Player) : bool {
        let dx : f64 = m.pos.x - player.pos.x;
        let dz : f64 = m.pos.z - player.pos.z;
        let despawn2 : f64 = config::mobDespawnDist * config::mobDespawnDist;
        return m.deathDone() || (!m.isDying() && dx * dx + dz * dz > despawn2);
    }

    // ── AI step (per physics tick) ──
    /**
     * Step every mob's AI for one tick (wander / graze / flee, creeper chase,
     * idle voices). Runs every physics tick so movement stays smooth and
     * frame-rate independent. Population upkeep (cull + respawn) is separate —
     * see `maintain`, which the scheduler runs on a coarser cadence.
     * @param world   the chunk manager the mobs live in
     * @param player  the player driving creeper AI and the voice listener
     * @param sfx     the audio manager for mob voices / creeper sounds
     * @param sim     the block-update sim a creeper blast wakes around its crater
     */
    fn update(mut self, world : ChunkManager, player : Player, sfx : AudioManager, sim : BlockSim) : void {
        let i : i32 = 0;
        while (i < self.chN) {
            self.chickens[i].wander(world, self.rand());
            self.voice(self.chickens[i] as Mob, player, sfx);
            i = i + 1;
        }
        i = 0;
        while (i < self.shN) {
            self.sheep[i].wander(world, self.rand());
            self.voice(self.sheep[i] as Mob, player, sfx);
            i = i + 1;
        }
        i = 0;
        while (i < self.coN) {
            self.cows[i].wander(world, self.rand());
            self.voice(self.cows[i] as Mob, player, sfx);
            i = i + 1;
        }
        i = 0;
        while (i < self.pgN) {
            self.pigs[i].wander(world, self.rand());
            self.voice(self.pigs[i] as Mob, player, sfx);
            i = i + 1;
        }
        i = 0;
        while (i < self.crN) {
            self.creepers[i].step(world, player, sfx, sim);
            i = i + 1;
        }
    }

    /**
     * Cull distant / finished mobs and top the population back up. Cheap but
     * not urgent: the scheduler calls this every `config::maintainTicks`
     * ticks rather than every tick — spawning is random and out of view, so
     * a few times per second is indistinguishable from per-tick while cutting
     * the spawn-ring probing ~`maintainTicks`×.
     * @param world   the chunk manager that provides column heights
     * @param player  the player whose position bounds spawn / cull ranges
     */
    fn maintain(mut self, world : ChunkManager, player : Player) : void {
        // Cull each array (swap-with-last compaction). The evicted mob's heap
        // object is freed before its slot is overwritten — otherwise every
        // despawn / death would leak one Mob for the whole session.
        let j : i32 = 0;
        while (j < self.chN) {
            if (self.cull(self.chickens[j] as Mob, player)) {
                free(self.chickens[j]);
                self.chN = self.chN - 1;
                self.chickens[j] = self.chickens[self.chN];
            } else {
                j = j + 1;
            }
        }
        j = 0;
        while (j < self.shN) {
            if (self.cull(self.sheep[j] as Mob, player)) {
                free(self.sheep[j]);
                self.shN = self.shN - 1;
                self.sheep[j] = self.sheep[self.shN];
            } else {
                j = j + 1;
            }
        }
        j = 0;
        while (j < self.coN) {
            if (self.cull(self.cows[j] as Mob, player)) {
                free(self.cows[j]);
                self.coN = self.coN - 1;
                self.cows[j] = self.cows[self.coN];
            } else {
                j = j + 1;
            }
        }
        j = 0;
        while (j < self.pgN) {
            if (self.cull(self.pigs[j] as Mob, player)) {
                free(self.pigs[j]);
                self.pgN = self.pgN - 1;
                self.pigs[j] = self.pigs[self.pgN];
            } else {
                j = j + 1;
            }
        }
        j = 0;
        while (j < self.crN) {
            if (self.cull(self.creepers[j] as Mob, player)) {
                free(self.creepers[j]);
                self.crN = self.crN - 1;
                self.creepers[j] = self.creepers[self.crN];
            } else {
                j = j + 1;
            }
        }

        let tries : i32 = 0;
        while (self.total() < config::mobTargetCount && tries < 16) {
            self.spawnOne(world, player);
            tries = tries + 1;
        }
    }

    // ── Combat (melee) ──
    /**
     * Consider one mob as a melee candidate; returns whether it beats the
     * current best (closer, in front, alive).
     * @param m       the candidate mob
     * @param player  the attacking player
     * @param fwdx    x component of the player's forward direction
     * @param fwdz    z component of the player's forward direction
     * @param bestD   the current best squared distance to beat
     * @return true if this mob is a closer, in-front, living candidate
     */
    fn better(self, m : Mob, player : Player, fwdx : f64, fwdz : f64, bestD : f64) : bool {
        if (m.isDying()) {
            return false;
        }
        let dx : f64 = m.pos.x - player.pos.x;
        let dz : f64 = m.pos.z - player.pos.z;
        let d2 : f64 = dx * dx + dz * dz;
        if (d2 > bestD) {
            return false;
        }
        return (dx * fwdx + dz * fwdz) > 0.0;
    }

    /**
     * Melee the nearest living mob in front of the player within range.
     * Returns the struck mob's kind, or -1 if nothing was hit.
     * @param player  the attacking player
     * @param sfx     the audio manager for the hurt sound
     * @return the struck mob's kind, or -1 if nothing was hit
     */
    fn attackNearest(mut self, player : Player, sfx : AudioManager) : i32 {
        let fwdx : f64 = 0.0 - player.siny;
        let fwdz : f64 = player.cosy;
        let bestD : f64 = config::attackRange * config::attackRange;
        let bestArr : i32 = 0 - 1;
        let bestIdx : i32 = 0 - 1;
        let i : i32 = 0;
        while (i < self.chN) {
            let m : Mob = self.chickens[i] as Mob;
            if (self.better(m, player, fwdx, fwdz, bestD)) {
                let dx : f64 = m.pos.x - player.pos.x;
                let dz : f64 = m.pos.z - player.pos.z;
                bestD = dx * dx + dz * dz;
                bestArr = 0;
                bestIdx = i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.shN) {
            let m : Mob = self.sheep[i] as Mob;
            if (self.better(m, player, fwdx, fwdz, bestD)) {
                let dx : f64 = m.pos.x - player.pos.x;
                let dz : f64 = m.pos.z - player.pos.z;
                bestD = dx * dx + dz * dz;
                bestArr = 1;
                bestIdx = i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.coN) {
            let m : Mob = self.cows[i] as Mob;
            if (self.better(m, player, fwdx, fwdz, bestD)) {
                let dx : f64 = m.pos.x - player.pos.x;
                let dz : f64 = m.pos.z - player.pos.z;
                bestD = dx * dx + dz * dz;
                bestArr = 2;
                bestIdx = i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.pgN) {
            let m : Mob = self.pigs[i] as Mob;
            if (self.better(m, player, fwdx, fwdz, bestD)) {
                let dx : f64 = m.pos.x - player.pos.x;
                let dz : f64 = m.pos.z - player.pos.z;
                bestD = dx * dx + dz * dz;
                bestArr = 4;
                bestIdx = i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.crN) {
            let m : Mob = self.creepers[i] as Mob;
            if (self.better(m, player, fwdx, fwdz, bestD)) {
                let dx : f64 = m.pos.x - player.pos.x;
                let dz : f64 = m.pos.z - player.pos.z;
                bestD = dx * dx + dz * dz;
                bestArr = 3;
                bestIdx = i;
            }
            i = i + 1;
        }

        if (bestArr < 0) {
            return 0 - 1;
        }
        let target : Mob = self.pick(bestArr, bestIdx);
        target.damage(config::attackDamage);
        target.flashHurt();
        sfx.mobHurt(target.kind, target.pos, self.rand());
        let kind : i32 = target.kind as i32;
        if (target.isAlive()) {
            target.panicFrom(player.pos.x, player.pos.z);
        } else {
            target.startDying();
        }
        return kind;
    }
}
