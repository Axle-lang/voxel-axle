// mob — base class for every creature. Extends Entity, so it is pulled
// down by gravity, stands on terrain and steps up ledges with the same
// physics as the player. On top it carries the shared mob state and the
// passive `wander` AI (ease toward a heading, alternate walking with
// grazing, bolt away when struck). Each species is a subclass under
// entities/ (chicken/sheep/cow/creeper) that sets its own size/speed and,
// for the creeper, its own hostile `step`. When killed a mob enters a
// `dying` state and the renderer collapses it before the manager removes it.
//
// Axle has no virtual dispatch, so the manager keeps one typed array per
// species and calls the concrete method on it (see entities/mobs.axle).

use crate::entities::entity::Entity;
use crate::world::manager::ChunkManager;
use crate::config;
use crate::config::{ MobKind };
use crate::mathx::{ clampF64, wrapAngle, PI, TAU };
use crate::vec3::{ Vec3, vec3 };

class Mob extends Entity {
    kind : MobKind,
    speed : f64,
    heading : f64,
    targetHeading : f64,
    turnTimer : i32,
    moving : i32,
    walkPhase : f64,
    fleeTimer : i32,
    hurtTimer : i32,
    state : i32,        // 0 = alive, 1 = dying
    deathTimer : i32,
    fuse : i32,         // creeper charge countdown; < 0 = not charging
    vocalTimer : i32,   // frames until the next idle voice (manager-driven)

    /** Create a mob at (x, y, z) of the given kind with maxHp hit points. */
    constructor(x : f64, y : f64, z : f64, own kind : MobKind, maxHp : i32) {
        this.pos = vec3(x, y, z);
        this.velY = 0.0;
        this.radius = config::mobRadius;
        this.height = 1.0;
        this.gravityScale = 1.0;
        this.hp = maxHp;
        this.maxHp = maxHp;
        this.onGround = 0;
        this.impact = 0.0;
        this.grav = config::mobGravity;
        this.apexY = y;
        this.stepUp = 0.0;
        this.kind = kind;
        this.heading = 0.0;
        this.targetHeading = 0.0;
        this.turnTimer = 0;
        this.moving = 1;
        this.walkPhase = 0.0;
        this.fleeTimer = 0;
        this.hurtTimer = 0;
        this.state = 0;
        this.deathTimer = 0;
        this.fuse = 0 - 1;
        this.vocalTimer = config::mobVocalMin;
        this.speed = config::mobWanderSpeed;
    }

    /** Flag a hit so the renderer glows the mob red for a few frames. */
    fn flashHurt() : void {
        this.hurtTimer = config::hurtFlashFrames;
    }

    /**
     * React to a hit from (px, pz): panic-run directly away for a while.
     * @param px  x coordinate of the source of the hit
     * @param pz  z coordinate of the source of the hit
     */
    fn panicFrom(px : f64, pz : f64) : void {
        this.targetHeading = atan2(this.pos.z - pz, this.pos.x - px);
        this.fleeTimer = config::mobFleeFrames;
        this.moving = 1;
        this.turnTimer = config::mobFleeFrames;
    }

    /** Begin the death collapse; the manager removes the mob when it ends. */
    fn startDying() : void {
        this.state = 1;
        this.deathTimer = config::deathFrames;
        this.moving = 0;
    }

    /**
     * Whether the mob is in its death collapse.
     * @return true while dying
     */
    fn isDying() : bool {
        return this.state == 1;
    }

    /**
     * Whether the death collapse has finished and the mob can be removed.
     * @return true when dying and the death timer has elapsed
     */
    fn deathDone() : bool {
        return this.state == 1 && this.deathTimer <= 0;
    }

    /**
     * Collapse progress in [0,1): 0 at the moment of death, 1 when gone.
     * @return the normalized death-collapse progress
     */
    fn deathProgress() : f64 {
        if (this.state == 0) {
            return 0.0;
        }
        let df : f64 = config::deathFrames as f64;
        return (df - (this.deathTimer as f64)) / df;
    }

    /**
     * Ease `heading` toward `targetHeading` by at most `mobTurnRate`,
     * taking the shortest way around the circle.
     */
    fn turnToward() : void {
        let d : f64 = wrapAngle(this.targetHeading - this.heading);
        let rate : f64 = config::mobTurnRate;
        this.heading = this.heading + clampF64(d, 0.0 - rate, rate);
    }

    /**
     * Passive wander AI, one frame. `rnd` is a fresh value in [0,1) from
     * the manager (the world has no RNG of its own). Shared by the calm
     * animals; the creeper overrides behaviour with its own `step`.
     * @param world  the chunk manager the mob moves through
     * @param rnd    a fresh pseudo-random value in [0,1)
     */
    fn wander(world : ChunkManager, rnd : f64) : void {
        if (this.hurtTimer > 0) {
            this.hurtTimer = this.hurtTimer - 1;
        }

        // Dying: stop steering, let gravity settle the body while the
        // collapse animation plays out.
        if (this.state == 1) {
            if (this.deathTimer > 0) {
                this.deathTimer = this.deathTimer - 1;
            }
            this.tick(world, 0.0, 0.0);
            return;
        }

        if (this.fleeTimer > 0) {
            this.fleeTimer = this.fleeTimer - 1;
        }
        this.turnTimer = this.turnTimer - 1;
        if (this.turnTimer <= 0 && this.fleeTimer <= 0) {
            this.targetHeading = rnd * TAU;
            this.turnTimer = config::mobTurnEveryMin + Math::floorToInt(rnd * (config::mobTurnEveryRand as f64)) as i32;
            if (rnd < config::mobIdleChance) {
                this.moving = 0;
            } else {
                this.moving = 1;
            }
        }
        this.turnToward();

        let spd : f64 = 0.0;
        if (this.fleeTimer > 0) {
            spd = config::mobFleeSpeed;
        } else if (this.moving == 1) {
            spd = this.speed;
        }

        if (spd > 0.0) {
            this.walkPhase = this.walkPhase + 0.35;
        }

        let dx : f64 = Math::cos(this.heading) * spd;
        let dz : f64 = Math::sin(this.heading) * spd;
        this.tick(world, dx, dz);
    }
}

/**
 * Two-argument arctangent over the full circle, in radians.
 * @param y  the y component
 * @param x  the x component
 * @return the angle of (x, y) in radians
 */
fn atan2(y : f64, x : f64) : f64 {
    if (x > 0.0) {
        return atanApprox(y / x);
    }
    if (x < 0.0) {
        if (y >= 0.0) {
            return atanApprox(y / x) + PI;
        }
        return atanApprox(y / x) - PI;
    }
    if (y > 0.0) {
        return PI * 0.5;
    }
    if (y < 0.0) {
        return 0.0 - PI * 0.5;
    }
    return 0.0;
}

/**
 * atan(z) approximation (max error ~0.0038 rad) — ample for AI facing.
 * @param z  the tangent value
 * @return the approximate arctangent of z in radians
 */
fn atanApprox(z : f64) : f64 {
    let a : f64 = z;
    if (a < 0.0) {
        a = 0.0 - a;
    }
    let inv : bool = a > 1.0;
    if (inv) {
        a = 1.0 / a;
    }
    let a3 : f64 = a * a * a;
    let r : f64 = 0.7853981634 * a - a * (a - 1.0) * (0.2447 + 0.0663 * a);
    if (inv) {
        r = 1.5707963268 - r;
    }
    if (z < 0.0) {
        return 0.0 - r;
    }
    return r;
}
