// physcheck — the physics assertions a picture cannot make.
//
// A screenshot proves the world generates and the renderer draws it. It
// proves nothing about whether the body can walk over a partial block,
// because a body stuck against a snow layer looks exactly like a body
// standing next to one.
//
// So this drives the REAL `Player` against the REAL `ChunkManager` over
// terrain the real generator built, and reads the position back. It is
// headless and deterministic — the world is a fixed seed and the probe
// searches it rather than assuming a coordinate — so it runs unattended
// and means the same thing every time.
//
// `voxel --physics-check` runs it and exits with the failure count.
//
// The case it was written for: a snow layer an eighth of a block deep,
// under a canopy. The auto-step used to test the body at the FULL step
// allowance rather than at the ledge's real height, which asks for 3.4
// blocks of clearance to climb an eighth of one — so under any ceiling
// a dusting of snow stopped the player dead. That is now the first
// assertion here.

use crate::engine::world::chunks::ChunkManager;
use crate::game::world::terraingen::TerrainGen;
use crate::engine::entity::player::Player;
use crate::engine::math::vec3::{ IVec3, ivec3 };
use crate::game::world::terrain::{ temperature, humidity, snowDepth };
use crate::engine::block::blocks::{ hasCollisionBox };
use crate::game::world::biomes::{ biomeAt };
use crate::configs::biomes::{ BiomeId };
use smalt::{Mem, SlotIndex};
use crate::configs::blocks::{ Block };
use crate::configs::world::{ World };

/** Ticks a walk assertion runs for. */
const WALK_TICKS : i32 = 40;

/** How far a body must travel in that time to count as unobstructed. */
const WALK_MIN : f64 = 1.0;

/** Yaw whose forward is +X — forward for a yaw is (-sin, cos). */
const YAW_PLUS_X : f64 = -1.5707963;

/** Yaw whose forward is +Z. */
const YAW_PLUS_Z : f64 = 0.0;

/** How far out the probe searches the loaded ring for a test site. */
const SCAN : i32 = 80;

/** How many chunks out the hunt for a snowy ring centre may go. */
const SNOW_HUNT : i32 = 64;

/**
 * Ticks a jump is followed for: past its apex (~17 ticks) and short of
 * landing back on level ground (~34).
 */
const JUMP_TICKS : i32 = 30;

/** Cells of level, open ground a jump needs ahead of it — a sprint covers ~4.2. */
const JUMP_RUN : i32 = 7;

/** Blocks a body drops before a fall-damage assertion — far past the safe fall. */
const FALL_HEIGHT : i32 = 20;

/** Depth of the water column the drop lands in. */
const POOL_DEPTH : i32 = 6;

/** Ticks given to each leg of a fall assertion: comfortably long enough to settle. */
const FALL_TICKS : i32 = 240;

/**
 * Walk a fresh body from (x, y, z) for `WALK_TICKS` and answer how far
 * it travelled along the axis it was facing.
 * @param man   the world to walk on
 * @param x     start x
 * @param y     start foot height
 * @param z     start z
 * @param yaw   facing
 * @param alongX  whether to measure the x displacement rather than the z
 * @return blocks travelled along that axis
 */
fn walk(man : ChunkManager, x : f64, y : f64, z : f64, yaw : f64, alongX : bool) : f64 {
    let p : Player = new Player(x, y, z);
    p.yaw = yaw;
    p.refresh();
    const sx : f64 = p.pos.x;
    const sz : f64 = p.pos.z;

    for (i of 0..WALK_TICKS) {
        p.update(
            man,
            1.0,
            0.0,
            false,
            false,
            false
        );
    }

    if (alongX) {
        return p.pos.x - sx;
    }
    return p.pos.z - sz;
}

/**
 * The chunk of the nearest column the generator will put snow on.
 *
 * The snow assertions need snow in the ring, and the origin is not
 * entitled to any: the cold biomes are a small share of the land, so
 * loading the ring at (0, 0) and hoping is how three assertions quietly
 * became a SKIP. This asks the climate the same questions `genVoxels`
 * asks — cold biome, above the sea, a snow depth that rounds to a layer
 * rather than a full block — and answers where the first yes is.
 *
 * The columns are read straight from the noise, so nothing is loaded to
 * find the place to load.
 * @param gen  the generator, for its own notion of a cold biome
 * @return the chunk coordinates to centre the ring on
 */
fn snowyChunk(gen : TerrainGen) : (i32, i32) {
    for (d of 0..=SNOW_HUNT) {
        for (cz of -d..=d) {
            for (cx of -d..=d) {
                if (cz.abs() == d || cx.abs() == d) {
                    const wx : i32 = cx * World::CHUNK_SIZE + World::CHUNK_SIZE / 2;
                    const wz : i32 = cz * World::CHUNK_SIZE + World::CHUNK_SIZE / 2;
                    const h : i32 = gen.colHeightWorld(wx, wz);
                    const temp : f64 = temperature(wx as f64, wz as f64);
                    const hum : f64 = humidity(wx as f64, wz as f64);
                    const b : BiomeId = biomeAt(temp, hum, h);
                    const frac : f64 = snowDepth(wx as f64, wz as f64);
                    if (gen.coldBiome(b)
                        && h > World::SEA_LEVEL
                        && frac > 0.0
                        && frac < 0.95) {
                        return (cx, cz);
                    }
                }
            }
        }
    }
    return (0, 0);
}

/**
 * Run every physics assertion; answer the number that failed.
 * @return the failure count, 0 when green
 */
fn runPhysicsCheck() : i32 {
    let fails : i32 = 0;
    let man : ChunkManager = new ChunkManager();
    let gen : TerrainGen = new TerrainGen(World::SPAN * World::SPAN);
    let (cx, cz) = snowyChunk(gen);
    man.attachGenerator(gen);
    const ax : i32 = cx * World::CHUNK_SIZE + World::CHUNK_SIZE / 2;
    const az : i32 = cz * World::CHUNK_SIZE + World::CHUNK_SIZE / 2;
    Console::println("ring centred on chunk (${cx}, ${cz}), column (${ax}, ${az})");
    while (man.ensureLoaded(cx, cz) > 0) {
    }

    fails += checkSnowEdge(man, ax, az, true);
    fails += checkSnowEdge(man, ax, az, false);
    fails += checkStoredBox(man, ax, az);
    fails += checkSprintJump(man, ax, az);
    // The survey describes the generated world, so it runs before the
    // assertions below dig a pool into it.
    surveyFaces(man);
    fails += checkWaterBreaksFall(man, ax, az);
    fails += checkModeSwitchFall(man, ax, az);

    man.stopLight();
    Console::println("physics failures: ${fails}");
    return fails;
}

/**
 * A sprint carries a jump further, never higher or faster: two bodies jump
 * from the same spot along the same level run, one walking and one
 * sprinting, and while both are in the air their heights must agree on
 * every tick.
 * @param man  the world to search and jump on
 * @param ax   x of the column the search is centred on
 * @param az   z of the column the search is centred on
 * @return 1 if the heights ever differ, else 0
 */
fn checkSprintJump(man : ChunkManager, ax : i32, az : i32) : i32 {
    const site = levelRun(man, ax, az);
    if (!site.found) {
        Console::println("  sprint jump: SKIP — no level run of ${JUMP_RUN} cells in the ring");
        return 0;
    }

    let walker : Player = new Player((site.x as f64) + 0.5, site.y as f64, (site.z as f64) + 0.5);
    let sprinter : Player = new Player((site.x as f64) + 0.5, site.y as f64, (site.z as f64) + 0.5);
    walker.yaw = YAW_PLUS_X;
    sprinter.yaw = YAW_PLUS_X;
    walker.refresh();
    sprinter.refresh();

    // Settle onto the ground first: a body only jumps from standing.
    for (t of 0..4) {
        walker.update(man, 0.0, 0.0, false, false, false);
        sprinter.update(man, 0.0, 0.0, true, false, false);
    }
    const y0 : f64 = walker.pos.y;
    let apex : f64 = 0.0;

    for (t of 0..JUMP_TICKS) {
        const jump : bool = t == 0;
        walker.update(man, 1.0, 0.0, false, jump, false);
        sprinter.update(man, 1.0, 0.0, true, jump, false);

        const walkRise : f64 = walker.pos.y - y0;
        const sprintRise : f64 = sprinter.pos.y - y0;
        if (walkRise != sprintRise) {
            Console::println("  sprint jump: FAIL at tick ${t} — walking ${walkRise}"
                + " blocks up, sprinting ${sprintRise}");
            return 1;
        }
        apex = apex.max(walkRise);
    }

    const ahead : f64 = sprinter.pos.x - walker.pos.x;
    Console::println("  sprint jump: same height on all ${JUMP_TICKS} ticks"
        + " (apex ${apex}), the sprint ${ahead} blocks further");
    return 0;
}

/**
 * Water arrests a fall, even one that never reaches the bottom: a body drops
 * twenty blocks into a pool dug in the ground and treads at its surface, the
 * pool is filled in under it, and the body settles on the new floor a step
 * below — losing nothing. Measured from the cliff instead of the water, that
 * landing was a twenty-block fall: swimming to a bank and stepping out killed
 * the player.
 * @param man  the world to build the pool in
 * @param ax   x of the column the search is centred on
 * @param az   z of the column the search is centred on
 * @return 1 if the landing hurt, else 0
 */
fn checkWaterBreaksFall(man : ChunkManager, ax : i32, az : i32) : i32 {
    const site = levelRun(man, ax, az);
    if (!site.found) {
        Console::println("  water breaks a fall: SKIP — no open ground in the ring");
        return 0;
    }

    // The pool's surface is the ground's: cells site.y - POOL_DEPTH .. site.y - 1.
    const bottom : i32 = site.y - POOL_DEPTH;
    for (y of bottom..site.y) {
        man.setVoxel(ivec3(site.x, y, site.z), Block::Water);
    }
    let p : Player = new Player((site.x as f64) + 0.5, (site.y + FALL_HEIGHT) as f64, (site.z as f64) + 0.5);
    p.refresh();

    // Down into the pool, then tread water near its surface without ever
    // touching the bottom.
    for (t of 0..FALL_TICKS) {
        const treading : bool = p.pos.y < (site.y as f64) - 1.5;
        p.update(man, 0.0, 0.0, false, treading, false);
    }

    // Fill the pool in under the body, all but its top cell, so the body has a
    // step at most to settle. Only that landing is under test: treading water
    // costs breath, and a drowning tick is not a fall.
    const hpInPool : i32 = p.hp;
    for (y of bottom..site.y - 1) {
        man.setVoxel(ivec3(site.x, y, site.z), Block::Stone);
    }
    man.setVoxel(ivec3(site.x, site.y - 1, site.z), Block::Air);
    for (t of 0..FALL_TICKS) {
        p.update(man, 0.0, 0.0, false, false, false);
    }

    if (p.hp < hpInPool) {
        Console::println("  water breaks a fall: FAIL — ${hpInPool - p.hp} damage stepping out of a pool"
            + " that caught a ${FALL_HEIGHT}-block drop");
        return 1;
    }
    Console::println("  water breaks a fall: a ${FALL_HEIGHT}-block drop into a pool, then dry land — no damage");
    return 0;
}

/**
 * Flight does not bank a fall: a body switches to creative twenty blocks up,
 * flies down to the ground, switches back and stands there — losing nothing.
 * @param man  the world to fly over
 * @param ax   x of the column the search is centred on
 * @param az   z of the column the search is centred on
 * @return 1 if switching back hurt, else 0
 */
fn checkModeSwitchFall(man : ChunkManager, ax : i32, az : i32) : i32 {
    const site = levelRun(man, ax, az);
    if (!site.found) {
        Console::println("  creative descent: SKIP — no open ground in the ring");
        return 0;
    }

    let p : Player = new Player((site.x as f64) + 0.5, (site.y + FALL_HEIGHT) as f64, (site.z as f64) + 0.5);
    p.refresh();
    p.toggleGameMode();
    for (t of 0..FALL_TICKS) {
        p.update(man, 0.0, 0.0, false, false, true);
    }
    p.toggleGameMode();
    for (t of 0..FALL_TICKS) {
        p.update(man, 0.0, 0.0, false, false, false);
    }

    if (p.hp < p.maxHp) {
        Console::println("  creative descent: FAIL — ${p.maxHp - p.hp} damage switching back to survival"
            + " on the ground after flying down ${FALL_HEIGHT} blocks");
        return 1;
    }
    Console::println("  creative descent: flew down ${FALL_HEIGHT} blocks, switched back — no damage");
    return 0;
}

/**
 * The first column near (ax, az) with `JUMP_RUN` cells of level, open, dry,
 * full-block ground ahead of it along +X.
 * @param man  the world to search
 * @param ax   x of the column the search is centred on
 * @param az   z of the column the search is centred on
 * @return whether one was found, and the start cell's x, foot height and z
 */
fn levelRun(man : ChunkManager, ax : i32, az : i32) : (found: bool, x: i32, y: i32, z: i32) {
    for (z of (az - SCAN)..=(az + SCAN)) {
        for (x of (ax - SCAN)..=(ax + SCAN - JUMP_RUN)) {
            const y : i32 = man.collisionHeight(x, z);
            let level : bool = y > World::SEA_LEVEL;
            for (k of 0..=JUMP_RUN) {
                if (!level) {
                    break;
                }
                const ground : IVec3 = ivec3(x + k, y - 1, z);
                const feet : IVec3 = ivec3(x + k, y, z);
                level = man.collisionHeight(x + k, z) == y
                    && man.blockBoxHeight(ground) == 1.0
                    && man.worldGet(feet) == Block::Air;
            }
            if (level) {
                return (true, x, y, z);
            }
        }
    }
    return (false, 0, 0, 0);
}

/**
 * A body must be able to walk onto a partial block whatever the ceiling
 * above it, on the axis asked for.
 *
 * The site is searched rather than hard-coded: a bare column with a
 * partial block beside it and at most three clear cells overhead, which
 * is the geometry the old step gate refused.
 * @param man     the world to search and walk on
 * @param ax      the ring's centre column x
 * @param az      the ring's centre column z
 * @param alongX  whether to test the +X neighbour rather than the +Z one
 * @return 1 when the body was stopped, 0 when it climbed
 */
fn checkSnowEdge(man : ChunkManager, ax : i32, az : i32, alongX : bool) : i32 {
    const axis : string = alongX ? "+X" : "+Z";
    for (z of az - SCAN..=az + SCAN) {
        for (x of ax - SCAN..=ax + SCAN) {
            const h : i32 = man.columnHeight(x, z);
            const nx : i32 = alongX ? x + 1 : x;
            const nz : i32 = alongX ? z : z + 1;
            if (h > 0 && man.worldGet(ivec3(nx, h, nz)) == Block::SnowLayer
                && !hasCollisionBox(man.worldGet(ivec3(x, h, z)))) {
                let k : i32 = 0;
                while (k < 6 && !hasCollisionBox(man.worldGet(ivec3(x, h + k, z)))) {
                    k++;
                }

                if (k <= 3) {
                    const deep : f64 = man.blockBoxHeight(ivec3(nx, h, nz));
                    const yaw : f64 = alongX ? YAW_PLUS_X : YAW_PLUS_Z;
                    const moved : f64 = walk(
                        man,
                        (x as f64) + 0.5,
                        h as f64,
                        (z as f64) + 0.5,
                        yaw,
                        alongX
                    );
                    Console::println(
                        "  ${axis}: level-${man.blockLevel(ivec3(nx, h, nz))} layer (${deep} deep)"
                        + " at (${nx}, ${h}, ${nz}) under ${k} cells — walk with --at ${x} ${z}"
                    );
                    if (moved < WALK_MIN) {
                        Console::println(
                            "FAIL ${axis}: a ${deep}-deep layer at (${nx}, ${h}, ${nz}) stopped the body"
                            + " under ${k} cells of headroom — moved ${moved}"
                        );
                        return 1;
                    }
                    return 0;
                }
            }
        }
    }
    Console::println("SKIP ${axis}: no low-headroom partial-block edge in the loaded ring");
    return 0;
}

/**
 * The stored level, the box and the standable top must be the same fact.
 *
 * This is the assertion the old model could not make. The height used to
 * come from noise sampled at the cell's coordinates, so there was no
 * stored value to check it against — the box was correct by definition
 * and wrong in every way that mattered. Now the generator writes a level
 * and everything downstream reads it, so the three can be compared, and a
 * chain that drifts says so here instead of on screen.
 * @param man  the world to search
 * @param ax   the ring's centre column x
 * @param az   the ring's centre column z
 * @return the failure count
 */
fn checkStoredBox(man : ChunkManager, ax : i32, az : i32) : i32 {
    let seen : i32 = 0;
    let fails : i32 = 0;
    let z : i32 = az - SCAN;
    while (z <= az + SCAN && seen < 24) {
        let x : i32 = ax - SCAN;
        while (x <= ax + SCAN && seen < 24) {
            const h : i32 = man.columnHeight(x, z);
            const cell : IVec3 = ivec3(x, h, z);
            if (h > 0 && man.worldGet(cell) == Block::SnowLayer) {
                seen++;
                const level : i32 = man.blockLevel(cell);
                const want : f64 = (level as f64) / 8.0;
                if (level < 1 || level > 8) {
                    Console::println("FAIL stored level ${level} out of range at (${x}, ${h}, ${z})");
                    fails += 1;
                } else if ((man.blockBoxHeight(cell) - want).abs() > 0.0001) {
                    Console::println(
                        "FAIL box ${man.blockBoxHeight(cell)} disagrees with level ${level}"
                        + " at (${x}, ${h}, ${z})"
                    );
                    fails += 1;
                } else if ((man.supportHeight(cell) - ((h as f64) + want)).abs() > 0.0001) {
                    Console::println(
                        "FAIL support ${man.supportHeight(cell)} is not the box top"
                        + " at (${x}, ${h}, ${z})"
                    );
                    fails += 1;
                }
            }
            x++;
        }
        z++;
    }

    if (seen == 0) {
        Console::println("SKIP stored box: no snow layer in the loaded ring");
        return 0;
    }
    Console::println("  stored box: ${seen} layers agree with their level");
    return fails;
}

/**
 * How the baked faces break down, and how much MORE a greedy merge could
 * still absorb.
 *
 * Run after the merge, so the numbers are what is left on the table: the
 * mesher merges along one axis per direction, and this counts the pairs
 * that a second axis — a true 2-D greedy over runs — would still find.
 *
 * Indexed rather than scanned. A cell emits up to six faces, so two
 * vertically adjacent faces of the same direction sit four to six
 * entries apart in the array — comparing a face with its predecessor
 * finds almost none of them, which is what a first attempt at this
 * measured and why the number was wrong.
 *
 * Every face goes into a `SlotIndex` keyed by (direction, x, y, z), then
 * each is asked whether the cell along each in-plane axis carries the
 * same face. The strict rule needs the same tile AND the same four baked
 * corner light and AO values, because a merged quad has four corners and
 * interpolates between them; the loose count is geometry alone, and the
 * gap between the two is what the lighting costs.
 * @param man  the meshed world whose faces are surveyed
 */
fn surveyFaces(man : ChunkManager) : void {
    const slots : i32 = World::SPAN * World::SPAN;
    let byDir : i32[] = malloc<i32>(6);
    for (d of 0..6) {
        byDir[d as i64] = 0;
    }

    let total : i32 = 0;
    for (slot of 0..slots) {
        if (man.cols.loaded[slot] == 1) {
            total += man.mesher.faces.fcount[slot];
        }
    }

    let index : SlotIndex = new SlotIndex(total * 2);
    for (slot of 0..slots) {
        if (man.cols.loaded[slot] != 1) {
            continue;
        }
        const base : i32 = slot * World::MAX_FACES_PER_CHUNK;
        for (fi of 0..man.mesher.faces.fcount[slot]) {
            const i : i32 = base + fi;
            const d : i64 = ((man.mesher.faces.ftile[i] as i32) / 256) as i64;
            byDir[d] = byDir[d] + 1;
            index.put(faceKey(man, i), i);
        }
    }

    // Along each direction's two in-plane axes, how many faces have an
    // identical neighbour to merge onto.
    let geom : i32 = 0;
    let strict : i32 = 0;
    // The same, over the slots whose eight neighbours are all loaded. A slot
    // on the ring's edge meshes against chunks that are not there, and what it
    // does there is a policy, not a property of the world — so the number a
    // change must leave alone is the interior one.
    let inner : i32 = 0;
    let innerGeom : i32 = 0;
    for (slot of 0..slots) {
        if (man.cols.loaded[slot] != 1) {
            continue;
        }
        const interior : bool = ringInterior(man, slot);
        if (interior) {
            inner += man.mesher.faces.fcount[slot];
        }
        const base : i32 = slot * World::MAX_FACES_PER_CHUNK;
        for (fi of 0..man.mesher.faces.fcount[slot]) {
            const i : i32 = base + fi;
            const d : i32 = (man.mesher.faces.ftile[i] as i32) / 256;
            // The two axes that lie IN the face's plane.
            let ax : i32 = 0;
            let az : i32 = 0;
            let ay : i32 = 0;
            if (d == 0 || d == 1) {
                ay = 1;
            } else if (d == 2 || d == 3) {
                ax = 1;
            } else {
                ax = 1;
            }

            const j : i32 = index.get(neighbourKey(man, i, ax, ay, az));
            if (j >= 0 && man.mesher.faces.ftile[j] == man.mesher.faces.ftile[i]) {
                geom++;
                if (interior) {
                    innerGeom++;
                }
                if (sameCorners(man, j, i)) {
                    strict++;
                }
            }
        }
    }
    index.close();

    Console::println("  faces: ${total} total"
        + "  +X=${byDir[0]} -X=${byDir[1]} top=${byDir[2]} bottom=${byDir[3]}"
        + " +Z=${byDir[4]} -Z=${byDir[5]}");
    Console::println("  one-axis merges: ${geom} by geometry,"
        + " ${strict} once the baked corner light and AO must match");
    Console::println("  interior slots: ${inner} faces, ${innerGeom} merges by geometry");
    free(byDir);
}

/**
 * The ring row/column a chunk coordinate lands in — the manager's own wrap.
 * @param v  a chunk coordinate on one axis
 * @return its ring index, in 0..World::SPAN
 */
fn ringSlot(v : i32) : i32 {
    let m : i32 = v % World::SPAN;
    if (m < 0) {
        m += World::SPAN;
    }
    return m;
}

/**
 * Whether every one of a slot's eight neighbours is loaded.
 * @param man   the world whose ring is read
 * @param slot  the ring slot to test
 * @return true when all eight neighbours hold the chunks beside this one
 */
fn ringInterior(man : ChunkManager, slot : i32) : bool {
    const cx : i32 = man.cols.cxs[slot];
    const cz : i32 = man.cols.czs[slot];
    for (dz of -1..=1) {
        for (dx of -1..=1) {
            const n : i32 = ringSlot(cz + dz) * World::SPAN + ringSlot(cx + dx);
            if (man.cols.loaded[n] != 1
                || man.cols.cxs[n] != cx + dx
                || man.cols.czs[n] != cz + dz) {
                return false;
            }
        }
    }
    return true;
}

/**
 * A face's world cell: its chunk-local bytes, placed by its slot's origin.
 * @param man  the world whose face arrays are read
 * @param i    the face's index in those arrays
 * @return the world cell the face belongs to
 */
fn faceCell(man : ChunkManager, i : i32) : IVec3 {
    const slot : i32 = i / World::MAX_FACES_PER_CHUNK;
    return ivec3(
        man.cols.cxs[slot] * World::CHUNK_SIZE + (man.mesher.faces.fx[i] as i32),
        man.mesher.faces.fy[i] as i32,
        man.cols.czs[slot] * World::CHUNK_SIZE + (man.mesher.faces.fz[i] as i32)
    );
}

/**
 * A face's identity: its direction and its cell.
 * @param man  the world whose face arrays are read
 * @param i    the face's index in those arrays
 * @return the face's key in the survey index
 */
fn faceKey(man : ChunkManager, i : i32) : i64 {
    const c : IVec3 = faceCell(man, i);
    return keyOf((man.mesher.faces.ftile[i] as i32) / 256, c.x, c.y, c.z);
}

/**
 * The same, for the cell one step along (ax, ay, az).
 * @param man  the world whose face arrays are read
 * @param i    the face's index in those arrays
 * @param ax   step along x
 * @param ay   step along y
 * @param az   step along z
 * @return the key a same-direction face in that neighbouring cell would carry
 */
fn neighbourKey(man : ChunkManager, i : i32, ax : i32, ay : i32, az : i32) : i64 {
    const c : IVec3 = faceCell(man, i);
    return keyOf(
        (man.mesher.faces.ftile[i] as i32) / 256,
        c.x + ax,
        c.y + ay,
        c.z + az
    );
}

/**
 * Pack a direction and a world cell into one key.
 * @param d  the face direction, 0..6
 * @param x  world x
 * @param y  world y
 * @param z  world z
 * @return the packed key
 */
fn keyOf(d : i32, x : i32, y : i32, z : i32) : i64 {
    return (d as i64)
        + (((x + 4000000) as i64) << 3)
        + (((z + 4000000) as i64) << 27)
        + ((y as i64) << 51);
}

/**
 * Whether two faces carry identical baked corner light and AO — the same test
 * the mesher merges on, and it has to READ THE SAME BYTES: eight of light per
 * face (two per corner, sky and block red then block green and blue) against
 * four of occlusion.
 * @param man  the world whose face arrays are read
 * @param a    the first face's index
 * @param b    the second face's index
 * @return true when every light byte and the occlusion byte match
 */
fn sameCorners(man : ChunkManager, a : i32, b : i32) : bool {
    for (k of 0..8) {
        if (Mem::byteAt(man.mesher.faces.flight, (a * 8 + k) as i64)
            != Mem::byteAt(man.mesher.faces.flight, (b * 8 + k) as i64)) {
            return false;
        }
    }
    // The four corners' occlusion is one byte, two bits each.
    return Mem::byteAt(man.mesher.faces.fao, a as i64)
        == Mem::byteAt(man.mesher.faces.fao, b as i64);
}
