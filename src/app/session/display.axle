// display — the window, and the size the frame is rendered at inside it.

use smalt::{ Platform, PlatformError, Window, WindowDesc };
use crate::engine::render::view::camera::{ Viewport, viewportFor };
use crate::engine::render::backend::{ RenderBackend };

const WINDOW_TITLE : string = "Axle Voxel — survival";

/**
 * The window, and the render size that follows its shape — up to a pixel
 * budget, for a backend that has one. Whatever draws into it owns its own
 * target and is told this size.
 */
class Display {
    platform : Platform,
    pub(crate) win : Window,
    vp : Viewport,

    /**
     * Opens a window of this size.
     * @param w  the window's width, in pixels
     * @param h  the window's height, in pixels
     */
    constructor(w : i32, h : i32) ! PlatformError {
        const desc = WindowDesc {
            title: WINDOW_TITLE,
            w,
            h,
            resizable: true,
        };

        self.platform = new Platform()?;
        self.win = self.platform.open(desc)?;
        self.vp = viewportFor(w, h);
    }

    /**
     * The render width — not the window's, once a pixel budget caps it.
     * @return the width, in pixels
     */
    pub(crate) fn width(self) : i32 {
        return self.vp.w;
    }

    /**
     * The render height — not the window's, once a pixel budget caps it.
     * @return the height, in pixels
     */
    pub(crate) fn height(self) : i32 {
        return self.vp.h;
    }

    /**
     * A window-space point in render pixels.
     * @param x  the point's x, in window pixels
     * @param y  the point's y, in window pixels
     * @return the point, scaled by the render-to-window ratio
     */
    pub(crate) fn toFrame(self, x : i32, y : i32) : (x: i32, y: i32) {
        const winW = self.win.width().max(1);
        const winH = self.win.height().max(1);
        return (x * self.width() / winW, y * self.height() / winH);
    }

    /**
     * Matches the render size to the window — both axes, up to the backend's
     * pixel budget — so going fullscreen widens the view instead of zooming into it.
     * @param backend  what draws the frames, which decides the size it renders at
     * @return whether the render size changed
     */
    pub(crate) fn fit(mut self, backend : dyn RenderBackend) : bool {
        const winW = self.win.width();
        const winH = self.win.height();
        if (winW < 1 || winH < 1) {
            return false;
        }

        const want = backend.viewportFor(winW, winH);
        if (want.w == self.width() && want.h == self.height()) {
            return false;
        }
        self.vp = want;
        return true;
    }

    /** Closes the window, then the platform. */
    pub(crate) fn close(self) : void {
        self.win.close();
        self.platform.close();
    }
}
