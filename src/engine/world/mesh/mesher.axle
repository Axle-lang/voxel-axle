// chunkmesher — turns a slot's voxel field into the render mesh, a leaf split
// out of the world manager.
//
// The mesher owns what it produces — the faces, the torch posts and each
// column's collision top, which the renderer and the physics read as
// `man.mesher.faces` etc. — and reads what it consumes through a `MeshSource`
// lent for one build: the voxel store and the baked light, nothing else of
// the manager's.
//
// Emitting a face for every block that borders air, it also bakes each face's
// Minecraft-style smooth light + ambient occlusion and records each column's
// highest collidable voxel for entity physics.

use smalt::Mem;
use crate::engine::block::blocks::{
    tileFor, isWater, isSource, fluidLevel, isTransparent, isPartialShape, isOpaque,
    isCollidable,
};
use crate::engine::block::box::{ boxOf };

/**
 * Cells a greedy run may span.
 *
 * Not unbounded, because the sun moves and the mesh does not: the soft cast
 * shadow is sampled at RENDER time, at whatever quad is actually drawn. The
 * renderer cuts a run wherever the shadow varies along it, so the bound here is
 * about the mesh alone — how long a face may be before the merge stops paying,
 * and how much surface one entry in the baked light arrays may stand for.
 * `FaceMesh.fform` stores a run in three bits, so it can be no more than 8.
 */
const MESH_MAX_RUN : i32 = 8;
use crate::engine::world::seams::{ ChannelLevels };
use crate::engine::world::voxstore::VoxStore;
use crate::engine::world::light::engine::{ LightEngine };
use crate::engine::world::mesh::meshbuf::{
    FaceMesh, TorchField, packXZ, packForm, faceKind, faceRun,
};
use crate::engine::world::mesh::facegeom::{ FaceTable, FaceKind, topSteps };
use crate::engine::math::vec3::{ IVec3, ivec3 };
use crate::configs::blocks::{ Block };
use crate::configs::face::{ FaceDir };
use crate::configs::water::{ Water };
use crate::configs::world::{ World };

/**
 * One voxel as the mesher walks it: the slot it is read from, and the same
 * cell twice — chunk-local (what the face arrays store, what the greedy runs
 * key on) and world (what the light is read at). A neighbour one step outside
 * the chunk keeps the slot and carries a local x/z of -1 or chunkSize.
 */
struct MeshCell {
    slot : i32,
    local : IVec3,
    world : IVec3,
}

/**
 * The cell one step away from `c`, in both coordinate frames.
 * @param c   the cell stepped from
 * @param dx  the step along x
 * @param dy  …along y
 * @param dz  …along z
 * @return the neighbour, still read through `c`'s slot
 */
fn stepped(c : MeshCell, dx : i32, dy : i32, dz : i32) : MeshCell {
    return MeshCell {
        slot: c.slot,
        local: ivec3(c.local.x + dx, c.local.y + dy, c.local.z + dz),
        world: ivec3(c.world.x + dx, c.world.y + dy, c.world.z + dz),
    };
}

/**
 * What one build reads: the slot's own voxels, and the light engine for the
 * baked light and for any cell across the chunk border.
 */
struct MeshSource {
    store : VoxStore,
    leng : LightEngine,
}

/** Turn a freshly (re)generated / edited slot's voxels into a render mesh. */
trait Mesher {
    /**
     * Rebuild one slot's mesh from its voxels and baked light.
     * @param src   the voxels and light this build reads
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn buildSlot(mut self, src : MeshSource, slot : i32, cx : i32, cz : i32) : void;
}

class ChunkMesher : Mesher {
    pub(crate) faces : FaceMesh,     // baked render faces, per slot
    pub(crate) torches : TorchField, // torch posts, per slot
    pub(crate) ctop : i16[],         // per-column highest collidable voxel + 1 (entity physics)
    pub(crate) meshGen : i32[],      // per slot, bumped by every rebuild: a retained copy
                                     // of the faces is stale once this moves

    // The open greedy runs. `runU` carries the runs that grow along X — top,
    // bottom and the two Z-facing walls — keyed by (dir, ly) and valid only
    // while `lz` is fixed, because the scan's middle loop is the one that
    // advances X. `runW` carries the X-facing walls, which grow along Z, keyed
    // by (dir, lx, ly) and valid for the whole chunk, because Z is the outer
    // loop. Two tables rather than one because the scan order makes the two
    // families' runs live for different spans, and a run that outlives its
    // span merges across a gap.
    runU : i32[],    // open face index, or -1
    runUAt : i32[],  // the last coordinate that run covered
    runW : i32[],
    runWAt : i32[],
    geom : FaceTable, // where each face corner sits (world::mesh::facegeom), the same
                      // table every renderer reads, so baked corner k is drawn at k

    /**
     * Allocate the per-slot face / torch / collision buffers and the greedy-run
     * scratch, and build the face-corner offset table.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        let faceCap : i32 = slots * World::MAX_FACES_PER_CHUNK;
        let torchCap : i32 = slots * World::MAX_TORCHES_PER_CHUNK;

        self.faces = FaceMesh {
            fcount: malloc<i16>(slots),
            fxz: malloc<i8>(faceCap),
            fy: malloc<i8>(faceCap),
            ftile: malloc<i16>(faceCap),
            fform: malloc<i8>(faceCap),
            flight: Mem::take((faceCap as i64) * 8),
            fao: Mem::take(faceCap as i64),
            ftop: malloc<i16>(faceCap * 4),
            fflow: malloc<i8>(faceCap * 2),
        };
        self.meshGen = malloc<i32>(slots);
        for (s of 0..slots) {
            self.meshGen[s] = 0;
        }
        self.torches = TorchField {
            tx: malloc<i8>(torchCap),
            ty: malloc<i8>(torchCap),
            tz: malloc<i8>(torchCap),
            tcount: malloc<i16>(slots),
        };

        self.ctop = malloc<i16>(slots * World::CHUNK_SIZE * World::CHUNK_SIZE);
        self.runU = malloc<i32>(6 * World::HEIGHT);
        self.runUAt = malloc<i32>(6 * World::HEIGHT);
        self.runW = malloc<i32>(2 * World::CHUNK_SIZE * World::HEIGHT);
        self.runWAt = malloc<i32>(2 * World::CHUNK_SIZE * World::HEIGHT);
        self.geom = FaceTable {};
    }

    /**
     * Append a face to the slot's face buffer (dropped if at capacity), baking
     * its 4 corners' smooth light + AO.
     * @param src   the voxels and light the corners are baked from
     * @param c     the face's voxel
     * @param dir   the face direction
     * @param tile  the atlas tile index
     * @return the face's index in the face arrays, or -1 when the chunk is full
     */
    fn addFace(mut self, src : MeshSource, c : MeshCell, own dir : FaceDir, tile : i32) : i32 {
        let fc : i32 = self.faces.fcount[c.slot];
        if (fc >= World::MAX_FACES_PER_CHUNK) {
            return -1;
        }

        self.addFaceRun(src, c, dir, tile, false);
        return c.slot * World::MAX_FACES_PER_CHUNK + fc;
    }

    /**
     * Emit one face, merging it onto the open run beside it where it can.
     *
     * The face is written and its corners baked FIRST, then compared with
     * the run's head — the comparison is over baked light and AO, so
     * there is nothing to compare until the bake has run. When it merges,
     * the write is simply not committed: `fcount` does not advance and
     * the head's `frun` does.
     *
     * `mergeable` is the caller's, because only the caller knows the
     * block. A water face is out — its corners are per-column heights, so
     * a merged quad would flatten the sloped surface. A partial block is
     * out for the same reason: its top sits at its own stored level.
     *
     * @param src        the voxels and light the corners are baked from
     * @param c          the face's voxel
     * @param dir        the face direction
     * @param tile       the atlas tile
     * @param mergeable  whether this face's geometry is a plain unit quad
     */
    fn addFaceRun(
        mut self,
        src : MeshSource,
        c : MeshCell,
        own dir : FaceDir,
        tile : i32,
        mergeable : bool
    ) : void {
        let fc : i32 = self.faces.fcount[c.slot];
        if (fc >= World::MAX_FACES_PER_CHUNK) {
            return;
        }

        let local : IVec3 = c.local;
        let i : i32 = c.slot * World::MAX_FACES_PER_CHUNK + fc;
        // Chunk-local x and z in a byte, and world y in another: every reader
        // has the slot, and the slot has the origin.
        self.faces.fxz[i] = packXZ(local.x, local.z);
        self.faces.fy[i] = local.y as i8;

        // Pack the face direction (0..5) and atlas tile (< 256) into one slot.
        // renderFace unpacks dir = ftile / 256, tile = ftile % 256.
        let di : i32 = dir as i32;
        self.faces.ftile[i] = (di * 256 + tile) as i16;
        self.faces.fform[i] = packForm(FaceKind::Solid as i32, 1);
        self.setTops(i, di, 1.0);
        self.faces.fflow[i * 2] = 0 as i8;
        self.faces.fflow[i * 2 + 1] = 0 as i8;
        self.bakeFaceCorners(src, i, c.world, di);
        if (!mergeable) {
            self.faces.fcount[c.slot] = (fc + 1) as i16;
            return;
        }

        if (di <= 1) {
            // An X-facing wall grows along Z.
            let k : i32 = (di * World::CHUNK_SIZE + local.x) * World::HEIGHT + local.y;
            let head : i32 = self.runW[k];
            if (head >= 0
                && self.runWAt[k] == local.z - 1
                && self.canMerge(head, i)) {
                self.lengthen(head);
                self.runWAt[k] = local.z;
                return;
            }
            self.runW[k] = i;
            self.runWAt[k] = local.z;
        } else {
            // Everything else grows along X.
            let k : i32 = di * World::HEIGHT + local.y;
            let head : i32 = self.runU[k];
            if (head >= 0
                && self.runUAt[k] == local.x - 1
                && self.canMerge(head, i)) {
                self.lengthen(head);
                self.runUAt[k] = local.x;
                return;
            }
            self.runU[k] = i;
            self.runUAt[k] = local.x;
        }
        self.faces.fcount[c.slot] = (fc + 1) as i16;
    }

    /**
     * One more cell on the run headed by `head`.
     * @param head  the run's face
     */
    fn lengthen(mut self, head : i32) : void {
        self.faces.fform[head] = packForm(faceKind(self.faces, head), faceRun(self.faces, head) + 1);
    }

    /**
     * Say what a face stands on, keeping its run.
     * @param i     the face
     * @param kind  its kind
     */
    fn setKind(mut self, i : i32, own kind : FaceKind) : void {
        self.faces.fform[i] = packForm(kind as i32, faceRun(self.faces, i));
    }

    /**
     * Whether face `b` may join the run headed by `a`.
     *
     * Same tile, and the SAME four baked corner light and AO values. The
     * second half is the one that costs merges and cannot be dropped: a
     * merged quad has four corners and Gouraud-interpolates between them,
     * so absorbing a cell whose corners differ is throwing that cell's
     * lighting away. Measured over a loaded ring, insisting on it turns
     * 103k merge candidates into 74k — a quarter of the opportunity, for
     * all of the lighting.
     *
     * The run is also capped at `MESH_MAX_RUN`, which is the most surface one
     * entry in the baked light arrays is allowed to stand for. The cast shadow
     * is not what caps it — that is sampled at render time, against the sun of
     * the moment, and the renderer cuts the run again wherever it varies.
     *
     * @param a  the run head
     * @param b  the candidate
     * @return whether they are the same face repeated
     */
    fn canMerge(self, a : i32, b : i32) : bool {
        if (self.faces.ftile[a] != self.faces.ftile[b]
            || faceRun(self.faces, a) >= MESH_MAX_RUN) {
            return false;
        }

        for (k of 0..8) {
            if (Mem::byteAt(self.faces.flight, (a * 8 + k) as i64)
                != Mem::byteAt(self.faces.flight, (b * 8 + k) as i64)) {
                return false;
            }
        }

        if (Mem::byteAt(self.faces.fao, a as i64) != Mem::byteAt(self.faces.fao, b as i64)) {
            return false;
        }
        return true;
    }

    /** Forget every open run that grows along X — they do not cross a Z step. */
    fn resetRunsU(mut self) : void {
        for (k of 0..(6 * World::HEIGHT)) {
            self.runU[k as i64] = -1;
        }
    }

    /** Forget every open run that grows along Z — they do not cross a chunk. */
    fn resetRunsW(mut self) : void {
        for (k of 0..(2 * World::CHUNK_SIZE * World::HEIGHT)) {
            self.runW[k as i64] = -1;
        }
    }

    /**
     * Smooth-light + AO bake for one face's 4 corners into flight / fao. Light =
     * average over the NON-opaque cells among the corner's air neighbours; AO =
     * the classic vertex term 3-(side1+side2+corner), 0 when both sides blocked.
     * @param src the light the corners average
     * @param i   the global face index (slot*maxFacesPerChunk + fc)
     * @param w   the face block world voxel
     * @param di  the face direction (0..5)
     */
    fn bakeFaceCorners(mut self, src : MeshSource, i : i32, w : IVec3, di : i32) : void {
        // Normal offset to the air cell this face looks into (di = dir 0..5).
        let mut nox : i32 = 0;
        let mut noy : i32 = 0;
        let mut noz : i32 = 0;
        match di {
            0 => { nox = 1; }
            1 => { nox = -1; }
            2 => { noy = 1; }
            3 => { noy = -1; }
            4 => { noz = 1; }
            _ => { noz = -1; }
        }
        let nb : IVec3 = ivec3(w.x + nox, w.y + noy, w.z + noz);

        // Normal axis: 0 = X (dir 0/1), 1 = Y (2/3), 2 = Z (4/5).
        let naxis : i32 = di / 2;
        // The four corners' occlusion, two bits each, gathered into one byte.
        let mut aoByte : i32 = 0;
        for (k of 0..4) {
            let b : i32 = (di * 4 + k) * 3;
            // Tangent signs from the corner block offset (0 → -1, 1 → +1).
            let sx : i32 = self.geom.coff[b] * 2 - 1;
            let sy : i32 = self.geom.coff[b + 1] * 2 - 1;
            let sz : i32 = self.geom.coff[b + 2] * 2 - 1;

            // The two in-plane neighbour offsets t1, t2 (skip the normal axis).
            let mut t1x : i32 = 0;
            let mut t1y : i32 = 0;
            let t1z : i32 = 0;
            let t2x : i32 = 0;
            let mut t2y : i32 = 0;
            let mut t2z : i32 = 0;
            match naxis {
                0 => {
                    t1y = sy;
                    t2z = sz;
                }
                1 => {
                    t1x = sx;
                    t2z = sz;
                }
                _ => {
                    t1x = sx;
                    t2y = sy;
                }
            }
            // The 4 cells meeting at this corner, all in the nb layer.
            let c1 : IVec3 = ivec3(nb.x + t1x, nb.y + t1y, nb.z + t1z);
            let c2 : IVec3 = ivec3(nb.x + t2x, nb.y + t2y, nb.z + t2z);
            let c3 : IVec3 = ivec3(nb.x + t1x + t2x, nb.y + t1y + t2y, nb.z + t1z + t2z);

            // Smooth light: average sky and each block channel over the
            // non-opaque cells.
            let bl0 : ChannelLevels = src.leng.blGetW(nb);
            let mut skSum : i32 = src.leng.skGetW(nb);
            let mut rSum : i32 = bl0.r;
            let mut gSum : i32 = bl0.g;
            let mut bSum : i32 = bl0.b;
            let mut cnt : i32 = 1;
            let o1 : bool = isOpaque(src.leng.worldGet(c1));
            let o2 : bool = isOpaque(src.leng.worldGet(c2));
            let o3 : bool = isOpaque(src.leng.worldGet(c3));
            if (!o1) {
                let bl1 : ChannelLevels = src.leng.blGetW(c1);
                skSum += src.leng.skGetW(c1);
                rSum += bl1.r;
                gSum += bl1.g;
                bSum += bl1.b;
                cnt++;
            }
            if (!o2) {
                let bl2 : ChannelLevels = src.leng.blGetW(c2);
                skSum += src.leng.skGetW(c2);
                rSum += bl2.r;
                gSum += bl2.g;
                bSum += bl2.b;
                cnt++;
            }
            if (!o3) {
                let bl3 : ChannelLevels = src.leng.blGetW(c3);
                skSum += src.leng.skGetW(c3);
                rSum += bl3.r;
                gSum += bl3.g;
                bSum += bl3.b;
                cnt++;
            }

            let half : i32 = cnt / 2;
            let o : i64 = ((i * 4 + k) * 2) as i64;
            let skyRed : i32 = ((skSum + half) / cnt) * 16 + (rSum + half) / cnt;
            let greenBlue : i32 = ((gSum + half) / cnt) * 16 + (bSum + half) / cnt;
            Mem::putByte(self.faces.flight, o, skyRed);
            Mem::putByte(self.faces.flight, o + 1, greenBlue);

            // Ambient occlusion (0..3): both sides blocked → fully dark corner.
            let mut s1 : i32 = 0;
            if (o1) {
                s1 = 1;
            }
            let mut s2 : i32 = 0;
            if (o2) {
                s2 = 1;
            }
            let mut sc : i32 = 0;
            if (o3) {
                sc = 1;
            }
            let mut ao : i32 = 3 - (s1 + s2 + sc);
            if (s1 == 1 && s2 == 1) {
                ao = 0;
            }
            aoByte |= ao << (2 * k);
        }
        Mem::putByte(self.faces.fao, i as i64, aoByte);
    }

    /**
     * Record a torch in this slot's torch list (dropped if at capacity). The
     * renderer draws these as thin posts, at the slot's origin plus the
     * chunk-local cell stored here.
     * @param c  the torch's cell
     */
    fn addTorch(mut self, c : MeshCell) : void {
        let tc : i32 = self.torches.tcount[c.slot];
        if (tc >= World::MAX_TORCHES_PER_CHUNK) {
            return;
        }

        let i : i32 = c.slot * World::MAX_TORCHES_PER_CHUNK + tc;
        self.torches.tx[i] = c.local.x as i8;
        self.torches.ty[i] = c.local.y as i8;
        self.torches.tz[i] = c.local.z as i8;
        self.torches.tcount[c.slot] = (tc + 1) as i16;
    }

    /**
     * Stand face `i`'s top corners at one height, its bottom corners on the
     * cell's floor.
     * @param i   the face index
     * @param di  the face direction (0..5)
     * @param h   the top corners' height in cells (1.0 = the top of the cell)
     */
    fn setTops(mut self, i : i32, di : i32, h : f64) : void {
        let top : i32 = topSteps(h);
        for (k of 0..4) {
            let oy : i32 = self.geom.coff[(di * 4 + k) * 3 + 1];
            self.faces.ftop[i * 4 + k] = (oy * top) as i16;
        }
    }

    /**
     * Emit one face of a water block, with its top corners on the sloped
     * surface and the flow its texture scrolls along.
     * @param src  the voxels read
     * @param c    the water voxel
     * @param id   its block
     * @param dir  the face direction
     */
    fn addWaterFace(mut self, src : MeshSource, c : MeshCell, id : Block, own dir : FaceDir) : void {
        let di : i32 = dir as i32;
        let i : i32 = self.addFace(src, c, dir, tileFor(id, dir));
        if (i < 0) {
            return;
        }

        self.setKind(i, FaceKind::Water);
        for (k of 0..4) {
            let b : i32 = (di * 4 + k) * 3;
            if (self.geom.coff[b + 1] > 0) {
                let h : f64 = self.waterCornerY(src, c, self.geom.coff[b], self.geom.coff[b + 2]);
                self.faces.ftop[i * 4 + k] = topSteps(h) as i16;
            }
        }

        // Flowing water scrolls toward the lower level; a still lake has no
        // gradient, so it does not move.
        let lpx : i32 = fluidLevel(self.beside(src, stepped(c, 1, 0, 0)));
        let lnx : i32 = fluidLevel(self.beside(src, stepped(c, -1, 0, 0)));
        let lpz : i32 = fluidLevel(self.beside(src, stepped(c, 0, 0, 1)));
        let lnz : i32 = fluidLevel(self.beside(src, stepped(c, 0, 0, -1)));
        self.faces.fflow[i * 2] = (lpx - lnx) as i8;
        self.faces.fflow[i * 2 + 1] = (lpz - lnz) as i8;
    }

    /**
     * Emit one face of a partial block, its top corners lowered to the box. A
     * box that fills its cell is a plain quad.
     * @param src   the voxels read
     * @param c     the block's voxel
     * @param id    its block
     * @param dir   the face direction
     * @param boxH  the block's box height (1.0 = a full cube)
     */
    fn addPartialFace(
        mut self,
        src : MeshSource,
        c : MeshCell,
        id : Block,
        own dir : FaceDir,
        boxH : f64
    ) : void {
        let di : i32 = dir as i32;
        let i : i32 = self.addFace(src, c, dir, tileFor(id, dir));
        if (i < 0 || boxH >= 1.0) {
            return;
        }

        self.setKind(i, FaceKind::Partial);
        self.setTops(i, di, boxH);
    }

    /**
     * What one column adds to the water corner it meets:
     *   above 1 → a source, or water under water (a column): the corner stays
     *             full, so lakes are flat and waterfalls solid;
     *   0..1    → a flowing surface at level/8, or the lip Water::EDGE_HEIGHT
     *             for air, so a free edge eases down instead of stepping;
     *   below 0 → solid: the column has no say.
     * @param src  the voxels read
     * @param c    the water voxel the face belongs to
     * @param dx   the column's x step from it
     * @param dz   the column's z step from it
     * @return the column's share, as above
     */
    fn cornerColumn(self, src : MeshSource, c : MeshCell, dx : i32, dz : i32) : f64 {
        let n : MeshCell = stepped(c, dx, 0, dz);
        let id : Block = self.beside(src, n);
        if (id == Block::Air) {
            return Water::EDGE_HEIGHT;
        }
        if (!isWater(id)) {
            return -1.0;
        }
        if (isSource(id) || isWater(self.beside(src, stepped(n, 0, 1, 0)))) {
            return 2.0;
        }
        return (fluidLevel(id) as f64) / 8.0;
    }

    /**
     * Sloped-surface height at a top corner shared by up to four water columns,
     * Minecraft-style: full when any of them is a source or a falling column,
     * otherwise the average of their shares (see `cornerColumn`).
     * @param src  the voxels read
     * @param c    the water voxel the face belongs to
     * @param ox   the corner's x offset in the cell (0 or 1)
     * @param oz   the corner's z offset in the cell (0 or 1)
     * @return the corner height fraction (0..1)
     */
    fn waterCornerY(self, src : MeshSource, c : MeshCell, ox : i32, oz : i32) : f64 {
        let mut sum : f64 = 0.0;
        let mut cnt : i32 = 0;
        for (dz of oz - 1..=oz) {
            for (dx of ox - 1..=ox) {
                let share : f64 = self.cornerColumn(src, c, dx, dz);
                if (share > 1.0) {
                    return 1.0;
                }
                if (share >= 0.0) {
                    sum += share;
                    cnt++;
                }
            }
        }

        if (cnt == 0) {
            return 1.0;
        }
        return sum / (cnt as f64);
    }

    /**
     * Should a partial block of height `myH` emit a side wall toward the neighbour
     * cell? Yes against air or a strictly LOWER partial block; no against a full
     * block or an equal/higher partial (avoids an internal z-fighting grid).
     * @param src  the voxels read
     * @param n    the neighbour cell
     * @param myH  this block's box height
     * @return whether to emit the side wall toward the neighbour
     */
    fn partialSideOpen(self, src : MeshSource, n : MeshCell, myH : f64) : bool {
        let nb : Block = self.beside(src, n);
        if (nb == Block::Air) {
            return true;
        }
        if (!isPartialShape(nb)) {
            return false;
        }

        // The neighbour's box comes from the neighbour's own stored level,
        // read from the same chunk as its id — so the wall a step between two
        // snow depths shows is the step that is really there.
        let neighbourBox = boxOf(nb, self.besideLevel(src, n));
        return neighbourBox.yMax < myH - 0.001;
    }

    /**
     * Whether a cell lies inside the chunk being meshed, so its slot holds it.
     * @param c  the cell
     * @return true unless its local x or z stepped over the border
     */
    fn inChunk(self, c : MeshCell) : bool {
        let s : i32 = World::CHUNK_SIZE;
        return c.local.x >= 0 && c.local.x < s && c.local.z >= 0 && c.local.z < s;
    }

    /**
     * The block in a cell beside the one being meshed.
     *
     * Inside the chunk that is this slot's own cell. On the border it is the
     * neighbour chunk's, and the slot no longer keeps a copy of it: the read
     * goes to the chunk that owns the cell, which is also the only chunk that
     * is ever right about it.
     * @param src  the voxels read
     * @param n    the neighbour cell (its local x/z may be -1 or chunkSize)
     * @return the block there; a wall where no chunk is loaded
     */
    fn beside(self, src : MeshSource, n : MeshCell) : Block {
        if (self.inChunk(n)) {
            return src.store.getVox(n.slot, n.local);
        }
        return src.leng.worldGetOrWall(n.world);
    }

    /**
     * The stored level of a cell beside the one being meshed — same lookup as
     * `beside`, so a partial block's height comes from the chunk its id did.
     * @param src  the voxels read
     * @param n    the neighbour cell
     * @return the level, 0 for the id's default box
     */
    fn besideLevel(self, src : MeshSource, n : MeshCell) : i32 {
        if (self.inChunk(n)) {
            return src.store.getLevel(n.slot, n.local);
        }
        return src.leng.worldLevel(n.world);
    }

    /**
     * Re-bake the chunk's faces from its voxels: every block emits a face on each
     * side that borders air. Water draws only its top surface + air-bordering
     * walls; a partial block its raised top + step walls; a solid block a face
     * wherever its neighbour is transparent. Each column's `ctop` is the highest
     * collidable voxel + 1. Directions match render.renderFace normals:
     * 0:+x 1:-x 2:+y(top) 3:-y(bottom) 4:+z 5:-z.
     * @param src   the voxels and light this build reads
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    fn buildSlot(mut self, src : MeshSource, slot : i32, cx : i32, cz : i32) : void {
        self.faces.fcount[slot] = 0;
        self.torches.tcount[slot] = 0;
        self.meshGen[slot] += 1;
        let s : i32 = World::CHUNK_SIZE;
        let top : i32 = src.store.faceTop(slot);
        let air : Block = Block::Air;

        self.resetRunsW();
        for (lz of 0..s) {
            self.resetRunsU();
            for (lx of 0..s) {
                let mut coll : i32 = 0;
                for (ly of 0..=top) {
                    let local : IVec3 = ivec3(lx, ly, lz);
                    let id : Block = src.store.getVox(slot, local);
                    // Non-air voxel: emit its faces; a collidable solid raises the
                    // column's collision top.
                    if (id != air) {
                        let c : MeshCell = MeshCell {
                            slot,
                            local,
                            world: ivec3(cx * s + lx, ly, cz * s + lz),
                        };
                        if (self.meshVoxel(src, c, id)) {
                            coll = ly + 1;
                        }
                    }
                }
                self.ctop[slot * s * s + lz * s + lx] = coll as i16;
            }
        }
    }

    /**
     * Emit the mesh faces for one non-air voxel: a torch records a post (no cube
     * faces), water shows its surface + air-bordering walls, a partial block its
     * raised top + step walls toward lower neighbours, and a solid block a face
     * wherever its neighbour is transparent.
     * @param src the voxels and light this build reads
     * @param c   the voxel
     * @param id  the voxel's block id (already known to be non-air)
     * @return true if the voxel is collidable (so the caller raises the column top)
     */
    fn meshVoxel(mut self, src : MeshSource, c : MeshCell, id : Block) : bool {
        let air : Block = Block::Air;
        if (id == Block::Torch) {
            // Torches emit no cube faces; a thin post is drawn separately.
            self.addTorch(c);
            return false;
        }

        // Above and below never leave the column, so they read the slot directly.
        let above : Block = src.store.getVox(c.slot, stepped(c, 0, 1, 0).local);

        if (isWater(id)) {
            // Water: top surface, plus side walls only where it borders air.
            if (above == air) {
                self.addWaterFace(src, c, id, FaceDir::Top);
            }
            if (self.beside(src, stepped(c, 1, 0, 0)) == air) {
                self.addWaterFace(src, c, id, FaceDir::PosX);
            }
            if (self.beside(src, stepped(c, -1, 0, 0)) == air) {
                self.addWaterFace(src, c, id, FaceDir::NegX);
            }
            if (self.beside(src, stepped(c, 0, 0, 1)) == air) {
                self.addWaterFace(src, c, id, FaceDir::PosZ);
            }
            if (self.beside(src, stepped(c, 0, 0, -1)) == air) {
                self.addWaterFace(src, c, id, FaceDir::NegZ);
            }
            return false;
        }

        if (isPartialShape(id)) {
            // A partial, floor-resting block at its real height. Emit the top, and
            // a side wall toward a neighbour that is air OR a LOWER partial block.
            let box = boxOf(id, src.store.getLevel(c.slot, c.local));
            let myH : f64 = box.yMax;
            let boxH : f64 = box.height();
            self.addPartialFace(src, c, id, FaceDir::Top, boxH);
            if (self.partialSideOpen(src, stepped(c, 1, 0, 0), myH)) {
                self.addPartialFace(src, c, id, FaceDir::PosX, boxH);
            }
            if (self.partialSideOpen(src, stepped(c, -1, 0, 0), myH)) {
                self.addPartialFace(src, c, id, FaceDir::NegX, boxH);
            }
            if (self.partialSideOpen(src, stepped(c, 0, 0, 1), myH)) {
                self.addPartialFace(src, c, id, FaceDir::PosZ, boxH);
            }
            if (self.partialSideOpen(src, stepped(c, 0, 0, -1), myH)) {
                self.addPartialFace(src, c, id, FaceDir::NegZ, boxH);
            }
            return false;
        }

        // A solid block shows a face wherever its neighbour is TRANSPARENT — air
        // or water — so submerged terrain stays visible through the water.
        let atPosX = self.beside(src, stepped(c, 1, 0, 0));
        if (isTransparent(atPosX)) {
            let tile = tileFor(id, FaceDir::PosX);
            self.addFaceRun(src, c, FaceDir::PosX, tile, true);
        }
        let atNegX = self.beside(src, stepped(c, -1, 0, 0));
        if (isTransparent(atNegX)) {
            let tile = tileFor(id, FaceDir::NegX);
            self.addFaceRun(src, c, FaceDir::NegX, tile, true);
        }
        // A partial block above (snow, a slab) is transparent but seals this top
        // from view (its own raised top renders double-sided). A normal
        // transparent block above keeps this top.
        if (isTransparent(above) && !isPartialShape(above)) {
            let tile = tileFor(id, FaceDir::Top);
            self.addFaceRun(src, c, FaceDir::Top, tile, true);
        }
        let below = src.store.getVox(c.slot, stepped(c, 0, -1, 0).local);
        if (isTransparent(below)) {
            let tile = tileFor(id, FaceDir::Bottom);
            self.addFaceRun(src, c, FaceDir::Bottom, tile, true);
        }
        let atPosZ = self.beside(src, stepped(c, 0, 0, 1));
        if (isTransparent(atPosZ)) {
            let tile = tileFor(id, FaceDir::PosZ);
            self.addFaceRun(src, c, FaceDir::PosZ, tile, true);
        }
        let atNegZ = self.beside(src, stepped(c, 0, 0, -1));
        if (isTransparent(atNegZ)) {
            let tile = tileFor(id, FaceDir::NegZ);
            self.addFaceRun(src, c, FaceDir::NegZ, tile, true);
        }
        return isCollidable(id);
    }
}
