// meshbuf — the render-mesh buffer layouts and the chunk ring, in a leaf so the
// mesher (which owns and writes the mesh), the renderer (which reads it) and the
// world manager and light engine (which share the ring) can name the field
// layout regardless of module order. Plain data: raw `i32[]` / `i64` buffers,
// no behaviour.

/**
 * The baked render-mesh faces, one set shared by the whole chunk ring: a
 * per-slot face count plus SoA face attributes — world cell (fx/fy/fz), the
 * packed (dir<<8|tile) and the per-corner smooth light / AO byte volumes. The
 * mesher writes them, the renderer reads them; grouped so the mesher holds one
 * field, not seven.
 */
struct FaceMesh {
    pub(crate) fcount : i16[], // face count per slot — under MAX_FACES_PER_CHUNK
    pub(crate) fxz : i8[],     // the face's cell, CHUNK-LOCAL x and z (0..15 each), a
                               // nibble each: read with `faceX` / `faceZ`. The slot's
                               // origin makes it a world cell
    pub(crate) fy : i8[],      // ... and its world y
    pub(crate) ftile : i16[],  // packs (dir << 8) | tile — see ChunkMesher.addFace
    pub(crate) fform : i8[],   // what the face stands on and how far it runs: `faceKind`
                               // (a FaceKind, 2 bits) and `faceRun` (the cells it spans
                               // along its merge axis, 1..MESH_MAX_RUN, 3 bits)
    pub(crate) flight : i64,   // per-face SMOOTH light: 8 bytes/face, TWO per corner —
                               // (sky << 4) | blockR, then (blockG << 4) | blockB. Four
                               // nibbles, because block light has a colour and the sky
                               // does not (Minecraft-style smooth light, per channel)
    pub(crate) fao : i64,      // per-face ambient occlusion: ONE byte/face, two bits
                               // per corner (0..3), corner k at bits 2k..2k+1
    pub(crate) ftop : i16[],   // 4/face: corner k's height above the face's cell,
                               // in FaceTop::STEPS — 0 or full for a unit quad, the
                               // sloped water surface, a partial block's box top
    pub(crate) fflow : i8[],   // 2/face: a water face's flow, the level difference
                               // across it along x then z (0 for the rest)
}

/**
 * A face's chunk-local cell column, as `FaceMesh.fxz` holds it.
 * @param x  the local x, 0..15
 * @param z  the local z, 0..15
 * @return the packed byte
 */
fn packXZ(x : i32, z : i32) : i8 {
    return (x | (z << 4)) as i8;
}

/**
 * A face's local x.
 * @param m  the faces
 * @param i  the face
 * @return 0..15
 */
fn faceX(m : FaceMesh, i : i32) : i32 {
    return (m.fxz[i] as i32) & 15;
}

/**
 * A face's local z.
 * @param m  the faces
 * @param i  the face
 * @return 0..15
 */
fn faceZ(m : FaceMesh, i : i32) : i32 {
    return ((m.fxz[i] as i32) >> 4) & 15;
}

/**
 * A face's kind and run, as `FaceMesh.fform` holds them.
 * @param kind  a `FaceKind` discriminant, 0..2
 * @param run   the cells it spans, 1..8
 * @return the packed byte
 */
fn packForm(kind : i32, run : i32) : i8 {
    return (kind | ((run - 1) << 2)) as i8;
}

/**
 * What a face stands on.
 * @param m  the faces
 * @param i  the face
 * @return its `FaceKind` discriminant
 */
fn faceKind(m : FaceMesh, i : i32) : i32 {
    return (m.fform[i] as i32) & 3;
}

/**
 * How many cells a face spans along its merge axis.
 * @param m  the faces
 * @param i  the face
 * @return 1..8
 */
fn faceRun(m : FaceMesh, i : i32) : i32 {
    return (((m.fform[i] as i32) >> 2) & 7) + 1;
}

/** Per-slot torch posts (drawn as thin columns, not cubes): world x/y/z + count. */
struct TorchField {
    pub(crate) tx : i8[],      // torch cell, CHUNK-LOCAL x/z and world y — the
    pub(crate) ty : i8[],      // slot's origin is the renderer's to add, as for
    pub(crate) tz : i8[],      // the faces
    pub(crate) tcount : i16[], // torch count per slot — under MAX_TORCHES_PER_CHUNK
}

/**
 * The chunk ring's per-slot ownership: which chunk each slot holds, and whether
 * it holds one. A class rather than a struct because the manager and the light
 * engine both hold it, as a `Shared<ColumnRing>`.
 */
class ColumnRing {
    pub(crate) cxs : i32[],
    pub(crate) czs : i32[],
    pub(crate) loaded : i8[],

    /**
     * Allocate the ring's per-slot fields.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        self.cxs = malloc<i32>(slots);
        self.czs = malloc<i32>(slots);
        self.loaded = malloc<i8>(slots);
    }
}
