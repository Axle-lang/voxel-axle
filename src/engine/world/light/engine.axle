// engine — the voxel lighting engine: the levels, the flood, the two ray bakes,
// the surface they bake into, and the read seam the mesher and the renderer sample.
//
//   volumes     block light per channel + sky light, per voxel (value struct of addresses)
//   flood       those levels, re-flooded on every edit
//   surface     sun visibility, sky access and the bounce tint, kept at the surface
//   sun         soft directional shadows, baked by rays on the light task
//   skyaccess   hemispherical sky access + one-bounce tint, same thread
//   sample      reading the surface back, per cell or per face corner
//
// Each component holds its own `RingView` over the voxel field and the ring,
// both co-owned with the manager, so the light task reaches the live world
// with no copy; each holds the same `LightVolumes` value, and the bakes co-own
// the one `SurfaceLight`. `ChunkManager` composes one of these and delegates its
// light seams to it.

use crate::engine::math::vec3::{ IVec3, vec3 };
use crate::engine::world::voxstore::{ VoxStore, VoxData };
use crate::engine::world::mesh::meshbuf::{ ColumnRing };
use crate::engine::world::ring::{ RingView };
use crate::engine::world::light::volumes::{ LightVolumes, newVolumes, clearVolumes };
use crate::engine::world::light::surface::{ SurfaceLight };
use crate::engine::world::light::flood::{ LightFlood, levelAt, channelsAt };
use crate::engine::world::light::sun::{ SunShadows };
use crate::engine::world::light::skyaccess::{ SkyAccess };
use crate::engine::world::light::sample::{ cellSample, cornerAverage };
use crate::engine::world::seams::{
    LightSample, LightMoment, CornerProbe, CornerSample, ChannelLevels,
};
use crate::engine::shade::daymodel::{ SkyBodyLight, activeBody };
use crate::engine::sky::cloud::{ cloudFieldAt };
use crate::configs::blocks::{ Block };
use crate::configs::light::{ Light };
use crate::configs::time::{ Daylight };

/**
 * The throttled per-frame light bake capability (directional sun soft-shadows +
 * hemispherical sky-access / one-bounce GI), run by the background light task.
 */
trait LightBaker {
    /**
     * One pass of the throttled bake: refresh the sun shadows and drain any
     * pending sky-access / bounce work.
     */
    fn stepBake(mut self) : void;
}

class LightEngine : LightSample, LightBaker {
    ring : RingView,              // this engine's view of the world, for the reads
    vols : LightVolumes,          // the per-voxel light levels
    surface : Shared<SurfaceLight>, // what the ray bakes leave at the surface
    flood : LightFlood,           // block + sky light, and the re-mesh flags
    sun : SunShadows,             // the directional shadow bake
    sky : SkyAccess,              // the sky-access / bounce bake
    moment : LightMoment,         // the hour, the clock and the camera column, published
                                  // by the main loop — everything the bake needs about now
    momentSeq : AtomicI32,        // odd while `moment` is being written (a seqlock)
    lightRunning : AtomicBoolean, // false tells the light task to exit (quit)

    /**
     * Compose the light components over a shared voxel field + ring ownership.
     * @param field  the voxel field, co-owned with the manager
     * @param cols   the chunk ring, co-owned with the manager
     * @param slots  the number of ring slots (span * span)
     */
    constructor(own field : Shared<VoxData>, own cols : Shared<ColumnRing>, slots : i32) {
        self.vols = newVolumes(slots);
        let surface : Shared<SurfaceLight> = new shared SurfaceLight(slots);
        self.surface = surface;
        self.ring = new RingView(new VoxStore(field), cols);
        self.flood = new LightFlood(new RingView(new VoxStore(field), cols), self.vols, slots);
        self.sun = new SunShadows(new RingView(new VoxStore(field), cols), self.vols, surface, slots);
        self.sky = new SkyAccess(new RingView(new VoxStore(field), cols), self.vols, surface, slots);
        self.moment = LightMoment {
            dayTime: Daylight::START,
            seconds: 0.0,
            camX: 0,
            camZ: 0,
        };
        self.momentSeq = new AtomicI32(0);
        self.lightRunning = new AtomicBoolean(true);
    }

    // ── The world, as the mesher reads it ───────────────────────

    /**
     * Block id at a world voxel; bedrock below 0, air above / unloaded.
     * @param cell  the world voxel
     * @return the block id there
     */
    pub(crate) fn worldGet(self, cell : IVec3) : Block {
        return self.ring.worldGet(cell);
    }

    /**
     * A world voxel for the mesher's neighbour reads: a wall past the ring.
     * @param cell  the world voxel
     * @return the block id, or Stone past the ring
     */
    pub(crate) fn worldGetOrWall(self, cell : IVec3) : Block {
        return self.ring.worldGetOrWall(cell);
    }

    /**
     * The stored level of a world cell; 0 outside the loaded ring.
     * @param cell  the world voxel
     * @return the cell's level, or 0 for "the id's default box"
     */
    pub(crate) fn worldLevel(self, cell : IVec3) : i32 {
        return self.ring.worldLevel(cell);
    }

    // ── Slot lifecycle ──────────────────────────────────────────

    /**
     * Flag a slot's light as changed so the manager re-meshes it.
     * @param slot  the slot index
     */
    pub(crate) fn markDirty(mut self, slot : i32) : void {
        self.flood.markDirty(slot);
    }

    /**
     * Flag a chunk dirty, but only if it is currently loaded at (cx, cz).
     * @param cx  the chunk x coordinate
     * @param cz  the chunk z coordinate
     */
    pub(crate) fn markDirtyAt(mut self, cx : i32, cz : i32) : void {
        self.flood.markDirtyAt(cx, cz);
    }

    /**
     * Consume a slot's re-mesh flag: return whether it was set, clearing it.
     * @param slot  the slot index
     * @return whether the flag was set
     */
    pub(crate) fn takeDirty(mut self, slot : i32) : bool {
        return self.flood.takeDirty(slot);
    }

    /**
     * Flag a slot's RAY passes for a re-bake after its geometry changed: the
     * hemispherical sky access, and the sun shadows too — the round-robin would
     * reach the slot eventually, but "eventually" is a second, and a block the
     * player just placed should cast its shadow as it lands.
     * @param slot  the slot index
     */
    pub(crate) fn flagSkyAO(mut self, slot : i32) : void {
        self.sky.markDirty(slot);
        self.sun.markDirty(slot);
    }

    /**
     * Reset a slot's light for a freshly (re)generated chunk, and queue both
     * ray bakes for it.
     * @param slot  the slot index
     */
    pub(crate) fn clearLight(mut self, slot : i32) : void {
        clearVolumes(self.vols, slot);
        self.surface.clear(slot);
        self.sky.markDirty(slot);
        self.sun.markDirty(slot);
    }

    /**
     * Seed sky light for a freshly generated chunk.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     */
    pub(crate) fn seedSky(mut self, slot : i32, cx : i32, cz : i32) : void {
        self.flood.seedSky(slot, cx, cz);
    }

    /**
     * Recompute block + sky light after an edit at a world voxel.
     * @param cell  the edited world voxel
     */
    pub(crate) fn lightUpdate(mut self, cell : IVec3) : void {
        self.flood.lightUpdate(cell);
    }

    // ── The read seam (LightSample) ─────────────────────────────

    /**
     * Block light per channel (0..15 each) at a world voxel; 0 if unloaded.
     * @param cell  the world voxel
     * @return the red, green and blue block-light levels
     */
    fn blGetW(self, cell : IVec3) : ChannelLevels {
        return channelsAt(self.ring, self.vols, cell);
    }

    /**
     * Sky-light level (0..15) at a world voxel; 0 if unloaded / out of range.
     * @param cell  the world voxel
     * @return the sky-light level 0..15
     */
    fn skGetW(self, cell : IVec3) : i32 {
        return levelAt(self.ring, self.vols.sky(), cell);
    }

    /**
     * Sun visibility at a world voxel: 0 (shadow) .. 255 (full sun).
     * @param cell  the world voxel
     * @return soft sun visibility 0..255
     */
    fn sunlitGet(self, cell : IVec3) : i32 {
        return cellSample(self.ring, self.surface, cell).sun;
    }

    /**
     * Sky access 0..255 at a world voxel: 255 = fully open.
     * @param cell  the world voxel
     * @return the sky access 0..255
     */
    fn skyaccessGet(self, cell : IVec3) : i32 {
        return cellSample(self.ring, self.surface, cell).sky;
    }

    /**
     * Packed one-bounce coloured tint at a world voxel.
     * @param cell  the world voxel
     * @return the packed bounce tint (0xRRGGBB)
     */
    fn bounceGet(self, cell : IVec3) : i32 {
        return cellSample(self.ring, self.surface, cell).bounce;
    }

    /**
     * Sun, sky access and bounce averaged over the four air cells at a face corner.
     * @param probe  the corner's cell and its two in-plane tangent steps
     * @return the averaged sample at that corner
     */
    fn cornerSample(self, probe : CornerProbe) : CornerSample {
        return cornerAverage(self.ring, self.surface, probe);
    }

    // ── The light task ────────────────────────────────────────

    /**
     * Light the whole loaded ring NOW, and do not come back until it is lit.
     *
     * The world is generated before the first frame; this is the other half of
     * that. Left to the light task, the ring is lit over the first tenth of a
     * second of play, and a tenth of a second is long enough to watch the shadows
     * and the ambient occlusion arrive — the world appears, and THEN it is lit.
     * Called once from the startup path, where the cost is a load and not a
     * stutter.
     *
     * ONE pass is the whole ring: both bakes see a backlog the size of the ring
     * and take their crew path, which drains it rather than budgeting it. The
     * light task then only ever has the sun's own movement to keep up with.
     */
    pub(crate) fn primeLight(mut self) : void {
        self.stepBake();
    }

    /**
     * One pass of the whole lighting system: refresh the directional sun-shadow
     * map and bake any pending hemispherical sky-access / colour-bounce. Run by
     * the dedicated light task, reading the time of day the main loop publishes.
     */
    fn stepBake(mut self) : void {
        // The clouds move on their own clock and the shadows are cast through
        // them, so the deck is re-marched before the ring is: a shadow bake
        // reading last pass's cloud would put the dark patch where the cloud has
        // already left.
        let now : LightMoment = self.readMoment();
        let body : SkyBodyLight = activeBody(now.dayTime);
        self.sun.rebakeClouds(
            cloudFieldAt(now.seconds),
            vec3(body.dirX, body.dirY, body.dirZ),
            now.camX,
            now.camZ
        );
        self.sun.step(now.dayTime, Daylight::SUN_CHUNKS_PER_TICK);
        self.sky.step(Light::SKY_AO_CHUNKS_PER_TICK);
    }

    /**
     * Publish the moment the background light task bakes against (main
     * thread). The sequence is odd while the four fields are being written, so
     * a reader can tell a half-written moment from a whole one.
     * @param m  the hour, clock and camera column to bake for
     */
    pub(crate) fn setMoment(mut self, m : LightMoment) : void {
        let begin : i32 = self.momentSeq.incrementAndGet();
        self.moment = m;
        let end : i32 = self.momentSeq.incrementAndGet();
    }

    /**
     * The last moment published, whole (light task). Read once a pass and
     * used for everything in it: a bake that mixed this frame's hour with last
     * frame's wind would put a cloud's shadow where the cloud is not.
     * @return a consistent copy of the moment
     */
    fn readMoment(self) : LightMoment {
        while (true) {
            let before : i32 = self.momentSeq.get();
            if ((before & 1) == 0) {
                let copy : LightMoment = self.moment;
                if (self.momentSeq.get() == before) {
                    return copy;
                }
            }
        }
        return self.moment;
    }

    /**
     * How many times a slot's sun visibility, sky access and bounce have been rebaked:
     * a renderer that keeps its own copy of them re-reads the slot when this moves.
     * @param slot  the ring slot
     * @return the slot's light generation
     */
    pub(crate) fn lightGen(self, slot : i32) : i32 {
        return self.surface.generation(slot);
    }

    /** A frame has been drawn: the surface tables it could have read are safe to free. */
    pub(crate) fn frameDone(mut self) : void {
        self.surface.frameDone();
    }

    /**
     * The memory the surface light holds.
     * @return its bytes
     */
    pub(crate) fn surfaceBytes(self) : i64 {
        return self.surface.bytesInUse();
    }

    /** Tell the background light task to stop (call before awaiting it). */
    pub(crate) fn stopLight(mut self) : void {
        self.lightRunning.set(false);
    }

    /**
     * Whether the background light task should keep running.
     * @return false once `stopLight` has been called
     */
    pub(crate) fn lightAlive(self) : bool {
        return self.lightRunning.get();
    }

    /**
     * Whether the bakes still owe work: a slot waiting for its shadow map or
     * its sky access. What the light loop paces itself on — a tick that finds
     * work comes back at once, an idle world sleeps the long interval.
     * @return true while any loaded slot is owed a bake
     */
    pub(crate) fn lightOwed(self) : bool {
        return self.sun.owed() || self.sky.owed();
    }

    /**
     * The light task is starting: from now on the bakes run while frames read
     * (light task, before its first bake).
     */
    pub(crate) fn lightStarted(mut self) : void {
        self.surface.shareWithReaders();
    }
}
