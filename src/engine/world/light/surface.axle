// surface — the light the two ray bakes leave at the surface: soft sun visibility,
// sky access and the one-bounce tint, kept only where a face can read them.
//
// A face corner reads them in the air cells that touch a block, and the bakes write
// them only in the sky-lit ones among those (`bake::scanShell`): a shell of air over
// the terrain, a cell or a few a column — about one cell in eighty. Stored for every
// cell of the ring they were five bytes of each of nine and a half million cells,
// forty-seven megabytes holding mostly "open air". So each slot keeps a table of its
// own: per column, the run of cells from its lowest shell cell to its highest, five
// bytes a cell. A cell outside its column's run reads as open air — full sun, open
// sky, a neutral tint — which is what the old volumes held there too.
//
// A table is one block:
//
//     byte    0  i32  the slot's load it was built for
//     byte    4  i32  cells
//     byte    8  i64  the next table retired before it (see Threads)
//     byte   16  i64  the frame count it was retired at
//     byte   24  256 x i32  per column (z * 16 + x): first y | run << 8 | first cell << 16
//     byte 1048  5 bytes a cell: sun, sky, bounce red, green, blue
//
// # Threads
//
// The bakes run on the light thread — a crew of workers over disjoint slots — and
// each builds its slot's table; the renderers read the tables during frames, on the
// main thread and the raster crew. A bake that finds the runs unchanged writes into
// the table in place, a byte at a time, as the volumes always were written. One whose
// runs changed fills a new table and publishes it: a full fence, then one aligned
// eight-byte store of its address, so a reader finds the old table whole or the new
// one whole. The old one is retired, and freed once a frame has completed since
// (`frameDone`): a reader that could have found it was in a frame that has ended.
// Until the light thread starts (`shareWithReaders`) nothing reads while the bakes
// write, and a retired table is freed at once.
//
// A chunk streamed into a slot (`clear`, on the main thread) only counts a new load:
// a table built for another load reads as open air until the bake the load queued
// replaces it. The main thread never writes a table, so every slot has one writer.

use smalt::Mem;
use crate::engine::world::seams::{ CornerSample };
use crate::configs::world::{ World };

/** What a cell no bake wrote reads as: full sun, open sky, a neutral tint. */
const OPEN_SUN : i32 = 255;
const OPEN_SKY : i32 = 255;
const NEUTRAL_TINT : i32 = 128;
const OPEN_BOUNCE : i32 = 0x808080;

/** Where a table's fields are (see the header). */
const TABLE_LOAD : i64 = 0;
const TABLE_CELLS : i64 = 4;
const TABLE_NEXT : i64 = 8;
const TABLE_RETIRED_AT : i64 = 16;
const TABLE_COLUMNS : i64 = 24;
const TABLE_VALUES : i64 = 1048;

/** Bytes a cell holds, and where each value is among them. */
const CELL_BYTES : i64 = 5;
const CELL_SUN : i64 = 0;
const CELL_SKY : i64 = 1;
const CELL_RED : i64 = 2;
const CELL_GREEN : i64 = 3;
const CELL_BLUE : i64 = 4;

/** Columns in a slot. */
const SLOT_COLUMNS : i32 = 256;

/**
 * Which cells of a slot the bakes write: the shell found by `bake::scanShell`, as one
 * bit a cell and the run each column keeps.
 */
struct ShellScan {
    pub(crate) bits : i64,     // 256 columns x World::HEIGHT bits, column-major
    pub(crate) columns : i64,  // 256 packed column runs, as a table holds them
    pub(crate) cells : i32,    // the cells all the runs hold together
}

/** A table a bake is writing: the slot's own, or a new one it has yet to publish. */
struct SurfaceDraft {
    pub(crate) slot : i32,
    pub(crate) table : i64,
    pub(crate) fresh : bool,   // a new table, published by `close`
    pub(crate) old : i64,      // the table it replaces, 0 for none
}

/** The surface light of the whole ring. */
class SurfaceLight {
    tables : i64[],        // per slot: its table, 0 for none
    loads : i32[],         // per slot: the chunk loads it has had (main thread)
    changes : i32[],       // per slot: the bakes that changed it (light thread)
    retired : i64[],       // per slot: the tables retired and not yet freed, newest first
    frames : AtomicI64,    // frames completed — a reader's frame has ended once it moves
    fence : AtomicI64,     // touched before a table is published, for the full fence
    deferFrees : AtomicBoolean,

    /**
     * No table for any slot: the whole ring reads as open air.
     * @param slots  the number of ring slots (span * span)
     */
    constructor(slots : i32) {
        self.tables = malloc<i64>(slots);
        self.loads = malloc<i32>(slots);
        self.changes = malloc<i32>(slots);
        self.retired = malloc<i64>(slots);
        for (i of 0..slots) {
            self.tables[i] = 0;
            self.loads[i] = 0;
            self.changes[i] = 0;
            self.retired[i] = 0;
        }
        self.frames = new AtomicI64(0);
        self.fence = new AtomicI64(0);
        self.deferFrees = new AtomicBoolean(false);
    }

    // ── Reading ─────────────────────────────────────────────────

    /**
     * The three values at one cell of a slot.
     * @param slot  the slot that owns the cell
     * @param lx    local x
     * @param y     the world y
     * @param lz    local z
     * @return its sun visibility, sky access and packed bounce tint
     */
    pub(crate) fn sample(self, slot : i32, lx : i32, y : i32, lz : i32) : CornerSample {
        const table : i64 = self.tables[slot];
        if (table == 0 || Mem::dwordAt(table, TABLE_LOAD) != self.loads[slot]) {
            return openAir();
        }
        const at : i64 = cellAt(table, lx, y, lz);
        if (at < 0) {
            return openAir();
        }
        return CornerSample {
            sun: Mem::byteAt(table, at + CELL_SUN),
            sky: Mem::byteAt(table, at + CELL_SKY),
            bounce: (Mem::byteAt(table, at + CELL_RED) << 16)
                | (Mem::byteAt(table, at + CELL_GREEN) << 8)
                | Mem::byteAt(table, at + CELL_BLUE),
        };
    }

    /**
     * How many times a slot's surface light has changed — a new chunk in it, or a bake
     * that moved a value: a copy of it taken at another count is stale.
     * @param slot  the slot index
     * @return the slot's light generation
     */
    pub(crate) fn generation(self, slot : i32) : i32 {
        return self.loads[slot] + self.changes[slot];
    }

    /**
     * The memory the published tables hold (main thread). Not the retired ones: their
     * list is the light thread's, which frees them as it walks it; a published table
     * cannot be freed before the next `frameDone`, which only this thread makes.
     * @return the bytes
     */
    pub(crate) fn bytesInUse(self) : i64 {
        let total : i64 = 0;
        for (slot of 0..World::SPAN * World::SPAN) {
            total += tableBytes(self.tables[slot]);
        }
        return total;
    }

    // ── The main thread ─────────────────────────────────────────

    /**
     * A new chunk in a slot: until it is baked, every cell of it reads as open air.
     * @param slot  the slot index
     */
    pub(crate) fn clear(mut self, slot : i32) : void {
        self.loads[slot] = self.loads[slot] + 1;
    }

    /** A frame has been drawn: no reader is still in a table retired before it. */
    pub(crate) fn frameDone(mut self) : void {
        const n : i64 = self.frames.incrementAndGet();
    }

    /**
     * From now on the bakes and the readers run at the same time: retired tables wait
     * for a frame to pass before they are freed. Called by the light thread as it
     * starts, before its first bake.
     */
    pub(crate) fn shareWithReaders(mut self) : void {
        self.deferFrees.set(true);
    }

    // ── The bakes ───────────────────────────────────────────────

    /**
     * The table a bake of `slot` writes into: the slot's own when its runs are the
     * scan's, otherwise a new one laid out by the scan, holding what the old one held
     * wherever the two overlap and open air elsewhere.
     * @param slot  the slot being baked
     * @param scan  the cells the bake will write
     * @return the table, for `close` once the bake has written it
     */
    pub(crate) fn open(mut self, slot : i32, scan : ShellScan) : SurfaceDraft {
        self.reclaim(slot);
        const old : i64 = self.tables[slot];
        const load : i32 = self.loads[slot];
        const valid : bool = old != 0 && Mem::dwordAt(old, TABLE_LOAD) == load;
        if (valid && sameRuns(old, scan)) {
            return SurfaceDraft {
                slot,
                table: old,
                fresh: false,
                old: 0,
            };
        }

        const table : i64 = Mem::take(TABLE_VALUES + (scan.cells as i64) * CELL_BYTES);
        Mem::putDword(table, TABLE_LOAD, load);
        Mem::putDword(table, TABLE_CELLS, scan.cells);
        Mem::putQword(table, TABLE_NEXT, 0);
        Mem::putQword(table, TABLE_RETIRED_AT, 0);
        Mem::copy(table + TABLE_COLUMNS, scan.columns, (SLOT_COLUMNS as i64) * 4);
        fillFrom(table, valid ? old : 0);
        return SurfaceDraft {
            slot,
            table,
            fresh: true,
            old,
        };
    }

    /**
     * A bake is done with its table: publish it if it is new, and count the change if
     * it made one.
     * @param d        the table the bake wrote
     * @param changed  whether the bake moved any value
     */
    pub(crate) fn close(mut self, d : SurfaceDraft, changed : bool) : void {
        if (d.fresh) {
            const touched : i64 = self.fence.incrementAndGet();
            self.tables[d.slot] = d.table;
            self.retire(d.slot, d.old);
        }
        if (d.fresh || changed) {
            self.changes[d.slot] = self.changes[d.slot] + 1;
        }
    }

    /**
     * Put a replaced table on its slot's retired list — or free it now, when no reader
     * runs beside the bakes.
     * @param slot   the slot index
     * @param table  the table, 0 for none
     */
    fn retire(mut self, slot : i32, table : i64) : void {
        if (table == 0) {
            return;
        }
        if (!self.deferFrees.get()) {
            Mem::release(table);
            return;
        }
        Mem::putQword(table, TABLE_RETIRED_AT, self.frames.get());
        Mem::putQword(table, TABLE_NEXT, self.retired[slot]);
        self.retired[slot] = table;
    }

    /**
     * Free the slot's retired tables that a frame has passed since.
     * @param slot  the slot index
     */
    fn reclaim(mut self, slot : i32) : void {
        const now : i64 = self.frames.get();
        let keep : i64 = 0;
        let t : i64 = self.retired[slot];
        while (t != 0) {
            const next : i64 = Mem::qwordAt(t, TABLE_NEXT);
            if (Mem::qwordAt(t, TABLE_RETIRED_AT) < now) {
                Mem::release(t);
            } else {
                Mem::putQword(t, TABLE_NEXT, keep);
                keep = t;
            }
            t = next;
        }
        self.retired[slot] = keep;
    }
}

/**
 * Where a cell's five bytes are in a table, or -1 when its column's run misses it.
 * @param table  the table
 * @param lx     local x
 * @param y      the world y
 * @param lz     local z
 * @return the byte offset of its values in the table, or -1
 */
fn cellAt(table : i64, lx : i32, y : i32, lz : i32) : i64 {
    const run : i32 = Mem::dwordAt(table, TABLE_COLUMNS + ((lz * World::CHUNK_SIZE + lx) as i64) * 4);
    const y0 : i32 = run & 0xFF;
    if (y < y0 || y >= y0 + ((run >> 8) & 0xFF)) {
        return 0 - 1;
    }
    return TABLE_VALUES + (((run >> 16) + y - y0) as i64) * CELL_BYTES;
}

/**
 * A column's run as a table holds it.
 * @param firstY     its lowest cell's y
 * @param length     its cells, 0 for none
 * @param firstCell  its lowest cell's index among the table's cells
 * @return the packed run
 */
fn packRun(firstY : i32, length : i32, firstCell : i32) : i32 {
    return firstY | (length << 8) | (firstCell << 16);
}

/**
 * The values a cell reads as when nothing else does.
 * @return full sun, open sky, a neutral tint
 */
fn openAir() : CornerSample {
    return CornerSample {
        sun: OPEN_SUN,
        sky: OPEN_SKY,
        bounce: OPEN_BOUNCE,
    };
}

/**
 * Whether a table's runs are the scan's.
 * @param table  the table
 * @param scan   the scan
 * @return true when every column's run is the same
 */
fn sameRuns(table : i64, scan : ShellScan) : bool {
    for (c of 0..SLOT_COLUMNS) {
        if (Mem::dwordAt(table, TABLE_COLUMNS + (c as i64) * 4) != Mem::wordOf(scan.columns, c as i64)) {
            return false;
        }
    }
    return true;
}

/**
 * Fill a new table's cells: from `old` where it held the same cell, open air elsewhere.
 * @param table  the new table, its runs written
 * @param old    the table it replaces, 0 for none
 */
fn fillFrom(table : i64, old : i64) : void {
    const s : i32 = World::CHUNK_SIZE;
    for (lz of 0..s) {
        for (lx of 0..s) {
            const run : i32 = Mem::dwordAt(table, TABLE_COLUMNS + ((lz * s + lx) as i64) * 4);
            const y0 : i32 = run & 0xFF;
            for (y of y0..(y0 + ((run >> 8) & 0xFF))) {
                const to : i64 = cellAt(table, lx, y, lz);
                const from : i64 = old == 0 ? 0 - 1 : cellAt(old, lx, y, lz);
                if (from >= 0) {
                    Mem::copy(table + to, old + from, CELL_BYTES);
                } else {
                    Mem::putByte(table, to + CELL_SUN, OPEN_SUN);
                    Mem::putByte(table, to + CELL_SKY, OPEN_SKY);
                    Mem::putByte(table, to + CELL_RED, NEUTRAL_TINT);
                    Mem::putByte(table, to + CELL_GREEN, NEUTRAL_TINT);
                    Mem::putByte(table, to + CELL_BLUE, NEUTRAL_TINT);
                }
            }
        }
    }
}

/**
 * A table's size.
 * @param table  the table, 0 for none
 * @return its bytes
 */
fn tableBytes(table : i64) : i64 {
    if (table == 0) {
        return 0;
    }
    return TABLE_VALUES + (Mem::dwordAt(table, TABLE_CELLS) as i64) * CELL_BYTES;
}

// ── A draft's cells, for the bakes ─────────────────────────────

/**
 * Where a cell's values are in the draft, or -1 when the scan left it out.
 * @param d   the draft
 * @param lx  local x
 * @param y   the world y
 * @param lz  local z
 * @return the byte offset, or -1
 */
fn draftCell(d : SurfaceDraft, lx : i32, y : i32, lz : i32) : i64 {
    return cellAt(d.table, lx, y, lz);
}

/**
 * A cell's sun visibility in the draft.
 * @param d   the draft
 * @param at  the cell, from `draftCell`
 * @return 0..255
 */
fn draftSun(d : SurfaceDraft, at : i64) : i32 {
    return Mem::byteAt(d.table, at + CELL_SUN);
}

/**
 * Store a cell's sun visibility; whether that changed it.
 * @param d   the draft
 * @param at  the cell, from `draftCell`
 * @param v   0..255
 * @return true when the stored value moved
 */
fn putDraftSun(d : SurfaceDraft, at : i64, v : i32) : bool {
    return storeByte(d.table, at + CELL_SUN, v);
}

/**
 * Store a cell's sky access and bounce tint; whether that changed any of them.
 * @param d       the draft
 * @param at      the cell, from `draftCell`
 * @param sky     the sky access, 0..255
 * @param bounce  the packed tint, 0xRRGGBB
 * @return true when a stored value moved
 */
fn putDraftSky(d : SurfaceDraft, at : i64, sky : i32, bounce : i32) : bool {
    const a : bool = storeByte(d.table, at + CELL_SKY, sky);
    const r : bool = storeByte(d.table, at + CELL_RED, (bounce >> 16) & 0xFF);
    const g : bool = storeByte(d.table, at + CELL_GREEN, (bounce >> 8) & 0xFF);
    const b : bool = storeByte(d.table, at + CELL_BLUE, bounce & 0xFF);
    return a || r || g || b;
}

/**
 * Store one byte; whether that changed it.
 * @param base  the block
 * @param off   the byte's offset
 * @param v     the value, 0..255
 * @return true when the stored value moved
 */
fn storeByte(base : i64, off : i64, v : i32) : bool {
    if (Mem::byteAt(base, off) == v) {
        return false;
    }
    Mem::putByte(base, off, v);
    return true;
}
