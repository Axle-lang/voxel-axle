// skyaccess — hemispherical sky access (ambient occlusion) and the one-bounce
// coloured tint, baked by rays.
//
// Every sky-lit air cell a face can read casts a fixed fan of upper-hemisphere
// rays: the share that escapes is its sky access, and the colour of what dimmed
// the rest is the hue its ambient takes — grass bounces green into the shade
// under a hedge. Slots are baked when they arrive or change; a ring-sized
// backlog goes to a crew.
//
// Runs on the light task.

use smalt::Mem;
use crate::engine::math::vec3::{ IVec3, Vec3, vec3, ivec3 };
use crate::engine::world::ring::{ RingView };
use crate::engine::world::light::volumes::{ LightVolumes };
use crate::engine::world::light::surface::{
    SurfaceLight, SurfaceDraft, ShellScan, OPEN_BOUNCE, draftCell, putDraftSky,
};
use crate::engine::world::light::bake::{
    BAKE_WORKERS, BakeQueue, scanShell, inShell, freeScan, terrainCeil,
};
use crate::engine::block::blocks::{ lightTransmit, albedoFor };
use crate::configs::blocks::{ Block };
use crate::configs::light::{ Light };
use crate::configs::world::{ World };

/** The precomputed upper-hemisphere ray directions the bake casts. */
struct HemiRays {
    hemiX : i64,
    hemiY : i64,
    hemiZ : i64,
}

/** What a cell's hemisphere came back with: its sky access, and its packed bounce tint. */
struct SkyCell {
    access : i32,
    bounce : i32,
}

/**
 * What one hemisphere ray came back with: how much of the sky it still saw
 * after whatever it crossed, and the colour of the first thing that dimmed it
 * (-1 if nothing did) — the surface the one bounce takes its hue from.
 */
struct HemiHit {
    open : f64,
    albedo : i32,
}

class SkyAccess {
    ring : RingView,      // this component's view of the world
    vols : LightVolumes,  // the sky-light plane, which decides the cells baked
    surface : Shared<SurfaceLight>, // where the sky access and tint it bakes are kept
    rays : HemiRays,      // M precomputed upper-hemisphere ray directions
    cursor : i32,         // round-robin slot index for the throttled bake
    queue : BakeQueue,    // slots whose sky access is owed a (re)bake

    /**
     * The ray table and the per-slot bookkeeping over a ring of `slots`.
     * @param ring     a view of the world
     * @param vols     the ring's light volumes
     * @param surface  the ring's surface light, co-owned with the engine
     * @param slots    the number of ring slots (span * span)
     */
    constructor(own ring : RingView, vols : LightVolumes, own surface : Shared<SurfaceLight>, slots : i32) {
        self.ring = ring;
        self.vols = vols;
        self.surface = surface;
        self.cursor = 0;

        // Precompute M upper-hemisphere directions (Fibonacci spiral, cosine-ish).
        let m : i32 = Light::SKY_AO_SAMPLES;
        self.rays = HemiRays {
            hemiX: Mem::take((m as i64) * 8),
            hemiY: Mem::take((m as i64) * 8),
            hemiZ: Mem::take((m as i64) * 8),
        };
        for (hi of 0..m) {
            let yy : f64 = ((hi as f64) + 0.5) / (m as f64); // 0..1 toward up
            let rr : f64 = (1.0 - yy * yy).sqrt();
            let th : f64 = (hi as f64) * 2.399963;           // golden angle
            Mem::putRealOf(self.rays.hemiX, hi, rr * th.cos());
            Mem::putRealOf(self.rays.hemiY, hi, yy);
            Mem::putRealOf(self.rays.hemiZ, hi, rr * th.sin());
        }

        self.queue = new BakeQueue(slots);
    }

    /**
     * Queue a slot for a re-bake: it has just arrived or its geometry changed.
     * @param slot  the slot index
     */
    pub(crate) fn markDirty(mut self, slot : i32) : void {
        self.queue.request(slot);
    }

    /**
     * March one hemisphere ray from a cell toward the sky: how much of the sky
     * it still sees at the end, and the colour of the first surface that dimmed
     * it. A wall takes all of it; a block of canopy takes its share and the ray
     * carries on, so a cell under one layer of leaves is shaded rather than
     * sealed, and it takes the leaves' green with it as the bounce hue.
     * @param cell  origin air cell
     * @param dir   ray direction (unit)
     * @param ceil  tallest terrain Y over loaded chunks
     * @return the surviving sky fraction and the packed albedo that dimmed it (-1 if none)
     */
    fn hemiHit(self, cell : IVec3, dir : Vec3, ceil : i32) : HemiHit {
        let ox : f64 = (cell.x as f64) + 0.5;
        let oy : f64 = (cell.y as f64) + 0.5;
        let oz : f64 = (cell.z as f64) + 0.5;
        let mut through : f64 = 1.0;
        let mut col : i32 = -1;
        let mut t : f64 = 0.6;

        while (t < Light::SKY_AO_REACH) {
            let cy : i32 = (oy + dir.y * t).floorToInt() as i32;
            if (cy > ceil) {
                return HemiHit { open: through, albedo: col };
            }
            if (cy >= 0 && cy < World::HEIGHT) {
                let cx : i32 = (ox + dir.x * t).floorToInt() as i32;
                let cz : i32 = (oz + dir.z * t).floorToInt() as i32;
                let hb : Block = self.ring.worldGet(ivec3(cx, cy, cz));
                let tr : f64 = lightTransmit(hb);
                if (tr < 1.0) {
                    if (col < 0) {
                        col = albedoFor(hb);
                    }
                    through *= tr;
                    if (through < 0.02) {
                        return HemiHit { open: 0.0, albedo: col };
                    }
                }
            }
            t += 0.7;
        }
        return HemiHit { open: through, albedo: col };
    }

    /**
     * Bake hemispherical sky access for one chunk: every open, sky-lit air cell
     * in the active band casts the M precomputed hemisphere rays and stores the
     * escaped fraction (0..255) plus the one-bounce coloured tint.
     * @param slot  the slot index
     * @param cx    the chunk x coordinate
     * @param cz    the chunk z coordinate
     * @param ceil  tallest terrain Y over loaded chunks
     */
    fn bakeChunk(mut self, slot : i32, cx : i32, cz : i32, ceil : i32) : void {
        let s : i32 = World::CHUNK_SIZE;
        let mut top : i32 = self.ring.store.faceTop(slot) + 1;
        if (top > World::HEIGHT - 1) {
            top = World::HEIGHT - 1;
        }

        let scan : ShellScan = scanShell(self.ring, self.vols.sky(), slot, cx, cz, top);
        let draft : SurfaceDraft = self.surface.open(slot, scan);
        let mut changed : bool = false;
        for (lz of 0..s) {
            for (lx of 0..s) {
                for (y of 0..=top) {
                    if (inShell(scan, lx, y, lz)) {
                        let lit : SkyCell = self.castHemisphere(ivec3(cx * s + lx, y, cz * s + lz), ceil);
                        if (putDraftSky(draft, draftCell(draft, lx, y, lz), lit.access, lit.bounce)) {
                            changed = true;
                        }
                    }
                }
            }
        }
        self.surface.close(draft, changed);
        freeScan(scan);
    }

    /**
     * Cast the hemisphere from one air cell: the share of the sky that escapes, and
     * the hue of what dimmed the rest.
     * @param cell  the world cell
     * @param ceil  tallest terrain Y over loaded chunks
     * @return its sky access and packed bounce tint
     */
    fn castHemisphere(self, cell : IVec3, ceil : i32) : SkyCell {
        let m : i32 = Light::SKY_AO_SAMPLES;
        // A ray comes back with a FRACTION of the sky rather than a yes or no, so
        // the escaped share and the bounce weight are both sums of what each ray
        // lost, not counts of the rays that were stopped.
        let mut esc : f64 = 0.0;
        let mut shut : f64 = 0.0;
        let mut ar : f64 = 0.0;
        let mut ag : f64 = 0.0;
        let mut ab : f64 = 0.0;
        for (r of 0..m) {
            let dir : Vec3 = vec3(
                Mem::realOf(self.rays.hemiX, r),
                Mem::realOf(self.rays.hemiY, r),
                Mem::realOf(self.rays.hemiZ, r)
            );
            let hit : HemiHit = self.hemiHit(cell, dir, ceil);
            esc += hit.open;
            if (hit.albedo >= 0) {
                let w : f64 = 1.0 - hit.open;
                ar += w * (((hit.albedo >> 16) & 0xFF) as f64);
                ag += w * (((hit.albedo >> 8) & 0xFF) as f64);
                ab += w * ((hit.albedo & 0xFF) as f64);
                shut += w;
            }
        }

        let access : i32 = (esc * 255.0 / (m as f64)).floorToInt() as i32;
        if (!Light::BOUNCE_ON || shut <= 0.001) {
            return SkyCell {
                access,
                bounce: OPEN_BOUNCE,
            };
        }
        let avr : f64 = ar / shut;
        let avg : f64 = ag / shut;
        let avb : f64 = ab / shut;
        let mut lum : f64 = 0.299 * avr + 0.587 * avg + 0.114 * avb;
        if (lum < 1.0) {
            lum = 1.0;
        }
        let occ : f64 = shut / (m as f64) * Light::BOUNCE_STRENGTH;
        return SkyCell {
            access,
            bounce: (bounceByte(avr / lum, occ) << 16)
                | (bounceByte(avg / lum, occ) << 8)
                | bounceByte(avb / lum, occ),
        };
    }

    /**
     * Whether any loaded slot is still owed a bake — the light loop's pacing
     * question, and the same one `step` asks before it walks the ring.
     * @return true while a chunk waits for its sky access
     */
    pub(crate) fn owed(self) : bool {
        return self.queue.owedCount(self.ring) > 0;
    }

    /**
     * Throttled sky-access bake: process up to `budget` dirty loaded chunks per
     * call (round-robin). Idles once every loaded chunk is baked.
     * @param budget  max chunks to bake this call
     */
    pub(crate) fn step(mut self, budget : i32) : void {
        let slots : i32 = World::SPAN * World::SPAN;
        let ceil : i32 = terrainCeil(self.ring);

        // A backlog this size is a ring that just filled, not a chunk the player
        // walked into, and dribbling it out `budget` at a time is the ambient
        // occlusion visibly settling in over the first seconds of a run. Drain it
        // over the crew instead; the trickle is for the one or two chunks that
        // arrive as you walk.
        if (self.queue.owedCount(self.ring) > BAKE_WORKERS) {
            // A local, not a field: the shares are handed `self`, and an object
            // holding their handles could carry them to another carrier (E0729).
            let mut crew : Future<void>[] = malloc<Future<void>>(BAKE_WORKERS - 1);
            for (i of 0..BAKE_WORKERS - 1) {
                crew[i] = spawn self.bakeDirty(i + 1, BAKE_WORKERS, ceil);
            }
            self.bakeDirty(0, BAKE_WORKERS, ceil);
            await all crew;
            return;
        }

        let mut done : i32 = 0;
        let mut guard : i32 = 0;
        while (done < budget && guard < slots) {
            let slot : i32 = self.cursor;
            self.cursor++;
            if (self.cursor >= slots) {
                self.cursor = 0;
            }
            guard++;
            if (self.ring.cols.loaded[slot] == 1 && self.queue.owed(slot)) {
                let claimed : i32 = self.queue.claim(slot);
                self.bakeChunk(slot, self.ring.cols.cxs[slot], self.ring.cols.czs[slot], ceil);
                self.queue.finish(slot, claimed);
                done++;
            }
        }
    }

    /**
     * One worker's share of the backlog: every owed loaded slot whose index is
     * `first` modulo `stride`. Shares never overlap, so each settles its own slots.
     * @param first   the first slot of this share
     * @param stride  the number of shares
     * @param ceil    tallest terrain Y over loaded chunks
     */
    pub(file) fn bakeDirty(mut self, first : i32, stride : i32, ceil : i32) : void {
        let slots : i32 = World::SPAN * World::SPAN;
        let mut d : i32 = first;
        while (d < slots) {
            if (self.ring.cols.loaded[d] == 1 && self.queue.owed(d)) {
                let claimed : i32 = self.queue.claim(d);
                self.bakeChunk(d, self.ring.cols.cxs[d], self.ring.cols.czs[d], ceil);
                self.queue.finish(d, claimed);
            }
            d += stride;
        }
    }
}

/**
 * Encode a bounce tint channel: normalised colour ratio `ratio` blended
 * toward neutral by `occ`, stored as a byte where 128 = ×1.0.
 * @param ratio  the channel's colour ratio (1.0 = neutral grey)
 * @param occ    occlusion weight 0..1
 * @return the packed byte (0..255, 128 = ×1.0)
 */
fn bounceByte(ratio : f64, occ : f64) : i32 {
    let f : f64 = 1.0 + (ratio - 1.0) * occ;
    let mut v : i32 = (f * 128.0).floorToInt() as i32;
    if (v < 0) {
        v = 0;
    }
    if (v > 255) {
        v = 255;
    }
    return v;
}

