// surface — what a block looks like: per-face atlas tile, bounce albedo and the
// fallback colour.
//
// The one capability that is a table rather than a handful of flags, and the
// one place per-block appearance lives. To add a block's look: a tile in
// `bake_atlas.py`, its `Tile` index in `configs::atlas`, an arm in `surfaceOf`.

use smalt::Color;
use crate::engine::block::traits::{ Textured };
use crate::configs::atlas::{ Tile };
use crate::configs::blocks::{ Block };
use crate::configs::face::{ FaceDir };

/** Per-face atlas tiles + bounce albedo + fallback colour. */
struct BlockSurface : Textured {
    albedoCol : i32,
    baseCol : i32,
    tTop : i32,
    tBottom : i32,
    tSide : i32,

    /**
     * Atlas tile for the given face. Top/bottom get their own tile on many
     * blocks; the four sides share `tSide`.
     * @param dir  the face direction
     * @return the atlas tile index
     */
    pub(crate) fn tile(self, dir : FaceDir) : i32 {
        return match dir {
            FaceDir::Top => self.tTop,
            FaceDir::Bottom => self.tBottom,
            _ => self.tSide,
        };
    }

    /**
     * Approximate surface albedo for coloured indirect light.
     * @return packed rgb
     */
    pub(crate) fn albedo(self) : i32 { return self.albedoCol; }

    /**
     * Base RGB colour (fallback / hotbar swatch).
     * @return packed rgb
     */
    pub(crate) fn color(self) : i32 { return self.baseCol; }
}

// ── Block-surface archetypes ──────────────────────────────────────────────
// Common tile/colour shapes as one-line factories so each `surfaceOf` arm reads
// as the data it is.

/**
 * A per-face solid: distinct top / bottom / side tiles.
 * @param tTop     top-face tile
 * @param tBottom  bottom-face tile
 * @param tSide    side tile (all four sides)
 * @param col      base colour
 * @param albedo   bounce albedo
 * @return the surface
 */
fn txSolid(tTop : i32, tBottom : i32, tSide : i32, col : i32, albedo : i32) : BlockSurface {
    return BlockSurface {
        albedoCol: albedo,
        baseCol: col,
        tTop,
        tBottom,
        tSide,
    };
}

/**
 * A surface with one tile on every face.
 * @param tile    the tile on all six faces
 * @param col     base colour
 * @param albedo  bounce albedo
 * @return the surface
 */
fn txUniform(tile : i32, col : i32, albedo : i32) : BlockSurface {
    return txSolid(tile, tile, tile, col, albedo);
}

/**
 * A pillar surface: `top` on top/bottom, `side` on the four sides.
 * @param top     top- and bottom-face tile
 * @param side    side tile (all four sides)
 * @param col     base colour
 * @param albedo  bounce albedo
 * @return the surface
 */
fn txColumn(top : i32, side : i32, col : i32, albedo : i32) : BlockSurface {
    return txSolid(top, top, side, col, albedo);
}

/**
 * A grass-family surface: tinted top/side, dirt bottom, grass bounce albedo.
 * @param tTop   top-face tile
 * @param tSide  side tile (all four sides)
 * @param col    base colour
 * @return the surface
 */
fn txGrass(tTop : i32, tSide : i32, col : i32) : BlockSurface {
    return BlockSurface {
        albedoCol: Color::packBytes(112, 150, 72),
        baseCol: col,
        tTop,
        tBottom: Tile::DIRT,
        tSide,
    };
}

/**
 * A leaf surface: one leaf tile on every face, canopy bounce albedo.
 * @param tile  the leaf tile on all six faces
 * @param col   base colour
 * @return the surface
 */
fn txLeaf(tile : i32, col : i32) : BlockSurface {
    return BlockSurface {
        albedoCol: Color::packBytes(84, 122, 56),
        baseCol: col,
        tTop: tile,
        tBottom: tile,
        tSide: tile,
    };
}

/**
 * A water surface: the water tile everywhere, grey bounce albedo, given colour.
 * @param col  base colour
 * @return the surface
 */
fn txWater(col : i32) : BlockSurface {
    return BlockSurface {
        albedoCol: Color::packBytes(138, 138, 138),
        baseCol: col,
        tTop: Tile::WATER,
        tBottom: Tile::WATER,
        tSide: Tile::WATER,
    };
}

/**
 * The one place per-block appearance lives: pick tiles / colour / albedo.
 * @param id  the block
 * @return its surface capability
 */
fn surfaceOf(id : Block) : BlockSurface {
    return match id {
        Block::Air => BlockSurface {
            albedoCol: Color::packBytes(138, 138, 138),
            baseCol: Color::packBytes(0, 0, 0),
            tTop: Tile::STONE,
            tBottom: Tile::STONE,
            tSide: Tile::STONE,
        },

        // ── Grass family: tinted top, dirt bottom, tinted side ──
        Block::Grass => txGrass(
            Tile::GRASS_TOP,
            Tile::GRASS_SIDE,
            Color::packBytes(110, 170, 90)
        ),
        Block::GrassSavanna => txGrass(
            Tile::GRASS_TOP_SAVANNA,
            Tile::GRASS_SIDE_SAVANNA,
            Color::packBytes(168, 156, 70)
        ),
        Block::GrassJungle => txGrass(
            Tile::GRASS_TOP_JUNGLE,
            Tile::GRASS_SIDE_JUNGLE,
            Color::packBytes(80, 160, 56)
        ),
        Block::GrassSwamp => txGrass(
            Tile::GRASS_TOP_SWAMP,
            Tile::GRASS_SIDE_SWAMP,
            Color::packBytes(96, 120, 80)
        ),
        Block::GrassTaiga => txGrass(
            Tile::GRASS_TOP_TAIGA,
            Tile::GRASS_SIDE_TAIGA,
            Color::packBytes(120, 160, 130)
        ),
        Block::Podzol => txSolid(
            Tile::PODZOL_TOP,
            Tile::DIRT,
            Tile::PODZOL_SIDE,
            Color::packBytes(96, 68, 36),
            Color::packBytes(122, 92, 62)
        ),
        Block::Mycelium => txSolid(
            Tile::MYCELIUM_TOP,
            Tile::DIRT,
            Tile::MYCELIUM_SIDE,
            Color::packBytes(120, 104, 116),
            Color::packBytes(122, 92, 62)
        ),

        // ── Soils / loose ──
        Block::Dirt => txUniform(
            Tile::DIRT,
            Color::packBytes(140, 100, 64),
            Color::packBytes(122, 92, 62)
        ),
        Block::CoarseDirt => txUniform(
            Tile::COARSE_DIRT,
            Color::packBytes(122, 90, 58),
            Color::packBytes(122, 92, 62)
        ),
        Block::Sand => txUniform(
            Tile::SAND,
            Color::packBytes(218, 205, 145),
            Color::packBytes(206, 188, 138)
        ),
        Block::RedSand => txUniform(
            Tile::RED_SAND,
            Color::packBytes(190, 110, 56),
            Color::packBytes(182, 112, 66)
        ),
        Block::Gravel => txUniform(
            Tile::GRAVEL,
            Color::packBytes(122, 118, 112),
            Color::packBytes(138, 138, 138)
        ),
        Block::Clay => txUniform(
            Tile::CLAY,
            Color::packBytes(160, 165, 172),
            Color::packBytes(160, 164, 172)
        ),
        Block::Snow => txUniform(
            Tile::SNOW,
            Color::packBytes(236, 240, 246),
            Color::packBytes(236, 240, 246)
        ),
        Block::Ice => txUniform(
            Tile::ICE,
            Color::packBytes(150, 180, 235),
            Color::packBytes(168, 200, 224)
        ),
        Block::PackedIce => txUniform(
            Tile::PACKED_ICE,
            Color::packBytes(140, 168, 222),
            Color::packBytes(168, 200, 224)
        ),

        // ── Stones / bricks ──
        Block::Stone => txUniform(
            Tile::STONE,
            Color::packBytes(128, 128, 132),
            Color::packBytes(138, 138, 138)
        ),
        Block::Cobble => txUniform(
            Tile::COBBLE,
            Color::packBytes(122, 120, 120),
            Color::packBytes(138, 138, 138)
        ),
        Block::MossyCobble => txUniform(
            Tile::MOSSY_COBBLE,
            Color::packBytes(104, 116, 96),
            Color::packBytes(138, 138, 138)
        ),
        Block::Granite => txUniform(
            Tile::GRANITE,
            Color::packBytes(154, 110, 92),
            Color::packBytes(138, 138, 138)
        ),
        Block::Diorite => txUniform(
            Tile::DIORITE,
            Color::packBytes(188, 188, 190),
            Color::packBytes(138, 138, 138)
        ),
        Block::Andesite => txUniform(
            Tile::ANDESITE,
            Color::packBytes(136, 138, 138),
            Color::packBytes(138, 138, 138)
        ),
        Block::StoneBricks => txUniform(
            Tile::STONE_BRICKS,
            Color::packBytes(122, 122, 124),
            Color::packBytes(138, 138, 138)
        ),
        Block::Bricks => txUniform(
            Tile::BRICKS,
            Color::packBytes(150, 96, 80),
            Color::packBytes(138, 138, 138)
        ),
        Block::Sandstone => txSolid(
            Tile::SANDSTONE_TOP,
            Tile::SANDSTONE_BOTTOM,
            Tile::SANDSTONE_SIDE,
            Color::packBytes(220, 208, 152),
            Color::packBytes(206, 188, 138)
        ),
        Block::RedSandstone => txSolid(
            Tile::RED_SANDSTONE_TOP,
            Tile::RED_SANDSTONE_TOP,
            Tile::RED_SANDSTONE_SIDE,
            Color::packBytes(184, 96, 38),
            Color::packBytes(182, 112, 66)
        ),
        Block::Terracotta => txUniform(
            Tile::TERRACOTTA,
            Color::packBytes(150, 92, 66),
            Color::packBytes(138, 138, 138)
        ),
        Block::TerracottaOrange => txUniform(
            Tile::TERRACOTTA_ORANGE,
            Color::packBytes(162, 84, 38),
            Color::packBytes(138, 138, 138)
        ),
        Block::TerracottaWhite => txUniform(
            Tile::TERRACOTTA_WHITE,
            Color::packBytes(208, 176, 156),
            Color::packBytes(138, 138, 138)
        ),

        // ── Logs (top/bottom = ring, side = bark) + leaves + planks ──
        Block::Wood => txColumn(
            Tile::OAK_LOG_TOP,
            Tile::OAK_LOG_SIDE,
            Color::packBytes(110, 78, 48),
            Color::packBytes(140, 106, 66)
        ),
        Block::Leaves => txLeaf(Tile::OAK_LEAVES, Color::packBytes(58, 132, 60)),
        Block::Planks => txUniform(
            Tile::PLANKS,
            Color::packBytes(150, 112, 66),
            Color::packBytes(140, 106, 66)
        ),
        Block::WoodBirch => txColumn(
            Tile::BIRCH_LOG_TOP,
            Tile::BIRCH_LOG_SIDE,
            Color::packBytes(196, 196, 188),
            Color::packBytes(140, 106, 66)
        ),
        Block::LeavesBirch => txLeaf(Tile::BIRCH_LEAVES, Color::packBytes(110, 150, 70)),
        Block::WoodSpruce => txColumn(
            Tile::SPRUCE_LOG_TOP,
            Tile::SPRUCE_LOG_SIDE,
            Color::packBytes(66, 48, 28),
            Color::packBytes(140, 106, 66)
        ),
        Block::LeavesSpruce => txLeaf(Tile::SPRUCE_LEAVES, Color::packBytes(54, 92, 64)),
        Block::WoodAcacia => txColumn(
            Tile::ACACIA_LOG_TOP,
            Tile::ACACIA_LOG_SIDE,
            Color::packBytes(104, 78, 64),
            Color::packBytes(140, 106, 66)
        ),
        Block::LeavesAcacia => txLeaf(Tile::ACACIA_LEAVES, Color::packBytes(100, 126, 46)),
        Block::WoodJungle => txColumn(
            Tile::JUNGLE_LOG_TOP,
            Tile::JUNGLE_LOG_SIDE,
            Color::packBytes(88, 68, 36),
            Color::packBytes(140, 106, 66)
        ),
        Block::LeavesJungle => txLeaf(Tile::JUNGLE_LEAVES, Color::packBytes(50, 132, 38)),
        Block::WoodDarkOak => txColumn(
            Tile::DARK_OAK_LOG_TOP,
            Tile::DARK_OAK_LOG_SIDE,
            Color::packBytes(66, 50, 32),
            Color::packBytes(140, 106, 66)
        ),
        Block::LeavesDarkOak => txLeaf(Tile::DARK_OAK_LEAVES, Color::packBytes(62, 96, 48)),

        // ── Decoration ──
        Block::Cactus => txColumn(
            Tile::CACTUS_TOP,
            Tile::CACTUS_SIDE,
            Color::packBytes(80, 118, 52),
            Color::packBytes(138, 138, 138)
        ),
        Block::Pumpkin => txColumn(
            Tile::PUMPKIN_TOP,
            Tile::PUMPKIN_SIDE,
            Color::packBytes(190, 122, 38),
            Color::packBytes(196, 134, 48)
        ),
        Block::Melon => txColumn(
            Tile::MELON_TOP,
            Tile::MELON_SIDE,
            Color::packBytes(110, 140, 40),
            Color::packBytes(196, 134, 48)
        ),
        Block::Glowstone => txUniform(
            Tile::GLOWSTONE,
            Color::packBytes(180, 150, 92),
            Color::packBytes(138, 138, 138)
        ),
        Block::Torch => BlockSurface {
            albedoCol: Color::packBytes(138, 138, 138),
            baseCol: Color::packBytes(240, 180, 70),
            tTop: Tile::TORCH,
            tBottom: Tile::TORCH,
            tSide: Tile::TORCH,
        },

        // ── Water: still source (blue) + flowing levels (no fallback colour) ──
        Block::Water => txWater(Color::packBytes(58, 110, 200)),
        Block::FlowWater1 | Block::FlowWater2 | Block::FlowWater3 | Block::FlowWater4
        | Block::FlowWater5 | Block::FlowWater6 | Block::FlowWater7
            => txWater(Color::packBytes(0, 0, 0)),

        // ── Ores ──
        Block::CoalOre => txUniform(
            Tile::COAL_ORE,
            Color::packBytes(70, 70, 72),
            Color::packBytes(138, 138, 138)
        ),
        Block::IronOre => txUniform(
            Tile::IRON_ORE,
            Color::packBytes(150, 132, 116),
            Color::packBytes(138, 138, 138)
        ),
        Block::GoldOre => txUniform(
            Tile::GOLD_ORE,
            Color::packBytes(160, 150, 96),
            Color::packBytes(138, 138, 138)
        ),
        Block::DiamondOre => txUniform(
            Tile::DIAMOND_ORE,
            Color::packBytes(120, 170, 170),
            Color::packBytes(138, 138, 138)
        ),
        Block::RedstoneOre => txUniform(
            Tile::REDSTONE_ORE,
            Color::packBytes(140, 90, 88),
            Color::packBytes(138, 138, 138)
        ),
        Block::EmeraldOre => txUniform(
            Tile::EMERALD_ORE,
            Color::packBytes(90, 150, 104),
            Color::packBytes(138, 138, 138)
        ),
        Block::LapisOre => txUniform(
            Tile::LAPIS_ORE,
            Color::packBytes(90, 100, 140),
            Color::packBytes(138, 138, 138)
        ),

        // ── Expansion: bamboo, cherry, giant mushrooms ──
        Block::Bamboo => txColumn(
            Tile::BAMBOO_TOP,
            Tile::BAMBOO_SIDE,
            Color::packBytes(120, 160, 80),
            Color::packBytes(140, 106, 66)
        ),
        Block::CherryLog => txColumn(
            Tile::CHERRY_LOG_TOP,
            Tile::CHERRY_LOG_SIDE,
            Color::packBytes(110, 80, 90),
            Color::packBytes(140, 106, 66)
        ),
        Block::CherryLeaves => txLeaf(Tile::CHERRY_LEAVES, Color::packBytes(236, 168, 206)),
        Block::MushroomStem => txUniform(
            Tile::MUSHROOM_STEM,
            Color::packBytes(206, 200, 186),
            Color::packBytes(138, 138, 138)
        ),
        Block::RedMushroom => txUniform(
            Tile::RED_MUSHROOM,
            Color::packBytes(180, 40, 40),
            Color::packBytes(138, 138, 138)
        ),
        Block::BrownMushroom => txUniform(
            Tile::BROWN_MUSHROOM,
            Color::packBytes(150, 112, 76),
            Color::packBytes(138, 138, 138)
        ),

        // ── Partial-height snow layer ──
        Block::SnowLayer => BlockSurface {
            albedoCol: Color::packBytes(236, 240, 246),
            baseCol: Color::packBytes(236, 240, 246),
            tTop: Tile::SNOW,
            tBottom: Tile::SNOW,
            tSide: Tile::SNOW,
        },

        // Fallback: a plain stone-like solid (matches the old per-fn defaults).
        _ => txUniform(
            Tile::STONE,
            Color::packBytes(0, 0, 0),
            Color::packBytes(138, 138, 138)
        ),
    };
}
