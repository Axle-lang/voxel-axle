// framedesc — everything one frame shows, decided once, as values.
//
// The game builds one `FrameDesc` a frame (frame::framebuilder) and every
// backend draws that same value. A backend translates it into pixels and
// owns nothing the game reads back, so two backends handed the same frame
// cannot disagree about what is in it, and a change to what a frame contains
// is made here, once, for both.
//
// The arrays are the builder's, refilled by every `build`: a `FrameDesc` is
// valid until the next one is built.

use crate::engine::math::vec3::{ Vec3, IVec3 };
use crate::engine::shade::daymodel::{ DayState };
use crate::engine::shade::gamma::{ LinRgb };
use crate::engine::render::view::camera::{ Camera };
use crate::engine::entity::model::{ BoxPart };

/** Where in its days and seconds the run is, as this frame shows it. */
struct FrameClock {
    pub(crate) dayTime : f64,    // [0, 1), the sun's hour
    pub(crate) seconds : f64,    // since the run began: the wind, and so the clouds
    pub(crate) ripple : f64,     // the water's phase
    pub(crate) underwater : bool,
}

/**
 * One box of one creature, placed: the box in the creature's own frame, the
 * frame it is placed by, and the light it is seen in.
 */
struct MobBox {
    pub(crate) part : BoxPart,
    pub(crate) pos : Vec3,       // the creature's feet
    pub(crate) heading : f64,    // radians; the whole model turns to it
    pub(crate) topple : f64,     // death collapse, 0 upright .. 1 on its side
    pub(crate) hurt : bool,      // the red damage flash is on
    pub(crate) light : LinRgb,   // ambient light at the creature, per channel
}

/** The block the player is aiming at, outlined in the frame. */
struct AimBox {
    pub(crate) on : bool,
    pub(crate) cell : IVec3,
    pub(crate) topH : f64,       // the block's box height, so the outline hugs it
}

/** One frame, as every backend receives it. */
struct FrameDesc {
    pub(crate) cam : Camera,
    pub(crate) clock : FrameClock,
    pub(crate) day : DayState,
    pub(crate) lcurve : i64,          // the brightness curve, 16 f64s by light level
    pub(crate) boxes : MobBox[],
    pub(crate) boxCount : i32,
    pub(crate) torches : IVec3[],     // the torch cells in visible chunks
    pub(crate) torchCount : i32,
    pub(crate) aim : AimBox,
}
