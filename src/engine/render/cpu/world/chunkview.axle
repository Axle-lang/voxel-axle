// chunkview — the world-face raster: one worker's share of the streamed
// chunks, projected, lit, clipped and queued, then filled in parallel bands.
//
// The sibling of `mobview`, for terrain. Each `ChunkRenderer` is one
// independent worker: it walks a stride of the chunk ring, projects every
// baked face of the slots it owns, computes the per-CORNER light (smooth
// light, ambient occlusion, the soft cast shadow and the coloured bounce,
// through `cornerlight`), near-clips in camera space and appends triangles to
// its own queue. Nothing is shared between workers, so nothing needs a lock.
//
// The queue is then filled by screen-column bands: every band owns its pixels,
// so no two threads touch the same z-buffer word, and each band walks every
// worker's queue. The split is deliberate — the build is one job and the fill
// is another, and measured, the build is the expensive two thirds.

use smalt::Mem;
use crate::engine::render::cpu::raster::triangle::{
    rasterTriTex, columnSpan, RasterVert, RasterTri, VertAttribs, ScreenScratch,
};
use crate::engine::render::cpu::raster::framebuf::{ FrameBuf, Band };
use crate::engine::render::cpu::raster::mip::{ MipAtlas };
use crate::engine::render::view::camera::{ Camera, Projected };
use crate::engine::shade::facelight::{ FaceLight };
use crate::engine::shade::gamma::{ Gamma, LinRgb };
use crate::engine::render::cpu::sky::fogtables::{ FogTable };
use crate::engine::shade::cornerlight::{ CornerLight, skyTint, sunSheen };
use crate::engine::shade::daymodel::{ DayState };
use crate::engine::world::seams::{ CornerProbe, CornerSample, TerrainView, SlotChunk };
use crate::engine::world::mesh::meshbuf::{ FaceMesh, faceX, faceZ, faceKind, faceRun };
use crate::engine::math::vec3::{ Vec3, IVec3, vec3, ivec3 };
use crate::engine::render::view::frustum::{ ViewCone, viewConeFor, chunkVisible };
use crate::engine::world::mesh::facegeom::{ FaceTable, FaceKind, topHeight, cornerProbe };
use crate::configs::face::{ FaceDir };
use crate::configs::light::{ Light };
use crate::configs::render::{ Render };
use crate::configs::time::{ Daylight };
use crate::configs::water::{ Water };
use crate::configs::world::{ World };

/**
 * Reconstruct a FaceDir from its packed discriminant (0..5). The mesher packs
 * the direction into each face's `ftile` slot (see ChunkManager.addFace) to
 * avoid a parallel direction array; this turns it back into the enum so the
 * renderer matches on it by name.
 * @param d  the direction discriminant, 0..5
 * @return the matching FaceDir
 */
fn faceDirFrom(d : i32) : FaceDir {
    return match d {
        0 => FaceDir::PosX,
        1 => FaceDir::NegX,
        2 => FaceDir::Top,
        3 => FaceDir::Bottom,
        4 => FaceDir::PosZ,
        _ => FaceDir::NegZ,
    };
}

/**
 * Everything about a face that does not change when its merged run is cut into
 * spans: which face it is in the baked arrays, which way it points, what it is
 * made of, and the Lambert term its corners all share.
 *
 * A struct rather than a dozen arguments threaded down: the split emits one to
 * eight quads from the same face, and every one of them wants all of this.
 */
struct FaceShade {
    mesh : FaceMesh,    // the baked face arrays the face is read from
    idx : i32,          // index into them (light / AO / corner heights)
    tile : i32,         // atlas tile
    dir : FaceDir,
    naxis : i32,        // normal axis: 0 = X, 1 = Y, 2 = Z
    normal : Vec3,
    light : FaceLight,  // the sun's and the sky's shares, before the shadow
    isWater : bool,
    wrap : bool,        // the texture repeats over this face (merged or water)
    flowU : f64,        // flowing-water texture scroll
    flowV : f64,
}

/**
 * One loaded chunk as a worker reads it: the baked faces, and the world origin
 * its chunk-local cells are offset by.
 */
struct SlotView {
    faces : FaceMesh,
    ox : i32,
    oz : i32,
}

/**
 * One span of a merged face: where it starts, how many cells it covers, and
 * where its texture picks up so a cut leaves no seam in the tiling.
 */
struct FaceSpan {
    cell : IVec3,   // the span's block origin
    probe : IVec3,  // the air cell its light and shadow are read from
    run : i32,      // cells it covers along the run axis
    uOff : f64,     // texture u where the span starts within the whole run
}

/**
 * ONE world-face raster worker. It owns the projection / near-clip scratch, the
 * per-direction face corner + UV tables and its own triangle queue: the frame
 * builds six of these over disjoint strides of the chunk ring, then fills every
 * queue in disjoint parallel column bands.
 *
 * Everything it reads of the world comes through the `TerrainView` seam: the
 * baked mesh (position, tile, run, light, AO and the corner heights the mesher
 * fixed for water and partial blocks), and one `cornerSample` per corner,
 * carrying sun, sky access and bounce.
 */
class ChunkRenderer {
    geom : FaceTable,     // face corner offsets + texture u/v (world::mesh::facegeom)
    cs : ScreenScratch,   // screen-space scratch (pixel x/y + inverse depth)
    ca : VertAttribs,     // camera-space input verts (pos + uv + Gouraud colour) …
    cb : VertAttribs,     // … and the near-clipped output verts
    triBuf : RasterTri[], // world-face triangle queue: the world pass projects/
                          // lights/clips into here once, then worker threads
                          // rasterise it in parallel column bands (tiled render)
    triN : i32,           // number of queued triangles this frame
    atlas : MipAtlas,     // ── per-frame render context (set in drawWorld) ──
    gam : Gamma,          // sRGB ↔ linear tables (owned by GammaTables)
    fogT : FogTable,      // the sky behind each pixel, and how much of it stands between
    day : DayState,       // sun / daylight snapshot (per-corner light + glint)
    lcurve : i64,         // brightness curve (owned by DayLighting)
    /** Triangles this worker queued in the last frame, for the `--snap` report. */
    pub(crate) queuedTris : i32 = 0,
    overflowed : bool = false, // the queue has filled once and said so

    /**
     * Allocate the triangle queue, the projection / clipping scratch buffers and
     * the face corner tables, and seed the (overwritten-per-frame) context.
     */
    constructor() {
        self.triBuf = malloc<RasterTri>(Render::TRI_QUEUE_CAP);
        self.triN = 0;
        self.geom = FaceTable {};

        // Screen-space scratch sized for a near-clipped polygon (≤ 5 verts).
        self.cs = ScreenScratch {
            sx: Mem::take(8 * 8),
            sy: Mem::take(8 * 8),
            iz: Mem::take(8 * 8),
        };

        // Camera-space input (ca) and clipped output (cb) vertex buffers: x, y,
        // z (depth), the u, v texture coordinates and the r, g, b Gouraud colour
        // per vertex — the same 16 disjoint allocBytes buffers, grouped.
        self.ca = VertAttribs {
            x: Mem::take(8 * 8),
            y: Mem::take(8 * 8),
            z: Mem::take(8 * 8),
            u: Mem::take(8 * 8),
            v: Mem::take(8 * 8),
            r: Mem::take(8 * 8),
            g: Mem::take(8 * 8),
            b: Mem::take(8 * 8),
        };
        self.cb = VertAttribs {
            x: Mem::take(8 * 8),
            y: Mem::take(8 * 8),
            z: Mem::take(8 * 8),
            u: Mem::take(8 * 8),
            v: Mem::take(8 * 8),
            r: Mem::take(8 * 8),
            g: Mem::take(8 * 8),
            b: Mem::take(8 * 8),
        };

        self.atlas = MipAtlas {
            mips: 0,
            mipOff: 0,
            mipSz: 0,
        };
        self.gam = Gamma {
            toLin: 0,
            toByte: 0,
            scale: 0.0,
        };
        self.fogT = FogTable {
            cols: 1,
            rows: 1,
            r: 0,
            g: 0,
            b: 0,
            curve: 0,
            xscale: 0.0,
            yscale: 0.0,
            dscale: 0.0,
        };
        self.day = DayState {
            sunX: 0.0,
            sunY: 1.0,
            sunZ: 0.0,
            dirX: 0.0,
            dirY: 1.0,
            dirZ: 0.0,
            dirStrength: 1.0,
            dirTintR: Light::SUN_TINT_R,
            dirTintG: Light::SUN_TINT_G,
            dirTintB: Light::SUN_TINT_B,
            skyAmbient: 1.0,
            skyColR: Daylight::DAY_SKY_R,
            skyColG: Daylight::DAY_SKY_G,
            skyColB: Daylight::DAY_SKY_B,
        };
        self.lcurve = 0;
    }

    // ── Projection & near-plane clipping ──

    /**
     * Transform a world point into camera space (post yaw + pitch) through the
     * shared Camera and store it into the `ca*` input buffers at slot k. No
     * perspective divide yet — that happens after near-plane clipping.
     * @param cam  the camera (eye + orientation + projection width)
     * @param w    the world-space point
     * @param k    scratch slot index to store the result in
     */
    fn toCam(self, cam : Camera, w : Vec3, k : i32) : void {
        let c : Vec3 = cam.toCamera(w);
        Mem::putRealOf(self.ca.x, k, c.x);
        Mem::putRealOf(self.ca.y, k, c.y);
        Mem::putRealOf(self.ca.z, k, c.z);
    }

    /**
     * Write the linear blend of input vertices j and i at parameter t
     * (the near-plane crossing) into output slot o.
     * @param j  first input vertex slot
     * @param i  second input vertex slot
     * @param t  blend parameter (0 at j, 1 at i)
     * @param o  output vertex slot
     */
    fn emitLerp(self, j : i32, i : i32, t : f64, o : i32) : void {
        Mem::putRealOf(
            self.cb.x,
            o,
            Mem::realOf(self.ca.x, j) + (Mem::realOf(self.ca.x, i) - Mem::realOf(self.ca.x, j)) * t
        );
        Mem::putRealOf(
            self.cb.y,
            o,
            Mem::realOf(self.ca.y, j) + (Mem::realOf(self.ca.y, i) - Mem::realOf(self.ca.y, j)) * t
        );
        Mem::putRealOf(
            self.cb.z,
            o,
            Mem::realOf(self.ca.z, j) + (Mem::realOf(self.ca.z, i) - Mem::realOf(self.ca.z, j)) * t
        );
        Mem::putRealOf(
            self.cb.u,
            o,
            Mem::realOf(self.ca.u, j) + (Mem::realOf(self.ca.u, i) - Mem::realOf(self.ca.u, j)) * t
        );
        Mem::putRealOf(
            self.cb.v,
            o,
            Mem::realOf(self.ca.v, j) + (Mem::realOf(self.ca.v, i) - Mem::realOf(self.ca.v, j)) * t
        );
        Mem::putRealOf(
            self.cb.r,
            o,
            Mem::realOf(self.ca.r, j) + (Mem::realOf(self.ca.r, i) - Mem::realOf(self.ca.r, j)) * t
        );
        Mem::putRealOf(
            self.cb.g,
            o,
            Mem::realOf(self.ca.g, j) + (Mem::realOf(self.ca.g, i) - Mem::realOf(self.ca.g, j)) * t
        );
        Mem::putRealOf(
            self.cb.b,
            o,
            Mem::realOf(self.ca.b, j) + (Mem::realOf(self.ca.b, i) - Mem::realOf(self.ca.b, j)) * t
        );
    }

    /**
     * Copy input vertex i to output slot o.
     * @param i  input vertex slot
     * @param o  output vertex slot
     */
    fn copyVert(self, i : i32, o : i32) : void {
        Mem::putRealOf(self.cb.x, o, Mem::realOf(self.ca.x, i));
        Mem::putRealOf(self.cb.y, o, Mem::realOf(self.ca.y, i));
        Mem::putRealOf(self.cb.z, o, Mem::realOf(self.ca.z, i));
        Mem::putRealOf(self.cb.u, o, Mem::realOf(self.ca.u, i));
        Mem::putRealOf(self.cb.v, o, Mem::realOf(self.ca.v, i));
        Mem::putRealOf(self.cb.r, o, Mem::realOf(self.ca.r, i));
        Mem::putRealOf(self.cb.g, o, Mem::realOf(self.ca.g, i));
        Mem::putRealOf(self.cb.b, o, Mem::realOf(self.ca.b, i));
    }

    /**
     * Which corner the fan triangulates from.
     *
     * A quad is drawn as two triangles, so one of its two diagonals becomes a
     * seam: the light is exact along it and interpolated across everything
     * else. Fanning always from corner 0 puts that seam in the same place
     * regardless of where the light actually varies, and on a quad with one
     * dark corner — the inside of every step, ledge and tree trunk — the wrong
     * choice smears the darkness diagonally across the face instead of letting
     * it wrap the corner.
     *
     * The seam belongs on the diagonal joining the DARKER pair, which is the
     * quad-flip rule from the smooth-lighting literature written as a fan
     * origin. Only a quad that survived the near clip whole can be flipped;
     * anything else is already a fan of its own shape.
     * @param n  vertices in the clipped polygon
     * @return the corner index to fan from (0 or 1)
     */
    fn fanOrigin(self, n : i32) : i32 {
        if (n != 4) {
            return 0;
        }
        let d02 : f64 = self.cornerLum(0) + self.cornerLum(2);
        let d13 : f64 = self.cornerLum(1) + self.cornerLum(3);
        return d02 > d13 ? 1 : 0;
    }

    /**
     * The baked Gouraud brightness at one clipped corner, as a plain sum of its
     * channels — only the ORDER of two of these ever matters.
     * @param i  index into the clipped-polygon scratch
     * @return the corner's brightness
     */
    fn cornerLum(self, i : i32) : f64 {
        return Mem::realOf(self.cb.r, i)
            + Mem::realOf(self.cb.g, i)
            + Mem::realOf(self.cb.b, i);
    }

    /**
     * Vertex `i` of the clipped polygon, gathered into one `RasterVert`.
     *
     * The clip and projection stages write eight parallel scratch arrays
     * (screen x/y, inverse depth, UV, and the baked Gouraud colour); the
     * rasteriser wants them as one value. Fan-triangulating a polygon
     * reads the same corner three times over, so the gather lives here
     * instead of being spelled out per triangle corner.
     *
     * @param i  index into the clipped-polygon scratch
     * @return the corner as the rasteriser's vertex
     */
    fn clippedVert(self, i : i32) : RasterVert {
        return RasterVert {
            sx: Mem::realOf(self.cs.sx, i) as f32,
            sy: Mem::realOf(self.cs.sy, i) as f32,
            iz: Mem::realOf(self.cs.iz, i) as f32,
            u: Mem::realOf(self.cb.u, i) as f32,
            v: Mem::realOf(self.cb.v, i) as f32,
            tr: Mem::realOf(self.cb.r, i) as f32,
            tg: Mem::realOf(self.cb.g, i) as f32,
            tb: Mem::realOf(self.cb.b, i) as f32,
        };
    }

    /**
     * Clip the `nIn`-vertex camera-space polygon in `ca*` against the
     * near plane (depth ≥ `Screen::NEAR_PLANE`) into `cb*` (Sutherland–Hodgman),
     * interpolating position + UV at each crossing. Replacing the old
     * "drop the whole face if any corner is too close" rule is what
     * removes the holes / texture smear when the camera hugs a block.
     * @param nIn  number of input vertices in the `ca*` buffers
     * @return number of output vertices written to the `cb*` buffers
     */
    fn clipNear(self, nIn : i32) : i32 {
        let mut outN : i32 = 0;
        let mut j : i32 = nIn - 1;
        for (i of 0..nIn) {
            let zi : f64 = Mem::realOf(self.ca.z, i);
            let zj : f64 = Mem::realOf(self.ca.z, j);
            let inI : bool = zi >= Screen::NEAR_PLANE;
            let inJ : bool = zj >= Screen::NEAR_PLANE;
            if (inI != inJ) {
                let t : f64 = (Screen::NEAR_PLANE - zj) / (zi - zj);
                self.emitLerp(j, i, t, outN);
                outN++;
            }
            if (inI) {
                self.copyVert(i, outN);
                outN++;
            }
            j = i;
        }
        return outN;
    }

    // ── Per-face baked-light reads through the split light seams ──

    /**
     * The ambient-sky occlusion factor of a corner sample: the baked
     * hemispherical sky access (ray-traced AO) mapped into [`Light::AO_SKY_MIN`, 1], so
     * valleys / recesses / canopy darken the ambient sky light.
     * @param s  the corner's light sample
     * @return the sky-AO factor in [`Light::AO_SKY_MIN`, 1]
     */
    fn skyAOFactor(self, s : CornerSample) : f64 {
        let skyAcc : f64 = (s.sky as f64) * 0.00392157;
        return Light::AO_SKY_MIN + (1.0 - Light::AO_SKY_MIN) * skyAcc;
    }

    /**
     * The one-bounce coloured indirect tint of a corner sample, unpacked to a
     * 0..2 RGB multiplier triple.
     * @param s  the corner's light sample
     * @return the bounce tint as (r, g, b) multipliers
     */
    fn bounceTint(self, s : CornerSample) : Vec3 {
        return vec3(
            (((s.bounce >> 16) & 0xFF) as f64) * 0.0078125,
            (((s.bounce >> 8) & 0xFF) as f64) * 0.0078125,
            ((s.bounce & 0xFF) as f64) * 0.0078125
        );
    }

    // ── World faces (water surface heights, face baking) ──

    /**
     * Project, cull, shade and rasterize one baked world face into the triangle
     * queue.
     * @param world  the light the corners sample
     * @param sv     the chunk the face belongs to
     * @param idx    index of the face to draw
     * @param cam    the camera (eye + orientation + projection width)
     * @param phase  animation time phase (scrolls flowing-water textures)
     */
    fn renderFace(
        mut self,
        world : dyn TerrainView,
        sv : SlotView,
        idx : i32,
        cam : Camera,
        phase : f64
    ) : void {
        let x : i32 = sv.ox + faceX(sv.faces, idx);
        let y : i32 = sv.faces.fy[idx] as i32;
        let z : i32 = sv.oz + faceZ(sv.faces, idx);

        // Unpack the direction and atlas tile from the packed ftile slot, and
        // what the face's corners stand on.
        let packed : i32 = sv.faces.ftile[idx] as i32;
        let dir : FaceDir = faceDirFrom(packed / 256);
        let kind : i32 = faceKind(sv.faces, idx);
        let isWaterFace : bool = kind == (FaceKind::Water as i32);
        let isPartialFace : bool = kind == (FaceKind::Partial as i32);

        // Cells this face spans, from the mesher's greedy merge, stretched along
        // one axis. Which axis needs no table: for every direction the corner's
        // `u` is exactly its offset along a HORIZONTAL axis — X for the top, the
        // bottom and the Z-facing walls, Z for the X-facing ones — so the run
        // multiplies the offset and the `u` together and the two cannot disagree.
        //
        // The extent is wanted whole HERE, for the culling centre and the
        // distance cut, which measure the surface that is actually there; the
        // span loop below is what decides how many quads it is drawn as.
        let run : i32 = faceRun(sv.faces, idx);
        let runF : f64 = run as f64;
        let mut runX : f64 = 1.0;
        let mut runZ : f64 = 1.0;
        if (dir == FaceDir::PosX || dir == FaceDir::NegX) {
            runZ = runF;
        } else {
            runX = runF;
        }

        let mut nx : f64 = 0.0;
        let mut ny : f64 = 0.0;
        let mut nz : f64 = 0.0;
        match dir {
            FaceDir::PosX => {
                nx = 1.0;
            }
            FaceDir::NegX => {
                nx = 0.0 - 1.0;
            }
            FaceDir::Top => {
                ny = 1.0;
            }
            FaceDir::Bottom => {
                ny = 0.0 - 1.0;
            }
            FaceDir::PosZ => {
                nz = 1.0;
            }
            _ => {
                nz = 0.0 - 1.0;
            }
        }

        // The centre of the MERGED quad, so back-face culling and the distance
        // cut both measure the thing that is actually drawn.
        let fcx : f64 = (x as f64) + 0.5 * runX + nx * 0.5;
        let fcy : f64 = (y as f64) + 0.5 + ny * 0.5;
        let fcz : f64 = (z as f64) + 0.5 * runZ + nz * 0.5;
        let vx : f64 = cam.eye.x - fcx;
        let vy : f64 = cam.eye.y - fcy;
        let vz : f64 = cam.eye.z - fcz;
        if (vx * vx + vz * vz > Render::DRAW_DIST * Render::DRAW_DIST) {
            return;
        }

        // Water surfaces AND the top of a partial block (thin snow, a slab) draw
        // double-sided so the surface stays visible from below; every other face
        // back-face culls. Without this the raised partial top back-face culls
        // the instant the eye drops below its plane and the top "disappears as
        // you descend" — worse the deeper the block (higher plane).
        let facing : f64 = vx * nx + vy * ny + vz * nz;
        if (!isWaterFace && facing <= 0.0 && (ny <= 0.0 || !isPartialFace)) {
            return;
        }

        // Flow animation: flowing water scrolls its texture along the flow the
        // mesher recorded (toward the lower level). Still lakes have none.
        let tscroll : f64 = phase * Water::FLOW_SPEED;
        let flowU : f64 = (sv.faces.fflow[idx * 2] as f64) * tscroll;
        let flowV : f64 = (sv.faces.fflow[idx * 2 + 1] as f64) * tscroll;

        // Face-direction (Lambert) shading + the directional sun shadow, shared
        // by all 4 corners (computed once before the per-corner light below).
        let mut bright : FaceLight = self.day.shade(vec3(nx, ny, nz));
        if (isWaterFace && facing <= 0.0) {
            // underside / far face of water, dimmer on both counts
            bright = FaceLight {
                direct: bright.direct * 0.62,
                ambient: bright.ambient * 0.62,
            };
        }

        // Directional sun shadow: if the air cell this face looks into is in the
        // sun's cast shadow, drop toward ambient (keeping Light::SHADOW_KEEP of
        // the direct term). A cell the bake never visits reads as full sun, so
        // caves / roofed faces are untouched without a separate sky-light gate.
        // The shadow-probe cell is just the neighbour in the face-normal
        // direction; dir already carries that, so match on it instead of
        // re-deriving the offset from the float normal three times.
        let mut sbx : i32 = x;
        let mut sby : i32 = y;
        let mut sbz : i32 = z;
        match dir {
            FaceDir::PosX => { sbx = x + 1; }
            FaceDir::NegX => { sbx = x - 1; }
            FaceDir::Top => { sby = y + 1; }
            FaceDir::Bottom => { sby = y - 1; }
            FaceDir::PosZ => { sbz = z + 1; }
            _ => { sbz = z - 1; }
        }
        let shadowCell : IVec3 = ivec3(sbx, sby, sbz);

        // `bright` is now the pure Lambert (sun-direction) term; the cast shadow
        // is applied PER CORNER below (smooth, face-independent), not flattened
        // over the whole face here — that's what removes the block staircase.
        let shade : FaceShade = FaceShade {
            mesh: sv.faces,
            idx,
            tile: packed % 256,
            dir,
            naxis: (dir as i32) / 2,   // normal axis: 0=X, 1=Y, 2=Z
            normal: vec3(nx, ny, nz),
            light: bright,
            isWater: isWaterFace,
            wrap: isWaterFace || run > 1,
            flowU,
            flowV,
        };

        // A merged quad carries the cast shadow at its four CORNERS and lets the
        // rasteriser interpolate between them. Over eight cells of flat ground
        // that turns a shadow edge into a ramp as wide as the run, and as the sun
        // creeps the ramp jumps from one run to the next — a shadow that moves in
        // eight-block steps instead of gliding, which is the staircase you see.
        //
        // So the run is cut where the shadow is NOT flat along it, and only
        // there: most of the world is evenly lit or evenly shaded, and those runs
        // still go out whole, which is what the merge was for.
        let step : i32 = self.shadowStep(world, shade, shadowCell, run);
        let mut start : i32 = 0;
        while (start < run) {
            let mut len : i32 = step;
            if (start + len > run) {
                len = run - start;
            }

            let mut advX : i32 = 0;
            let mut advZ : i32 = 0;
            if (shade.naxis == 0) {
                advZ = start;
            } else {
                advX = start;
            }

            self.emitSpan(
                world,
                cam,
                shade,
                FaceSpan {
                    cell: ivec3(x + advX, y, z + advZ),
                    probe: ivec3(shadowCell.x + advX, shadowCell.y, shadowCell.z + advZ),
                    run: len,
                    uOff: start as f64,
                }
            );
            start += len;
        }
    }

    /**
     * How many cells of a merged run one quad may cover before the cast shadow
     * has to be resampled: the whole run where the sun visibility along it is
     * flat, one cell where it is not.
     *
     * Two gates come first because they are nearly free and they take most of
     * the faces with them: a face the sky never reaches has no cast shadow to
     * resolve, and a face turned away from the sun has no direct term at all
     * for a shadow to take away. What is left to walk is the
     * sunward, sky-facing surface — and of that, only the runs a shadow edge
     * actually crosses come back split.
     * @param world  the sun visibility the run is walked through
     * @param fs     the face's per-quad constants
     * @param cell   the face's air probe cell (the run's near end)
     * @param run    cells the merged face spans
     * @return the cells one emitted quad may cover
     */
    fn shadowStep(self, world : dyn TerrainView, fs : FaceShade, cell : IVec3, run : i32) : i32 {
        if (run < 2 || fs.light.direct <= 0.0) {
            return run;
        }
        if ((Mem::byteAt(fs.mesh.flight, (fs.idx * 4 * 2) as i64) >> 4) == 0) {
            return run;
        }

        let mut dx : i32 = 1;
        let mut dz : i32 = 0;
        if (fs.naxis == 0) {
            dx = 0;
            dz = 1;
        }

        let mut lo : i32 = 255;
        let mut hi : i32 = 0;
        for (i of 0..run) {
            let v : i32 = world.sunlitGet(ivec3(cell.x + dx * i, cell.y, cell.z + dz * i));
            if (v < lo) {
                lo = v;
            }
            if (v > hi) {
                hi = v;
            }
        }

        if (hi - lo > Light::SHADOW_SPLIT) {
            return 1;
        }
        return run;
    }

    /**
     * Project, light, clip and queue ONE span of a face — the whole merged run
     * when its shadow is flat, a single cell when the run was cut.
     *
     * Everything a span does not change is in `fs`; what it does change is where
     * it starts along the run, how far it reaches, and the texture offset that
     * keeps the tiling continuous across a cut.
     * @param world  the light the corners sample
     * @param cam    the camera (eye + orientation + projection width)
     * @param fs     the face's per-quad constants
     * @param sp     this span's origin, length and texture offset
     */
    fn emitSpan(mut self, world : dyn TerrainView, cam : Camera, fs : FaceShade, sp : FaceSpan) : void {
        let x : i32 = sp.cell.x;
        let y : i32 = sp.cell.y;
        let z : i32 = sp.cell.z;
        let nx : f64 = fs.normal.x;
        let ny : f64 = fs.normal.y;
        let nz : f64 = fs.normal.z;

        // Cells the span spans, per axis: the run on the one it runs along, one
        // on the other. As integers, because the corner's world column is one of
        // them and the far end of the run is the other minus one.
        let mut runXi : i32 = 1;
        let mut runZi : i32 = 1;
        if (fs.naxis == 0) {
            runZi = sp.run;
        } else {
            runXi = sp.run;
        }
        let runF : f64 = sp.run as f64;

        // Load the 4 corners into camera space + their tile UVs, and bake each
        // corner's light colour (smooth light + AO + per-corner soft shadow) into
        // the car/cag/cab inputs so clipNear interpolates colour like it does UV.
        // Each corner stands at the height the mesher recorded for it: the top
        // of the cell, a partial block's box, or the sloped water surface.
        let di : i32 = fs.dir as i32;
        let q : i32 = di * 4;
        for (k of 0..4) {
            let b : i32 = (di * 4 + k) * 3;
            let oxv : i32 = self.geom.coff[b];
            let oyv : i32 = self.geom.coff[b + 1];
            let ozv : i32 = self.geom.coff[b + 2];

            // The corner's own world column — its block offset stretched along
            // the run, so the eye vector reads the column the corner actually
            // sits over, not the span's origin.
            let cwx : i32 = x + oxv * runXi;
            let cwz : i32 = z + ozv * runZi;
            let top : i32 = fs.mesh.ftop[fs.idx * 4 + k] as i32;
            let cornerY : f64 = (y as f64) + topHeight(top);
            self.toCam(cam, vec3(cwx as f64, cornerY, cwz as f64), k);
            Mem::putRealOf(self.ca.u, k, (self.geom.uvu[q + k] as f64) * runF + sp.uOff + fs.flowU);
            Mem::putRealOf(self.ca.v, k, (self.geom.uvv[q + k] as f64) + fs.flowV);

            // Every smooth term is read AT THIS CORNER, through one probe: the
            // corner's own air cell and the two in-plane steps to the other
            // three cells meeting there. On a merged quad that cell is the far
            // end of the run, not the face's origin — a term sampled at the
            // origin would be spread over eight blocks of surface.
            let probe : CornerProbe = cornerProbe(
                sp.probe,
                ivec3(oxv, oyv, ozv),
                fs.naxis,
                runXi - 1,
                runZi - 1
            );
            let smp : CornerSample = world.cornerSample(probe);

            let visK : f64 = (smp.sun as f64) * 0.00392157;
            let keepK : f64 = Light::SHADOW_KEEP + (1.0 - Light::SHADOW_KEEP) * visK;
            let brightK : f64 = fs.light.exposure(keepK);

            // Per-corner smooth light: the four nibbles the mesher averaged —
            // sky, then block red / green / blue — each through the exponential
            // curve (sky dimmed by daylight), with the corner's shaded
            // brightness and its ambient occlusion.
            let lo : i64 = ((fs.idx * 4 + k) * 2) as i64;
            let lb0 : i32 = Mem::byteAt(fs.mesh.flight, lo);
            let lb1 : i32 = Mem::byteAt(fs.mesh.flight, lo + 1);
            let aok : i32 = (Mem::byteAt(fs.mesh.fao, fs.idx as i64) >> (2 * k)) & 3;
            let aoFac : f64 = 1.0 - Light::AO_STRENGTH * ((3 - aok) as f64) * 0.3333333;
            let lit : CornerLight = CornerLight {
                sky: Mem::realOf(self.lcurve, (lb0 >> 4) & 0xF) * self.skyAOFactor(smp),
                block: LinRgb {
                    r: Mem::realOf(self.lcurve, lb0 & 0xF),
                    g: Mem::realOf(self.lcurve, (lb1 >> 4) & 0xF),
                    b: Mem::realOf(self.lcurve, lb1 & 0xF),
                },
                bright: brightK,
                ao: aoFac,
            };

            // Warm sun / cool shade by which of the two halves of this corner's
            // light won — the sun's or the sky's. A ratio, so it is a fraction by
            // construction. Taking it off the EXPOSED brightness instead, as this
            // did, folded `Light::SUN_STRENGTH` into it: past 1 the blend stopped
            // interpolating and started extrapolating, pushing every lit surface
            // a good third BEYOND the warmest tint the config names. That is
            // where the neon came from — sunlit grass was being multiplied by a
            // blue of 0.56 where the table says 0.86.
            let mut cc : LinRgb = lit.colour(skyTint(
                fs.light.directShare(keepK),
                LinRgb {
                    r: self.day.dirTintR,
                    g: self.day.dirTintG,
                    b: self.day.dirTintB,
                },
                self.bounceTint(smp)
            ));

            // View vector from this corner to the eye. Both reflections want it:
            // water's sharp glint, and the broad sheen every other surface has.
            let mut vx : f64 = cam.eye.x - (cwx as f64);
            let mut vy : f64 = cam.eye.y - cornerY;
            let mut vz : f64 = cam.eye.z - (cwz as f64);
            let mut vl : f64 = (vx * vx + vy * vy + vz * vz).sqrt();
            if (vl < 0.0001) {
                vl = 0.0001;
            }
            vx /= vl;
            vy /= vl;
            vz /= vl;

            if (fs.isWater) {
                // Sun glint: half-vector specular, cos^32, gated by sun visibility
                // and daylight. A strong warm multiplier that bloom turns to gold.
                let hx : f64 = vx + self.day.sunX;
                let hy : f64 = vy + self.day.sunY;
                let hz : f64 = vz + self.day.sunZ;
                let mut hl : f64 = (hx * hx + hy * hy + hz * hz).sqrt();
                if (hl < 0.0001) {
                    hl = 0.0001;
                }
                let mut ndh : f64 = (nx * hx + ny * hy + nz * hz) / hl;
                if (ndh < 0.0) {
                    ndh = 0.0;
                }
                let s2 : f64 = ndh * ndh;
                let s4 : f64 = s2 * s2;
                let s8 : f64 = s4 * s4;
                let s16 : f64 = s8 * s8;
                let spec : f64 = s16 * s16 * visK * self.day.dirStrength * Water::SPEC_STRENGTH;

                // Fresnel: brighter at grazing view angles (sky-reflection sheen).
                let mut ndv : f64 = nx * vx + ny * vy + nz * vz;
                if (ndv < 0.0) {
                    ndv = 0.0;
                }
                let om : f64 = 1.0 - ndv;
                let om2 : f64 = om * om;
                let fres : f64 = Water::F0 + (1.0 - Water::F0) * om2 * om2 * om;
                let fboost : f64 = 1.0 + fres * Water::FRESNEL_STRENGTH;
                cc.r = cc.r * fboost * (1.0 + spec * 1.10);
                cc.g = cc.g * fboost * (1.0 + spec * 1.00);
                cc.b = cc.b * fboost * (1.0 + spec * 0.72);
            } else {
                // What the ground sends back of the sun. Added in the sun's own
                // colour rather than multiplied into the texel's, so a surface in
                // full sun moves toward the light instead of simply becoming more
                // of itself — which is what stops grass at noon reading as paint.
                let sheen : f64 = sunSheen(
                    fs.normal,
                    vec3(vx, vy, vz),
                    vec3(self.day.dirX, self.day.dirY, self.day.dirZ),
                    visK
                );
                let sh : f64 = sheen * self.day.dirStrength;
                cc.r += sh * self.day.dirTintR;
                cc.g += sh * self.day.dirTintG;
                cc.b += sh * self.day.dirTintB;
            }
            Mem::putRealOf(self.ca.r, k, cc.r);
            Mem::putRealOf(self.ca.g, k, cc.g);
            Mem::putRealOf(self.ca.b, k, cc.b);
        }

        // Clip against the near plane, then project the surviving polygon.
        let n : i32 = self.clipNear(4);
        if (n < 3) {
            return;
        }

        // Mip selection + filtering is now per pixel in the rasteriser
        // (anisotropic), so no per-face mip is computed here.
        // Per-corner light colour was baked into car/cag/cab and carried through
        // clipNear into cbr/cbg/cbb — the rasteriser interpolates it per pixel.
        for (v of 0..n) {
            let proj : Projected = cam.screenOf(vec3(
                Mem::realOf(self.cb.x, v),
                Mem::realOf(self.cb.y, v),
                Mem::realOf(self.cb.z, v)
            ));
            Mem::putRealOf(self.cs.sx, v, proj.sx);
            Mem::putRealOf(self.cs.sy, v, proj.sy);
            Mem::putRealOf(self.cs.iz, v, proj.iz);
        }

        // Fan-triangulate the clipped polygon from vertex 0 and QUEUE each
        // triangle (with its Gouraud per-vertex colours) — the parallel band
        // rasteriser fills them later. The heavy per-face lighting above is thus
        // done once, not once per worker.
        // A merged quad tiles its texture, which is the same wrap the scrolled
        // water surface asks for — and a span cut out of one carries a texture
        // offset, so it wraps for the same reason even when it is one cell wide.
        let wf : i32 = fs.wrap ? 1 : 0;
        let o : i32 = self.fanOrigin(n);
        for (t of 1..n - 1) {
            if (self.triN < Render::TRI_QUEUE_CAP) {
                let i1 : i32 = (o + t) % n;
                let i2 : i32 = (o + t + 1) % n;
                // The column span, taken here where the projection just ran,
                // so the fill's band test costs a comparison instead of a
                // whole triangle setup it then throws away.
                let (colLo, colHi) = columnSpan(
                    Mem::realOf(self.cs.sx, o),
                    Mem::realOf(self.cs.sx, i1),
                    Mem::realOf(self.cs.sx, i2)
                );
                self.triBuf[self.triN] = RasterTri {
                    a: self.clippedVert(o),
                    b: self.clippedVert(i1),
                    c: self.clippedVert(i2),
                    tile: fs.tile as i16,
                    wrap: wf as i8,
                    minx: colLo,
                    maxx: colHi,
                };
                self.triN++;
            } else if (!self.overflowed) {
                // A full queue drops the rest of the frame's terrain from this
                // worker — holes, with nothing on screen to say why. Once is
                // enough to say so.
                self.overflowed = true;
                Console::println("world raster: a worker's triangle queue is full"
                    + " (Render::TRI_QUEUE_CAP = ${Render::TRI_QUEUE_CAP}); faces dropped");
            }
        }
    }

    /**
     * Snapshot the per-frame render context onto this component.
     *
     * Copied onto every worker rather than threaded through each call:
     * the band rasteriser and the projection both read it a hundred
     * thousand times a frame, and it does not change within one.
     * @param atlas   the texture atlas mip chain view
     * @param gam     the colour space the texels are lit in
     * @param fogT    the fog tables (the sky behind each pixel, and its depth curve)
     * @param day     the day/night state (sun / daylight for corner shading)
     * @param lcurve  the brightness-curve lookup
     */
    pub(crate) fn setFrame(
        mut self,
        atlas : MipAtlas,
        gam : Gamma,
        fogT : FogTable,
        day : DayState,
        lcurve : i64
    ) : void {
        self.atlas = atlas;
        self.gam = gam;
        self.fogT = fogT;
        self.day = day;
        self.lcurve = lcurve;
        self.triN = 0;
    }

    /**
     * Project / light / clip the faces of every `stride`-th loaded chunk
     * from `first` into THIS component's triangle queue.
     *
     * The share is taken by striding the slot ring rather than by cutting
     * it into contiguous runs: chunks differ enormously in how many faces
     * they carry — a hillside against open sky — and adjacent slots are
     * the ones most likely to be alike, so contiguous shares are the ones
     * that come out lopsided.
     *
     * Each worker owns its own queue and its own clipping scratch, so
     * nothing here is shared and nothing needs a lock.
     * @param world   the loaded chunks, their baked faces and their light
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     * @param first   the first slot this worker takes
     * @param stride  how many workers there are
     */
    pub(crate) fn buildSlots(
        mut self,
        world : dyn TerrainView,
        cam : Camera,
        phase : f64,
        first : i32,
        stride : i32
    ) : void {
        let slots : i32 = World::SPAN * World::SPAN;
        let cone : ViewCone = viewConeFor(cam);
        let faces : FaceMesh = world.faces();
        let mut slot : i32 = first;
        while (slot < slots) {
            let sc : SlotChunk = world.slotChunk(slot);
            if (sc.loaded && chunkVisible(cone, sc.cx, sc.cz)) {
                let sv : SlotView = SlotView {
                    faces,
                    ox: sc.cx * World::CHUNK_SIZE,
                    oz: sc.cz * World::CHUNK_SIZE,
                };
                let base : i32 = slot * World::MAX_FACES_PER_CHUNK;
                for (fi of 0..faces.fcount[slot]) {
                    self.renderFace(world, sv, base + fi, cam, phase);
                }
            }
            slot += stride;
        }
        self.queuedTris = self.triN;
    }

    /**
     * Rasterise the queued world triangles whose pixels fall in the column band
     * [bx0, bx1). Each band is disjoint, so threads never touch the same z-buffer
     * pixel. Called by the renderer's `BandFill` pass, one band per worker.
     * Reads this frame's atlas + fog off the component (set in drawWorld).
     * @param fb   the render target (framebuffer + z-buffer + size)
     * @param bx0  inclusive left screen column of this band
     * @param bx1  exclusive right screen column of this band
     */
    pub(crate) fn rasterizeBand(self, fb : FrameBuf, bx0 : i32, bx1 : i32) : void {
        let band : Band = Band { x0: bx0, x1: bx1 };
        for (i of 0..self.triN) {
            let tri : RasterTri = self.triBuf[i];
            // The band owns columns [bx0, bx1); a triangle that touches none
            // of them is done with here, before the setup it would not use.
            if ((tri.maxx as i32) >= bx0 && (tri.minx as i32) < bx1) {
                rasterTriTex(fb, tri, self.atlas, self.gam, self.fogT, band);
            }
        }
    }
}

