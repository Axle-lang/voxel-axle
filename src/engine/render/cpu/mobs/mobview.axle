// mobview — the mob box-model renderer.
//
// Mobs (and torches) are drawn as little stacks of shaded, atlas-textured
// cuboids sharing the world z-buffer. Each mob describes its own boxes through
// `ActorVisual.buildModel` (entity::model); this file only knows how to draw an
// oriented box — the corner math, the per-face project + backface-cull +
// raster, the per-mob ambient light — so a new species never touches it.
//
// Per frame the Renderer hands in a `MobScene` value (atlas + fog colour + the
// day/night state); MobView never stores frame state beyond the per-mob
// `mobLight`. The block torches reuse `drawQuad` directly, so it is the one
// public quad primitive.

use smalt::Mem;
use smalt::Color;
use crate::engine::ui::widget::{tintIf};
use crate::engine::shade::daymodel::{ DayState };
use crate::engine::render::cpu::raster::triangle::{
    rasterTriTex, rasterTri, columnSpan, RasterVert, RasterTri, FlatTri, ScreenVert,
};
use crate::engine::render::cpu::raster::framebuf::{ FrameBuf, Band };
use crate::engine::render::cpu::raster::mip::{ MipAtlas };
use crate::engine::render::view::camera::{ Camera, Projected };
use crate::engine::shade::facelight::{ sunExposure };
use crate::engine::shade::gamma::{ Gamma, LinRgb };
use crate::engine::render::cpu::sky::fogtables::{ FogTable };
use crate::engine::math::vec3::{ Vec3, vec3, ivec3 };
use crate::engine::entity::mobs::MobManager;
use crate::engine::world::chunks::ChunkManager;
use crate::engine::world::seams::{ ChannelLevels };
use crate::engine::entity::seams::{ ActorVisual };
use crate::engine::entity::model::{ BoxModel, BoxPart };
use crate::configs::atlas::{ Atlas };
use crate::configs::light::{ Light };
use crate::configs::screen::{ Screen };

/**
 * The per-frame context for the mob pass: the atlas mip chain, the colour space
 * the faces are lit in, the distance-fog colour and the day/night state (sun
 * direction + daylight for shading). Bundled so each draw helper takes one
 * `scene` instead of threading four loose values through every call.
 */
struct MobScene {
    atlas : MipAtlas,
    gam : Gamma,
    fogT : FogTable,
    ds : DayState,
}

/** One box face's surface: flat fill colour, atlas tile (<0 = flat), hurt tint. */
struct Material {
    color : i32,
    tile : i32,
    hurt : bool,
}

/** One corner of a face being clipped: camera-space position and texture u/v. */
struct ClipVert {
    p : Vec3,
    u : f64,
    v : f64,
}

/** Corners a clipped quad can have: four, plus one per edge the near plane cuts. */
const CLIP_MAX : i32 = 8;

class MobView {
    clipIn : ClipVert[],  // a quad's corners in camera space, before the near clip
    clipOut : ClipVert[], // ...and the polygon that survives it
    obx : i64,      // oriented-box world corners (8 per body part)
    oby : i64,
    obz : i64,
    mobLight : LinRgb, // ambient light on the mob currently being drawn, per channel
    model : BoxModel,  // the boxes the mob being drawn described

    /** Allocate the clipping scratch and the oriented-box corner buffers. */
    constructor() {
        self.clipIn = malloc<ClipVert>(CLIP_MAX);
        self.clipOut = malloc<ClipVert>(CLIP_MAX);
        self.obx = Mem::take(8 * 8);
        self.oby = Mem::take(8 * 8);
        self.obz = Mem::take(8 * 8);
        self.mobLight = LinRgb { r: 1.0, g: 1.0, b: 1.0 };
        self.model = new BoxModel();
    }

    /**
     * Clip the polygon in `clipIn[0..n)` against the near plane into
     * `clipOut`, carrying the texture coordinates along each cut edge.
     *
     * The terrain has always been clipped; mobs and torches dropped a whole
     * face the moment one corner crossed the plane, so walking up to an
     * animal or a torch made it blink out a face at a time.
     * @param n  corners in `clipIn`
     * @return corners in `clipOut`, under 3 when nothing survives
     */
    fn clipNear(mut self, n : i32) : i32 {
        const near : f64 = Screen::NEAR_PLANE;
        let m : i32 = 0;
        for (i of 0..n) {
            const cur : ClipVert = self.clipIn[i];
            const nxt : ClipVert = self.clipIn[(i + 1) % n];
            const curIn : bool = cur.p.z >= near;
            const nxtIn : bool = nxt.p.z >= near;
            if (curIn) {
                self.clipOut[m] = ClipVert {
                    p: cur.p,
                    u: cur.u,
                    v: cur.v,
                };
                m++;
            }
            if (curIn != nxtIn) {
                const t : f64 = (near - cur.p.z) / (nxt.p.z - cur.p.z);
                self.clipOut[m] = ClipVert {
                    p: vec3(
                        cur.p.x + (nxt.p.x - cur.p.x) * t,
                        cur.p.y + (nxt.p.y - cur.p.y) * t,
                        near
                    ),
                    u: cur.u + (nxt.u - cur.u) * t,
                    v: cur.v + (nxt.v - cur.v) * t,
                };
                m++;
            }
        }
        return m;
    }

    /**
     * One clipped corner on screen, for a flat-colour fill.
     * @param cam  the frame's camera
     * @param k    the corner, in `clipOut`
     * @return its screen position and inverse depth
     */
    fn flatAt(self, cam : Camera, k : i32) : ScreenVert {
        const pr : Projected = cam.screenOf(self.clipOut[k].p);
        return ScreenVert {
            sx: pr.sx,
            sy: pr.sy,
            iz: pr.iz,
        };
    }

    /**
     * One clipped corner on screen, lit and textured for the triangle filler.
     * @param cam  the frame's camera
     * @param k    the corner, in `clipOut`
     * @param tr   red light multiplier
     * @param tg   green light multiplier
     * @param tb   blue light multiplier
     * @return the vertex
     */
    fn screenAt(self, cam : Camera, k : i32, tr : f64, tg : f64, tb : f64) : RasterVert {
        const c : ClipVert = self.clipOut[k];
        const pr : Projected = cam.screenOf(c.p);
        return RasterVert {
            sx: pr.sx as f32,
            sy: pr.sy as f32,
            iz: pr.iz as f32,
            u: c.u as f32,
            v: c.v as f32,
            tr: tr as f32,
            tg: tg as f32,
            tb: tb as f32,
        };
    }

    /**
     * Set the light every following quad is drawn in, until the next mob sets
     * its own. What the torch pass needs: a torch is the SOURCE, so it is not
     * lit by the room the way an animal standing in it is — left to take the
     * ambient it would be a black post in the middle of the pool of light it
     * is casting.
     * @param l  the light to draw in
     */
    pub(crate) fn setLight(mut self, l : LinRgb) : void {
        self.mobLight = l;
    }

    /**
     * Mob Lambert term for a face normal, lifted by ambient and exposed by the
     * same sun the world faces get — a mob has no shadow map, so it sees the
     * whole of it. Kept local so mobview has no back-reference to Renderer.
     * @param nx  normal x
     * @param ny  normal y
     * @param nz  normal z
     * @param ds  the day/night state (sun direction)
     * @return the mob face's light factor
     */
    fn shadeMob(self, nx : f64, ny : f64, nz : f64, ds : DayState) : f64 {
        return sunExposure(vec3(nx, ny, nz), vec3(ds.sunX, ds.sunY, ds.sunZ), 1.0);
    }

    /**
     * One face of a mob box: project 4 corners, backface-cull against the eye,
     * then fill atlas-textured (or flat-shaded). `mat.hurt` tints the face red
     * for the damage flash. Public because the block torches reuse it.
     * @param cam    the frame's camera
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param a      world-space corner a
     * @param b      world-space corner b
     * @param c      world-space corner c
     * @param d      world-space corner d
     * @param n      face normal (for backface cull + Lambert shading)
     * @param mat    the face surface (colour / tile / hurt)
     * @param scene  the per-frame mob context (atlas, fog, day-state, lens)
     */
    pub(crate) fn drawQuad(
        mut self,
        cam : Camera,
        fb : FrameBuf,
        a : Vec3,
        b : Vec3,
        c : Vec3,
        d : Vec3,
        n : Vec3,
        mat : Material,
        scene : MobScene
    ) : void {
        const mx : f64 = (a.x + b.x + c.x + d.x) * 0.25;
        const my : f64 = (a.y + b.y + c.y + d.y) * 0.25;
        const mz : f64 = (a.z + b.z + c.z + d.z) * 0.25;
        if ((cam.eye.x - mx) * n.x + (cam.eye.y - my) * n.y + (cam.eye.z - mz) * n.z <= 0.0) {
            return;
        }

        // The quad in camera space, clipped where it crosses the near plane;
        // the texture runs (0,1) (1,1) (1,0) (0,0) round its corners.
        self.clipIn[0] = ClipVert {
            p: cam.toCamera(a),
            u: 0.0,
            v: 1.0,
        };
        self.clipIn[1] = ClipVert {
            p: cam.toCamera(b),
            u: 1.0,
            v: 1.0,
        };
        self.clipIn[2] = ClipVert {
            p: cam.toCamera(c),
            u: 1.0,
            v: 0.0,
        };
        self.clipIn[3] = ClipVert {
            p: cam.toCamera(d),
            u: 0.0,
            v: 0.0,
        };
        const corners : i32 = self.clipNear(4);
        if (corners < 3) {
            return;
        }

        // Mobs are little multi-box models: the full terrain light contrast
        // (0.5..1.0) makes every box edge read as a hard seam. Compress it
        // toward bright so adjacent faces blend and the model looks rounded
        // rather than crated.
        const shade : f64 = 0.80 + 0.20 * self.shadeMob(n.x, n.y, n.z, scene.ds);
        const bright : f64 = shade * self.mobLight.g;

        // A struck mob glows red: lift the red multiplier, damp green/blue.
        let tr : f64 = shade * self.mobLight.r;
        let tg : f64 = bright;
        let tb : f64 = shade * self.mobLight.b;
        if (mat.hurt) {
            tr = bright + 0.6;
            tg = bright * 0.4;
            tb = bright * 0.4;
        }
        const textured : bool = Atlas::USE_MOB_TEXTURES && mat.tile >= 0;
        const col : i32 = scene.gam.shade(tintIf(mat.hurt, mat.color), bright);
        const band : Band = Band { x0: 0, x1: fb.w };

        // A fan from the first corner: unclipped, that is (a, b, c) then
        // (a, c, d), the two triangles the quad always was.
        const v0 : RasterVert = self.screenAt(cam, 0, tr, tg, tb);
        for (k of 1..corners - 1) {
            const v1 : RasterVert = self.screenAt(cam, k, tr, tg, tb);
            const v2 : RasterVert = self.screenAt(cam, k + 1, tr, tg, tb);
            if (textured) {
                // A mob is drawn straight into the full-width band rather than
                // queued, so nothing reads the span — filled in anyway, so no
                // triangle anywhere carries a stale one.
                let (lo, hi) = columnSpan(
                    self.flatAt(cam, 0).sx,
                    self.flatAt(cam, k).sx,
                    self.flatAt(cam, k + 1).sx
                );
                rasterTriTex(
                    fb,
                    RasterTri {
                        a: v0,
                        b: v1,
                        c: v2,
                        tile: mat.tile as i16,
                        wrap: 0 as i8,
                        minx: lo,
                        maxx: hi,
                    },
                    scene.atlas,
                    scene.gam,
                    scene.fogT,
                    band
                );
            } else {
                rasterTri(
                    fb,
                    FlatTri {
                        a: self.flatAt(cam, 0),
                        b: self.flatAt(cam, k),
                        c: self.flatAt(cam, k + 1),
                        color: col,
                    },
                    scene.fogT
                );
            }
        }
    }

    /**
     * One face of an oriented box: the 4 vertices are corner indices into the
     * `ob*` world-corner buffers filled by drawObox.
     * @param cam    the frame's camera
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param i0     corner index for vertex 0
     * @param i1     corner index for vertex 1
     * @param i2     corner index for vertex 2
     * @param i3     corner index for vertex 3
     * @param n      face normal (backface cull + Lambert shading)
     * @param mat    the face surface (colour / tile / hurt)
     * @param scene  the per-frame mob context
     */
    fn oquad(
        mut self,
        cam : Camera,
        fb : FrameBuf,
        i0 : i32,
        i1 : i32,
        i2 : i32,
        i3 : i32,
        n : Vec3,
        mat : Material,
        scene : MobScene
    ) : void {
        const c0 : Vec3 = vec3(
            Mem::realOf(self.obx, i0),
            Mem::realOf(self.oby, i0),
            Mem::realOf(self.obz, i0)
        );
        const c1 : Vec3 = vec3(
            Mem::realOf(self.obx, i1),
            Mem::realOf(self.oby, i1),
            Mem::realOf(self.obz, i1)
        );
        const c2 : Vec3 = vec3(
            Mem::realOf(self.obx, i2),
            Mem::realOf(self.oby, i2),
            Mem::realOf(self.obz, i2)
        );
        const c3 : Vec3 = vec3(
            Mem::realOf(self.obx, i3),
            Mem::realOf(self.oby, i3),
            Mem::realOf(self.obz, i3)
        );

        self.drawQuad(
            cam,
            fb,
            c0,
            c1,
            c2,
            c3,
            n,
            mat,
            scene
        );
    }

    /**
     * Draw one body part as an **oriented** box: the part is positioned in the
     * mob's own frame (`part.ctr` = right / up-above-feet / forward,
     * half-extents `part.half`), then the whole box is rotated by the
     * mob's heading, so the head/body/legs turn together as a rigid model. The
     * +forward face carries `part.faceTile` (the animal's face), the rest
     * `part.skinTile`. Death collapses the box (sink + squash + topple along
     * the heading).
     * @param cam    the frame's camera
     * @param a      the actor whose frame the box is placed in (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param part   the box: placement in the mob frame, colour and tiles
     * @param scene  the per-frame mob context
     */
    fn drawObox(
        mut self,
        cam : Camera,
        a : dyn ActorVisual,
        fb : FrameBuf,
        part : BoxPart,
        scene : MobScene
    ) : void {
        const color : i32 = part.color;
        // Read the seam once (dynamic dispatch) into locals for the corner loop.
        const heading : f64 = a.heading();
        const pos : Vec3 = a.pos();
        const fwdx : f64 = heading.cos();
        const fwdz : f64 = heading.sin();
        const rgtx : f64 = heading.sin();
        const rgtz : f64 = 0.0 - heading.cos();

        // Death: topple onto one side like Minecraft — rotate the whole model
        // up→right about the feet by up to ~90° as the collapse plays out. `lr`,
        // `lu` are the same rotation applied to every part (so the box stays
        // rigid); a small lift keeps the resting flank from dipping underground.
        const pr : f64 = a.deathProgress();
        const theta : f64 = pr * 1.5707963;
        const ct : f64 = theta.cos();
        const st : f64 = theta.sin();
        const lift : f64 = 0.15 * st;

        for (ci of 0..8) {
            const sr : f64 = (ci & 1) != 0 ? 1.0 : 0.0 - 1.0;
            const su : f64 = (ci & 2) != 0 ? 1.0 : 0.0 - 1.0;
            const sf : f64 = (ci & 4) != 0 ? 1.0 : 0.0 - 1.0;
            const lr0 : f64 = part.ctr.x + sr * part.half.x;
            const hun : f64 = part.ctr.y + su * part.half.y;
            const lf : f64 = part.ctr.z + sf * part.half.z;
            const lr : f64 = lr0 * ct + hun * st;
            const lu : f64 = hun * ct - lr0 * st + lift;
            Mem::putRealOf(self.obx, ci, pos.x + lr * rgtx + lf * fwdx);
            Mem::putRealOf(self.oby, ci, pos.y + lu);
            Mem::putRealOf(self.obz, ci, pos.z + lr * rgtz + lf * fwdz);
        }

        const hurt : bool = a.hurtFlash() > 0;

        // The right and up face normals rotate with the topple (forward is the
        // rotation axis, so forward normals are unchanged), keeping backface
        // culling correct while the body lies down.
        const rnx : f64 = ct * rgtx;
        const rny : f64 = 0.0 - st;
        const rnz : f64 = ct * rgtz;
        const unx : f64 = st * rgtx;
        const uny : f64 = ct;
        const unz : f64 = st * rgtz;

        const skin : Material = Material {
            color,
            tile: part.skinTile,
            hurt,
        };
        const faceM : Material = Material {
            color,
            tile: part.faceTile,
            hurt,
        };
        self.oquad(
            cam,
            fb,
            1,
            5,
            7,
            3,
            vec3(rnx, rny, rnz),
            skin,
            scene
        );
        self.oquad(
            cam,
            fb,
            4,
            0,
            2,
            6,
            vec3(0.0 - rnx, 0.0 - rny, 0.0 - rnz),
            skin,
            scene
        );
        self.oquad(
            cam,
            fb,
            2,
            3,
            7,
            6,
            vec3(unx, uny, unz),
            skin,
            scene
        );
        self.oquad(
            cam,
            fb,
            4,
            5,
            7,
            6,
            vec3(fwdx, 0.0, fwdz),
            faceM,
            scene
        );
        self.oquad(
            cam,
            fb,
            1,
            0,
            2,
            3,
            vec3(0.0 - fwdx, 0.0, 0.0 - fwdz),
            skin,
            scene
        );

        // Once tipping over, the underside comes into view, so draw it too.
        if (pr > 0.0) {
            self.oquad(
                cam,
                fb,
                0,
                1,
                5,
                4,
                vec3(0.0 - unx, 0.0 - uny, 0.0 - unz),
                skin,
                scene
            );
        }
    }

    /**
     * Ambient light factor (0..1) for a mob at world position (mx,my,mz): the
     * brighter of sky×daylight and block light at its cell, through the same
     * exponential curve as terrain, so mobs darken at night / underground and
     * are lit — in the torch's own colour — by nearby torches. Sky and block
     * light ADD, as they do on terrain; taking the brighter of the two is what
     * stops a torch from warming an animal the sky already reaches.
     * @param man       the chunk manager (light maps)
     * @param pos       the mob's feet position
     * @param lcurve    the renderer's brightness lookup (lightFalloff^(15-level))
     * @param daylight  the day factor that scales sky light
     * @return ambient light factor in [`Light::MIN`, 1]
     */
    fn mobLightAt(self, man : ChunkManager, pos : Vec3, lcurve : i64, daylight : f64) : LinRgb {
        const cell : IVec3 = ivec3(
            pos.x.floorToInt() as i32,
            (pos.y + 0.5).floorToInt() as i32,
            pos.z.floorToInt() as i32
        );
        const skyF : f64 = Mem::realOf(lcurve, man.skGetW(cell)) * daylight;
        const blk : ChannelLevels = man.blGetW(cell);
        const floor : f64 = Light::MIN;
        const span : f64 = 1.0 - Light::MIN;

        return LinRgb {
            r: floor + span * (skyF + Mem::realOf(lcurve, blk.r)),
            g: floor + span * (skyF + Mem::realOf(lcurve, blk.g)),
            b: floor + span * (skyF + Mem::realOf(lcurve, blk.b)),
        };
    }

    /**
     * Draw every mob of every species, sharing the world's z-buffer (so terrain
     * correctly occludes animals behind it). Each mob's ambient light factor is
     * sampled once (mobLight) and applied by drawQuad.
     * @param man     chunk manager (light maps, for per-mob ambient light)
     * @param mm      mob manager holding the per-species arrays
     * @param cam     the frame's camera
     * @param fb      the render target (framebuffer + z-buffer + size)
     * @param scene   the per-frame mob context (atlas, fog, day-state, hw)
     * @param lcurve  the renderer's brightness lookup table
     */
    pub(crate) fn drawAll(
        mut self,
        man : ChunkManager,
        mm : MobManager,
        cam : Camera,
        fb : FrameBuf,
        scene : MobScene,
        lcurve : i64
    ) : void {
        const day : f64 = scene.ds.skyAmbient;

        // Iterate the actors uniformly through the ActorVisual seam (RTTI
        // dispatch), instead of the old five per-species while-loops.
        const n : i32 = mm.actorCount();
        for (i of 0..n) {
            const a : dyn ActorVisual = mm.actorAt(i);
            self.mobLight = self.mobLightAt(man, a.pos(), lcurve, day);
            self.drawActor(cam, a, fb, scene);
        }
    }

    /**
     * Draw one actor: ask it for this frame's boxes, then draw each as an
     * oriented box in its frame. Which species it is never comes up.
     * @param cam    the frame's camera
     * @param a      the actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawActor(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        self.model.clear();
        a.buildModel(self.model);
        for (i of 0..self.model.count()) {
            self.drawObox(cam, a, fb, self.model.at(i), scene);
        }
    }
}
