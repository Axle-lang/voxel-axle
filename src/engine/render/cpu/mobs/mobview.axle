// mobview — the mob box-model renderer, split out of Renderer.
//
// Mobs (and torches) are drawn as little stacks of shaded, atlas-textured
// cuboids sharing the world z-buffer. That machinery — the oriented-box corner
// math, the per-face project + backface-cull + raster, the per-mob ambient
// light — is cohesive and lives here in an owned `MobView` (the Renderer holds
// one, like it holds a `Bloom`). MobView keeps its OWN projection scratch and
// oriented-box corner buffers, so it never reaches back into the Renderer — a
// one-way dependency (render → mobview), no import cycle.
//
// Per frame the Renderer hands in a `MobScene` value (atlas + fog colour + the
// day/night state + the projection half-width); MobView never stores frame
// state beyond the per-mob `mobLight`. The block torches reuse `drawQuad`
// directly, so it is the one public quad primitive.

use smalt::Mem;
use smalt::Color;
use crate::engine::ui::widget::{tintIf};
use crate::engine::shade::daymodel::{ DayState };
use crate::engine::render::cpu::raster::triangle::{
    rasterTriTex, rasterTri, columnSpan, RasterVert, RasterTri,
};
use crate::engine::render::cpu::raster::framebuf::{ FrameBuf, Band };
use crate::engine::render::cpu::raster::mip::{ MipAtlas };
use crate::engine::render::view::camera::{ Camera, Projected };
use crate::engine::shade::facelight::{ sunExposure };
use crate::engine::shade::gamma::{ Gamma, LinRgb };
use crate::engine::render::cpu::sky::fogtables::{ FogTable };
use crate::engine::math::vec3::{ Vec3, vec3, ivec3 };
use crate::engine::entity::mobs::MobManager;
use crate::engine::world::chunks::ChunkManager;
use crate::engine::seams::{ ChannelLevels, ActorVisual };
use crate::configs::atlas::{ Atlas, Tile };
use crate::configs::light::{ Light };
use crate::configs::mobs::{ MobKind };
use crate::configs::screen::{ Screen };

/**
 * The per-frame context for the mob pass: the atlas mip chain, the colour space
 * the faces are lit in, the distance-fog colour and the day/night state (sun
 * direction + daylight for shading). Bundled so each draw helper takes one
 * `scene` instead of threading four loose values through every call.
 */
struct MobScene {
    atlas : MipAtlas,
    gam : Gamma,
    fogT : FogTable,
    ds : DayState,
}

/** One box face's surface: flat fill colour, atlas tile (<0 = flat), hurt tint. */
struct Material {
    color : i32,
    tile : i32,
    hurt : bool,
}

/**
 * One body part placed in the mob's own frame: `ctr` is the box centre as
 * (right, up-above-feet, forward) and `half` its half-extents along the same
 * axes. Replaces the six loose mr/my/mf/hr/hy/hf scalars drawObox used to take.
 */
struct BoxPlacement {
    ctr : Vec3,
    half : Vec3,
}

class MobView {
    csx : i64,      // projected screen x / y / inverse depth (4 quad corners)
    csy : i64,
    ciz : i64,
    cvis : i32[],   // per-corner near-plane visibility (1 = in front)
    obx : i64,      // oriented-box world corners (8 per body part)
    oby : i64,
    obz : i64,
    mobLight : LinRgb, // ambient light on the mob currently being drawn, per channel

    /** Allocate the quad projection scratch and the oriented-box corner buffers. */
    constructor() {
        self.csx = Mem::take(8 * 8);
        self.csy = Mem::take(8 * 8);
        self.ciz = Mem::take(8 * 8);
        self.cvis = malloc<i32>(4);
        self.obx = Mem::take(8 * 8);
        self.oby = Mem::take(8 * 8);
        self.obz = Mem::take(8 * 8);
        self.mobLight = LinRgb { r: 1.0, g: 1.0, b: 1.0 };
    }

    /**
     * Project one world point into screen + inverse depth at slot k through the
     * shared Camera. Mobs keep their own scratch so the pass is independent of
     * the world face buffers.
     * @param cam  the camera (eye + orientation + projection width)
     * @param w    the world-space point
     * @param k    scratch slot index to store the result in
     */
    fn project(mut self, cam : Camera, w : Vec3, k : i32) : void {
        const pr : Projected = cam.project(w);
        if (pr.cz < Screen::NEAR_PLANE) {
            self.cvis[k] = 0;
            return;
        }
        Mem::putRealOf(self.csx, k, pr.sx);
        Mem::putRealOf(self.csy, k, pr.sy);
        Mem::putRealOf(self.ciz, k, pr.iz);
        self.cvis[k] = 1;
    }

    /**
     * Set the light every following quad is drawn in, until the next mob sets
     * its own. What the torch pass needs: a torch is the SOURCE, so it is not
     * lit by the room the way an animal standing in it is — left to take the
     * ambient it would be a black post in the middle of the pool of light it
     * is casting.
     * @param l  the light to draw in
     */
    pub(crate) fn setLight(mut self, l : LinRgb) : void {
        self.mobLight = l;
    }

    /**
     * Mob Lambert term for a face normal, lifted by ambient and exposed by the
     * same sun the world faces get — a mob has no shadow map, so it sees the
     * whole of it. Kept local so mobview has no back-reference to Renderer.
     * @param nx  normal x
     * @param ny  normal y
     * @param nz  normal z
     * @param ds  the day/night state (sun direction)
     * @return the mob face's light factor
     */
    fn shadeMob(self, nx : f64, ny : f64, nz : f64, ds : DayState) : f64 {
        return sunExposure(vec3(nx, ny, nz), vec3(ds.sunX, ds.sunY, ds.sunZ), 1.0);
    }

    /**
     * One face of a mob box: project 4 corners, backface-cull against the eye,
     * then fill atlas-textured (or flat-shaded). `mat.hurt` tints the face red
     * for the damage flash. Public because the block torches reuse it.
     * @param cam    the frame's camera
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param a      world-space corner a
     * @param b      world-space corner b
     * @param c      world-space corner c
     * @param d      world-space corner d
     * @param n      face normal (for backface cull + Lambert shading)
     * @param mat    the face surface (colour / tile / hurt)
     * @param scene  the per-frame mob context (atlas, fog, day-state, lens)
     */
    pub(crate) fn drawQuad(
        mut self,
        cam : Camera,
        fb : FrameBuf,
        a : Vec3,
        b : Vec3,
        c : Vec3,
        d : Vec3,
        n : Vec3,
        mat : Material,
        scene : MobScene
    ) : void {
        const mx : f64 = (a.x + b.x + c.x + d.x) * 0.25;
        const my : f64 = (a.y + b.y + c.y + d.y) * 0.25;
        const mz : f64 = (a.z + b.z + c.z + d.z) * 0.25;
        if ((cam.eye.x - mx) * n.x + (cam.eye.y - my) * n.y + (cam.eye.z - mz) * n.z <= 0.0) {
            return;
        }

        self.project(cam, a, 0);
        self.project(cam, b, 1);
        self.project(cam, c, 2);
        self.project(cam, d, 3);
        if (self.cvis[0] == 0 || self.cvis[1] == 0 || self.cvis[2] == 0 || self.cvis[3] == 0) {
            return;
        }

        // Mobs are little multi-box models: the full terrain light contrast
        // (0.5..1.0) makes every box edge read as a hard seam. Compress it
        // toward bright so adjacent faces blend and the model looks rounded
        // rather than crated.
        const shade : f64 = 0.80 + 0.20 * self.shadeMob(n.x, n.y, n.z, scene.ds);
        const bright : f64 = shade * self.mobLight.g;

        const sx0 : f64 = Mem::realOf(self.csx, 0);
        const sy0 : f64 = Mem::realOf(self.csy, 0);
        const iz0 : f64 = Mem::realOf(self.ciz, 0);
        const sx1 : f64 = Mem::realOf(self.csx, 1);
        const sy1 : f64 = Mem::realOf(self.csy, 1);
        const iz1 : f64 = Mem::realOf(self.ciz, 1);
        const sx2 : f64 = Mem::realOf(self.csx, 2);
        const sy2 : f64 = Mem::realOf(self.csy, 2);
        const iz2 : f64 = Mem::realOf(self.ciz, 2);
        const sx3 : f64 = Mem::realOf(self.csx, 3);
        const sy3 : f64 = Mem::realOf(self.csy, 3);
        const iz3 : f64 = Mem::realOf(self.ciz, 3);

        if (Atlas::USE_MOB_TEXTURES && mat.tile >= 0) {
            // A struck mob glows red: lift the red multiplier, damp green/blue.
            let tr : f64 = shade * self.mobLight.r;
            let tg : f64 = bright;
            let tb : f64 = shade * self.mobLight.b;
            if (mat.hurt) {
                tr = bright + 0.6;
                tg = bright * 0.4;
                tb = bright * 0.4;
            }
            const band : Band = Band { x0: 0, x1: fb.w };

            // The queue's vertex is 32-bit; the projection and the light are
            // narrowed here, once per corner.
            const va : RasterVert = RasterVert {
                sx: sx0 as f32,
                sy: sy0 as f32,
                iz: iz0 as f32,
                u: 0.0 as f32,
                v: 1.0 as f32,
                tr: tr as f32,
                tg: tg as f32,
                tb: tb as f32,
            };
            const vb : RasterVert = RasterVert {
                sx: sx1 as f32,
                sy: sy1 as f32,
                iz: iz1 as f32,
                u: 1.0 as f32,
                v: 1.0 as f32,
                tr: tr as f32,
                tg: tg as f32,
                tb: tb as f32,
            };
            const vc : RasterVert = RasterVert {
                sx: sx2 as f32,
                sy: sy2 as f32,
                iz: iz2 as f32,
                u: 1.0 as f32,
                v: 0.0 as f32,
                tr: tr as f32,
                tg: tg as f32,
                tb: tb as f32,
            };
            const vd : RasterVert = RasterVert {
                sx: sx3 as f32,
                sy: sy3 as f32,
                iz: iz3 as f32,
                u: 0.0 as f32,
                v: 0.0 as f32,
                tr: tr as f32,
                tg: tg as f32,
                tb: tb as f32,
            };
            const tile : i16 = mat.tile as i16;

            // A mob is drawn straight into the full-width band rather than
            // queued, so nothing reads the span — filled in anyway, so no
            // triangle anywhere carries a stale one.
            let (abcLo, abcHi) = columnSpan(sx0, sx1, sx2);
            let (acdLo, acdHi) = columnSpan(sx0, sx2, sx3);
            const abc : RasterTri = RasterTri {
                a: va,
                b: vb,
                c: vc,
                tile,
                wrap: 0 as i8,
                minx: abcLo,
                maxx: abcHi,
            };
            rasterTriTex(
                fb,
                abc,
                scene.atlas,
                scene.gam,
                scene.fogT,
                band
            );
            const acd : RasterTri = RasterTri {
                a: va,
                b: vc,
                c: vd,
                tile,
                wrap: 0 as i8,
                minx: acdLo,
                maxx: acdHi,
            };
            rasterTriTex(
                fb,
                acd,
                scene.atlas,
                scene.gam,
                scene.fogT,
                band
            );
        } else {
            const col : i32 = scene.gam.shade(tintIf(mat.hurt, mat.color), bright);
            rasterTri(
                fb,
                sx0,
                sy0,
                iz0,
                sx1,
                sy1,
                iz1,
                sx2,
                sy2,
                iz2,
                col
            );
            rasterTri(
                fb,
                sx0,
                sy0,
                iz0,
                sx2,
                sy2,
                iz2,
                sx3,
                sy3,
                iz3,
                col
            );
        }
    }

    /**
     * One face of an oriented box: the 4 vertices are corner indices into the
     * `ob*` world-corner buffers filled by drawObox.
     * @param cam    the frame's camera
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param i0     corner index for vertex 0
     * @param i1     corner index for vertex 1
     * @param i2     corner index for vertex 2
     * @param i3     corner index for vertex 3
     * @param n      face normal (backface cull + Lambert shading)
     * @param mat    the face surface (colour / tile / hurt)
     * @param scene  the per-frame mob context
     */
    fn oquad(
        mut self,
        cam : Camera,
        fb : FrameBuf,
        i0 : i32,
        i1 : i32,
        i2 : i32,
        i3 : i32,
        n : Vec3,
        mat : Material,
        scene : MobScene
    ) : void {
        const c0 : Vec3 = vec3(
            Mem::realOf(self.obx, i0),
            Mem::realOf(self.oby, i0),
            Mem::realOf(self.obz, i0)
        );
        const c1 : Vec3 = vec3(
            Mem::realOf(self.obx, i1),
            Mem::realOf(self.oby, i1),
            Mem::realOf(self.obz, i1)
        );
        const c2 : Vec3 = vec3(
            Mem::realOf(self.obx, i2),
            Mem::realOf(self.oby, i2),
            Mem::realOf(self.obz, i2)
        );
        const c3 : Vec3 = vec3(
            Mem::realOf(self.obx, i3),
            Mem::realOf(self.oby, i3),
            Mem::realOf(self.obz, i3)
        );

        self.drawQuad(
            cam,
            fb,
            c0,
            c1,
            c2,
            c3,
            n,
            mat,
            scene
        );
    }

    /**
     * Draw one body part as an **oriented** box: the part is positioned in the
     * mob's own frame (`place.ctr` = right / up-above-feet / forward, half-extents
     * `place.half`), then the whole box is rotated by the mob's heading, so the
     * head/body/legs turn together as a rigid model. The +forward face carries
     * `faceTile` (the animal's face), the rest `skinTile`. Death collapses the
     * box (sink + squash + topple along the heading).
     * @param cam       the frame's camera
     * @param a         the actor whose frame the box is placed in (seam-typed)
     * @param fb        the render target (framebuffer + z-buffer + size)
     * @param place     the box centre + half-extents in the mob frame
     * @param color     flat fill color (used when untextured)
     * @param skinTile  atlas tile for the non-forward faces
     * @param faceTile  atlas tile for the +forward face
     * @param scene     the per-frame mob context
     */
    fn drawObox(
        mut self,
        cam : Camera,
        a : dyn ActorVisual,
        fb : FrameBuf,
        place : BoxPlacement,
        color : i32,
        skinTile : i32,
        faceTile : i32,
        scene : MobScene
    ) : void {
        // Read the seam once (dynamic dispatch) into locals for the corner loop.
        const heading : f64 = a.heading();
        const pos : Vec3 = a.pos();
        const fwdx : f64 = heading.cos();
        const fwdz : f64 = heading.sin();
        const rgtx : f64 = heading.sin();
        const rgtz : f64 = 0.0 - heading.cos();

        // Death: topple onto one side like Minecraft — rotate the whole model
        // up→right about the feet by up to ~90° as the collapse plays out. `lr`,
        // `lu` are the same rotation applied to every part (so the box stays
        // rigid); a small lift keeps the resting flank from dipping underground.
        const pr : f64 = a.deathProgress();
        const theta : f64 = pr * 1.5707963;
        const ct : f64 = theta.cos();
        const st : f64 = theta.sin();
        const lift : f64 = 0.15 * st;

        const mr : f64 = place.ctr.x;
        const my : f64 = place.ctr.y;
        const mf : f64 = place.ctr.z;
        const hr : f64 = place.half.x;
        const hy : f64 = place.half.y;
        const hf : f64 = place.half.z;
        for (ci of 0..8) {
            const sr : f64 = (ci & 1) != 0 ? 1.0 : 0.0 - 1.0;
            const su : f64 = (ci & 2) != 0 ? 1.0 : 0.0 - 1.0;
            const sf : f64 = (ci & 4) != 0 ? 1.0 : 0.0 - 1.0;
            const lr0 : f64 = mr + sr * hr;
            const hun : f64 = my + su * hy;
            const lf : f64 = mf + sf * hf;
            const lr : f64 = lr0 * ct + hun * st;
            const lu : f64 = hun * ct - lr0 * st + lift;
            Mem::putRealOf(self.obx, ci, pos.x + lr * rgtx + lf * fwdx);
            Mem::putRealOf(self.oby, ci, pos.y + lu);
            Mem::putRealOf(self.obz, ci, pos.z + lr * rgtz + lf * fwdz);
        }

        const hurt : bool = a.hurtFlash() > 0;

        // The right and up face normals rotate with the topple (forward is the
        // rotation axis, so forward normals are unchanged), keeping backface
        // culling correct while the body lies down.
        const rnx : f64 = ct * rgtx;
        const rny : f64 = 0.0 - st;
        const rnz : f64 = ct * rgtz;
        const unx : f64 = st * rgtx;
        const uny : f64 = ct;
        const unz : f64 = st * rgtz;

        const skin : Material = Material {
            color,
            tile: skinTile,
            hurt,
        };
        const faceM : Material = Material {
            color,
            tile: faceTile,
            hurt,
        };
        self.oquad(
            cam,
            fb,
            1,
            5,
            7,
            3,
            vec3(rnx, rny, rnz),
            skin,
            scene
        );
        self.oquad(
            cam,
            fb,
            4,
            0,
            2,
            6,
            vec3(0.0 - rnx, 0.0 - rny, 0.0 - rnz),
            skin,
            scene
        );
        self.oquad(
            cam,
            fb,
            2,
            3,
            7,
            6,
            vec3(unx, uny, unz),
            skin,
            scene
        );
        self.oquad(
            cam,
            fb,
            4,
            5,
            7,
            6,
            vec3(fwdx, 0.0, fwdz),
            faceM,
            scene
        );
        self.oquad(
            cam,
            fb,
            1,
            0,
            2,
            3,
            vec3(0.0 - fwdx, 0.0, 0.0 - fwdz),
            skin,
            scene
        );

        // Once tipping over, the underside comes into view, so draw it too.
        if (pr > 0.0) {
            self.oquad(
                cam,
                fb,
                0,
                1,
                5,
                4,
                vec3(0.0 - unx, 0.0 - uny, 0.0 - unz),
                skin,
                scene
            );
        }
    }

    /**
     * Draw a chicken as a stack of oriented boxes (legs, body, head, beak, wattle).
     * @param cam    the frame's camera
     * @param a      chicken actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawChicken(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        const sw : f64 = (a.walkPhase()).sin() * 0.08;   // forward leg stride
        const leg : i32 = Color::packBytes(232, 150, 40);
        const body : i32 = Color::packBytes(236, 236, 232);
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.07, 0.10, sw), half: vec3(0.035, 0.10, 0.04) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0 - 0.07, 0.10, 0.0 - sw), half: vec3(0.035, 0.10, 0.04) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.27, 0.0), half: vec3(0.15, 0.14, 0.18) },
            body,
            Tile::CHICKEN_BODY,
            Tile::CHICKEN_BODY,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.47, 0.18), half: vec3(0.11, 0.12, 0.10) },
            body,
            Tile::CHICKEN_BODY,
            Tile::CHICKEN_HEAD,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.45, 0.30), half: vec3(0.05, 0.04, 0.06) },
            Color::packBytes(232, 170, 40),
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.58, 0.08), half: vec3(0.05, 0.06, 0.04) },
            Color::packBytes(200, 40, 40),
            -1,
            -1,
            scene
        );
    }

    /**
     * Draw a sheep as a stack of oriented boxes (four legs, woolly body, head).
     * @param cam    the frame's camera
     * @param a      sheep actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawSheep(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        const sw : f64 = (a.walkPhase()).sin() * 0.11;
        const leg : i32 = Color::packBytes(54, 46, 40);
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0 - 0.20, 0.16, 0.18 + sw), half: vec3(0.07, 0.16, 0.07) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.20, 0.16, 0.18 - sw), half: vec3(0.07, 0.16, 0.07) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.0 - 0.20, 0.16, 0.0 - 0.18 - sw),
                half: vec3(0.07, 0.16, 0.07),
            },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.20, 0.16, 0.0 - 0.18 + sw), half: vec3(0.07, 0.16, 0.07) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.50, 0.0), half: vec3(0.28, 0.30, 0.40) },
            Color::packBytes(232, 230, 222),
            Tile::SHEEP_WOOL,
            Tile::SHEEP_WOOL,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.54, 0.46), half: vec3(0.15, 0.15, 0.14) },
            Color::packBytes(226, 222, 214),
            Tile::SHEEP_WOOL,
            Tile::SHEEP_HEAD,
            scene
        );
    }

    /**
     * Draw a cow as a stack of oriented boxes (four legs, body, head).
     * @param cam    the frame's camera
     * @param a      cow actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawCow(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        const sw : f64 = (a.walkPhase()).sin() * 0.12;
        const leg : i32 = Color::packBytes(70, 54, 44);
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0 - 0.26, 0.20, 0.24 + sw), half: vec3(0.09, 0.20, 0.09) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.26, 0.20, 0.24 - sw), half: vec3(0.09, 0.20, 0.09) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.0 - 0.26, 0.20, 0.0 - 0.24 - sw),
                half: vec3(0.09, 0.20, 0.09),
            },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.26, 0.20, 0.0 - 0.24 + sw), half: vec3(0.09, 0.20, 0.09) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.60, 0.0), half: vec3(0.38, 0.34, 0.50) },
            Color::packBytes(110, 86, 66),
            Tile::COW_BODY,
            Tile::COW_BODY,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.64, 0.58), half: vec3(0.18, 0.18, 0.18) },
            Color::packBytes(110, 86, 66),
            Tile::COW_BODY,
            Tile::COW_HEAD,
            scene
        );
    }

    /**
     * Draw a pig as a stack of oriented boxes (four legs, body, head, snout).
     * @param cam    the frame's camera
     * @param a      pig actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawPig(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        const sw : f64 = (a.walkPhase()).sin() * 0.10;
        const leg : i32 = Color::packBytes(196, 128, 128);
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0 - 0.20, 0.16, 0.20 + sw), half: vec3(0.07, 0.16, 0.07) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.20, 0.16, 0.20 - sw), half: vec3(0.07, 0.16, 0.07) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.0 - 0.20, 0.16, 0.0 - 0.20 - sw),
                half: vec3(0.07, 0.16, 0.07),
            },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.20, 0.16, 0.0 - 0.20 + sw), half: vec3(0.07, 0.16, 0.07) },
            leg,
            -1,
            -1,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.46, 0.0), half: vec3(0.30, 0.26, 0.42) },
            Color::packBytes(222, 150, 150),
            Tile::PIG_BODY,
            Tile::PIG_BODY,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.50, 0.48), half: vec3(0.18, 0.17, 0.16) },
            Color::packBytes(226, 156, 156),
            Tile::PIG_BODY,
            Tile::PIG_HEAD,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement { ctr: vec3(0.0, 0.47, 0.64), half: vec3(0.08, 0.07, 0.05) },
            Color::packBytes(232, 170, 170),
            -1,
            -1,
            scene
        );
    }

    /**
     * Creeper: textured from the atlas. Normally the green creeper skin with its
     * iconic face on the head's forward face; once the fuse is lit it swaps to
     * the "gilet jaune" charge skin/face, swells to 1.25x and strobes white
     * (faster as the blast nears). The `color` args are the lighting base.
     * @param cam    the frame's camera
     * @param a      creeper actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawCreeper(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        const sw : f64 = (a.walkPhase()).sin() * 0.10;
        const fuse : i32 = a.fuseLevel();

        // Calm green vs. charging gilet jaune skin/face tiles + base tints.
        let skin : i32 = Tile::CREEPER_SKIN;
        let face : i32 = Tile::CREEPER_FACE;
        let body : i32 = Color::packBytes(58, 140, 58);
        let leg : i32 = Color::packBytes(42, 96, 42);
        // Legs always wear the plain green skin — the vest only belongs on the
        // torso, so they never carry the charge tile.
        let legTile : i32 = Tile::CREEPER_SKIN;

        // Charging menace: swell the whole model and strobe white. The strobe
        // accelerates as the fuse runs down; a flash frame paints every part
        // flat white (tile = -1) so it reads as a bright pulse over the model.
        let s : f64 = 1.0;
        let flash : bool = false;
        if (fuse >= 0) {
            skin = Tile::CHARGE_SKIN;
            face = Tile::CHARGE_FACE;
            body = Color::packBytes(228, 196, 40);
            leg = Color::packBytes(170, 140, 28);
            s = 1.25;
            const period : i32 = 2 + fuse / 40;
            if ((fuse / period) % 4 == 0) {
                flash = true;
            }
        }
        if (flash) {
            const wht : i32 = Color::packBytes(242, 248, 242);
            skin = -1;
            face = -1;
            legTile = -1;
            body = wht;
            leg = wht;
        }

        // Four legs (plain skin), the upright body (vest), then the head whose
        // forward face carries the creeper / meme mug. Every extent and offset
        // is scaled by `s` so the swell grows from the feet.
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3((0.0 - 0.12) * s, 0.13 * s, (0.12 + sw) * s),
                half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            },
            leg,
            legTile,
            legTile,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.12 * s, 0.13 * s, (0.12 - sw) * s),
                half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            },
            leg,
            legTile,
            legTile,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3((0.0 - 0.12) * s, 0.13 * s, (0.0 - 0.12 - sw) * s),
                half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            },
            leg,
            legTile,
            legTile,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.12 * s, 0.13 * s, (0.0 - 0.12 + sw) * s),
                half: vec3(0.07 * s, 0.13 * s, 0.07 * s),
            },
            leg,
            legTile,
            legTile,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.0, 0.58 * s, 0.0),
                half: vec3(0.16 * s, 0.32 * s, 0.11 * s),
            },
            body,
            skin,
            skin,
            scene
        );
        self.drawObox(
            cam,
            a,
            fb,
            BoxPlacement {
                ctr: vec3(0.0, 1.06 * s, 0.0),
                half: vec3(0.18 * s, 0.18 * s, 0.18 * s),
            },
            body,
            skin,
            face,
            scene
        );
    }

    /**
     * Ambient light factor (0..1) for a mob at world position (mx,my,mz): the
     * brighter of sky×daylight and block light at its cell, through the same
     * exponential curve as terrain, so mobs darken at night / underground and
     * are lit — in the torch's own colour — by nearby torches. Sky and block
     * light ADD, as they do on terrain; taking the brighter of the two is what
     * stops a torch from warming an animal the sky already reaches.
     * @param man       the chunk manager (light maps)
     * @param pos       the mob's feet position
     * @param lcurve    the renderer's brightness lookup (lightFalloff^(15-level))
     * @param daylight  the day factor that scales sky light
     * @return ambient light factor in [`Light::MIN`, 1]
     */
    fn mobLightAt(self, man : ChunkManager, pos : Vec3, lcurve : i64, daylight : f64) : LinRgb {
        const cell : IVec3 = ivec3(
            pos.x.floorToInt() as i32,
            (pos.y + 0.5).floorToInt() as i32,
            pos.z.floorToInt() as i32
        );
        const skyF : f64 = Mem::realOf(lcurve, man.skGetW(cell)) * daylight;
        const blk : ChannelLevels = man.blGetW(cell);
        const floor : f64 = Light::MIN;
        const span : f64 = 1.0 - Light::MIN;

        return LinRgb {
            r: floor + span * (skyF + Mem::realOf(lcurve, blk.r)),
            g: floor + span * (skyF + Mem::realOf(lcurve, blk.g)),
            b: floor + span * (skyF + Mem::realOf(lcurve, blk.b)),
        };
    }

    /**
     * Draw every mob of every species, sharing the world's z-buffer (so terrain
     * correctly occludes animals behind it). Each mob's ambient light factor is
     * sampled once (mobLight) and applied by drawQuad.
     * @param man     chunk manager (light maps, for per-mob ambient light)
     * @param mm      mob manager holding the per-species arrays
     * @param cam     the frame's camera
     * @param fb      the render target (framebuffer + z-buffer + size)
     * @param scene   the per-frame mob context (atlas, fog, day-state, hw)
     * @param lcurve  the renderer's brightness lookup table
     */
    pub(crate) fn drawAll(
        mut self,
        man : ChunkManager,
        mm : MobManager,
        cam : Camera,
        fb : FrameBuf,
        scene : MobScene,
        lcurve : i64
    ) : void {
        const day : f64 = scene.ds.skyAmbient;

        // Iterate the actors uniformly through the ActorVisual seam (RTTI
        // dispatch), instead of the old five per-species while-loops.
        const n : i32 = mm.actorCount();
        for (i of 0..n) {
            const a : dyn ActorVisual = mm.actorAt(i);
            self.mobLight = self.mobLightAt(man, a.pos(), lcurve, day);
            self.drawActor(cam, a, fb, scene);
        }
    }

    /**
     * Dispatch one actor to its per-species box model, switched on the seam's
     * `kind()`. The geometry stays per-species; only the collection iteration and
     * the field reads flow through the ActorVisual seam.
     * @param cam    the frame's camera
     * @param a      the actor to draw (seam-typed)
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param scene  the per-frame mob context
     */
    fn drawActor(mut self, cam : Camera, a : dyn ActorVisual, fb : FrameBuf, scene : MobScene) : void {
        match a.kind() {
            MobKind::Chicken => { self.drawChicken(cam, a, fb, scene); }
            MobKind::Sheep => { self.drawSheep(cam, a, fb, scene); }
            MobKind::Cow => { self.drawCow(cam, a, fb, scene); }
            MobKind::Pig => { self.drawPig(cam, a, fb, scene); }
            _ => { self.drawCreeper(cam, a, fb, scene); }
        }
    }
}
