// renderer — the software frame conductor.
//
// One class, and what it does is decide the ORDER of a frame: clear, sky
// gradient and celestial bodies, the world faces, the mobs, the selection
// wireframe, then the post chain (god-rays, bloom, the underwater overlay).
// Every heavy job lives in a component it composes and none of them knows
// about the others:
//
//   `SkyEngine`      (cpu::sky::skyengine)      everything above the ground
//   `TextureAtlas`   (cpu::atlas)               the mip chain
//   `GammaTables`    (shade::gamma)             the sRGB <-> linear tables
//   `ChunkRenderer`  (cpu::world::chunkview)    the world-face raster crew
//   `MobView`        (cpu::mobs::mobview)       the mob box models
//   `Selection`      (cpu::selection)           the targeted-block wireframe
//   `Bloom`          (cpu::bloom)               the soft glow
//   `GodRayFX` / `UnderwaterFX` (cpu::postfx)   the other two post passes
//
// It is handed a `FrameDesc` once a frame (render::frame) — the camera, the
// hour's light, the creatures' boxes, the torches, the aimed block — and draws
// what it says; nothing below it knows there is a player or a mob.

use smalt::Mem;
use smalt::{ Job, WorkerPool };
use std::time::monotonicNanos;
use smalt::Color;
use crate::engine::render::cpu::bloom::Bloom;
use crate::engine::sky::viewray::{ ViewRay };
use crate::engine::render::cpu::sky::clouddome::{ CloudSample };
use crate::engine::render::cpu::sky::skyengine::{ SkyEngine };
use crate::engine::render::cpu::postfx::{ GodRayFX, UnderwaterFX, SunScreen };
use crate::engine::render::cpu::atlas::{ TextureAtlas };
use crate::engine::render::cpu::world::chunkview::{ ChunkRenderer, buildSlotsJob };
use crate::engine::shade::daymodel::{ DayState };
use crate::engine::render::cpu::mobs::mobview::{ MobView, MobScene, Material };
use crate::engine::render::cpu::selection::Selection;
use crate::engine::render::cpu::raster::framebuf::{ clearFrame, clearDepth, FrameBuf };
use crate::engine::render::view::camera::{ lensFor, cameraOf, Camera, Projected, View };
use crate::engine::render::frame::framedesc::{ FrameDesc };
use crate::engine::render::cpu::raster::mip::{ MipAtlas };
use crate::engine::shade::gamma::{ Gamma, GammaTables, LinRgb };
use crate::engine::math::vec3::{ IVec3, vec3 };
use crate::engine::world::seams::{ TerrainView };
use crate::configs::atlas::{ Tile };
use crate::configs::light::{ Light };
use crate::configs::render::{ Render };
use crate::configs::screen::{ Screen };
use crate::configs::water::{ Water };

/**
 * Independent world-raster workers, each with its own triangle queue and
 * clipping scratch: one on the calling thread, the rest spawned per frame.
 */
const BUILD_WORKERS : i32 = 6;

/** Screen column bands the fill splits into. */
const RASTER_BANDS : i32 = 12;

/**
 * The world-face raster crew: `BUILD_WORKERS` independent components, each
 * with its own triangle queue and clipping scratch.
 *
 * One was not enough for the reason the frame timings gave: the projection /
 * clip / light pass over eighty-eight thousand faces ran on ONE thread and was
 * two thirds of the world pass, while the fill it feeds already spread over
 * twelve. The Renderer, which fills the queues, and the banded fill, which
 * drains them, both hold the crew as a `Shared<RasterCrew>`.
 */
class RasterCrew {
    members : ChunkRenderer[],
    builders : Task<i32>[], // one slot per member but the first, which runs on the caller

    /** Build every member of the crew. */
    constructor() {
        self.members = malloc<ChunkRenderer>(BUILD_WORKERS as i64);
        for (i of 0..BUILD_WORKERS) {
            self.members[i as i64] = new ChunkRenderer();
        }
        self.builders = malloc<Task<i32>>(BUILD_WORKERS - 1);
    }

    /**
     * Hand every member this frame's atlas, colour space, fog and light.
     * @param atlas   the texture atlas mip chain view
     * @param gam     the colour space the texels are lit in
     * @param fogT    the fog: the sky's colour behind each pixel, and its depth curve
     * @param day     the day/night state
     * @param lcurve  the brightness-curve lookup
     */
    pub(crate) fn setFrame(
        mut self,
        atlas : MipAtlas,
        gam : Gamma,
        fogT : FogTable,
        day : DayState,
        lcurve : i64
    ) : void {
        for (i of 0..BUILD_WORKERS) {
            self.members[i as i64].setFrame(
                atlas,
                gam,
                fogT,
                day,
                lcurve
            );
        }
    }

    /**
     * Fill every member's triangle queue, the slots dealt round-robin: member 0
     * on this thread, the rest on their own.
     * @param world  the loaded chunks, their baked faces and their light
     * @param cam    the camera (eye + orientation + projection width)
     * @param phase  animation time phase (scrolls flowing-water textures)
     */
    pub(crate) fn build(mut self, world : dyn TerrainView, cam : Camera, phase : f64) : void {
        for (i of 0..BUILD_WORKERS - 1) {
            self.builders[i] = spawn buildSlotsJob(
                self.members[(i + 1) as i64],
                world,
                cam,
                phase,
                i + 1,
                BUILD_WORKERS
            );
        }

        self.members[0].buildSlots(
            world,
            cam,
            phase,
            0,
            BUILD_WORKERS
        );

        for (i of 0..BUILD_WORKERS - 1) {
            const d : i32 = self.builders[i].join();
        }
    }

    /**
     * Rasterise every member's queue into one column band.
     * @param fb  the render target
     * @param x0  the band's first column
     * @param x1  one past its last
     */
    pub(crate) fn fillBand(self, fb : FrameBuf, x0 : i32, x1 : i32) : void {
        for (i of 0..BUILD_WORKERS) {
            self.members[i as i64].rasterizeBand(fb, x0, x1);
        }
    }

    /**
     * Triangles the crew queued in the last build.
     * @return the queued triangle count summed over every member
     */
    pub(crate) fn triCount(self) : i32 {
        let n : i32 = 0;
        for (i of 0..BUILD_WORKERS) {
            n += self.members[i as i64].queuedTris;
        }
        return n;
    }
}

/**
 * The banded fill, as a pass the worker pool can run.
 *
 * A pass is attached to the pool once and run every frame after, so its
 * inputs are co-owned with the Renderer: the crew whose queues it drains, and
 * a one-slot frame the Renderer writes before each pass and the pass reads
 * during one.
 */
class BandFill : Job {
    crew : Shared<RasterCrew>,  // the queues to fill from, co-owned with the Renderer
    frame : Shared<FrameBuf[]>, // one slot: the target this frame, written before the pass

    /**
     * Build the pass around the crew it drains and the frame slot it reads.
     * @param crew   the raster crew
     * @param frame  the one-slot render target the Renderer publishes into
     */
    constructor(own crew : Shared<RasterCrew>, own frame : Shared<FrameBuf[]>) {
        self.crew = crew;
        self.frame = frame;
    }

    /**
     * Fill this share's column band from every worker's queue.
     *
     * The bands are disjoint columns, so no two shares touch the same z-buffer
     * word and none of them needs a lock.
     * @param share   which band
     * @param shares  how many bands the frame was cut into
     */
    fn run(mut self, share : i32, shares : i32) : void {
        const fb : FrameBuf = self.frame[0];
        const bw : i32 = (fb.w + shares - 1) / shares;
        const x0 : i32 = (bw * share).min(fb.w);
        const x1 : i32 = (bw * (share + 1)).min(fb.w);
        self.crew.fillBand(fb, x0, x1);
    }
}

/**
 * The frame conductor: composes the focused render components (texture atlas,
 * day/night lighting, world-face raster, bloom, mob box models, selection
 * wireframe) and drives one frame's passes. It holds no raster / lighting state
 * of its own beyond the projection half-width — every heavy job lives in a
 * component it delegates to.
 */
class Renderer {
    cam : Camera,         // this frame's camera, as the frame describes it
    atlas : TextureAtlas, // owns the atlas mip chain (setAtlas / atlasBase)
    gamma : GammaTables,  // owns the sRGB ↔ linear tables every pass lights through
    crew : Shared<RasterCrew>, // the world-face raster crew, co-owned with the banded fill
    fillUs : i64 = 0,          // microseconds spent in the banded fill, accumulated over the run
    sky : SkyEngine,  // everything above the ground: the atmosphere, the cloud
                      // deck, the fog those two agree on, and the backdrop
    bloom : Bloom,   // soft-glow post-process (owns its half-res buffers + jobs)
    mobs : MobView,  // mob box-model renderer (owns its own projection scratch)
    sel : Selection, // targeted-block selection wireframe (owns its own scratch)
    /**
     * The crew the parallel passes run on, started once instead of once a
     * frame. A fan-out of twelve costs ten microseconds here against four
     * hundred and ninety for twelve fresh threads, and the difference is paid
     * by THIS thread, in the middle of the frame. Co-owned with the sky, which
     * runs its paint on the same crew.
     */
    pool : Shared<WorkerPool>,
    fillPass : i32,             // the banded fill's handle into the pool
    frame : Shared<FrameBuf[]>, // one slot: this frame's target, published to the passes

    /**
     * Build a Renderer: set the projection width from config and construct the
     * render components (each owns its own scratch / buffers).
     */
    constructor() {
        self.cam = cameraOf(
            View {
                eye: vec3(0.0, 0.0, 0.0),
                cosy: 1.0,
                siny: 0.0,
                cosp: 1.0,
                sinp: 0.0,
            },
            lensFor(Screen::RENDER_W, Screen::RENDER_H)
        );
        self.atlas = new TextureAtlas();
        self.gamma = new GammaTables();
        self.crew = new shared RasterCrew();
        self.bloom = new Bloom();
        self.mobs = new MobView();
        self.sel = new Selection();
        // One fewer than the widest fan-out: the calling thread takes share 0.
        self.pool = new shared WorkerPool(RASTER_BANDS - 1);
        self.frame = Shared::wrap(malloc<FrameBuf>(1));
        self.frame[0] = FrameBuf {
            pixels: 0,
            zbuf: 0,
            w: 0,
            h: 0,
        };
        self.fillPass = self.pool.attach(new BandFill(self.crew, self.frame));
        // Built last: it attaches its own pass to the pool above.
        self.sky = new SkyEngine(self.pool);
    }

    /**
     * Stop the render crew and wait for it.
     *
     * Called before the framebuffer it fills is released, for the reason every
     * join in this program exists: a worker still writing into memory that has
     * been given back is the one bug none of the checks can catch.
     */
    pub(crate) fn close(mut self) : void {
        self.pool.close();
    }

    /**
     * Set the atlas base pointer and (re)build its mip chain (delegated to the
     * texture atlas).
     * @param base  base address of the loaded atlas texels
     */
    pub(crate) fn setAtlas(mut self, base : i64) : void {
        self.atlas.setBase(base, self.gamma.view());
    }

    /**
     * Base pointer to the full-resolution atlas texels (mip level 0), for callers
     * that need raw tile texels (e.g. the HUD hotbar icons).
     * @return base address of the level-0 atlas texels
     */
    pub(crate) fn atlasBase(self) : i64 {
        return self.atlas.base();
    }

    // ── World pass (clear → sky → world raster) ──

    /**
     * One frame's opaque terrain: build the triangle queues in parallel,
     * then fill them in disjoint parallel column bands.
     *
     * Two different parallel shapes, because the two halves are different
     * problems. The BUILD splits by chunk — every worker owns its queue,
     * so nothing is shared. The FILL splits by screen column — every band
     * owns its pixels, so no two threads touch the same z-buffer word,
     * and each band walks every worker's queue.
     * @param world   the loaded chunks, their baked faces and their light
     * @param fb      the render target (framebuffer + z-buffer + size)
     * @param cam     the camera (eye + orientation + projection width)
     * @param phase   animation time phase (scrolls flowing-water textures)
     * @param atlas   the texture atlas mip chain view
     * @param gam     the colour space the texels are lit in
     * @param fogT    the fog: the sky's colour behind each pixel, and its depth curve
     * @param day     the day/night state
     * @param lcurve  the brightness-curve lookup
     */
    pub(file) fn drawWorld(
        mut self,
        world : dyn TerrainView,
        fb : FrameBuf,
        cam : Camera,
        phase : f64,
        atlas : MipAtlas,
        gam : Gamma,
        fogT : FogTable,
        day : DayState,
        lcurve : i64
    ) : void {
        self.crew.setFrame(
            atlas,
            gam,
            fogT,
            day,
            lcurve
        );
        self.crew.build(world, cam, phase);

        const tFill : i64 = monotonicNanos();
        self.frame[0] = fb;
        self.pool.run(self.fillPass, RASTER_BANDS);
        self.fillUs += (monotonicNanos() - tFill) / 1000;
    }

    /**
     * Triangles the world pass queued in the last frame.
     * @return the queued triangle count
     */
    pub(crate) fn triCount(self) : i32 {
        return self.crew.triCount();
    }

    /**
     * Microseconds the banded fill has taken, accumulated over the run.
     * @return the accumulated fill time in microseconds
     */
    pub(crate) fn fillMicros(self) : i64 {
        return self.fillUs;
    }

    /**
     * Draw one full world frame: clear to the sky/fog (or deep water when
     * submerged), move the sky on a frame, then hand the world-face raster the
     * visible chunks to project + light + clip + fill. Mobs, torches, the sky
     * paint and post-fx are layered on by the caller after this returns.
     * @param world  the loaded chunks, their baked faces and their light
     * @param frame  what this frame shows
     * @param fb     the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn render(mut self, world : dyn TerrainView, frame : FrameDesc, fb : FrameBuf) : void {
        self.cam = frame.cam;

        // Under water the cleared "void" is deep water, and nothing paints over
        // it — `drawSky` returns early down there, so the colour has to be laid
        // down here. Above water it must not be: the sky paint covers every
        // pixel the world left empty, so a colour clear is a whole frame
        // written and then thrown away.
        if (frame.clock.underwater) {
            const deep : i32 = Color::packBytes(Water::DEEP_R, Water::DEEP_G, Water::DEEP_B);
            clearFrame(fb, deep);
        } else {
            clearDepth(fb);
        }

        // The sky moves on by a frame whether or not it is drawn: the fog reads
        // its colour field, and the world is fogged even from under water. It
        // is PAINTED later, by `drawSky`, into whatever the world leaves empty.
        self.sky.update(frame.day, self.cam, frame.clock.seconds, fb);

        self.drawWorld(
            world,
            fb,
            self.cam,
            frame.clock.ripple,
            self.atlas.mip(),
            self.gamma.view(),
            self.sky.fog(),
            frame.day,
            frame.lcurve
        );
    }

    /**
     * Paint the sky into every pixel the opaque passes left empty. Call after
     * the world, mobs and torches: it reads the z-buffer they wrote, and only
     * computes the pixels that are actually sky.
     * @param frame  what this frame shows
     * @param fb     the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn drawSky(mut self, frame : FrameDesc, fb : FrameBuf) : void {
        if (frame.clock.underwater) {
            self.sky.hidden();
            return;
        }
        self.sky.draw(frame.day, self.cam, fb);
    }

    /**
     * Microseconds the cloud march and fog build have taken, accumulated over the run.
     * @return the accumulated march time in microseconds
     */
    pub(crate) fn skyMarchMicros(self) : i64 {
        return self.sky.marchMicros();
    }

    /**
     * Microseconds the sky paint has taken, accumulated over the run.
     * @return the accumulated sky paint time in microseconds
     */
    pub(crate) fn skyDrawMicros(self) : i64 {
        return self.sky.drawMicros();
    }

    // ── Post-processing (god-rays, bloom, underwater) ──

    /**
     * Volumetric god-rays (crepuscular shafts): a screen-space radial scatter
     * from the sun's projected position. Each pixel marches toward the sun and
     * sums the visible-sky mask (z-buffer cleared = sky) with per-step decay, so
     * terrain silhouettes carve warm bright shafts out of the sky glow. Additive,
     * warm-tinted, scaled by daylight. Skipped with the sun below the horizon or
     * behind the camera. Call after the opaque world + mobs + torches are drawn.
     * @param frame  what this frame shows
     * @param fb     the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn godRays(self, frame : FrameDesc, fb : FrameBuf) : void {
        const ds : DayState = frame.day;
        if (!Render::GOD_RAYS_ON || ds.sunY < 0.02) {
            return;
        }

        // Project the sun direction to screen through the shared camera.
        const pr : Projected = self.cam.projectDir(vec3(ds.sunX, ds.sunY, ds.sunZ));
        if (pr.cz < 0.05) {
            return;   // sun behind the camera
        }

        // Overall exposure: fade in as the sun climbs, scale by daylight.
        let climb : f64 = ds.sunY * 4.0;
        if (climb > 1.0) {
            climb = 1.0;
        }

        // Shafts are made of the light that got past the deck, so a sun behind a
        // cloud casts none. Sampled once, at the sun — not per march step per
        // pixel, which is twenty-four cloud reads a pixel and was, measured, the
        // single most expensive thing in a sunset frame.
        const sunRay : ViewRay = ViewRay {
            dx: ds.sunX,
            dy: ds.sunY,
            dz: ds.sunZ,
            inv: 1.0,
        };
        const sunCloud : CloudSample = self.sky.clouds().sample(sunRay);
        const expo : f64 = Render::GOD_RAY_WEIGHT * ds.dirStrength * climb * (1.0 - sunCloud.a);
        if (expo < 0.002) {
            return;
        }
        if (expo <= 0.0) {
            return;
        }

        // The scatter is a PostEffect over the finished frame.
        let fx : GodRayFX = new GodRayFX(SunScreen {
            sunSx: pr.sx,
            sunSy: pr.sy,
            expo,
        });
        fx.apply(fb);
    }

    /**
     * Bloom: bright pixels (luminance above `Render::BLOOM_THRESHOLD`) bleed a soft glow.
     * Extracted and averaged into a half-resolution buffer, blurred separably a
     * few times, then added back over the full frame — so the sun, halo,
     * god-rays, water glints and snow get a warm honeyed glow. Midtones below the
     * threshold are untouched. Call after the sky/world/god-rays, before the HUD.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn bloomPass(self, fb : FrameBuf) : void {
        self.bloom.apply(fb);
    }

    /**
     * Procedural underwater post-pass: fog every pixel toward the water colour
     * by its real depth (read from the z-buffer) and add a moving caustic light
     * pattern, so being submerged feels like a living volume rather than a flat
     * tint. Call after the world + mobs are drawn, while the eye is underwater.
     * @param fb     the render target (framebuffer + z-buffer + size)
     * @param phase  time phase that animates the caustics
     */
    pub(crate) fn underwaterOverlay(self, fb : FrameBuf, phase : f64) : void {
        let fx : UnderwaterFX = new UnderwaterFX(phase);
        fx.apply(fb);
    }

    // ── Torches (thin upright posts, drawn via the mob quad path) ──

    /**
     * Draw the frame's torches as thin upright posts (4 side quads + a top),
     * reusing the oriented-quad path. Torch voxels emit no cube faces in the
     * mesh; the frame lists the ones in view.
     * @param frame  what this frame shows
     * @param fb     the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn renderTorches(self, frame : FrameDesc, fb : FrameBuf) : void {
        const hw : f64 = 0.09;
        const ht : f64 = 0.55;
        const mat : Material = Material {
            color: Color::packBytes(240, 180, 70),
            tile: Tile::TORCH,
            hurt: false,
        };
        const scene : MobScene = self.mobScene(frame.day);

        // A torch is drawn in its own light, above white, so it reads as the
        // source of the pool around it and the bloom catches the flame.
        self.mobs.setLight(LinRgb {
            r: Light::TORCH_GLOW,
            g: Light::TORCH_GLOW * 0.86,
            b: Light::TORCH_GLOW * 0.62,
        });

        for (ti of 0..frame.torchCount) {
            const cell : IVec3 = frame.torches[ti];
            const cx : f64 = (cell.x as f64) + 0.5;
            const cz : f64 = (cell.z as f64) + 0.5;
            const x0 : f64 = cx - hw;
            const x1 : f64 = cx + hw;
            const z0 : f64 = cz - hw;
            const z1 : f64 = cz + hw;
            const y0 : f64 = cell.y as f64;
            const y1 : f64 = y0 + ht;
            self.mobs.drawQuad(
                self.cam,
                fb,
                vec3(x1, y0, z1),
                vec3(x1, y0, z0),
                vec3(x1, y1, z0),
                vec3(x1, y1, z1),
                vec3(1.0, 0.0, 0.0),
                mat,
                scene
            );
            self.mobs.drawQuad(
                self.cam,
                fb,
                vec3(x0, y0, z0),
                vec3(x0, y0, z1),
                vec3(x0, y1, z1),
                vec3(x0, y1, z0),
                vec3(0.0 - 1.0, 0.0, 0.0),
                mat,
                scene
            );
            self.mobs.drawQuad(
                self.cam,
                fb,
                vec3(x0, y0, z1),
                vec3(x1, y0, z1),
                vec3(x1, y1, z1),
                vec3(x0, y1, z1),
                vec3(0.0, 0.0, 1.0),
                mat,
                scene
            );
            self.mobs.drawQuad(
                self.cam,
                fb,
                vec3(x1, y0, z0),
                vec3(x0, y0, z0),
                vec3(x0, y1, z0),
                vec3(x1, y1, z0),
                vec3(0.0, 0.0, 0.0 - 1.0),
                mat,
                scene
            );
            self.mobs.drawQuad(
                self.cam,
                fb,
                vec3(x0, y1, z0),
                vec3(x1, y1, z0),
                vec3(x1, y1, z1),
                vec3(x0, y1, z1),
                vec3(0.0, 1.0, 0.0),
                mat,
                scene
            );
        }
    }

    /**
     * Build this frame's mob/torch scene: the atlas mip chain, the colour space,
     * the distance-fog colour and the day/night state. Handed to the MobView
     * draws each frame.
     * @param ds  the frame's day/night state
     * @return the per-frame mob scene context
     */
    fn mobScene(self, ds : DayState) : MobScene {
        return MobScene {
            atlas: self.atlas.mip(),
            gam: self.gamma.view(),
            fogT: self.sky.fog(),
            ds,
        };
    }

    // ── Mobs (oriented-box models, drawn by cpu/mobs/mobview.axle) ──

    /**
     * Draw the frame's creature boxes through the MobView, sharing the world's
     * z-buffer (so terrain correctly occludes animals behind it).
     * @param frame  what this frame shows
     * @param fb     the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn renderMobs(self, frame : FrameDesc, fb : FrameBuf) : void {
        self.mobs.drawAll(
            self.cam,
            fb,
            self.mobScene(frame.day),
            frame.boxes,
            frame.boxCount
        );
    }

    /**
     * Draw the centre-screen crosshair.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn crosshair(self, fb : FrameBuf) : void {
        const pixels : i64 = fb.pixels;
        const w : i32 = fb.w;
        const h : i32 = fb.h;
        const cx : i32 = w / 2;
        const cy : i32 = h / 2;
        const white : i32 = Color::packBytes(255, 255, 255);
        for (i of -6..7) {
            Mem::putWordOf(pixels, cy * w + cx + i, white);
            Mem::putWordOf(pixels, (cy + i) * w + cx, white);
        }
    }

    // ── Selection wireframe (drawn by gfx/selection.axle) ──

    /**
     * Draw the soft, depth-tested outline of the block the frame says is aimed
     * at, hugging its real box height; nothing when none is.
     * @param frame  what this frame shows
     * @param fb     the render target (framebuffer + z-buffer + size)
     */
    pub(crate) fn drawSelection(self, frame : FrameDesc, fb : FrameBuf) : void {
        if (!frame.aim.on) {
            return;
        }
        self.sel.draw(
            self.cam,
            fb,
            frame.aim.cell.x,
            frame.aim.cell.y,
            frame.aim.cell.z,
            frame.aim.topH
        );
    }
}

