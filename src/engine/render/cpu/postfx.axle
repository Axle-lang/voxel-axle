// postfx — the two full-frame passes that are lighting rather than drawing:
// the volumetric god-rays, and the underwater overlay.
//
// Both implement `PostEffect`: they consume the finished framebuffer (colour
// + depth) and blend over it in place, so the frame's post chain is a set of
// uniform steps rather than a hand-ordered list of methods on the Renderer.
// Bloom, the third of them, is big enough to own its own file.
//
// The god-rays are a screen-space radial scatter from the sun's projected
// position: each pixel marches toward the sun summing the visible-sky mask,
// so terrain silhouettes carve bright warm shafts out of the air. They are
// disabled with the sun below the horizon, and skipped entirely underwater.

use smalt::Mem;
use crate::engine::math::narrow::{ floatOf };
use crate::engine::render::cpu::raster::{ FrameBuf, PostEffect };
use crate::configs::render::{ Render };
use crate::configs::water::{ Water };

/**
 * The sun projected to screen space plus the god-ray exposure: bundles the
 * three loose `sunSx, sunSy, expo` scalars that the god-ray driver, its row
 * band and its worker job all passed around together.
 */
struct SunScreen {
    sunSx : f64,
    sunSy : f64,
    expo : f64,
}

/**
 * The volumetric god-ray scatter as a PostEffect: a screen-space radial march
 * from the sun's projected position, summing the visible-sky mask (z-buffer
 * cleared → sky) with per-step decay so terrain silhouettes carve warm shafts.
 * Built each frame by Renderer.godRays (which does the sun projection + exposure
 * gate), then applied over the finished frame. Splits the rows across two threads
 * (disjoint output rows → race-free).
 */
class GodRayFX : PostEffect {
    sun : SunScreen,

    /**
     * Build the effect around the sun's screen projection + exposure.
     * @param sun  the projected sun position and god-ray exposure
     */
    constructor(own sun : SunScreen) {
        self.sun = sun;
    }

    /**
     * Apply the scatter over the frame: a worker does the top half while the
     * main thread does the bottom half.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    fn apply(mut self, fb : FrameBuf) : void {
        // Eight row bands, not two. The rows are disjoint outputs, so unlike
        // the world raster — where every band re-walks the whole triangle
        // queue — this splits with no redundant work at all and scales with
        // the cores it is given. It was costing a fifth of the frame on two
        // of them.
        // Eight, as a literal: a fixed-array size must be one — not a
        // `const` and not a `static` field — so the count and the `Task`
        // array below are kept in step by hand.
        const bh : i32 = (fb.h + 7) / 8;
        let jobs : Task<i32>[7];
        for (i of 0..7) {
            let y0 : i32 = bh * (i + 1);
            let y1 : i32 = bh * (i + 2);
            if (y1 > fb.h) {
                y1 = fb.h;
            }
            if (y0 > fb.h) {
                y0 = fb.h;
            }
            jobs[i] = spawn godRaysJob(self, fb, y0, y1);
        }

        let firstEnd : i32 = bh;
        if (firstEnd > fb.h) {
            firstEnd = fb.h;
        }
        self.rows(fb, 0, firstEnd);

        for (i of 0..7) {
            const d : i32 = jobs[i].join();
        }
    }

    /**
     * God-rays for the screen rows [y0, y1) — the parallel work unit.
     * @param fb  the render target (framebuffer + z-buffer + size)
     * @param y0  first screen row (inclusive)
     * @param y1  last screen row (exclusive)
     */
    pub(crate) fn rows(self, fb : FrameBuf, y0 : i32, y1 : i32) : void {
        const pixels : i64 = fb.pixels;
        const zbuf : i64 = fb.zbuf;
        const w : i32 = fb.w;
        const h : i32 = fb.h;
        const invN : f64 = 1.0 / (Render::GOD_RAY_SAMPLES as f64);
        const cr : f64 = Render::SKY_HALO_R as f64;
        const cg : f64 = Render::SKY_HALO_G as f64;
        const cb : f64 = Render::SKY_HALO_B as f64;

        for (y of y0..y1) {
            const row : i32 = y * w;
            for (x of 0..w) {
                const illum : f64 = godRayIllum(zbuf, w, h, x, y, self.sun);
                if (illum > 0.0) {
                    const f : f64 = illum * invN * self.sun.expo;
                    const c : i32 = Mem::dwordAt(pixels, (row + x) as i64 * 4);
                    const r : i32 = clampI32(
                        ((c >> 16) & 0xFF) + ((cr * f).floorToInt() as i32),
                        0,
                        255
                    );
                    const g : i32 = clampI32(
                        ((c >> 8) & 0xFF) + ((cg * f).floorToInt() as i32),
                        0,
                        255
                    );
                    const b : i32 = clampI32(
                        (c & 0xFF) + ((cb * f).floorToInt() as i32),
                        0,
                        255
                    );
                    Mem::putWordOf(pixels, row + x, r * 65536 + g * 256 + b);
                }
            }
        }
    }
}

/**
 * The living-water post-pass as a PostEffect: fog every pixel toward the water
 * colour by its real z-buffer depth, add a moving caustic light pattern, and
 * drift rising bubbles up the frame, so being submerged feels like a living
 * volume. Built each frame by Renderer.underwaterOverlay with the animation
 * phase; single-threaded (it reads and writes overlapping rows).
 */
class UnderwaterFX : PostEffect {
    phase : f64,

    /**
     * Build the effect around the animation phase.
     * @param phase  time phase that animates the caustics + bubbles
     */
    constructor(phase : f64) {
        self.phase = phase;
    }

    /**
     * Fog + caustics + bubbles over the finished frame.
     * @param fb  the render target (framebuffer + z-buffer + size)
     */
    fn apply(mut self, fb : FrameBuf) : void {
        const phase : f64 = self.phase;
        const pixels : i64 = fb.pixels;
        const zbuf : i64 = fb.zbuf;
        const w : i32 = fb.w;
        const h : i32 = fb.h;
        const fogR : f64 = Water::FOG_R as f64;
        const fogG : f64 = Water::FOG_G as f64;
        const fogB : f64 = Water::FOG_B as f64;

        for (y of 0..h) {
            const row : i32 = y * w;
            // Vertical half of the caustic pattern — constant across the row.
            const cy : f64 = ((y as f64) * Water::CAUSTIC_FREQ - phase * 1.3).sin();
            for (x of 0..w) {
                const idx : i32 = row + x;

                // Depth fog from the z-buffer: izp = 1/depth (0 = cleared bg).
                const izp : f64 = floatOf(zbuf, idx);
                let depth : f64 = Water::FOG_FAR;
                if (izp > 0.0) {
                    depth = 1.0 / izp;
                }
                let fog : f64 = depth / Water::FOG_FAR;
                if (fog > 1.0) {
                    fog = 1.0;
                }
                fog *= Water::FOG_MAX;

                const caustic : f64 =
                    (((x as f64) * Water::CAUSTIC_FREQ + phase).sin() + cy) * Water::CAUSTIC_AMP;
                const keep : f64 = 1.0 - fog;
                const c : i32 = Mem::dwordAt(pixels, (idx as i64) * 4);
                const r : i32 = clampI32(
                    ((((c >> 16) & 0xFF) as f64) * keep + fogR * fog + caustic).floorToInt() as i32,
                    0,
                    255
                );
                const g : i32 = clampI32(
                    ((((c >> 8) & 0xFF) as f64) * keep + fogG * fog + caustic).floorToInt() as i32,
                    0,
                    255
                );
                const b : i32 = clampI32(
                    (((c & 0xFF) as f64) * keep + fogB * fog + caustic).floorToInt() as i32,
                    0,
                    255
                );
                Mem::putWordOf(pixels, idx, r * 65536 + g * 256 + b);
            }
        }

        // Rising bubbles: bright motes drifting upward. Each gets its own
        // column, rise speed, phase and size from a per-index hash, so they
        // don't climb in lockstep (no visible grid) and the columns wobble with
        // height instead of forming straight streaks.
        const nb : i32 = Water::BUBBLE_COUNT;
        const bcol : i32 = 200 * 65536 + 228 * 256 + 244;
        for (bi of 0..nb) {
            const hx : i32 = (bi * 1664525 + 1013904223) & 0x7FFFFFFF;
            const hp : i32 = ((bi + 1) * 22695477 + 13) & 0x7FFFFFFF;
            const hs : i32 = ((bi + 7) * 40503 + 101) & 0x7FFFFFFF;

            // Per-bubble rise speed (0.5..1.5x) breaks the synchronised motion.
            const sp : f64 = 0.5 + ((hs % 1000) as f64) * 0.001;
            const trav : i32 = (phase * Water::BUBBLE_SPEED * sp).floorToInt() as i32;
            const yy : i32 = h - 1 - (((hp + trav) & 0x7FFFFFFF) % h);

            // Column wobbles with height + its own phase → wavy, not a streak.
            const wob : f64 = (phase * 0.4 + (bi as f64) * 1.7 + (yy as f64) * 0.07).sin() * 3.0;
            const bx : i32 = (hx % w) + wob.floorToInt() as i32;
            self.plotBubble(fb, bx, yy, bcol);

            // Vary size: about half are a 2-px mote, the rest a single pixel.
            if ((hs & 1) == 0) {
                self.plotBubble(fb, bx + 1, yy, bcol);
                self.plotBubble(fb, bx, yy - 1, bcol);
            }
        }
    }

    /**
     * Lighten one in-bounds pixel toward `col` (one cell of a bubble mote).
     * @param fb   the render target (framebuffer + z-buffer + size)
     * @param x    pixel x
     * @param y    pixel y
     * @param col  bubble colour
     */
    fn plotBubble(self, fb : FrameBuf, x : i32, y : i32, col : i32) : void {
        const pixels : i64 = fb.pixels;
        const w : i32 = fb.w;
        const h : i32 = fb.h;
        if (x < 0 || x >= w || y < 0 || y >= h) {
            return;
        }

        const idx : i32 = y * w + x;
        const c : i32 = Mem::dwordAt(pixels, (idx as i64) * 4);
        const r : i32 = (((c >> 16) & 0xFF) + ((col >> 16) & 0xFF)) / 2;
        const g : i32 = (((c >> 8) & 0xFF) + ((col >> 8) & 0xFF)) / 2;
        const b : i32 = ((c & 0xFF) + (col & 0xFF)) / 2;
        Mem::putWordOf(pixels, idx, (r & 0xFF) * 65536 + (g & 0xFF) * 256 + (b & 0xFF));
    }
}

/**
 * March one screen pixel toward the sun, summing the visible-sky mask (z-buffer
 * cleared → sky) with per-step decay. The god-ray kernel, pulled out of
 * GodRayFX.rows so that loop stays shallow.
 * @param zbuf  depth buffer (≤ 0 where sky)
 * @param w     framebuffer width
 * @param h     framebuffer height
 * @param x     pixel x
 * @param y     pixel y
 * @param sun   the sun's screen position + exposure
 * @return the accumulated sky illumination (pre-exposure)
 */
fn godRayIllum(zbuf : i64, w : i32, h : i32, x : i32, y : i32, sun : SunScreen) : f64 {
    const n : i32 = Render::GOD_RAY_SAMPLES;
    const invN : f64 = 1.0 / (n as f64);
    const stepx : f64 = (sun.sunSx - (x as f64)) * invN * Render::GOD_RAY_DENSITY;
    const stepy : f64 = (sun.sunSy - (y as f64)) * invN * Render::GOD_RAY_DENSITY;

    let sxp : f64 = x as f64;
    let syp : f64 = y as f64;
    let illum : f64 = 0.0;
    let dec : f64 = 1.0;
    for (i of 0..n) {
        sxp += stepx;
        syp += stepy;
        const ix : i32 = sxp.floorToInt() as i32;
        const iy : i32 = syp.floorToInt() as i32;
        if (ix >= 0 && ix < w && iy >= 0 && iy < h
            && floatOf(zbuf, (iy * w + ix) as i64) <= 0.0) {
            illum += dec;   // a sky sample contributes
        }
        dec *= Render::GOD_RAY_DECAY;
    }
    return illum;
}

/**
 * Worker job: god-rays for one horizontal row band, run on its own thread by
 * GodRayFX.apply (spawn → join). A thin wrapper so `spawn` calls a free
 * function (the effect is passed by value).
 * @param fx  the god-ray effect whose rows are drawn
 * @param fb  the render target (framebuffer + z-buffer + size)
 * @param y0  first screen row (inclusive)
 * @param y1  last screen row (exclusive)
 * @return 0 (Task result unused)
 */
fn godRaysJob(fx : GodRayFX, fb : FrameBuf, y0 : i32, y1 : i32) : i32 {
    fx.rows(fb, y0, y1);
    return 0;
}
