// skyengine — everything above the ground, behind one seam.
//
// The sky is not one thing and never was: it is an atmosphere whose colour
// depends on where you look, a cloud field that is a volume of water, the light
// that gets through that volume onto the ground, the light that comes back out
// of it toward the eye, and the backdrop those are painted on. Five questions,
// answered in five files — but a caller should not have to know that, and until
// this existed the renderer knew all of it: it built the dome, marched the
// clouds, refilled the fog tables, ordered the gradient and the discs, and held
// the pieces in the right order by hand.
//
// So this owns the painting and answers for it. `update` builds a frame's
// colour field and fog from the cloud deck the frame hands it; `draw` paints
// them; `fog` hands the world pass the fog. The deck itself is not marched
// here: it is state that moves on frame by frame, so it belongs to the frame
// (frame::framebuilder advances `sky::cloudsky`) and is the same deck whichever
// backend paints it.
//
//   atmosphere   what colour the sky is in a direction, and the fog that follows
//   cloud        where the water is: a 3-D density field
//   cloudlight   what the sun makes of that water, on the way down to the ground
//   clouddome    …and on the way to the eye, as a direction-indexed table
//   backdrop     the gradient, the halo, the sun and the moon
//
// The ordering rules it enforces: the fog grid and the gradient both composite
// the deck; the discs are drawn after the gradient but read the same table, so
// a cloud crossing the sun hides it; and the whole paint happens AFTER the
// world, into the pixels it left empty.

use smalt::WorkerPool;
use std::time::monotonicNanos;
use crate::engine::render::cpu::sky::fogtables::{ FogTable, FogTables };
use crate::engine::sky::atmosphere::{ SkyDome, skyDomeFor };
use crate::engine::render::cpu::sky::viewrays::{ ViewRays };
use crate::engine::render::cpu::sky::backdrop::{
    SkyPaint, SkyPaintFrame, SKY_BANDS, drawCelestial
};
use crate::engine::sky::clouddome::{ CloudDome };
use crate::engine::shade::daymodel::{ DayState };
use crate::engine::render::cpu::raster::framebuf::{ FrameBuf };
use crate::engine::render::view::camera::{ Camera };

/**
 * The sky, for one frame: the atmosphere's colour field, and the tables the
 * world pass reads out of it and the frame's cloud deck.
 */
class SkyEngine {
    fogT : FogTables,      // the screen-space sky grid + the depth curve
    dome : SkyDome,        // this frame's colour field
    rays : ViewRays,       // …and how a pixel becomes a direction in it
    lastFog : FogTable,    // the view of the fog tables this frame was built with
    pool : Shared<WorkerPool>, // the render crew, co-owned with the SoftRenderer
    paintPass : i32,       // the sky paint's handle into that pool
    paintNow : Shared<SkyPaintFrame[]>, // one slot: what the paint is to draw this frame
    fogUs : i64,           // microseconds the fog build has taken, over the run
    drawUs : i64,          // ...and the sky paint

    /**
     * Compose the pieces; nothing is sized until the first `update`.
     * @param pool  the render crew the sky paint runs its row bands on
     */
    constructor(own pool : Shared<WorkerPool>) {
        self.fogT = new FogTables();
        self.dome = SkyDome {
            zenR: 0.0,
            zenG: 0.0,
            zenB: 0.0,
            horR: 0.0,
            horG: 0.0,
            horB: 0.0,
            sunX: 0.0,
            sunY: 1.0,
            sunZ: 0.0,
            haloFade: 0.0,
        };
        self.rays = ViewRays {
            cosy: 1.0,
            siny: 0.0,
            cosp: 1.0,
            sinp: 0.0,
            hw: 0.0,
            hh: 0.0,
            focal: 1.0,
        };
        self.lastFog = FogTable {
            cols: 1,
            rows: 1,
            r: 0,
            g: 0,
            b: 0,
            curve: 0,
            xscale: 0.0,
            yscale: 0.0,
            dscale: 0.0,
        };

        self.pool = pool;
        self.paintNow = Shared::wrap(malloc<SkyPaintFrame>(1));
        self.paintPass = self.pool.attach(new SkyPaint(self.paintNow));
        self.fogUs = 0;
        self.drawUs = 0;
    }

    /**
     * Ready the sky for one frame: the hour's colour field, the camera's view
     * rays, and the fog tables that read them and the deck.
     *
     * The dome is the atmosphere's answer for this hour; the fog grid samples
     * that same dome, so distant terrain dissolves into the sky actually painted
     * behind it.
     * @param ds     the day/night state
     * @param cam    the frame's camera (orientation, eye height and lens)
     * @param deck   the frame's cloud deck
     * @param fb     the render target, for the fog grid's size
     */
    pub(crate) fn update(
        mut self,
        ds : DayState,
        cam : Camera,
        deck : CloudDome,
        fb : FrameBuf
    ) : void {
        const t : i64 = monotonicNanos();
        self.dome = skyDomeFor(ds);
        self.rays = ViewRays {
            cosy: cam.cosy,
            siny: cam.siny,
            cosp: cam.cosp,
            sinp: cam.sinp,
            hw: cam.lens.hw,
            hh: cam.lens.hh,
            focal: cam.lens.focal,
        };

        self.lastFog = self.fogT.build(
            self.dome,
            self.rays,
            deck,
            fb.w,
            fb.h
        );
        self.fogUs += (monotonicNanos() - t) / 1000;
    }

    /**
     * Paint the backdrop into the pixels the world left empty: the gradient with
     * the deck composited over it, then the sun and moon, which the same deck can
     * hide. Called AFTER the world, mobs and torches — it reads their z.
     * @param ds    the day/night state
     * @param cam   the frame's camera
     * @param deck  the frame's cloud deck
     * @param fb    the render target
     */
    pub(crate) fn draw(mut self, ds : DayState, cam : Camera, deck : CloudDome, fb : FrameBuf) : void {
        const t : i64 = monotonicNanos();
        self.paintNow[0] = SkyPaintFrame {
            dome: self.dome,
            rays: self.rays,
            cloud: deck,
            fb,
        };
        self.pool.run(self.paintPass, SKY_BANDS);
        drawCelestial(ds, cam, fb, deck);
        self.drawUs += (monotonicNanos() - t) / 1000;
    }

    /**
     * Microseconds the fog build has taken, accumulated over the run.
     * @return the total, in microseconds
     */
    pub(crate) fn fogMicros(self) : i64 {
        return self.fogUs;
    }

    /**
     * Microseconds the sky paint has taken, accumulated over the run.
     * @return the total, in microseconds
     */
    pub(crate) fn drawMicros(self) : i64 {
        return self.drawUs;
    }

    /**
     * The fog this frame: the sky's colour behind each pixel, and how much of it
     * stands between the eye and a given depth.
     * @return the fog table view
     */
    pub(crate) fn fog(self) : FogTable {
        return self.lastFog;
    }
}
