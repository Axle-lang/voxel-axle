// backend — the one call the game makes to put a frame on screen.
//
// A backend is handed the frame the game decided (render::frame), the world's
// baked mesh and light to draw it from (`TerrainView`, read-only) and the
// window to show it in. It translates; it decides nothing the game reads back,
// so the software rasteriser and a GPU backend fed the same frame show the
// same thing, and game code changes without touching either.

use smalt::Window;
use crate::engine::render::frame::framedesc::{ FrameDesc };
use crate::engine::render::view::camera::{ Viewport };
use crate::engine::world::seams::{ TerrainView };

trait RenderBackend {
    /**
     * Draw the frame — the world, its creatures, the sky, the effects, the
     * overlay — and show it.
     * @param frame  what this frame shows
     * @param world  the baked mesh and the light it is lit by
     * @param win    the window to show it in
     */
    fn draw(mut self, frame : FrameDesc, world : dyn TerrainView, win : Window) : void;

    /**
     * The size this backend renders a window of this size at.
     * @param winW  the window's width in pixels
     * @param winH  the window's height in pixels
     * @return the render size
     */
    fn viewportFor(self, winW : i32, winH : i32) : Viewport;

    /**
     * Render at this size from the next frame on.
     * @param w  the target's width in pixels
     * @param h  the target's height in pixels
     */
    fn resize(mut self, w : i32, h : i32) : void;

    /**
     * Write the next frame drawn to a BMP file — the next, because a GPU backend can
     * only read back a frame it is drawing.
     * @param path  the file to write
     */
    fn captureNext(mut self, path : string) : void;

    /**
     * Whether the capture asked for has been written.
     * @return true once the file is on disk
     */
    fn captured(self) : bool;

    /**
     * Whether the backend can no longer draw — its GPU was lost. The game then carries
     * on with the software one.
     * @return true for good once it is
     */
    fn isLost(self) : bool;

    /**
     * What is drawing, for the start-up line.
     * @return the backend's name
     */
    fn name(self) : string;

    /** Print what the frames cost, averaged over the run. */
    fn report(self) : void;

    /** Stop any worker and release the target, before the window goes. */
    fn close(mut self) : void;
}
