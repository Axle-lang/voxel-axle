// atmosphere — what colour the sky is in a given direction.
//
// The model, and only the model: a value `SkyDome` built once a frame from the
// day state, and the colour it answers along any direction. Nothing here knows
// about pixels — the CPU painter (render::cpu::sky) asks it per pixel and
// through its fog grid, and a GPU sky would upload the same dome as uniforms.
//
// The fog and the sky pass ask the SAME dome, which is the point: a hillside on
// the horizon dissolves into the sky actually behind it, not into one average
// colour for the frame.

use crate::engine::shade::daymodel::{ DayState };
use crate::engine::sky::viewray::{ ViewRay };
use crate::configs::render::{ Render };

/** A colour in display range (0..255 per channel), before it is packed. */
struct SkyColour {
    pub(crate) r : f64,
    pub(crate) g : f64,
    pub(crate) b : f64,
}

/**
 * The highlight shoulder, in display units.
 *
 * The halo around the sun is ADDED to the gradient, so it runs past 255 long
 * before it runs out of sky, and clamping each channel at its own ceiling put a
 * hard boundary in the picture wherever a channel arrived there. Red saturates a
 * couple of degrees off the sun, green a little further, blue further still —
 * three curves of constant angle to the sun, which is to say three rings, each
 * with a hue shift across it, and all three at their worst at dusk when the halo
 * is strongest and the sky under it is already warm.
 *
 * The same shoulder the world's tone map uses: identity below the knee, then a
 * roll-off that approaches 255 without ever arriving. Value and slope match at
 * the join, so there is no boundary to see, and because the brightest channel is
 * compressed hardest the halo desaturates toward white as it brightens — which
 * is what a halo does.
 * @param x  the channel's value, which may exceed 255
 * @return the rolled-off value, below 255
 */
fn shoulder(x : f64) : f64 {
    if (x <= Render::SKY_SHOULDER) {
        return x;
    }
    const head : f64 = 255.0 - Render::SKY_SHOULDER;
    const over : f64 = x - Render::SKY_SHOULDER;
    return Render::SKY_SHOULDER + head * over / (over + head);
}

/**
 * The sky's colour in every direction this frame: a zenith-to-horizon gradient
 * with a warm glow around the sun.
 *
 * A value struct, so it crosses `spawn` into the gradient's worker rows the same
 * way `DayState` does.
 */
struct SkyDome {
    zenR : f64,
    zenG : f64,
    zenB : f64,
    horR : f64,
    horG : f64,
    horB : f64,
    sunX : f64,
    sunY : f64,
    sunZ : f64,
    haloFade : f64,

    /**
     * The sky's colour along a direction. It need not be unit: the ray carries
     * one over its length, which the caller that has one already computed and
     * the caller that has not sets to 1.
     * @param ray  the direction, with 1 / its length alongside
     * @return the sky's colour there, in display range
     */
    pub(crate) fn colourAt(self, ray : ViewRay) : SkyColour {
        let t : f64 = ray.dy * ray.inv;
        if (t < 0.0) {
            t = 0.0;
        }
        if (t > 1.0) {
            t = 1.0;
        }

        // Sharper near the horizon: the square root pushes the gradient up, the
        // way the real one is compressed into the first few degrees.
        const ts : f64 = t.sqrt();
        let r : f64 = self.horR + (self.zenR - self.horR) * ts;
        let g : f64 = self.horG + (self.zenG - self.horG) * ts;
        let b : f64 = self.horB + (self.zenB - self.horB) * ts;

        const sd : f64 = (ray.dx * self.sunX + ray.dy * self.sunY + ray.dz * self.sunZ) * ray.inv;
        if (sd > 0.0 && self.haloFade > 0.0) {
            const s2 : f64 = sd * sd;
            let halo : f64 = s2 * s2 * s2 * Render::SKY_HALO_STRENGTH * self.haloFade;
            if (sd > Render::SKY_CORE_THRESH) {
                const cc : f64 = (sd - Render::SKY_CORE_THRESH) / (1.0 - Render::SKY_CORE_THRESH);
                halo += cc * cc * self.haloFade * Render::SKY_CORE_STRENGTH;
            }
            r += (Render::SKY_HALO_R as f64) * halo;
            g += (Render::SKY_HALO_G as f64) * halo;
            b += (Render::SKY_HALO_B as f64) * halo;
        }
        return SkyColour { r, g, b };
    }
}

/**
 * The dome for this frame's day state: the two gradient endpoints derived from
 * the day/night sky colour, and the sun's glow.
 * @param ds  the day/night state
 * @return the sky's colour field for the frame
 */
fn skyDomeFor(ds : DayState) : SkyDome {
    const baseR : f64 = ds.skyColR as f64;
    const baseG : f64 = ds.skyColG as f64;
    const baseB : f64 = ds.skyColB as f64;
    const lift : f64 = Render::SKY_HORIZON_LIFT;

    let fade : f64 = (ds.sunY + 0.1) * 3.0;
    if (fade < 0.0) {
        fade = 0.0;
    }
    if (fade > 1.0) {
        fade = 1.0;
    }

    return SkyDome {
        zenR: baseR * Render::SKY_ZENITH_R,
        zenG: baseG * Render::SKY_ZENITH_G,
        zenB: baseB * Render::SKY_ZENITH_B,
        horR: baseR + (250.0 - baseR) * lift,
        horG: baseG + (245.0 - baseG) * lift,
        horB: baseB + (235.0 - baseB) * lift,
        sunX: ds.sunX,
        sunY: ds.sunY,
        sunZ: ds.sunZ,
        haloFade: fade,
    };
}
